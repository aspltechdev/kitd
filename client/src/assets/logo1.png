<style>
body,
html {
height: 100%;
margin: 0;
}
.zm-initial-loader-wrapper {
align-items: center;
background-color: var(--app-bg);
display: flex;
height: 100%;
justify-content: center;
width: 100%;
}
.zm-initial-loader-content {
align-items: center;
display: flex;
flex-direction: column;
gap: 24px;
text-align: center;
/* position: relative; */
}
.zm-initial-loader-content-text {
color: var(--app-text-color-dark);
font-size: 1rem;
line-height: 1.4;
font-family: ZohoPuvi;
}
.zm-initial-loader-content-image-wrapper {
position: relative;
block-size: 120px;
inline-size: 120px;
}
.zm-initial-loader-content-image {
width: 120px;
height: 120px;
flex: 0 0 auto;
position: absolute;
top: 0;
left: 0;
right: 0;
bottom: 0;
}
.zm-initial-loader-content-image--hide {
display: none;
}
@font-face {
font-family: ZohoPuvi;
font-weight: 400;
font-style: normal;
font-display: swap;
src:
local('ZohoPuvi Regular'),
local('ZohoPuvi-Regular'),
