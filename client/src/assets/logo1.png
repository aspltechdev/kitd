reyClr" data-tooltip="Tags">Tags</div><div class="zmMHdrData"><span class="jsTGNEM zmHIP"><button aria-haspopup="true" class="zmbtn__rhuj3 zmbtn--mbtn__rhuj3 zmbtn--flat__rhuj3 zmbtn--default__rhuj3 zmbtn--size__rhuj3" aria-label="Add tags for this email" data-tooltip="Tag As"><i class="zmci-tag__1nf5uxk" aria-hidden="true"></i></button></span></div></div><div class="zmMHdrRow zmMHmD jsEncryRow zmHIP"><div class="zmMHdrLeft zmGreyClr">Security</div><div class="zmMHdrData"><div class="zmMHdrSecurityData"><i class="msi-secured ylwtxt" aria-hidden="true" role="presentation"></i><span class="ylwtxt" aria-label="The email has been encrypted using TLS (Transport Layer Security)">TLS</span><span><a target="_blank" rel="noopener noreferrer" href="https://www.zoho.in/mail/help/email-encryption.html#alink3" class="zmBlueLink" aria-label="Learn about email encryption status">Learn more</a></span></div></div><div class="jsExtraExpanded zmHIP"><div class="zmmenubar__rhuj3 zmMHdrSecAct" role="toolbar" aria-label="mail association" data-tabster="{&quot;mover&quot;:{&quot;cyclic&quot;:true,&quot;direction&quot;:2,&quot;memorizeCurrent&quot;:true}}"><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i><button data-testid="reader" class="zmbtn__rhuj3 zmbtn--mbtn__rhuj3 zmbtn--flat__rhuj3 zmbtn--primary__rhuj3 zmbtn--xs__rhuj3" aria-label="Reader View" data-tooltip="Reader View"><i class="msi-readerView" addtionalclassnames="zmThmClr" aria-hidden="true"></i></button><button data-testid="mail-share-icon-btn" class="zmbtn__rhuj3 zmbtn--mbtn__rhuj3 zmbtn--flat__rhuj3 zmbtn--default__rhuj3 zmbtn--xs__rhuj3 share-icn" aria-label="Click to select this mail for sharing" data-tooltip="Click to select this mail for sharing"><i class="msi-share "></i></button><i tabindex="0" role="none" data-tabster-dummy="" aria-hidden="true" style="position: fixed; height: 1px; width: 1px; opacity: 0.001; z-index: -1; content-visibility: hidden; top: 0px; left: 0px;"></i></div></div></div><div class="zmMRNum zmThmClr zmModeBG jsMRIx "></div></div></div><div class="zmMailWrapper"><div class="zmMailContent" data-zmcopy="true"><!----><!----><!----><!----><!----><div class="jsCTWR"><div class="zmRdrIco"></div><!----><!----><div data-rmvstyle-oncpy="true" style="color: initial;"><div lang="en" class="jsConTent  zm-nofocus" tabindex="0" role="document"><meta content="text/html;charset=UTF-8"><div><div dir="auto" style="font-size: 10pt; font-family: Verdana, Arial, Helvetica, sans-serif"><div id="x_890946838message" dir="auto"><div><br id="x_890946838br3"><br id="x_890946838br3"><br id="x_890946838br3"></div></div><div id="x_890946838signature" dir="auto"></div><div id="x_890946838content" dir="auto"><br><div class="x_890946838zmail_extra_hr" style="border-top-width: 1px; border-top-style: solid; border-top-color: rgb(204, 204, 204); min-height: 0px; margin-top: 10px; margin-bottom: 10px; line-height: 0px"></div><br>============ Forwarded Message ============<br>From : <a href="mailto:kitd.verein@gmail.com" target="_blank">kitd.verein@gmail.com</a><br>To : <a href="mailto:info@aspltech.in" target="_blank">info@aspltech.in</a>,<a href="mailto:abinath@aspltech.in" target="_blank">abinath@aspltech.in</a><br>Date : Wed, 08 Jul 2026 20:15:50 +0530<br>Subject : Website development - KITDe.V<br>============ Forwarded Message ============<br><br><div id="zmail_block"><i class="msi-ellipsis  zmDoubleIcon" role="button" aria-label="show block quote content" aria-expanded="false" aria-controls="jsBQC" tabindex="0"></i></div><div class="jsBQC" id="jsBQC" style="display: none;"><div><blockquote style="border: 0px; padding: 0px; margin: 0px"><div><div dir="ltr"><div>Dear Team,</div><div><br></div><div>Thank you for the call yesterday.&nbsp;<span style="background-color: transparent">Website pages and structure can be found in the below link.</span></div><div><div><br></div><div><a href="https://docs.google.com/document/d/1pOehEnjOg0pTwZRYySvGCOJXTsTTJ2b5p6SO-OCf4f0/edit?tab=t.0" target="_blank">https://docs.google.com/document/d/1pOehEnjOg0pTwZRYySvGCOJXTsTTJ2b5p6SO-OCf4f0/edit?tab=t.0</a></div><div><br></div><div><b>Backend or Admin panel requirement:</b></div><div>-We send newsletters to the members or anyone who subscribers&nbsp;it. could we have a way to send it together for everyone.&nbsp;</div><div><br></div><div><span style="background-color: transparent">-Membership form should be online. we will need membership payment as SEPA&nbsp; (you can check Berlin Tamil sangam for the online payment)</span></div><div><span style="background-color: transparent"><br></span></div><div><span style="background-color: transparent">- We conduct expert sessions</span></div><div><span style="background-color: transparent">- artist database (dance classes in germany north, south,west ,east)</span></div><div><span style="background-color: transparent">-&nbsp;</span></div><div><br></div><div>I am adding some more documents which&nbsp;gives information&nbsp;about the association&nbsp;for your better understanding of our organization</div></div><div>below is our Instagram page&nbsp;</div><div><a href="https://www.instagram.com/kitdverein/" target="_blank">https://www.instagram.com/kitdverein/</a></div><div><br></div><div>Below are few links of some other dance association</div><div><div><a href="https://en.fatart.ch/" target="_blank">https://en.fatart.ch/</a><br><a href="https://artistmanagementassociation.org/" target="_blank">https://artistmanagementassociation.org/</a></div></div><div><br></div><div>we are working on new logo, we would like to bring that to the website and you can suggest the colour combination</div><div><br></div><span class="x_890946838x_713281714gmail_signature_prefix">-- </span><br><div dir="ltr" class="x_890946838x_713281714gmail_signature"><div dir="ltr"><span style="color: rgb(34, 34, 34)">Yours sincerely/ Mit freundlichen Grüßen,</span><br style="color: rgb(34, 34, 34)"><br style="color: rgb(34, 34, 34)"><b style="color: rgb(34, 34, 34)">Klassischer indischer Tanz Deutschland e.V&nbsp;</b><div style="color: rgb(34, 34, 34)"><b>(KITD e.V)</b></div><div style="color: rgb(34, 34, 34)"><i style="color: rgb(179, 132, 92)">"</i><span style="color: rgb(179, 132, 92)"><i>A collective for mediating, broadcasting and continued fostering of Indian classical dance and respective knowledge in Germany"</i></span></div><div><b style="color: rgb(34, 34, 34)"><u>Board Members</u></b><br style="color: rgb(136, 136, 136)"><b style="color: rgb(34, 34, 34)">Sandhya Keelery&nbsp;</b><span style="color: rgb(136, 136, 136)">(Hamburg)</span><b style="color: rgb(34, 34, 34)">, Gudrun&nbsp;</b><font color="#222222"><b>Märtins</b></font><b style="color: rgb(136, 136, 136)">&nbsp;</b><span style="color: rgb(136, 136, 136)">(Hamburg)</span><b style="color: rgb(34, 34, 34)">, Josephine Ramya Antony&nbsp;</b><span style="color: rgb(136, 136, 136)">(Oberkochen)</span><b style="color: rgb(34, 34, 34)">, Dr Vijayalakshmi Villadathu&nbsp;</b><span style="color: rgb(136, 136, 136)">(Nuremberg),&nbsp;</span><b style="color: rgb(34, 34, 34)">Sivani Saraswatula</b><span style="color: rgb(136, 136, 136)">&nbsp;(Ingolstadt)</span></div><div><span style="color: rgb(136, 136, 136)"><br></span></div><div style="color: rgb(34, 34, 34)"><span style="color: rgb(179, 132, 92)"><i><img width="200" height="200" src="https://mail.zoho.in/zm/"><br></i></span></div></div></div></div>
