            .zq-record-counter-wrap{
                position: fixed;
                height: 100vh;
                width: 100%;
                top : 0px;
                background-color: rgb(0 0 0 / 80%);
                color: #ffffff;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 28px;
                z-index: 99999;
            }
            .zq-record-counter-title{
                margin: 0;
                color: #ffffff;
                font-size: 24px;
            }
            .zq-record-counter{
                font-size: 36px;
                color: #ffffff;
                opacity: 1;
                width: 160px;
                height: 160px;
                border-radius: 160px;
                display: flex;
                justify-content: center;
                align-items: center;
                position: relative;
            }
            .zq-record-counter-wrap:before{
                content: "";
                position: absolute;
                top: calc(50% + 30px);
                left: 50%;
                transform: translate(-50%,-50%);
                z-index: -1;
                width: 120px;
                height: 120px;
                border-radius: 160px;
                background-color: rgb(0 0 0 / 75%);
            }
            .zq-record-counter.puffer{
                opacity: 0;
                transform: scale(1.6);
                transition: all .4s ease-out;
            }
    </style><link rel="stylesheet" type="text/css" href="./logo1_files/static_js_appSuiteInit_views_banners_topBanners_controller_js.8c1411157a3e.css" crossorigin="anonymous" integrity="sha384-A+uCSY0wO0A3MJQmkfC/qs+Eeqf8TGZE8J6EJmIHBO8IIAwxceNd2YKXK/hHpMd5"><link rel="stylesheet" type="text/css" href="./logo1_files/static_js_appSuiteInit_views_AccountSwitcher_init_js.feb34fcfd851.css" crossorigin="anonymous" integrity="sha384-R7EnG0i2SxF6pnZZcNzbBeTVnz8ZfdxQh5ndLrQmLg6eqj9IznblNxOgjJcMpql6"><link rel="stylesheet" type="text/css" href="./logo1_files/vendors-node_modules_pnpm_zohomail_alerts_7_1_0_node_modules_zohomail_alerts_lib_js_init_css--14e85d1.a3da6b071b90.css" crossorigin="anonymous" integrity="sha384-hJ1DICPLkyERa6iGPYTcjySpAOTc3kxdM9iViyfCZryLpuzyRgIREkTfdQYnem2u"><link rel="stylesheet" type="text/css" href="./logo1_files/static_js_helpers_lazyload_ts-static_js_modules_application_entry_init-state_ts-static_js_mod-11dff4.a3da6b071b90.css" crossorigin="anonymous" integrity="sha384-hJ1DICPLkyERa6iGPYTcjySpAOTc3kxdM9iViyfCZryLpuzyRgIREkTfdQYnem2u"><link rel="stylesheet" type="text/css" href="./logo1_files/static_js_helpers_lazyload_ts-static_js_modules_application_entry_init-state_ts-static_js_mod-e166d8.a3da6b071b90.css" crossorigin="anonymous" integrity="sha384-hJ1DICPLkyERa6iGPYTcjySpAOTc3kxdM9iViyfCZryLpuzyRgIREkTfdQYnem2u"><link rel="stylesheet" type="text/css" href="./logo1_files/vendors-node_modules_pnpm_zohomail_alerts_7_1_0_node_modules_zohomail_alerts_lib_js_init_css--08588e7.677be1b2dea7.css" crossorigin="anonymous" integrity="sha384-i/KT7fSDtmd9Dp/rYF+I3FoNNr5975IsMDMB3cvFAEfQ2rBY6fUaD0RWObdBux07"><link rel="stylesheet" type="text/css" href="./logo1_files/static_js_helpers_deferred_ts-static_js_modules_error-tracking_debugLog_ts-node_modules_pnpm_-d08d2c.82bce0f6d0dd.css" crossorigin="anonymous" integrity="sha384-U9ckCnecMPl42KAfAS3II5Tp8y0k8CAe4Nc0l4hUZ6v/Z7zbWd0dTQIAuYzRrqf6"><link rel="stylesheet" type="text/css" href="./logo1_files/static_js_he