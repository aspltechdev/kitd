.SC_load {
position: absolute;
background-color: #f5f5f5;
font-family: Arial;
font-size: 14px;
left: 0px;
top: 0px;
width: 100%;
height: 100%;
margin: 0px auto;
z-index: 101;
}
.SC_load > div {
left: 50%;
position: absolute;
top: 50%;
-webkit-transform: translate(-50%, -55%);
-moz-transform: translate(-50%, -55%);
-ms-transform: translate(-50%, -55%);
transform: translate(-50%, -55%);
text-align: center;
}
.SC_load.SC_loadZC {
background-color: #ffffff;
}
.SC_load.SC_loadZC div {
color: #333;
}
.SC_load.SC_loadZC div span {
color: #878787 !important;
}
@-webkit-keyframes pulse {
0%,
50%,
100% {
-webkit-transform: scale(1);
-webkit-filter: grayscale(1);
filter: grayscale(1);
opacity: 0.6;
}
25% {
-webkit-transform: scale(1.35);
-webkit-filter: grayscale(0);
filter: grayscale(0);
opacity: 1;
}
}
@-moz-keyframes pulse {
0%,
50%,
100% {
-moz-transform: scale(1);
filter: grayscale(1);
opacity: 0.6;
}
25% {
-moz-transform: scale(1.35);
filter: grayscale(0);
opacity: 1;
}
}
@-ms-keyframes pulse {
0%,
50%,
100% {
-ms-transform: scale(1);
filter: grayscale(1);
opacity: 0.6;
}
25% {
-ms-transform: scale(1.35);
filter: grayscale(0);
opacity: 1;
}
}
@-o-keyframes pulse {
0%,
50%,
100% {
-o-transform: scale(1);
filter: grayscale(1);
opacity: 0.6;
}
25% {
-o-transform: scale(1.35);
filter: grayscale(0);
opacity: 1;
}
}
@keyframes pulse {
0%,
50%,
100% {
transform: scale(1);
-webkit-filter: grayscale(1);
filter: grayscale(1);
opacity: 0.6;
}
25% {
transform: scale(1.35);
-webkit-filter: grayscale(0);
filter: grayscale(0);
opacity: 1;
}
}
.zm_mLoad {
text-align: center;
margin-top: 15px;
padding-top: 15px;
border-top: solid 1px #aaa;
white-space: nowrap
}
.zm-loadIco {
box-sizing: border-box;
width: 26px;
height: 26px;
padding: 0 2px;
display: inline-block;
text-align: center;
-webkit-filter: grayscale(1);
-moz-filter: grayscale(1);
-o-filter: grayscale(1);
-ms-filter: grayscale(1);
filter: grayscale(1);
margin-left: 12px;
-webkit-animation: pulse 1s ease infinite;
-moz-animation: pulse 1s ease infinite;
-ms-animation: pulse 1s ease infinite;
-o-animation: pulse 1s ease infinite;
animation: pulse 1s ease infinite;
}
.zm-loadIco:nth-child(6) {
animation-delay: 0.83333s;
}
.zm-loadIco:nth-child(5) {
animation-delay: 0.66667s;
}
.zm-loadIco:nth-child(4) {
animation-delay: 0.5s;
}
.zm-loadIco:nth-child(3) {
animation-delay: 0.33333s;
}
.zm-loadIco:nth-child(2) {
animation-delay: 0.16667s;
}
.zm-loadIco:nth-child(1) {
animation-delay: 0s;
margin-left: 0;
}
