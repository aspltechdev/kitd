// $Id: $
var ZContacts = {
	// tmp variable used to cache multipart request info
	_rsvbObj : {},
};

ZContacts.getContextPath = function() {
	if(zmail.forContactsApp) {
        return ZContacts.meta.serviceInfo.contacts_server_url;
	}
	return "/zm/" + (zmail.contactsProxyPath || 'zc'); // No I18N
};


ZContacts.getCurrentAccount = function() {
	return this.acc;
};

