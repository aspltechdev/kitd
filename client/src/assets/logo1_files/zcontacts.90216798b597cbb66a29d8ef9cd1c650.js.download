ZContacts.AccountConstants = {
	contacts: { is_sortable: true, add_contact: true, is_deletable: true, view_add_to: true, is_mergeable: true, is_exportable: true, print_all: true, is_importable: true, is_archiveable: true, view_add_category_button: true },
	archived: { is_sortable: false, add_contact: false, is_deletable: true, view_add_to: false, is_mergeable: false, is_exportable: false, print_all: false, is_importable: false, is_unarchiveable: true },
	inactive: { is_sortable: false, add_contact: false, is_deletable: true, view_add_to: false, is_mergeable: false, is_exportable: false, print_all: false, is_importable: false }
}
ZContacts.isFunctionableForCurrAcc = function(...keys) {
	result = true;
	for (const key of keys) {
		result = result && this.acc.is_writable == true && ZContacts.isFunctionable(this.acc.getViewType(), key);
	}
	return result;
};
ZContacts.isFunctionable = function(type, key) {
	return ZContacts.AccountConstants[type] != undefined && ZContacts.AccountConstants[type][key] == true;
};

ZContacts.isExportable = function(account_type) {
	if (account_type == undefined) {
		account_type = this.acc.account_type;
	}
	if ((account_type == "org" || account_type == "org_group") && ZContacts.org_contacts.is_contacts_exportable) {
		return true;
	} else if (account_type == "personal" && ZContacts.personal_contacts.is_contacts_exportable) {
		return true;
	} else {
		if (account_type == "org") {
			return ZContacts.I18N.get('IAM.CONTACTS.ORGANIZATION');
		} else if (account_type == "org_group") {
			return ZContacts.I18N.get('IAM.CONTACTS.ORG.GROUPS');
		} else {
			return ZContacts.I18N.get('IAM.CONTACTS.PERSONAL');
		}
	}
}

ZContacts.isDeletable = function() {
	return ZContacts.getCurrentAccount().is_deletable;
}

ZContacts.isEditable = function() {
	return ZContacts.getCurrentAccount().is_editable;
}

ZContacts.isBulkEditable = function() {
 	return ZContacts.getCurrentAccount().is_bulk_editable;
 }

ZContacts.isMergeable = function() {
	return ZContacts.getCurrentAccount().is_mergeable;
}

