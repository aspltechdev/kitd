// $META
// ********************
ZContacts.meta = {
	user : {},
	syncUrls : {},
	serviceInfo : {}
};

// ********************
// $CONSTANTS
// ********************
ZContacts.Constants = {
	REGEX : {
		EMAIL_PATTERN : new XRegExp("^[\\p{L}\\p{M}\\p{N}\\_]([\\p{L}\\p{M}\\p{N}\\_\\+\\-\\.\\'\\*&amp;!~]*)@(?=.{4,256}$)(([\\p{L}\\p{N}\\p{M}]+)(([\\-\\_]*[\\p{L}\\p{N}\\p{M}])*)[\\.])+[\\p{L}\\p{M}]{2,22}$","i"), // No I18N
		USERNAME_PATTERN : new XRegExp("^[\\p{L}\\p{M}\\p{N}\\-\\_\\.\\']+$","i"), // No I18N
		PHONE_PATTERN : /^[\(\)\+\-0-9x\.\,\*\s#]{1,30}$/,
		BYEAR_PATTERN : /^\d{4}$/,
		ZM_SRCH_TAB_PATTERN : /zm_srch[0-9]+$/,
		BASIC_LATIN_REGEX : new XRegExp("[0-9a-zA-Z_\\-%~#,+.';&$@?/:!\\[\\]()\\s]+", "u"), // No I18N
		NON_BASIC_LATIN_REGEX : new XRegExp("[^\\x00-\\x7F]+", "u") // No I18N
	},
	Params : {
		FILTER_PREFIX : 'filter_', // No I18N
		MULTIPOST_SUFFIX : '_all', // No I18N
		DELETEALL_PREFIX : '_' // No I18N
	},

	StatusCode : {
		OK : 200,
		NOT_FOUND : 404,
		CONFLICT : 409
	},
	
	ChatStatus : {
		DELETED : -4,
		PENDING : -1,
		REQACC : -3,
		REJECTED : -2,
		OFFLINE : 0,
		ONLINE : 1,
		INVISIBLE : 2,
		BUSY : 3,
		IDLE : 4,
		NO_CHAT: -10
	}
};

