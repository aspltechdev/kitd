// $Id: $

ZContacts.importContacts =  {
	zid : undefined, categoryId : undefined, fileKey : undefined, refreshContacts : false
};

ZContacts.gSyncContacts = {
	gSyncFileKey : undefined
};

var resetImportContacts = function() {
	$.each(ZContacts.importContacts, function(key, value) {
		ZContacts.importContacts[key] = undefined;
	});
};

ZContacts.syncResponse = function(data){
	var date = new Date(parseInt(data.lastSyncedTime));
	ZContacts._syncedTime = date.toLocaleDateString() + "," + date.toLocaleTimeString();
	if (data.result == "failed") {
		zmUtil.succErrMsg("e", data.error_message);// NO I18N
		if (data.sync_now == true) {
			zmsuite.getCenter()[0].getNodes()[2].$el.find('#googleSyncDetails').find('.zcs_import_header_two').html(ZContacts.I18N.get('IAM.GOOGLE.LAST.SYNC.TIME') + ZContacts._syncedTime);
			return;
		}
		if (data.ignore_sync_summary === undefined || !data.ignore_sync_summary) { // when user has no space reserved.
			ZContacts._sync = true;
			ZContacts._authenticatedMailId = data.authenticatedMailId;
			ZContacts._enableStatus = data.enableDisableStatus;
			syncSummeryWorkspace();	
		}
		return;
	} 
	else if (data.duplicateGSyncContacts) {
		ZContacts.gSyncContacts.gSyncFileKey = data.fileKey;
		ZContacts.gSyncContacts.duplicateGSyncContacts = data.duplicateGSyncContacts == undefined ? false : true; 
		
		var contactImport = new ZContacts.contactimport();
		contactImport.createPageContent(getHtmlForGsyncConsent(data));
		var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_import');
		$(rightContainer).find('[data-field-type = duplicate_email_ids]').on("click", function() {
			errorValuesPopup('duplicate_email_ids'); //No I18N
		});
		$(rightContainer).find('[data-field-type = finish_import]').on("click", function() {
			actionOnGSyncConsent(data.total_count);
		});
		$(rightContainer).find('[data-field-type=close_import]').on("click", function() {
			actionOnGSyncConsentClose();
		});
		$(rightContainer).parent().siblings().find(".msi-close").on("click", function() {
			actionOnGSyncConsentClose();
		});
	}
	
	else {
		zmUtil.succErrMsg("s", ZContacts.I18N.get("CONTACT.SYNC.SUCCESS")); // NO I18N
		zmsDialog.remove();
		$("#zcs_twowaySyncPopup").remove();
		ZContacts._sync = true;
		ZContacts._authenticatedMailId = data.authenticatedMailId;
		var date = new Date(parseInt(data.lastSyncedTime));
		ZContacts._syncedTime = date.toLocaleDateString() + "," + date.toLocaleTimeString();
		ZContacts._enableStatus = data.enableDisableStatus;
		if(data.sync_now == true){
			zmsuite.getCenter()[0].getNodes()[2].$el.find('#googleSyncDetails').find('.zcs_import_header_two').html(ZContacts.I18N.get('IAM.GOOGLE.LAST.SYNC.TIME') + ZContacts._syncedTime);
		} else {
			syncSummeryWorkspace();
		}
		try {
			var acc = zmcontact.getAccountByZidForType(ZContacts.importContacts.zid, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
			if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
				zmcontact.invokeEvent("contactsApp/refresh", acc.getAccountId()); // NO I18N
			}
		} catch(e) {
			
		}
		var rootFolderId = ZContacts.AccountsVsRootFolderMap[ZContacts.importContacts.zid];
		if(ZContacts.importContacts.categoryId && ZContacts.importContacts.categoryId != -1){
			category = zmcontact.getCategory(ZContacts.importContacts.categoryId);
		} else {
			category = zmcontact.getCategory(rootFolderId);
		}
		ZContacts.importContacts.refreshContacts = true;
		zmcontact.refreshContactCounts(ZContacts.importContacts.zid);
		var isContactRefresh = false;
		$(".zmAppTab").one("click", function() {
		    if (isContactRefresh) {
		        return;
		    }
		    zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
		    isContactRefresh = true;
		});
		$(".msi-close").one("click", function() {
		    if (isContactRefresh) {
		        return;
		    }
			zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
		    isContactRefresh = true;
		});
	}
};

ZContacts.importResponse = function(data) {
	if(data.result == "failed") {
		zmUtil.succErrMsg("e", data.error_message);// NO I18N
		return;
	} else {
		var contactImport = new ZContacts.contactimport();
		var duplicateContacts;
		if(data.duplicate_email_ids) {
			duplicateContacts = { duplicate_email_ids : data.duplicate_email_ids };
		}
		contactImport.createPageContent(getHtmlForFinishImport(true, data.total_count, data.added_count, data.updated_count, duplicateContacts, data.message), false);
		var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_import');
		$(rightContainer).find('[data-field-type=result_close_import_page]').on("click", function(event){
			var isImported = event.target.dataset.id;
			closeImport(isImported);
		});
		$(rightContainer).find('[data-field-type=result_go_to_import]').on("click", function(event){
			goToImportPage(true);
		});
		$(rightContainer).find('[data-field-type = duplicate_email_ids]').on("click", function() {
			errorValuesPopup('duplicate_email_ids'); //No I18N
		});
		try {
			var acc = zmcontact.getAccountByZidForType(ZContacts.importContacts.zid, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
			if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
				zmcontact.invokeEvent("contactsApp/refresh", acc.getAccountId()); // NO I18N
			}
		} catch(e) {
			
		}
		
		return;
	}
};


var getErrorDetailsInHtml = function(key, field, data) {
	var html = new ZContacts.StringBuilder();
	html.append('<li style="margin-bottom: -40px;line-height: 3.5em;" class="zcs_im_align"><span>' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.INVALID.FIELDS.COUNT'), field) + '</span>');
	html.append('<span data-val="'+key+','+field+'"  data-field-type="invalid_emails_list" class="SC_lnk zcs_show_popup zmThmClr">' + ZContacts.I18N.get('IAM.CONTACTS.VIEW.DETAILS') + '</span><br></li>');
	return html;
};


ZContacts.contactimport = function() {
	var encodeHTML = ZContacts.Utils.encodeHTML;
	var enableSync = true;

	/* -----------Import Home Page----------- */

	getHtmlForImport = function() {
		var html = new ZContacts.StringBuilder();
		var acc = ZContacts.getCurrentAccount();
		importSyncPopUp = false;
		if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_CONTACTS) {
			importSyncPopUp = true;
		}
		if (ZContacts.getCurrentAccount().getAccountType() != "personal") {
			importSyncPopUp = false;
		}
		var rootFolderId = zmcontact.getRootFolderId(ZContacts._currentCategoryId);
		var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];

		var categoryId = ZContacts._currentCategoryId;
		var rootFolderId = zmcontact.getRootFolderId(categoryId);
		var category = zmcontact.getCategory(categoryId);
		var categoryName;
		if (zmcontact.isRootFolder(categoryId)) {
			categoryName = ZContacts.I18N.get('IAM.CONTACTS.ALL.CONTACTS'); // NO I18N
			categoryId = rootFolderId;
		} else {
			categoryName = category.category_name;
		}

		// categories list
		html.append('<div id="syncContinue" style="padding-left : 1%;"><h4>' + ZContacts.I18N.get('IAM.CONTACTS.WHERE.IMPORT') + '</h4>'); // NO I18N
		html.append('<div style="margin-left: 2%;margin-bottom: 5%;"><p>' + ZContacts.I18N.get('IAM.CONTACTS.WHICH.CATEGORY') + '</p>'); // NO I18N
		html.append('<div class="SC_flt">');

		html.append('<b id="zcs_account"><input class="SC_tiput" data-field-type="import_accounts_list" id=' + acc.getAccountId() + ' name="' + encodeHTML(acc.getName()) + '" placeholder="' + encodeHTML(acc.getName()) + '" readonly=readonly style="width: 200px;cursor: pointer;"></b>'); // NO I18N
		html.append('<b id="zcs_category"><input class="SC_tiput" data-field-type="import_category_list" id=' + categoryId + ' name="' + encodeHTML(categoryName) + '" placeholder="' + encodeHTML(categoryName) + '" readonly=readonly style="width: 200px;margin-left: 30px;cursor: pointer;"></b>'); // NO I18N
		html.append('</div></div>');
		html.append('<span class="zcs_im_border_bottom" style="width: 94%"></span>'); // NO I18N
		html.append('</div><br>');

		if (ZContacts._sync == true) {
			html.append(getHtmlForSync());
		}
		if (ZContacts.meta.hideThirdPartyImport) {
			html.append('<div style="padding-top: 1%;padding-left: 1%;"><h4>' + ZContacts.I18N.get('IAM.CONTACTS.IMPORT.FILE.EMAIL.PROVIDER.NIC') + '</h4></div>'); // NO I18N
		} else {
			html.append('<div style="padding-top: 1%;padding-left: 1%;"><h4>' + ZContacts.I18N.get('IAM.CONTACTS.IMPORT.FILE.EMAIL.PROVIDER') + '</h4></div>'); // NO I18N
		}
		//Local File
		html.append('<div style="display: flex;flex-wrap: wrap;">');
		html.append('<label class="zcs_import_box" data-field-type="local_file" id="local_file">'); //No I18N
		html.append('<div class="zcs_import_img_main"><img class="zcs_import_img" src='+ZContacts.getFingerPrintedFile("/images/import/file.png")+'></div>');
		html.append('<div class="zcs_import_txt_main"><span class="zcs_import_header">' + ZContacts.I18N.get('IAM.CONTACTS.IMPORT.LOCAL.DRIVE') + '</span>');
		html.append('<span class="zcs_import_header_two">' + ZContacts.I18N.get('IAM.CONTACTS.IMPORT.FROM.FILE.UPDATED')+'<br>'+ZContacts.I18N.get('IAM.CONTACTS.IMPORT.FROM.FILE.MAX.CONTACTS.ALLOWED') +'</span></div>');
		html.append("<label style='display: inline;'><div><form name='importlocalForm' id='import' enctype='multipart/form-data' method='Post'><input name='importcontact' id='importFile' accept='.ldif,.csv,.vcf' type='file' style='display: none;'/></form></div></label>");
		html.append('</label>');

		// Google
		if (!zmail.isCN && !ZContacts.meta.hideThirdPartyImport) {
			if (importSyncPopUp == false){
				html.append('<div class="zcs_import_box" data-field-type="google_import" id="google">');
			} else {
				if (ZContacts._sync == true) {
					html.append('<div class="zcs_import_box" data-field-type="google_import" id="google">');
				} else {
					html.append('<div class="zcs_import_box" data-field-type="google_sync" id="google">');
				}
			}
			html.append('<div class="zcs_import_img_main"><img class="zcs_import_img" src='+ZContacts.getFingerPrintedFile("/images/import/google.png")+'></div>');
			html.append('<div class="zcs_import_txt_main"><span class="zcs_import_header">' + ZContacts.I18N.get('IAM.CONTACTS.GMAIL') + '</span>');
			if (importSyncPopUp == false) {
				html.append('<span class="zcs_import_header_two">' + ZContacts.I18N.get('IAM.CONTACTS.IMPORT.FROM.GOOGLE.UPDATED') + '</span>');
			} else {
				if (ZContacts._sync == true) {
					html.append('<span class="zcs_import_header_two">' + ZContacts.I18N.get('IAM.CONTACTS.IMPORT.FROM.GOOGLE.UPDATED') + '</span>');
				} else {
					html.append('<span class="zcs_import_header_two">' + ZContacts.I18N.get('IAM.IMPORT.SUPPORT.TWO.WAY.SYNC') + '</span>');
				}
			}
			html.append('</div></div>');
		}

		// yahoo (Yahoo import hide skydesk setup)
		if (!ZContacts.meta.yahoo_disable) {
			if (!zmail.isFuji) {
				html.append('<div class="zcs_import_box" id="yahoo" data-field-type="yahoo_import">');
				html.append('<div class="zcs_import_img_main"><img class="zcs_import_img" src='+ZContacts.getFingerPrintedFile("/images/import/yahoo.png")+'></div>');
				html.append('<div class="zcs_import_txt_main"><span class="zcs_import_header">' + ZContacts.I18N.get('IAM.CONTACTS.YAHOO') + '</span>');
				html.append('<span class="zcs_import_header_two">' + ZContacts.I18N.get('IAM.CONTACTS.YAHOO.ACCOUNT') + '</span>');
				html.append('</div></div>');
			}
		}

		// Outlook
		if (!ZContacts.meta.hideThirdPartyImport) {
			html.append('<div class="zcs_import_box" id="outlook" data-field-type="outlook_import">');
			html.append('<div class="zcs_import_img_main"><img class="zcs_import_img" src='+ZContacts.getFingerPrintedFile("/images/import/windows.svg")+'></div>');
			html.append('<div class="zcs_import_txt_main" style="margin-right: 32px"><span class="zcs_import_header">' + ZContacts.I18N.get('IAM.CONTACTS.OUTLOOK') + '</span>');
			html.append('<span class="zcs_import_header_two">' + ZContacts.I18N.get('IAM.CONTACTS.OUTLOOK.ACCOUNT.UPDATED') + '</span>');
			html.append('</div></div>');
		}
		html.append('</div>');
		return html.toString();
	};
	
	getHtmlForSync = function() {
		var html = new ZContacts.StringBuilder();
		
		html.append('<div id="sync"><div style="padding-top: 1%;padding-left: 1%;"><h4>' + ZContacts.I18N.get('IAM.GOOGLE.SYNCED.CONTACTS') + '</h4></div>'); // NO I18N
		
		html.append('<div class="zcs_sync_box" data-field-type="sync_details" id="googleSync">');
		html.append('<div class="zcs_import_img_main"><img class="zcs_import_img" src='+ZContacts.getFingerPrintedFile("/images/import/google.png")+'></div>');
		html.append('<div class="zcs_import_txt_main"><span class="zcs_import_header">' + ZContacts.I18N.get('IAM.GOOGLE.TWO.WAY.SYNC') + '</span>');
		html.append('<span class="zcs_import_header_two" style="overflow: hidden;white-space: nowrap;text-overflow: ellipsis;">' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.GOOGLE.SYNCED.ACCOUNT'), ZContacts._authenticatedMailId) +'</span></div>');
		if(ZContacts._enableStatus == true){
			html.append('<div class="zcs_toggle_btn" data-field-type="on_off_button" style="float: right;"><input type="checkbox"  style="cursor: pointer;" class="radio_input" onclick="" checked><div class="radio_style"></div></div>');
		} else {
			html.append('<div class="zcs_toggle_btn" data-field-type="on_off_button" style="float: right;"><input type="checkbox"  style="cursor: pointer;" class="radio_input" onclick="" unchecked><div class="radio_style"></div></div>');
		}
		
		html.append('</div><br>');
		
		
		html.append('<div class="zcs_sync_details hide" id="googleSyncDetails" >');
		html.append('<div class="zcs_import_img_main"><img class="zcs_import_img" src='+ZContacts.getFingerPrintedFile("/images/import/google.png")+'></div>');
		html.append('<div class="zcs_import_txt_main"><span class="zcs_import_header">' + ZContacts.I18N.get('IAM.GOOGLE.TWO.WAY.SYNC') + '</span>');
		html.append('<span class="zcs_import_header_two">' + ZContacts.I18N.get('IAM.GOOGLE.LAST.SYNC.TIME') + ZContacts._syncedTime +'</span></div>');
		html.append('<div style="margin-top: 25px;"><span class="zcs_sync_header">'+ ZContacts.I18N.get('IAM.GOOGLE.SYNCED.ACCOUNT.HEADER') +'</span><span style="display: block;overflow: hidden;white-space: nowrap;text-overflow: ellipsis;width: 350px;">' + ZContacts._authenticatedMailId + '</span></div>'); //No I18N
		html.append('<div style="margin-top: 25px;"><span class="zcs_sync_header">'+ ZContacts.I18N.get('IAM.GOOGLE.SYNC.FREQUENCY') +'</span><span style="font-size: 14px;color: #000000;">'+ ZContacts.I18N.get('IAM.GOOGLE.SYNC.DAILY') +'</span></div>'); //No I18N
		html.append('<div style="margin-top: 25px;"><span class="zcs_sync_header">'+ ZContacts.I18N.get('IAM.GOOGLE.DAILY.SYNC') +'</span>');
		if(ZContacts._enableStatus == true){
			html.append('<div class="zcs_toggle_btn" data-field-type="on_off_button"><input type="checkbox" style="cursor: pointer;" class="radio_input" checked><div class="radio_style"></div></div></div>');
		} else {
			html.append('<div class="zcs_toggle_btn" data-field-type="on_off_button"><input type="checkbox" style="cursor: pointer;" class="radio_input" unchecked><div class="radio_style"></div></div></div>');
		}
		html.append('<div class="SC_PUbtm"><span data-field-type="zcs-sync-now">').append(ZContacts.I18N.get("IAM.GOOGLE.SYNC.NOW")).append('</span>'); // No I18N
		html.append('<span style="margin-left: 10px;" data-val="Cancel" data-field-type="zcs-revoke-btn" data-val="Cancel">' + ZContacts.I18N.get("IAM.GOOGLE.DEACTIVATE.SYNC") + '</span>');
		html.append('<span style="margin-left: 10px;" data-field-type="zcs-sync-popup-cancel-btn" data-val="Cancel">' + ZContacts.I18N.get('IAM.CANCEL') + '</span>');
		html.append('</div></div></div>');
		
		html.append('<span class="zcs_im_border_bottom" style="width: 94%"></span><br>'); // NO I18N
		return html.toString();
	};
	
	getHtmlForGsyncConsent = function(data) {
		var html = new ZContacts.StringBuilder();
		html.append('<div> <form id="confirmationForm">');
		this.data = data;
		html.append('<div style="margin-top: 1%;"><span class="zcs_im_align redtxt">' + ZContacts.I18N.get("IAM.CONTACTS.CONSENT.SYNC") + '</span><br></br>');
		if (data.duplicateGSyncContacts) {
			html.append('<div class="zcs_im_align" style="padding-left: 30px;"><span class="zcs_im_checkbox"><input class="gsync_consent_checkbox" id="override_duplicates" type="checkbox"/></span><span class="zcs_im_overwirte_pending">' + ZContacts.I18N.get("IAM.CONTACTS.CONSENT.SYNC.OVERWRITE.DUPLICATES") + '</span>');
			html.append('&nbsp;&nbsp;&nbsp;<span data-val="duplicate_email_ids" data-field-type="duplicate_email_ids" class="SC_lnk zcs_show_popup zmThmClr" style="font-size: 14px;">' + ZContacts.I18N.get('IAM.CONTACTS.VIEW.DETAILS') + '</span></div>');
		}
		html.append('<div class="zcs_im_align" style="padding-left: 10px;font-size: 14px;padding-top: 15px;"><b>Note:</b>&nbsp;' +'<i>'+ZContacts.I18N.get("IAM.CONTACTS.CONSENT.SYNC.NOTE")+'</i>'+ '</div>');
		html.append('<span class="zcs_im_border_bottom"></span>');
		html.append('</div></br>');
		html.append('<br><div class="zcs_im_save_div"><span class="SC_PUbtm" style="margin-left: 30%">');
		html.append('<span data-val="Next" data-field-type="finish_import">' + ZContacts.I18N.get("IAM.CONTACTS.SYNC") + '</span>');
		html.append('<span data-val="Cancel" data-field-type="close_import">' + ZContacts.I18N.get('IAM.CANCEL') + '</span>');// No i18N
		html.append('</span></div>');
		html.append('</form></div>');
		return html.toString();
	}
	
	onOffButton = function(event){
		event.stopPropagation();
		var zid = $('#zcs_account').find("input").attr('id'); // No I18N
		if(!zid) {
			return;
		}
		if($(event.currentTarget).find('.radio_input').prop("checked") == true){ // enable 
			new ZContacts.URI(ZContacts.EnableSync, zid).PUT().then(function(response) {
				if(response == true) {
					return;
				}
			}); 
		} else { // disable
			new ZContacts.URI(ZContacts.DisableSync, zid).PUT().then(function(response) {
				if(response) {
					return;
				}
			});
		}
	};

	showSyncDetails = function(){
		var $gSyncElem = $("#googleSync");
		if($gSyncElem.hasClass('hide')){
			var check = $("#googleSyncDetails").find('.zcs_toggle_btn').find('.radio_input').prop("checked"); //No I18N
			$("#googleSyncDetails").addClass('hide');
			$gSyncElem.removeClass('hide');
			if ($gSyncElem.find('.zcs_toggle_btn').find('.radio_input').prop("checked") == check) {
				return;
			} else {
				 $gSyncElem.find('.zcs_toggle_btn').find('.radio_input').prop('checked', check); //No I18N
			}
		}else{
			var check = $gSyncElem.find('.zcs_toggle_btn').find('.radio_input').prop("checked"); //No I18N
			$("#googleSyncDetails").removeClass('hide');
			$gSyncElem.addClass('hide');
			if ($("#googleSyncDetails").find('.zcs_toggle_btn').find('.radio_input').prop("checked") == check) {
				return;
			} else {
				$("#googleSyncDetails").find('.zcs_toggle_btn').find('.radio_input').prop('checked', check); //No I18N
			}
		}
	};
	
	twoWaySyncPopup = function(data) {
		var enableSyncDiv = {};
		enableSyncDiv.title = ZContacts.I18N.get("IAM.IMPORT.CONTACTS.VIA.GOOGLE"); // No I18N
		enableSyncDiv.mask = true;

		enableSyncDiv.buttons = [ {
			txt : ZContacts.I18N.get("IAM.CONTACTS.IMPORT"), // No I18N
			selected : true,
			callback : function(data) {
				enableSync = $('input[name=enable_sync]:checked').val();
				if(enableSync == "true"){
					importGoogleSync();
				} else {
					importGoogle(enableSync);
				}
			}

		}, {
			isCancel : true,
			txt : ZContacts.I18N.get("IAM.CANCEL"),
			callback : function() {
				zmsDialog.remove();
				$("#zcs_twowaySyncPopup").remove();
			}	

		} ];

		enableSyncDiv.closeaction = function() {
			zmsDialog.remove();
			$("#zcs_twowaySyncPopup").remove();
		};
		enableSyncDiv.pos = "center"; // No I18N

		createFolElem = $("<div id='zcs_twowaySyncPopup'></div>");
		if (!$("#zcs_twowaySyncPopup").length) {
			var html = "<div class='SC_tdtl'>";
			html = html + "<div><input type='radio' id='disable_sync' style='height: 14px;cursor: pointer;' name='enable_sync' value='false' checked/><label for='disable_sync'><span style='padding:  5px;'>" + ZContacts.I18N.get("IAM.CONTACTS.IMPORT.FROM.GOOGLE.UPDATED") + "</span></br><span style='margin-left: 25px;font-size: 13px;'>" + ZContacts.I18N.get("IAM.CONTACTS.IMPORT.MESSAGE") + "</span></label></div><br>"; // No I18N
			html = html + "<div><input type='radio' id='enable_sync' style='height: 14px;cursor: pointer;' name='enable_sync' value='true'/><label for='enable_sync'><span style='padding:  5px;'>" + ZContacts.I18N.get("IAM.IMPORT.SYNC.CONTACTS") + "</span></br><span style='margin-left: 25px;font-size: 13px;'>" + ZContacts.I18N.get("IAM.CONTACTS.SYNC.MESSAGE") + "</span></label></div>"; // No I18N
			html = html + "<br><div id='termsAndCondition' style='margin-left:2px;'><span><i class='msi-uncheck'></i></span>"+ZContacts.I18N.get("IAM.GOOGLE.SYNC.PRIVACY.POLICY")+"<a style='color: #0073e8; text-decoration: none;' href='"+ZContacts.meta.serviceInfo.google_terms_of_use+"' target='_blank'>"+ZContacts.I18N.get("IAM.CONTACTS.LOGIN.TERMS.USE")+"</a> "+ZContacts.I18N.get("IAM.CONTACTS.AND")+" <a style='color: #0073e8; text-decoration: none;' href='"+ZContacts.meta.serviceInfo.google_privacy_policy+"' target='_blank'>"+ZContacts.I18N.get("IAM.CONTACTS.LOGIN.PPOLICY")+"</a></div>"; // No I18N
			createFolElem.append(html);
			$(document.body).append(createFolElem);
		}
		zmsDialog.create("zcs_twowaySyncPopup", enableSyncDiv); // No I18N
		$('#zcs_twowaySyncPopup').parents('.SC_pe').on("click", function(e) {
			e.stopPropagation();
		});
		$('#zcs_twowaySyncPopup').parents('.SC_Pop').on("click", function() {
			this.remove();
		});
		$('#termsAndCondition').find('.msi-uncheck').on("click", function(event){
			if ($(event.target).hasClass('msi-uncheck')) {
				$(event.target).removeClass("msi-uncheck").addClass("msi-check");// No I18N
			} else if ($(event.target).hasClass('msi-check')) {
				$(event.target).removeClass("msi-check").addClass("msi-uncheck");// No I18N
			}
		});
	};

	importGoogleSync = function(){
		if($('#termsAndCondition').find('.msi-uncheck').length == 1){
			zmUtil.succErrMsg("e", ZContacts.I18N.get("IAM.GOOGLE.PRIVACY.POLICY.ENSURE")); // NO I18N
			return;
		}
		zmsDialog.remove();
		$("#zcs_twowaySyncPopup").remove();
		var zid = $('#zcs_account').find("input").attr('id'); // No I18N
		if(zid != ZContacts.getCurrentAccount().getAccountId()) {
			zmUtil.succErrMsg("e", ZContacts.I18N.get("IAM.CONTACTS.GOOGLE.SYNC.RESTRICT")); // NO I18N
			return;
		}
		var rootFolderId = ZContacts.AccountsVsRootFolderMap[zid];
		var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
		
		ZContacts.importContacts.zid = zid;
		var uri = new ZContacts.URI(ZContacts.ImportGoogleSync, zid);
		var categoryId = $('#zcs_category').find("input").attr('id'); // No I18N
		var googleSync = ZContacts.ImportGoogleSync.create();
		if (categoryId && !zmcontact.isRootFolder(categoryId)) {
			ZContacts.importContacts.categoryId = categoryId;
			uri.addPostParam("category_id", categoryId); // No I18N
		}
		var domain;
		if(zmail.forContactsApp){
			domain = window.location.host;
		} else {
			domain = window.location.host + ZContacts.getContextPath();
		}
		uri.addPostParam("domain", domain).POST(googleSync).then(function(response) { // No I18N
			if(response) {
				var googleUrl = response.google.google_url;
				openSyncNewTab(googleUrl, "google"); // No I18N
				return;
			}
		});
		
	};
	
	syncSummeryWorkspace = function(){
		zmsuite.getCenter()[0].getNodes()[2].$el.find('#syncContinue').after(getHtmlForSync());
		zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs_import_box')[1].setAttribute('onClick', 'importGoogle()');
		zmsuite.getCenter()[0].getNodes()[2].$el.find('#google').find('.zcs_import_header_two').html(ZContacts.I18N.get('IAM.CONTACTS.IMPORT.FROM.GOOGLE.UPDATED'));
		var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find('.SC_import');
		$(rightContainer).find('[data-field-type=sync_details]').on("click", function() {
			showSyncDetails();
		});
		$(rightContainer).find('[data-field-type=zcs-sync-now]').on("click", function() {
			syncNow();
		});
		$(rightContainer).find('[data-field-type=zcs-revoke-btn]').on("click", function() {
			revokeSync();
		});
		$(rightContainer).find('[data-field-type=zcs-sync-popup-cancel-btn]').on("click", function() {
			showSyncDetails();
		});
	};
	
	
	revokeSync = function(){
		var zid = $('#zcs_account').find("input").attr('id'); // No I18N
		if(!zid) {
			return;
		}
		if(confirm(ZContacts.I18N.get('IAM.SYNC.SURE.DEACTIVATE'))){
			new ZContacts.URI(ZContacts.RevokeSync, zid).DELETE().then(function(response) {
				if(response == "true") {
					zmsuite.getCenter()[0].getNodes()[2].$el.find('#sync').remove();
					ZContacts._sync = false;
					zmsuite.getCenter()[0].getNodes()[2].$el.find('#google').find('.zcs_import_header_two').html(ZContacts.I18N.get('IAM.IMPORT.SUPPORT.TWO.WAY.SYNC'));
					zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs_import_box')[1].setAttribute('onClick','twoWaySyncPopup()');
					zmUtil.succErrMsg("s", ZContacts.I18N.get("SYNCED.CONTACTS.RETAIN")); // NO I18N
					return;
				}
			});
		}
	};
	
	syncNow = function(){
		var zid = $('#zcs_account').find("input").attr('id'); // No I18N
		if(!zid) {
			return;
		}
		ZContacts.importContacts.zid = zid;
		var uri = new ZContacts.URI(ZContacts.SyncNow, zid);
		var googleSync = ZContacts.SyncNow.create();
		var domain;
		if(zmail.forContactsApp){
			domain = window.location.host;
		} else {
			domain = window.location.host + ZContacts.getContextPath();
		}
		zmsuite.getCenter()[0].$el.find('[data-field-type="zcs-sync-now"]').html(ZContacts.I18N.get('IAM.GOOGLE.SYNCING'));
		zmcontact.restrictClick(zmsuite.getCenter()[0].$el.find('[data-field-type="zcs-sync-now"]'), true);
		uri.addPostParam("domain", domain).PUT(googleSync).then(function(response) { // No I18N
			zmsuite.getCenter()[0].$el.find('[data-field-type="zcs-sync-now"]').removeAttr('disabled'); //No I18N
			zmsuite.getCenter()[0].$el.find('[data-field-type="zcs-sync-now"]').html(ZContacts.I18N.get('IAM.GOOGLE.SYNC.NOW'));
			if(response) {
				ZContacts.syncResponse(response.contacts);
			}
		});
	};
	
	
	importGoogle = function() {
		zmsDialog.remove();
		$("#zcs_twowaySyncPopup").remove();
		var zid = $('#zcs_account').find("input").attr('id'); // No I18N
		if(!zid) {
			return;
		}
		var rootFolderId = ZContacts.AccountsVsRootFolderMap[zid];
		var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
		if(ZContacts._countObj[rootFolderId].c && ZContacts._countObj[rootFolderId].c >= ZContacts.getCurrentAccount().getLimit()) {
			zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.ERROR.MAX.CTS.LIMIT.EXCEEDED'), acc.getLimit())); // No I18N
			return;
		}
		ZContacts.importContacts.zid = zid;
		var uri = new ZContacts.URI(ZContacts.ImportGoogle, zid);
		var categoryId = $('#zcs_category').find("input").attr('id'); // No I18N
		var google = ZContacts.ImportGoogle.create();
		if (categoryId && !zmcontact.isRootFolder(categoryId)) {
			ZContacts.importContacts.categoryId = categoryId;
			uri.addPostParam("category_id", categoryId); // No I18N
		}
		var domain;
		if(zmail.forContactsApp){
			domain = window.location.host;
		} else {
			domain = window.location.host + ZContacts.getContextPath();
		}
		uri.addPostParam("domain", domain).POST(google).then(function(response) { // No I18N
			if(response) {
				var googleUrl = response.google.google_url;
				openNewTab(googleUrl, "google"); // No I18N
				return;
			}
		});
	};
	
