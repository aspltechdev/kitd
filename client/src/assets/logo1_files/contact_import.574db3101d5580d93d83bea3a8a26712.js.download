	getValidatedDetailsInHtml = function(response) {
		this.data = response.import;
		confirm_response = data;
		// see
		var html = new ZContacts.StringBuilder();
		var rootFolderId = ZContacts.AccountsVsRootFolderMap[ZContacts.importContacts.zid];
		var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
		html.append('<div class="zcs_confirm_page_main"><span class="zcs_im_main_div">');
		if (data.total_count == 0) {
			html.append('<div><span class="zcs_im_align" style="color:red">' + ZContacts.I18N.get('IAM.OOPS') + '</span><br></br>');
			html.append('<span class="zcs_im_align">' + ZContacts.I18N.get('IAM.CONTACTS.UPLOADED.EMPTY.FILE') + '</span></div>'); // No I18N
			html.append('<span class="zcs_im_border_bottom"></span><br></br>');
			button_check = true;
		} else {
			categoryId = rootFolderId;
			html.append('<div> <form id="confirmationForm">');
			// Merge Contacts
			if(data.duplicate_count){ 
				html.append('<div style="margin-top: 1%;"><span class="zcs_im_align redtxt">' + ZContacts.I18N.get('IAM.CONTACTS.CONFLICTS') + '</span><br></br>');
				html.append('<span class="zcs_im_align">' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.DUPLICATE.CONTACTS.DETAILS'), encodeHTML(acc.getName()))  + '</span>');
				html.append('<span data-val="duplicate_email_ids" data-field-type="duplicate_email_ids" class="SC_lnk zcs_show_popup zmThmClr">' + ZContacts.I18N.get('IAM.CONTACTS.VIEW.DETAILS') + '</span></br>');
				html.append('<br><div class="zcs_im_align"><span class="zcs_im_checkbox"><input id="overwritebox" type="checkbox"/></span><span class="zcs_im_overwirte_pending">' + ZContacts.I18N.get('IAM.CONTACTS.IMPORT.OVERWRITE.DUPLICATE') + '</span></div>');
				html.append('<span class="zcs_im_border_bottom"></span>');
				html.append('</div></br>');
			}

			// Details Insufficient
			var invalidCount = data.total_count - data.valid_count - (data.duplicate_count ? data.duplicate_count : 0);
			var doContinueNext = (data.total_count - invalidCount) > 0;
			var invalidCategoryCount = data.invalid_category_count > 0;
			if (invalidCount && data.invalid_fields || invalidCategoryCount) {
				html.append('<div style="margin-top: 2%;">');
				html.append('<span style="margin-left: 6%;font-size: 17px;padding: 10px;text-transform: uppercase;" class="SC_thm">'+ZContacts.I18N.get("IAM.NOTE")+' :</span>'); // No I18N
				var note = !doContinueNext ? ZContacts.I18N.get('IAM.CONTACTS.NO.VALID.CONTACTS.FILE') : zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.SKIP.INVALID.IMPORT'), invalidCount, data.total_count);
				if(invalidCount == 0 && invalidCategoryCount ){
					var note = zmcontact.formatMessage(ZContacts.I18N.get("IAM.CONTACTS.SKIP.INVALID.CATEGORY.IMPORT"), data.invalid_category_count); //No I18N
				}
				html.append('<span style="color: #545454;font-size: 17px;">' + note + '</span></br>');
				html.append('<ul>');
				if(data.invalid_fields.mandatory_missing_count){
					html.append('<li style="margin-bottom: -40px;margin-top: -20px;line-height: 3.5em" class="zcs_im_align"><span>' +zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.SKIPPED.CONTACTS.COUNT'), data.invalid_fields.mandatory_missing_count)+ '</span><br></li>');
				}
				$.each(data.invalid_fields, function(key, value) {
					if(key!="mandatory_missing_count") {
						var field = ZContacts.I18N.get('IAM.CONTACTS.CHARACTERS'); // No I18N
						if(key=="first_name") {
							field = ZContacts.I18N.get('IAM.CONTACTS.FIRSTNAME'); // No I18N
						} else if(key=="middle_name") {
							field = ZContacts.I18N.get('IAM.CONTACTS.MIDDLENAME'); // No I18N
						} else if(key=="last_name") {
							field = ZContacts.I18N.get('IAM.CONTACTS.LASTNAME'); // No I18N
						} else if(key=="nick_name") {
							field = ZContacts.I18N.get('IAM.CONTACTS.BASIC.NNAME'); // No I18N
						} else if(key=="category_name"){ 
							field = ZContacts.I18N.get('IAM.CONTACTS.CATEGORIES'); // No I18N
						} else if(key=="email_id") {
							field = ZContacts.I18N.get('IAM.EMAIL.IDS'); // No I18N
						} else if(key=="phones") {
							field = ZContacts.I18N.get('IAM.CONTACTS.BASIC.PHONE'); // No I18N
						} else if(key=="urls") {
							field = ZContacts.I18N.get('IAM.CONTACTS.URLS'); // No I18N
						} else if(key=="gender") {
							field = ZContacts.I18N.get('IAM.CONTACTS.GENDER'); // No I18N
						} else if(key=="birth_day") {
							field = ZContacts.I18N.get('IAM.CONTACTS.BASIC.BDAY'); // No I18N
						} else if(key=="birth_month") {
							field = ZContacts.I18N.get('IAM.CONTACTS.BIRTH.MONTH'); // No I18N
						} else if(key=="birth_year") {
							field = ZContacts.I18N.get('IAM.CONTACTS.BIRTH.YEAR'); // No I18N
						} else if(key=="notes") {
							field = ZContacts.I18N.get('IAM.CONTACTS.NOTES'); // No I18N
						} else if(key=="street_addr") {
							field = ZContacts.I18N.get('IAM.CONTACTS.ST.ADDRESS'); // No I18N
						} else if(key=="street_addr1") {
							field = ZContacts.I18N.get('IAM.CONTACTS.ST.ADDRESS1'); // No I18N
						} else if(key=="city") {
							field = ZContacts.I18N.get('IAM.CONTACTS.WORK.CITY'); // No I18N
						} else if(key=="postal_code") {
							field = ZContacts.I18N.get('IAM.CONTACTS.WORK.ZIP.POSTAL'); // No I18N
						} else if(key=="state") {
							field = ZContacts.I18N.get('IAM.CONTACTS.WORK.STATE'); // No I18N
						} else if(key=="country") {
							field = ZContacts.I18N.get('IAM.CONTACTS.WORK.COUNTRY'); // No I18N
						} else if(key=="company") {
							field = ZContacts.I18N.get('IAM.CONTACTS.COMPANY'); // No I18N
						} else if(key=="job_title") {
							field = ZContacts.I18N.get('IAM.CONTACTS.JOBTITLE'); // No I18N
						} else if(key=="designation") {
							field = ZContacts.I18N.get('IAM.CONTACTS.DESIGNATION'); // No I18N
						}
						html.append(getErrorDetailsInHtml(key, field));
					}
				});
				html.append("</ul>"); // No I18N
				
				html.append('<span class="zcs_im_border_bottom"></span>'); // No I18N
				html.append('</div></br>'); // No I18N
				html.append('</div>');
			}
		}
		
		// control buttons
		html.append('<br><div class="zcs_im_save_div"><span class="SC_PUbtm" style="margin-left: 30%">');
		if(data.total_count == 0) {
			html.append('<span data-field-type="go_import_page">' + ZContacts.I18N.get('IAM.CONTACTS.GO.BACK') + '</span>');
			
			// close import workspace
			html.append('<span data-val="Cancel" data-field-type="close_import_page">' + ZContacts.I18N.get('IAM.CANCEL') + '</span>');// No i18N
		} else {
			if(doContinueNext) { // if atlease a contact available to import, showing these options
				if(ZContacts.importContacts.fileFormat == "csv") {
					html.append('<span data-field-type="prev_mapping_page">' + ZContacts.I18N.get('IAM.CONTACTS.PREV') + '</span>');
				}
				html.append('<span data-val="Next" data-field-type="nxt_mapping_page">' + ZContacts.I18N.get('IAM.CONTACTS.NEXT') + '</span>');
			} else { // if no valid contacts available to import, then showing these options
				html.append('<span data-val="import" data-field-type="go_import_page">' + ZContacts.I18N.get('IAM.CONTACTS.GO.BACK') + '</span>');
			}
			html.append('<span data-val="Cancel" data-field-type="close_import_page">' + ZContacts.I18N.get('IAM.CANCEL') + '</span>');// No i18N
			
		}
		html.append('</span></div>');

		html.append('</form></div>');
		html.append('</span></div>');
		return html.toString();
	};
	
	processFile = function() {
		var zid = $('#zcs_account').find("input").attr('id');
		var rootFolderId = ZContacts.AccountsVsRootFolderMap[zid];
		var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
		if(ZContacts._countObj[rootFolderId].c && ZContacts._countObj[rootFolderId].c >= ZContacts.getCurrentAccount().getLimit()) {
			zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.ERROR.MAX.CTS.LIMIT.EXCEEDED'), acc.getLimit())); // No I18N
			return;
		}
		var importForm = ZContacts.ImportUpload.create({
			__form : "#import" // No I18N
		});
		ZContacts.importContacts.zid = zid;
		var categoryId = $('#zcs_category').find("input").attr('id');
		if(zmcontact.isRootFolder(categoryId)) {
			categoryId = -1;
		}
		ZContacts.importContacts.categoryId = categoryId;
		var importFile = $("#importFile")[0].files[0];
		var fileName = importFile.name.trim();
		ZContacts.importContacts.fileFormat = fileName.substring(fileName.lastIndexOf(".")+1, fileName.length).toLowerCase().trim(); // NO I18N
		if (ZContacts.importContacts.fileFormat != "csv" && ZContacts.importContacts.fileFormat != "vcf" && ZContacts.importContacts.fileFormat != "ldif") {
			zmUtil.succErrMsg("e", ZContacts.I18N.get("IAM.CONTACTS.INVALID.FILE.FORMAT"));// NO I18N
			$('.SC_sld').remove();
			$("#importFile").prop("disabled", false);
			$("#iimportFile").replaceWith($("#importFile").val('').clone(true));
			return;
		}
		if (importFile.size > 3072000) {
			zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.UPLOAD.NOTE2'), 3072));// No I18N
			$("#importFile").replaceWith($("#importFile").val('').clone(true));
			return;
		};
		$('.zcs_new_loading').removeClass('hide');
		
//		uri : /api/v1/accounts/zid/contacts/import/upload
		
		new ZContacts.URI(ZContacts.ImportUpload, zid).POST(importForm).then(function(response) {
			if (response.status_code == 200) {
				if(response.import.total_count == 0) {
					zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(response)); // No I18N
					return;
				}
				ZContacts.importContacts.fileKey = response.import.file_key;
				var contactImport = new ZContacts.contactimport();
				if (response.import.headers) {
					$('.zcs_new_loading').removeClass('hide');
					contactImport.createPageContent(getHtmlForMapping(response), false);
				} else {
					if(response.import.invalid_count || response.import.duplicate_count) {
						$('.zcs_new_loading').removeClass('hide'); // No I18N
						contactImport.createPageContent(getValidatedDetailsInHtml(response), false);
					} else {
						importContacts(response.import);
					}
				}
				var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_import');
				$(rightContainer).find('[data-field-type=go_import_page]').on("click", function(event){
					goToImportPage(false);
				});
				$(rightContainer).find('[data-field-type=validate_contacts]').on("click", function(event){
					validateContacts(mappingForm)
				});
				$(rightContainer).find('[data-field-type=close_import_page]').on("click", function(event){
					closeImport(false)
				});
				
				$(rightContainer).find('[data-field-type=add_or_remove_field]').on("click", function(event){
					addOrRemoveField(this, event.target.dataset.id);
				});
				
				$(rightContainer).find('[data-field-type=duplicate_email_ids]').on("click", function(event){
					errorValuesPopup('duplicate_email_ids'); //No I18N
				});

				$(rightContainer).find('[data-field-type=invalid_emails_list]').on("click", function(event){
					var key_list = event.target.dataset.val.split(',');
					var key = key_list[0].toString();
					var value = key_list[1].toString();
					errorValuesPopup(key,value); //No I18N
				});

				$(rightContainer).find('[data-field-type=nxt_mapping_page]').on("click", function(event){
					importContacts(data);
				});
				
				zmsDialog.remove();
			} else {
				zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response));// NO I18N
				$('.zcs_new_loading').addClass('hide');
				$('.SC_sld').remove();
				$("#importFile").prop("disabled", false);
				$("#importFile").replaceWith($("#importFile").val('').clone(true));
				return;
			}
			fileFormat = "";
		}, function(response) {
			zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response));// NO I18N
			$('.zcs_new_loading').addClass('hide');
			$('.SC_sld').remove();
			$("#importFile").prop("disabled", false);
			$("#importFile").replaceWith($("#importFile").val('').clone(true));
			return;
		});
	},
	
	importContacts = function(data) {
		var doOverWrite = $("#overwritebox").is(':checked');
		var doImport = ((data.total_count - (data.duplicate_count ? data.duplicate_count : 0)) > 0) || doOverWrite;
		var contactImport = new ZContacts.contactimport();
		if(doImport) {
			zmUtil.succErrMsg("s", ZContacts.I18N.get("IAM.CONTACTS.IMPORTING"));// NO I18N
			var zid = ZContacts.importContacts.zid;
			var categoryId = ZContacts.importContacts.categoryId;
			var mappingConfirmation = ZContacts.Import.create();
			mappingConfirmation.set("overwrite_duplicate", $("#overwritebox").is(':checked')); // NO I18N
			mappingConfirmation.set("category_id", categoryId); // NO I18N
			mappingConfirmation.set("file_key", ZContacts.importContacts.fileKey); // NO I18N
			mappingConfirmation.set("file_format", ZContacts.importContacts.fileFormat); // NO I18N
			mappingConfirmation.set("total_count", data.total_count); // NO I18N
			mappingConfirmation.set("valid_count", data.valid_count); // NO I18N
			mappingConfirmation.set("invalid_category_count", data.invalid_category_count); // NO I18N
			var centerNode = zmsuite.getCenter()[0].getNodes()[2].$el;
			var loadingDiv = function(){};
			if (centerNode.find('.SC_import').get(0)) {
				loadingDiv = zmComponent.loadingBand({
					container : centerNode.find('.SC_import').get(0), // No i18N
					type : "listing" // No i18N
				});
			}
			
			// "/api/v1/accounts/zid/contacts/import"
			
			new ZContacts.URI(ZContacts.Import, zid).POST(mappingConfirmation).then(function(response) {
				loadingDiv();
				if(response.import) {
					zmcontact.refreshContactCounts();
					contactImport.createPageContent(getHtmlForFinishImport(true, response.import.total_count, response.import.added_count, response.import.updated_count), false);
					var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_import');
					$(rightContainer).find('[data-field-type=result_close_import_page]').on("click", function(event){
						var isImported = event.target.dataset.id;
						closeImport(isImported);
					});
					$(rightContainer).find('[data-field-type=result_go_to_import]').on("click", function(event){
						goToImportPage(true);
					});
					$(rightContainer).find('[data-field-type=duplicate_email_ids]').on("click", function(event){
						errorValuesPopup('duplicate_email_ids'); //No I18N
					});
					return;
				} else {
					zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response));// NO I18N
					return;
				}
			});
		} else {
			contactImport.createPageContent(getHtmlForFinishImport(false, data.total_count, 0, 0), false);
			var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_import');
			$(rightContainer).find('[data-field-type=result_close_import_page]').on("click", function(event){
				var isImported = event.target.dataset.id;
				closeImport(isImported);
			});
			$(rightContainer).find('[data-field-type=result_go_to_import]').on("click", function(event){
				goToImportPage(true);
			});
			return;
		}
		
	};

	// Import Finshing Page
	getHtmlForFinishImport = function(isImported, totalContactsCount, addedContactsCount, updateContactsCount, duplicateContacts, msg) {
		var html = new ZContacts.StringBuilder();
		html.append('<div style="padding: 20px;">'); // NO I18N
		var acc = zmcontact.getAccountByZidForType(ZContacts.importContacts.zid, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
		if (isImported) {
			if (!msg) {
				if (ZContacts.importContacts.categoryId != -1) {
					var category = zmcontact.getCategory(ZContacts.importContacts.categoryId);
					if (category) {
						msg = zmcontact.formatMessage(ZContacts.I18N.get("IAM.CONTACTS.IMPORTED.TO.CATEGORY.IN.OTHER.SPACE.SUCCESSFULLY"), encodeHTML(category.category_name), encodeHTML(acc.getName()));// NO I18N
					} else {
						msg = zmcontact.formatMessage(ZContacts.I18N.get("IAM.CONTACTS.IMPORTED.IN.OTHER.SPACE.SUCCESSFULLY"), encodeHTML(acc.getName())); // NO I18N
					}
				} else {
					msg = zmcontact.formatMessage(ZContacts.I18N.get("IAM.CONTACTS.IMPORTED.IN.OTHER.SPACE.SUCCESSFULLY"), encodeHTML(acc.getName())); // NO I18N
				}
			}
			zmUtil.succErrMsg("s", msg);// NO I18N
			try {
				if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
					zmcontact.invokeEvent("contactsApp/refresh", acc.getAccountId()); // NO I18N
				}
			} catch(e) {
				
			}
		}
		
		var totalContacts;
		if(totalContactsCount > 1 ) {
			totalContacts = zmcontact.formatMessage(ZContacts.I18N.get("IAM.MULTIPLE.CONATCT"), totalContactsCount); // NO I18N
		} else {
			totalContacts = zmcontact.formatMessage(ZContacts.I18N.get("IAM.SINGLE.CONTACT"), totalContactsCount); // NO I18N
		}
		var addedContacts;
		if(addedContactsCount > 1 ) {
			addedContacts = zmcontact.formatMessage(ZContacts.I18N.get("IAM.MULTIPLE.CONATCT"), addedContactsCount) +" "+ ZContacts.I18N.get("IAM.CONTACTS.ARE"); // NO I18N
		} else {
			addedContacts = zmcontact.formatMessage(ZContacts.I18N.get("IAM.SINGLE.CONTACT"), addedContactsCount) +" "+ ZContacts.I18N.get("IAM.CONTACTS.IS"); // NO I18N
		}
		var updatedContacts;
		if(updateContactsCount > 1 ) {
			updatedContacts = zmcontact.formatMessage(ZContacts.I18N.get("IAM.MULTIPLE.CONATCT"), updateContactsCount) +" "+ ZContacts.I18N.get("IAM.CONTACTS.ARE"); // NO I18N
		} else {
			updatedContacts = zmcontact.formatMessage(ZContacts.I18N.get("IAM.SINGLE.CONTACT"), updateContactsCount) +" "+ ZContacts.I18N.get("IAM.CONTACTS.IS"); // NO I18N
		}
		var statistics  = zmcontact.formatMessage(ZContacts.I18N.get("IAM.CONTACTS.IMPORT.STATISTICS.RESULT"), totalContacts, addedContacts, updatedContacts);
		html.append('<div><span class="SC_thm" style="font-size: 18px;">'+ZContacts.I18N.get("IAM.CONTACTS.RESULT")+'</span><br><br>');
		html.append('<span class="zcs_im_align">' + statistics + '</span><br>');
		html.append('</div><br>');
		if(duplicateContacts){
			this.data = duplicateContacts;
			html.append('<div><span class="SC_ltl redtxt" style="text-transform: none; font-size: 18px;">' + ZContacts.I18N.get('IAM.CONTACTS.CONFLICTS') + '</span><br></br>');
			html.append('<span class="zcs_im_align">' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.DUPLICATE.CONTACTS.DETAILS'), encodeHTML(acc.getName()))  + '</span>');
			html.append('<span data-val="duplicate_email_ids" data-field-type="duplicate_email_ids" class="SC_lnk zcs_show_popup zmThmClr">' + ZContacts.I18N.get('IAM.CONTACTS.VIEW.DETAILS') + '</span></br>');
			html.append('</div></br>');
		}
		// submit button
		html.append('<div class="SC_PUbtm" style="margin-left: 5%;">');
		html.append('<span data-val="Cancel" data-field-type="result_close_import_page" data-id='+isImported+'>' + ZContacts.I18N.get('IAM.CONTACTS.DONE') + '</span>');
		html.append('<span data-field-type="result_go_to_import">'+ZContacts.I18N.get('IAM.CONTACTS.IMPORT.MORE')+'</span>');
		html.append('</div>');
		html.append('</form></div></div>');
		return html.toString();
	};
	
	errorValuesPopup = function(key, fieldName) {
		var errorInfo = this.data;
		var errorDetails = {};
		errorDetails.title = key == "duplicate_email_ids" ? ZContacts.I18N.get("IAM.CONTACTS.DUPLICATE.E_ADDRESS") : zmcontact.formatMessage(ZContacts.I18N.get("IAM.CONTACTS.INVALID.FIELD"), fieldName); // No I18N
		errorDetails.name = key;
		errorDetails.mask = true;
		errorDetails.buttons = [ {
			isCancel : true,
			txt : ZContacts.I18N.get("IAM.CONTACTS.DONE"), // No I18N
			callback : function() {
				zmsDialog.remove();
				$("#zcs_errorDetailsPopup").remove(); // No I18N
			}
		} ];

		errorDetails.closeaction = function() {
			zmsDialog.remove();
			$("#zcs_errorDetailsPopup").remove(); // No I18N
		};
		errorDetails.pos = "center"; // No I18N
		createFolElem = $("<div id='zcs_errorDetailsPopup' style='max-height: 500px;'></div>"); // No I18N
		if (!$("#zcs_errorDetailsPopup").length) { // No I18N
			var email_list = "<div class='zcs_Emaildetails_main'>"; // No I18N
			var fields = errorInfo[key];
			if(errorInfo[key]) {
				fields = errorInfo[key];
			} else if (errorInfo.invalid_fields[key]) {
				fields = errorInfo.invalid_fields[key];
			}
			
			if(fields){
				for (var i = 0; i < fields.length; i++) {
					email_list = email_list + "<div><span>" + (i+1) + ".</span><span style='margin-left: 5px;'>" + ZContacts.Utils.encodeHTML(fields[i]) + "</span></div></br>"; // No I18N
				}
				email_list = email_list + "</div>"; // No I18N
			}
			createFolElem.append(email_list);
			$(document.body).append(createFolElem);
		}
		zmsDialog.create("zcs_errorDetailsPopup", errorDetails); // No I18N
	};
	
	actionOnGSyncConsent = function(total_count) {
		zmUtil.succErrMsg("s", ZContacts.I18N.get("IAM.CONTACTS.IMPORTING"));// NO I18N
		var zid = ZContacts.importContacts.zid;
		var mappingConfirmation = ZContacts.GSyncConsentResponse.create();
		mappingConfirmation.set("file_key", ZContacts.gSyncContacts.gSyncFileKey); // NO I18N
		mappingConfirmation.set("override_duplicates", $("#override_duplicates")[0] == undefined ? false : $("#override_duplicates").is(':checked') ? true : false);  // NO I18N
		mappingConfirmation.set("total_count", total_count); // NO I18N
		var centerNode = zmsuite.getCenter()[0].getNodes()[2].$el;
		var loadingDiv = function() { };
		if (centerNode.find('.SC_import').get(0)) {
			loadingDiv = zmComponent.loadingBand({
				container: centerNode.find('.SC_import').get(0), // No i18N
				type: "listing" // No i18N
			});
		}
		new ZContacts.URI(ZContacts.GSyncConsentResponse, zid).POST(mappingConfirmation).then(function(response) {
			loadingDiv();
			if (response.contacts) {
				var contactImport = new ZContacts.contactimport();
				contactImport.createPageContent(getHtmlForFinishImport(true, response.contacts.total_count, response.contacts.added_count, response.contacts.updated_count), false);
				var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_import');
				$(rightContainer).find('[data-field-type=result_close_import_page]').on("click", function(event) {
					var isImported = event.target.dataset.id;
					closeImport(isImported);
				});
				$(rightContainer).find('[data-field-type=result_go_to_import]').on("click", function(event) {
					goToImportPage(true);
				});
			}
			try {
				var acc = zmcontact.getAccountByZid(ZContacts.importContacts.zid);
				if (acc.getType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || acc.getType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
					zmcontact.invokeEvent("contactsApp/refresh", acc.getAccountId()); // NO I18N
				}
			} catch (e) {

			}
			var rootFolderId = ZContacts.AccountsVsRootFolderMap[ZContacts.importContacts.zid];
			if (ZContacts.importContacts.categoryId && ZContacts.importContacts.categoryId != -1) {
				category = zmcontact.getCategory(ZContacts.importContacts.categoryId);
			} else {
				category = zmcontact.getCategory(rootFolderId);
			}
			ZContacts.importContacts.refreshContacts = true;
			zmcontact.refreshContactCounts(ZContacts.importContacts.zid);
		})

	};
	
	actionOnGSyncConsentClose = function() {
		var zid = ZContacts.importContacts.zid;
		var mappingConfirmation = ZContacts.GSyncConsentResponseClose.create();
		mappingConfirmation.set("file_key", ZContacts.gSyncContacts.gSyncFileKey); // NO I18N
		new ZContacts.URI(ZContacts.GSyncConsentResponseClose, zid).POST(mappingConfirmation).then(function(response) {
			closeImport();
		})
	};
	
	getTypeSelectBox = function(data, type_model) {
		var type_array = "";
		if(type_model == "phone"){
			type_array = ZContacts.MappingType.Phone_Type;
		} else if (type_model == "urls"){
			type_array  = ZContacts.MappingType.Urls_Type;
		}
		var selectTypeBox = '<select class="zcs-list-type zcs_'+type_model+'_type" name="type">';
		selectTypeBox += '<option value="none">' + "None" + '</option>';
		for (var i = 0; i < type_array.length; i++) {
			var newdata = ZContacts.I18N.get("IAM.CONTACTS."+type_model.toUpperCase()+".TYPE."+type_array[i].toUpperCase());
			selectTypeBox += '<option value="' + type_array[i] + '" '; // No I18N
			if (data && data == type_array[i]) {
				selectTypeBox += 'selected = "true"';
			}
			selectTypeBox += '>' + newdata + '</option>';
		}
		selectTypeBox += '</select>';
		return selectTypeBox;
	};

	getSelectBox = function(response, data) {
		var headers = response.import.headers;
		var headers_map = response.import.headersMap;
		var valueIndex = headers_map[data];
		var selectBox = '<select id="' + data + '_field" class="zcs_mapping_select_box select">';
		selectBox += '<option value="-1">' + "None" + '</option>';
		for (var i = 0; i < headers.length; i++) {
			selectBox += '<option value="' + i + '" '; // No I18N
			if (valueIndex != -1 && valueIndex === i) {
				selectBox += 'selected = "true"';
			}
			selectBox += '>' + encodeHTML(headers[i].name) + " " + '(' + i + ')' + '</option>';
		}
		selectBox += '</select>';
		return selectBox;
	};

	this.createPageContent = function(content) {
		ZContacts.contactimport.$containerElem.html($(content));
	}

	this.createAppendPageContent = function(content) {
		ZContacts.contactimport.$containerElem.append($(content));
	}

	this.mappingValues = function(data) {
		var mapping = ZContacts.MappingFields.create();
		/* Names */
		mapping.set('first_name', $(data).find("#FIRST_NAME_field option:selected").val());// NO I18N
		mapping.set('middle_name', $(data).find("#MIDDLE_NAME_field option:selected").val()); // NO I18N
		mapping.set('last_name', $(data).find("#LAST_NAME_field option:selected").val());// NO I18N
		mapping.set('nick_name', $(data).find("#NICK_NAME_field option:selected").val());// NO I18N

		/* Category */
		mapping.set('categories', $(data).find("#CATEGORIES_field option:selected").val());

		/* Email */
		var $emailLength = $(data).find('.zcs_email_div').find('div[name=zcs_field]').find('.zcs_siblings').find('select');
		var storeEmailArray = [];
		for (var i = 0; i < $emailLength.length; i++) {
			var emailIndex = $($emailLength[i]).val();
			storeEmailArray.push(emailIndex);
		}
		mapping.set('emails', storeEmailArray);// NO I18N

		/* phone */
		var $phoneRows = $(data).find('.zcs_phone_div').find("div[name=zcs_field]"); //No I18N
		for (var i = 0; i < $phoneRows.length; i++) {
			var phone = $($phoneRows[i]).find('.zcs_siblings').find('[name="phone"]').find('select').val();
			var types = $($phoneRows[i]).find('.zcs_siblings').find('[name="type"]').val();
			var phoneModel = ZContacts.PhoneNumbers.create({
				number : phone,
				type : types
			});
			mapping.addSubResource(phoneModel);
		}
		
		/* Urls */
		var $urlRows = $(data).find('.zcs_urls_div').find("div[name=zcs_field]"); //No I18N
		for (var i = 0; i < $urlRows.length; i++) {
			var url = $($urlRows[i]).find('.zcs_siblings').find('[name="urls"]').find('select').val();
			var types = $($urlRows[i]).find('.zcs_siblings').find('[name="type"]').val();
			var urlModel = ZContacts.Urls.create({
				url : url,
				type : types
			});
			mapping.addSubResource(urlModel);
		}

		/* Gender */
		mapping.set('gender', $(data).find("#GENDER_field option:selected").val());// NO I18N
		/* Birthday */
		mapping.set('birth_date', $(data).find("#BIRTH_DAY_field option:selected").val());// NO I18N
		mapping.set('birth_month', $(data).find("#BIRTH_MONTH_field option:selected").val());// NO I18N
		mapping.set('birth_year', $(data).find("#BIRTH_YEAR_field option:selected").val());// NO I18N
		/* Notes */
		mapping.set('notes', $(data).find("#NOTES_field option:selected").val());// NO I18N
		/* company */
		mapping.set('company', $(data).find("#COMPANY_NAME_field option:selected").val());// NO I18N
		/* jobtitle */
		mapping.set('job_title', $(data).find("#JOB_TITLE_field option:selected").val());// NO I18N
		/* designation */
		mapping.set('designation', $(data).find("#DESIGNATION_field option:selected").val());// NO I18N

		/* Address */

		// Home Address
		var homeAddress = ZContacts.Address.create({
			street_addr : $(data).find("#HOME_ADDR_field option:selected").val(),
			street_addr1 : $(data).find("#HOME_ADDR1_field option:selected").val(),
			city : $(data).find("#HOME_CITY_field option:selected").val(),
			state : $(data).find("#HOME_STATE_field option:selected").val(),
			country : $(data).find("#HOME_COUNTRY_field option:selected").val(),
			postal_code : $(data).find("#HOME_ZIPCODE_field option:selected").val(),
			type : "home", // No i18N
		});
		mapping.addSubResource(homeAddress);

		// Work Address
		var workAddress = ZContacts.Address.create({
			street_addr : $(data).find("#WORK_ADDR_field option:selected").val(),
			street_addr1 : $(data).find("#WORK_ADDR1_field option:selected").val(),
			city : $(data).find("#WORK_CITY_field option:selected").val(),
			state : $(data).find("#WORK_STATE_field option:selected").val(),
			country : $(data).find("#WORK_COUNTRY_field option:selected").val(),
			postal_code : $(data).find("#WORK_ZIPCODE_field option:selected").val(),
			type : "work", // No i18N
		});
		mapping.addSubResource(workAddress);

		return mapping;
	};


	ZContacts.contactimport.EmailDetailsPopup = function(key, key2) {
		var errorDetails = {};
		// see
		if(key == "duplicate_email") {
			errorDetails.title = ZContacts.I18N.get("IAM.CONTACTS.DUPLICATE.E_ADDRESS"); // No I18N
			errorDetails.name = key;
		} else if(resp == "invalid_email") {
			errorDetails.title = ZContacts.I18N.get("IAM.CONTACTS.INVALID.E_ADDRESS"); // No I18N
			errorDetails.name = resp;
		} else if(resp  == "record_duplicate"){
			errorDetails.title =  ZContacts.I18N.get("IAM.CONTACTS.RECORD.DUPLICATE.E_ADDRESS"); // No I18N
			errorDetails.name = resp;
		}
		errorDetails.mask = true;
		errorDetails.buttons = [ {
			isCancel : true,
			txt : ZContacts.I18N.get("IAM.CONTACTS.DONE"),
			callback : function() {
				zmsDialog.remove();
				$("#zcs_errorDetailsPopup").remove();
			}
		} ];

		errorDetails.closeaction = function() {
			zmsDialog.remove();
			$("#zcs_errorDetailsPopup").remove();
		};
		errorDetails.pos = "center"; // No I18N
		createFolElem = $("<div id='zcs_errorDetailsPopup' style='max-height: 500px;'></div>");
		if (!$("#zcs_errorDetailsPopup").length) {
			var email_list = "<div class='zcs_Emaildetails_main'>";
			if(key == "duplicate_email" && data.duplicate_email_ids){
				for (var i = 0; i < data.duplicate_email_ids.length; i++) {
					email_list = email_list + "<div><span>" + (i+1) + ".</span><span style='margin-left: 5px;'>" + data.duplicate_email_ids[i] + "</span></div></br>";
				}
				email_list = email_list + "</div>"
			} 
			
			createFolElem.append(email_list);
			$(document.body).append(createFolElem);
		}
		zmsDialog.create("zcs_errorDetailsPopup", errorDetails); // No I18N
	};

	goToImportPage = function(doRefreshCounts) {
		this.data = undefined;
		if(doRefreshCounts) {
			zmcontact.refreshContactCounts(ZContacts.importContacts.zid);
		}
		resetImportContacts();
		var contactImport = new ZContacts.contactimport();
		contactImport.createPageContent(getHtmlForImport());
		var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find('.SC_import');
		$(rightContainer).find('[data-field-type=import_accounts_list]').on("click", function(eve){
			zmcontact.getScrollList($(this), 'account', true); //No I18N
		});
		$(rightContainer).find('[data-field-type=import_category_list]').on("click", function(eve){
			zmcontact.getScrollList($(this), 'category', true); //No I18N
		});
		$(rightContainer).find('[data-field-type=local_file]').change(function(ev){
			processFile();
		});
		$(rightContainer).find('[data-field-type=google_import]').on("click", function(ev){
			importGoogle();
		});
		$(rightContainer).find('[data-field-type=google_sync]').on("click", function(ev){
			twoWaySyncPopup();
		});
		$(rightContainer).find('[data-field-type=yahoo_import]').on("click", function(ev){
			importYahoo()
		});
		$(rightContainer).find('[data-field-type=outlook_import]').on("click", function(ev){
			importOutlook();
		});
		return;
	};

	validateContacts = function(map) {
		zmUtil.succErrMsg("s", ZContacts.I18N.get("IAM.CONTACTS.VALIDATING"));// NO I18N
		var contactImport = new ZContacts.contactimport();
		var mappingFieds = contactImport.mappingValues(map);
		if (mappingFieds.first_name == '-1' && mappingFieds.emails[0] == "-1" && mappingFieds.company == "-1") {
			zmUtil.succErrMsg("e", ZContacts.I18N.get("IAM.CONTACTS.FIRST.NAME.REQUIRED"));// NO I18N
			$("#first_name_field").focus();
			return;
		}

		var centerNode = zmsuite.getCenter()[0].getNodes()[2].$el;
		var mapping_loading = zmComponent.loadingBand({
			container : centerNode.find('.zcs_header_loadingband').get(0), // No i18N
			type : "listing", // No i18N
			notToSetInnerHTML : true
		});
		
		var importMapping = ZContacts.ImportValidate.create();
		
		importMapping.file_key = ZContacts.importContacts.fileKey;
		importMapping.addSubResource(mappingFieds);
		
		// api/v1/accounts/zid/contacts/import/validate

		new ZContacts.URI(ZContacts.ImportValidate, ZContacts.importContacts.zid).POST(importMapping).then(function(response) {
			mapping_loading();
			if (response.status_code == 200) { // NO I18N
				var contactImport = new ZContacts.contactimport();
				$("#mappingPage").hide();
				if(response.import.invalid_count || response.import.duplicate_count || response.import.invalid_category_count) {
					contactImport.createAppendPageContent(getValidatedDetailsInHtml(response), false);
				} else {
					importContacts(response.import);
				}
				zmsuite.getCenter()[0].$el.find('[data-field-type=prev_mapping_page]').on("click", function(event){
					goMappingPage();
				});
				zmsuite.getCenter()[0].$el.find('[data-field-type=nxt_mapping_page]').on("click", function(event){
					importContacts(data);
				});
				zmsuite.getCenter()[0].$el.find('[data-field-type=close_import_page]').on("click", function(event){
					closeImport(false);
				});
				zmsuite.getCenter()[0].$el.find('[data-field-type=go_import_page]').on("click", function(event){
					goToImportPage(false);
				});
				zmsuite.getCenter()[0].$el.find('[data-field-type=duplicate_email_ids]').on("click", function(event){
					errorValuesPopup('duplicate_email_ids'); //No I18N
				});
				zmsuite.getCenter()[0].$el.find('[data-field-type=invalid_emails_list]').on("click", function(event){
					var key_list = event.target.dataset.val.split(',');
					var key = key_list[0].toString();
					var value = key_list[1].toString();
					errorValuesPopup(key,value); //No I18N
				});
			
			} else {
				zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response)); // No I18N
			}
		}, function(response) {
			zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response)); // No I18N
		});
	};

	closeImport = function(result) {
		this.data = undefined;
		zmsuite.closeWorkspace(ZContacts.ZMailConstants.IMPORT_APP_ID);
		// TODO : if deleting upload file is possible, need to implement it here.
		if(result) {
			zmcontact.refreshContactCounts(ZContacts.importContacts.zid);
			var rootFolderId = ZContacts.AccountsVsRootFolderMap[ZContacts.importContacts.zid];
			if(ZContacts.importContacts.categoryId && ZContacts.importContacts.categoryId != -1){
				category = zmcontact.getCategory(ZContacts.importContacts.categoryId);
			} else {
				category = zmcontact.getCategory(rootFolderId);
			}
			zmcontact.loadFirstPage(category);
			new ZContacts.URI(ZContacts.Categories, ZContacts.importContacts.zid).GETS().then(function(json) {
				var rootFolderId = ZContacts.AccountsVsRootFolderMap[ZContacts.importContacts.zid];
				var layer = zmcontact.getCategoriesListLayer(rootFolderId);
				for (var i = 0; i < json.length; i++) {
					if(!layer.childObject[rootFolderId].CH[json[i].category_id]) {
						if(!ZContacts._parentObj[rootFolderId]) {
							ZContacts._parentObj[rootFolderId] = [];
						}
						ZContacts._parentObj[rootFolderId].push(json[i]);
						var rowInfo = {};
						rowInfo[json[i].category_id] = {
								category_id : json[i].category_id,
								category_name : json[i].category_name,
								E : 0,
								HC : false,
								SE : 2
						}
						var categoryMapObj = {
								id : "category_id", // No i18N
								name : "category_name", // No i18N
								count : "count", // No i18N
								hasChild : "HC", // No I18N
								expChild : "E", // No I18N
								sequence : "SE", // No I18N
								parentId : "p", // No I18N
								notBold : "notBold" // No I18N
							};
						
						layer.insertNodeBefore(rowInfo, categoryMapObj, rootFolderId+"_add", rootFolderId); // No I18N
					}
				}
				resetImportContacts();
			}, function() {
				resetImportContacts();
			});
		}
		return
	};
	
	openNewTab = function(url, name) {
		var width = parseInt(('80' * screen.width) / 100);
		var height = parseInt(('80' * screen.height) / 100);
		var left = (screen.width - width) / 2;
		var top = (screen.height - height) / 2;
		url+=(url.indexOf('?') == -1 ? "?" : "&");
		var contextDomain;
		if(zmail.forContactsApp){
			contextDomain = zmail.urls.contactsURL;
		} else {
			contextDomain = window.location.host + ZContacts.getContextPath();
		}
		url+=("domain="+ contextDomain); // No I18N
		window.open(url, name, "height=" + height + ", width=" + width + ", top=" + top + ", left=" + left + ",status=1,toolbar=0,scrollbars=1,resizable=1", true);
		return false;
	};
	
	openSyncNewTab = function(url, name) {
		var width = parseInt(('80' * screen.width) / 100);
		var height = parseInt(('80' * screen.height) / 100);
		var left = (screen.width - width) / 2;
		var top = (screen.height - height) / 2;
		url+=(url.indexOf('?') == -1 ? "?" : "&");
		window.open(url, name, "height=" + height + ", width=" + width + ", top=" + top + ", left=" + left + ",status=1,toolbar=0,scrollbars=1,resizable=1", true);
		return false;
	};
	
	// confirmatoin page previous
	goMappingPage = function() {
		$(".zcs_confirm_page_main").remove();
		$(".zcs_mapping_page").show();
	};
	
	
	addOrRemoveField = function(elem, field) {
		response = this.mapping_response;
		var $appendRow = $(elem).parents("div[name="+field+"]").find("div[name=zcs_left_field]")
		var isType = false;
		var size = 0;
		if(field=="email") {
			size = 5;
			isType = false;
		} else if(field == "phone") {
			size = 8;
			isType = true;
		} else if (field == "urls") {
			size = 10;
			isType = true;
		}
		if($(elem).hasClass("msi-plus")) {
			var html = new ZContacts.StringBuilder();
			var currentSize = $appendRow.find('.zcs_siblings').length;
			if(currentSize <= size) {
				html.append('<div name="zcs_field" style="width: 100%;min-height: 30px;margin-bottom: 15px;">'); //zcs_mapping_fld_grp
				html.append('<div class="zcs_siblings" style="display: block;width: 100%;min-width: 597px;">');
				html.append('<div name=' + field + ' class="zcs_mapping_info_right SC_select">' + getSelectBox(response, field) + '</div>');
				if(isType) {
					html.append('<div class="zcs-left SC_select" style="margin-left: 10px;">'+ getTypeSelectBox(field , field) +'</div>');
				}
				if(currentSize < size) {
					var currentChild = $(elem).parents("div[name=zcs_field]"); //No I18N
					if(!currentChild.find('.msi-close').length) {
						$(elem).removeClass("msi-plus").addClass("msi-close");
					} else {
						$(elem).remove();
					}
					if(!(currentSize == size-1)) {
						html.append('<div class="msi-plus" style="display: inline-block;float: left;margin-top: 10px;margin-left: 10px;" data-field-type="add_or_remove_field" data-id='+field+'></div>');
					}
				}
				html.append('<div class="msi-close zcs_msi_close" style="display: inline-block;float: left;margin-top: 10px;margin-left: 10px;" data-field-type="add_or_remove_field" data-id='+field+'></div>');
				html.append('</div></div>');
				$appendRow.append(html.toString());
			}
			var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_import');
			$(rightContainer).find('[data-field-type=add_or_remove_field]').off('click').on("click", function(event){
					addOrRemoveField(this, event.target.dataset.id);
			});

		} else if ($(elem).hasClass("msi-close")) {
			var $siblingElem = $(elem).parents('.zcs_siblings');
			var $delElm = $siblingElem.parents("div[name=zcs_field]"); //No I18N
			$delElm.remove();
			var children = $appendRow.find(".zcs_siblings");
				var lastChild = children.last();
				if(!$(lastChild).find(".msi-plus").length) {
					$(lastChild).find(".msi-close").removeClass('msi-close zcs_msi_close').addClass('msi-plus');
					if(children.length != 1) {
						$(lastChild).append('<div class="msi-close zcs_msi_close" style="display: inline-block;float: left;margin-top: 10px;margin-left: 10px;" data-field-type="add_or_remove_field" data-id='+field+'></div>');
					}
				}
				if(children.length == 1) {
					$(lastChild).find(".msi-close").removeClass('msi-close zcs_msi_close');
				}
		}
	};

};