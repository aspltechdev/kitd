            .cal-loader {
                align-items: center;
                background-color: #ffffff;
                display: flex;
                flex-direction: column;
                justify-content: center;
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 9999;
                transition: opacity 0.4s ease;
            }

            .cal-loader .progress-label {
                font-size: 0.875rem;
                color: #666666;
                transition: opacity 0.4s ease;
                font-family: Open Sans, sans-serif !important;
                margin: 1rem;
                margin-top: 1.25rem;
            }

            .cal-loader.hidden,
            .cal-loader .hidden {
                opacity: 0;
            }

            .cal-loader .logo-svg {
                width: 4rem;
                height: 4rem;
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                right: 0;
                transition: opacity 0.4s ease;
            }

            .cal-loader .animated-svg {
                top: -5px;
                left: 0px;
                transform: scale3d(1.1, 1.1, 1);
            }

            .cal-loader .logo-svg .st0 {
                opacity: 0.9;
            }

            .cal-loader .logo-svg .st1 {
                fill: #F4B01C;
            }

            .cal-loader .logo-svg .st2 {
                fill: #256FB2;
            }

            .cal-loader .progress-bar {
                margin: 0;
                padding: 0;
                width: 250px;
                height: 4px;
                background-color: #dadada;
                border-radius: 1.5px;
                transform: scale(1.5);
                overflow: hidden;
                position: relative;
                margin-top: 30px;
                visibility: visible;
                transition: opacity 0.4s ease;
            }

            @media (max-width: 480px) {
                .cal-loader .progress-bar {
                    transform: scale(1.2) !important;
                }
            }

            .cal-loader .fill-indicator {
                margin: 0;
                padding: 0;
                position: absolute;
                left: 0;
                background-color: #4181bc;
                top: 0;
                bottom: 0;
                border-radius: 0;
                width: 100%;
                transform: translateX(-100%);
                transition: transform 0.2s ease;
            }

            .cal-loader .svg-wrapper {
                margin: 0;
                padding: 0;
                position: relative;
                width: 66px;
                height: 66px;
                transform: scale(1.3);
            }

            @-webkit-keyframes cal-loader-ping {
                0% {
                    -webkit-transform: scale(0.9);
                    transform: scale(0.9);
                    opacity: 0.3;
                }

                100% {
                    -webkit-transform: scale(1);
                    transform: scale(1);
                    opacity: 0.8;
                }
            }

            @keyframes cal-loader-ping {
                0% {
                    -webkit-transform: scale(0.9);
                    transform: scale(0.9);
                    opacity: 0.3;
                }

                100% {
                    -webkit-transform: scale(1);
                    transform: scale(1);
                    opacity: 0.8;
                }
            }

            .cal-loader-ping-animation {
                -webkit-animation: cal-loader-ping 0.8s ease-in-out infinite both;
                animation: cal-loader-ping 0.8s ease-in-out infinite both;
                -webkit-animation-direction: alternate;
                animation-direction: alternate;
            }

            .cal-loader-ping-animation.hidden {
                -webkit-animation: none;
                animation: none;
            }

            .dev-mode .cal-loader .fill-indicator {
                background-color: tomato;
            }

            .dev-mode .cal-loader .logo-svg .st2 {
                fill: tomato;
            }

            .dev-mode .cal-loader .animated-svg path {
                stroke: tomato !important;
            }

    `,{domID:"loading-icon-dev-override"}),(0,p.Iu)(`
