			formatObj.par = $("#zcs_restorePopup").find("#zcs_format ul li");// No I18N
			formatObj.defaultclass = true;
			formatObj.parWidth = true;
			formatObj.onHide = function() {

			};
			formatObj.clk = function(data, elem, event) {
				if (data.action == "10") {
					$('#zmsdialog_zcs_restorePopup').find("#days")[0].placeholder = I18N.get("IAM.CONTACTS.10.DAYS");
				}
