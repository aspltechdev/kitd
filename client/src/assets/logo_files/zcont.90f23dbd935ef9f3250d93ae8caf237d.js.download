		},

		showEditPage : function(contact) {
			var editorActions = {
				save : function() {
					if (!doAllowClick(this.$e.find('.SC_PUbtm'))) {
						return;
					}
					var contactModel = this.toContactsModel(ZContacts.Contacts.create());
					if (!contactModel) {
						return;
					}
					zmcontact.restrictClick(this.$e.find('.SC_PUbtm'), true);
					$('.SC_PUbtm').append("<div id='zcs_loading'></div>");
					var destroyLoadingDiv = zmComponent.loadingBand({
						container : $('#zcs_loading').get(0),
						type : "pagination" // No i18N
					});
					var contactId = contact.get('contact_id').toString();
					var zid = contact.zid;
					if (!zid) {
						zid = ZContacts.getCurrentAccount().getAccountId();
					}
					new URI(ZContacts.Contacts, zid, contactId).PUT(contactModel).then(function(json) {
						destroyLoadingDiv();
						if (json.status_code !== ZContacts.Constants.StatusCode.OK || !json.contacts || json.contacts.contact_id == -1) {
							zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
							return;
						}
						var newContactId = json.contacts.contact_id;
						var newPhotoUrl = json.contacts.photo_url;
						delete ZContacts._audit[contactId];
						$('.SC_PUbtm').removeAttr('disabled');
						zmUtil.succErrMsg('s', ZContacts.getMessageFromResponse(json)); // No I18N
						var photoUrl = zmcontact.getJsStdUrl(newPhotoUrl); // No I18N 
						contactModel.set('photo_url', photoUrl); // No I18N
						contactModel.set('contact_id', newContactId); // No I18N
						contactModel.set('is_writable', contact.get('is_writable')); // No I18N
						contactModel.set('zid', contact.get('zid')); // No I18N
						contactModel.set('is_active', contact.isActive()); // No I18N
						contactModel.set("own_org", contact.isOwnOrg()); // No I18N
						// Update List Row element
						var $rowEle = zmcontact.getContactRowElement(contactModel);
						var oldRowEle = zmsuite.getCenter()[0].getNodes()[2].$el.find('#' + contactId);
						$rowEle.insertAfter(oldRowEle);
						$rowEle[0].setAttribute("data-field-type", "zcs-cnt-view");
						oldRowEle.remove();
						var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find('.SC_conLft')[0];
                        $(rightContainer).find('[data-field-type="crow_select_box"]').unbind().on("click",function(event) {
                            zmcontact.select(event);
                        });
						if (isOldSearchWorkSpace()) {
							var $contactsTabRowEle = zmcontact.getContactRowElement(contactModel);
							var contactsTabOldRowEle = zmsuite.getWorkSpace(ZContacts.ZMailConstants.CONTACTS_APP_ID)[0].getNodes()[2].$el.find('#' + contactId);
							$contactsTabRowEle.insertAfter(contactsTabOldRowEle);
							contactsTabOldRowEle.remove();
						}

						// Render Contact Details Page
						printResponse = {};
						zmcontact.renderContactDetails(contactModel);
						zmcontact.switchDetailsPage(true);
						
						/*	Event triggering to notify mail client	*/
						try {
							if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
								zmcontact.invokeEvent("contactsApp/updated", { zid : ZContacts.getCurrentAccount().getAccountId(), contact : contactModel }); // No I18N
							}
						} catch (e) {

						}
						
					}, function(json) {
						destroyLoadingDiv();
						$('.SC_PUbtm').removeAttr('disabled');
						if(json.status_code == ZContacts.Constants.StatusCode.CONFLICT) {
							if(json.errors[0] && json.errors[0].code == "same_data") {
								$('.SC_PUbtm').removeAttr('disabled');
								zmUtil.succErrMsg('s', I18N.get('IAM.CONTACTS.ERROR.UPDATED.SUCCESS')); // No I18N
								// Render Contact Details Page
								printResponse = {};
								zmcontact.renderContactDetails(contact);
								zmcontact.switchDetailsPage(true);
								return;
							}
							zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
							var exist_contacts = json.errors[0].params.exist_contacts;
							var html = "<h4 style='float: left;width:90%; padding: 5px 0px 15px 5px;'>" + I18N.get("IAM.CONTACTS.DUPLICATE.EMAIL.RESTRICTED") + "</h4>"; // No I18N
							html += "<div class='SC_PUbtm'><span id='zcs_exist_contact_edit' class='sel'>"+I18N.get('IAM.CONTACTS.VIEW')+"</span><span data-val='Cancel'>"+I18N.get('IAM.CANCEL')+"</span></div>"; // No I18N
							Dialog.new({
								 title: "", // NO I18N
								 $content: html,
								 defaultCloseIcon:true
							});
							$(".SC_PUcen").find('#zcs_exist_contact_edit').click(function() {
								zmcontact.showCustomSearchPage(exist_contacts, ZContacts.getCurrentAccount().getAccountId());
								zmcontact.removeDialog(this);
							});
							$(".SC_PUcen").find('[data-val=Cancel]').click(function() {
								zmcontact.removeDialog(this);
							});
						} else {
							zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
						}
					});
					if(!isNewSearchWorkSpace()){
						zmcontact.unChkAll();
					}

				},
				cancel : function() {
					$('.SC_PUbtm').removeAttr('disabled');
					var contactId = contact.get('contact_id');
					var zid = contact.get('zid')
					if (!isCleanWorkSpace()) {
						zmcontact.switchDetailsPage(true);
					}
					zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId));
				}
			};
			var ceditor = new ZContacts.ContactEditor(false, contact, {
				actions : editorActions
			});

			var $rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el;
			ceditor.render($rightContainer.find('.zcs-cont-edit'), true);
			
			var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find(".SC_conRgt")[0];
			
			$(rightContainer).find('#zcs-photo').find('.msi-edit').click(function(event) {
				zmcontact.openUploadPopup(contact);
			});
		
			$(rightContainer).find('[name="zcs-update-photo"]').find('img').click(function(event) {
				zmcontact.openUploadPopup(contact);
			});
		
			$('.zcs-cont-edit').off("keypress").on("keypress",function(e) {
				if (e.which == 13 && e.target.type != "textarea" && !e.shiftKey) {
					$(this).find('#zcs-save-btn')[0].click();
				}
			});
			$(".SC_PUcen").find('#zcs_delete').click(function() {
				zmcontact.editPageConfirm(contactId, currentAccountId);
				zmcontact.removeDialog(this);
			});
			$(".SC_PUcen").find('[data-val=Cancel]').click(function() {
				zmcontact.removeDialog(this);
			});
			zmcontact.switchDetailsPage(false);
			zmsuite.getCenter()[0].getNodes()[2].$el.find('[data-field-type="first_name"]')[0].focus();
		},

		showDuplicates : function(event,isFirst) {
			var t = event.target;
			if(isFirst) {
				var t = event;
			}
			if (!$(t).hasClass('SC_cont')) {
				t = $(t).parents(".zmL.SC_cont")[0];
			}
			if (!$(t).hasClass("zmSLst")) {
				$(".zmL.SC_cont.zmSLst").removeClass("zmSLst");
				$('div[data-field-type="zcs-cnt-view"]').attr("data-field-type", "");
				t.setAttribute("class", "zmL SC_cont zmSLst");
				t.setAttribute("data-field-type", "zcs-cnt-view");
				var id = t.id;
				zmcontact.showMergeUI(id.split(","));
			}
			event.stopPropagation();
		},

		getContactRowElement : function(contact, isCleanDupes) {
			var cRow = new ZContacts.StringBuilder();
			if (isCleanDupes) {
				var contact_id = contact.contact_id.toString();
				contact = ZContacts.Contacts.create(contact);
				cRow.append("<div class='zmL SC_cont' data-val='show_duplicates' id='").append(contact_id).append("'>");
				var count = contact_id.split(",").length;
				cRow.append("<div class='zmLst'>");
				cRow.append("<div class='zmDtl'>");
				cRow.append("<div class='zcs-contDup-row'><span>").append(encodeHTML(contact.getFullName().trim())).append("</span>");
				cRow.append("<div class='zcs-matched-count'><b title='" + count + " " + I18N.get("IAM.CONTACTS.MATCHED") + "'>" + count + "</b></div>");
				cRow.append("</div></div>");
				cRow.append("</div>");
				cRow.append("</div>");

			} else {
				var photo_url = zmcontact.getJsStdUrl(contact.get('photo_url')); // No I18N
				var contactZuid = contact.get('contact_zuid');
				var contactStatus = contact.get('status');
				var contact_id = contact.get('contact_id').toString();
				var zid = contact.get("zid");

				var srchTab = getCurrentSearchTab(zmTab.currentTab);
				if(isNewSearchWorkSpace()){
					cRow.append("<div class='zmL SC_cont'  draggable='true' data-val='new_search_load_contact_details' data-id='"+contact_id+ "\,"+zid+"\' data-field-type='' id='").append(contact_id).append("'>");
				} else {
					cRow.append("<div class='zmL SC_cont'  draggable='true'  data-field-type='' id='").append(contact_id).append("'>");
				}
				cRow.append("<div class='zmLst'>");
				cRow.append("<div class='zmFlt'>");
//				if(isNewSearchWorkSpace()){ // allowing select in new search
					cRow.append("<i class='msi-uncheck' data-field-type='crow_select_box'></i>");
					if (contactZuid != -1) {
						var status;
						var presence;
						try {
							status = WmsContacts.getStatusType(contactZuid);
						} catch (e) {

						}
						if (!status || status == ContactStatus.OFFLINE) {
							status = "wms-0"; // No I18N
							presence = I18N.get('IAM.OFFLINE'); // No I18N
						} else if (status == ContactStatus.ONLINE) {
							status = "wms-1-1"; // No I18N
							presence = I18N.get('IAM.ONLINE'); // No I18N
						} else if (status == ContactStatus.INVISIBLE) {
							status = "wms-2-1"; // No I18N
							presence = I18N.get('IAM.INVISIBLE'); // No I18N
						} else if (status == ContactStatus.BUSY) {
							status = "wms-3-1"; // No I18N
							presence = I18N.get('IAM.BUSY'); // No I18N
						} else if (status == ContactStatus.IDLE) {
							status = "wms-4-1"; // No I18N
							presence = I18N.get('IAM.IDLE'); // No I18N
						}
						cRow.append("<i class='" + status + "' title='" + presence + "'></i>");
					}
//				}
				cRow.append("</div>");
				cRow.append("<div class='zmDtl'>");
				cRow.append("<div class='zmImg'>");
				cRow.append("<img src='" + photo_url + "'>");

				cRow.append("</div>");
				var fullName = getHighlightedName(contact.first_name, contact.last_name, ZContacts.sortBy);
				if(isNewSearchWorkSpace()){
					cRow.append("<div class='zmFrm' style='max-width: 200px; text-overflow: ellipsis;'><span>").append(fullName).append("</span></div>");
				} else {
					cRow.append("<div class='zmFrm'><span class='zcs-contact-name'>").append(fullName).append("</span></div>");
				}
				
				if (!contact.isActive()) {
					cRow.append("<div class='zmAct-lst zmAct'>" + I18N.get('IAM.CONTACTS.INACTIVE') + "</div>");
				} else if (contact.isGroup()) {
					cRow.append("<div class='ZC_org'><i class='msi-users' data-tooltip='" + I18N.get('IAM.CONTACTS.GROUPS') + "'></i> </div>");
				} else if (contact.isOwnOrg()) {
					cRow.append("<div class='ZC_org'><i class='msi-building' data-tooltip='" + I18N.get('IAM.CONTACTS.ORGANIZATION') + "'></i> </div>");
				}

				if (contact.getPrimaryEmail()) {
					cRow.append("<div class='zmSub'><span>").append(encodeHTML(contact.getPrimaryEmail())).append("</span></div>");
					cRow.append("<div class='SC_icn'>");
					if(zmail.forContactsApp){
						cRow.append("<a data-field-type='send_mail' style='text-decoration: none !important;'><i class='msi-mail' data-id="+contact.getPrimaryEmail()+" title='" + I18N.get('IAM.CONTACTS.SEND.MAIL') + "'></i></a>");
					} else {
						cRow.append("<i class='msi-mail' data-field-type='send_mail' data-id="+contact.getPrimaryEmail()+" data-tooltip='" + I18N.get('IAM.CONTACTS.SEND.MAIL') + "' data-tooltip-pos='top'></i>");
					}
					
					if (!isNewSearchWorkSpace()) {
						if (!contact.isGroup()) {
							if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT) {
								if (contactStatus >= 0) { // chat applicable
									if (zmail.forContactsApp) {
										cRow.append("<i class='msi-chat' data-field-type='open_chat' data-id=" + contactZuid + " title='" + I18N.get('IAM.CONTACTS.CHAT') + "'></i>");
									} else {
										cRow.append("<i class='msi-chat' data-field-type='open_chat' data-id=" + contactZuid + "  data-tooltip='" + I18N.get('IAM.CONTACTS.CHAT') + "' data-tooltip-pos='top'></i>");
									}

								} else if (contactStatus == ContactStatus.DELETED || contactStatus == ContactStatus.REJECTED) {
									var chat;
									if (contactStatus == ContactStatus.DELETED) {
										chat = I18N.get('IAM.CONTACTS.DELETED');
									} else {
										chat = I18N.get('IAM.CONTACTS.REJECTED');
									}
									if (zmail.forContactsApp) {
										cRow.append("<i class='msi-chat-rejected' data-field-type='chat_reject' data-id=" + contact_id + "\," + contactStatus + " title='" + chat + "'></i>");
									} else {
										cRow.append("<i class='msi-chat-rejected' data-field-type='chat_reject' data-id=" + contact_id + "\," + contactStatus + " data-tooltip='" + chat + "' data-tooltip-pos='top'></i>");
									}
								} else if (contactStatus == ContactStatus.NO_CHAT) {
									if (zmail.forContactsApp) {
										cRow.append("<i class='msi-invite-chat' data-field-type='chat_reject' data-id=" + contact_id + "\," + contactStatus + " title='" + I18N.get('IAM.CONTACTS.INVITE.TO.CHAT') + "'></i>");
									} else {
										cRow.append("<i class='msi-invite-chat' data-field-type='chat_reject' data-id=" + contact_id + "\," + contactStatus + " data-tooltip='" + I18N.get('IAM.CONTACTS.INVITE.TO.CHAT') + "' data-tooltip-pos='top'></i>");
									}
								} else if (contactStatus == ContactStatus.PENDING || contactStatus == ContactStatus.REQACC) {
									if (zmail.forContactsApp) {
										cRow.append("<i class='msi-chat-pending' data-field-type='invite_pending' title='" + I18N.get('IAM.CONTACTS.PENDING') + "'></i>");
									} else {
										cRow.append("<i class='msi-chat-pending' data-field-type='invite_pending' data-tooltip='" + I18N.get('IAM.CONTACTS.PENDING') + "' data-tooltip-pos='top' ></i>");
									}
								}
							}
						}
					}
					cRow.append("</div>");
				}
				cRow.append("</div>");
				cRow.append("</div>");
				cRow.append("</div>");

			}
			retHTML = cRow.toString();
			var $html = $(retHTML);
			$html.get(0).__zc_contact = contact;
			return $html;
		},
		
		dodragend : function(event) {
			$('.SC_dg').remove();
			$('.zmTreeDrop').remove();
		},

		doDrag : function(event, contactId) {
			event.stopPropagation();
			$(event.dataTransfer)[0].setData('text/html', 'anything'); // No I18N
			var contactIdsArr = [];
			var mouseMoveY;
			var mouseMoveX;
			if ($(event.target).hasClass('SC_check')) {
				var selectedCount = zmsuite.getCenter()[0].$el.find('.SC_check').length;
				if (selectedCount == 1) {
					contactIdsArr.push(event.target.id);
				} else {
					for (var i = 0; i < selectedCount; i++) {
						contactIdsArr.push(zmsuite.getCenter()[0].$el.find('.SC_check')[i].id);
					}
				}
			} else {
				contactIdsArr.push(contactId);
			}
			dragElement = $("<div class='SC_dg'></div>");
			if (contactIdsArr.length == 1) {
				$(dragElement).html(encodeHTML(zmsuite.getCenter()[0].$el.find('#' + contactIdsArr[0]).get(0).__zc_contact.first_name) + "<br>");
				if (zmsuite.getCenter()[0].$el.find('#' + contactIdsArr[0]).get(0).__zc_contact.emails != null) {
					$(dragElement).append(encodeHTML(zmsuite.getCenter()[0].$el.find('#' + contactIdsArr[0]).get(0).__zc_contact.emails[0].email_id));
				}
			} else {
				$(dragElement).html(zmcontact.formatMessage(I18N.get('IAM.CONTACTS.OF.SELECTED'), contactIdsArr.length));
			}
			$(dragElement).css("minWidth", "100px");
			$(dragElement).css("fontWeight", "bold");
			$(dragElement).css("top", "99999px");
			$(dragElement).css("left", "99999px");
			$(dragElement).css("zIndex", "-1");
			$(dragElement).css("text-align", "left"); // No I18N
			$(dragElement).css("position", "absolute");
			$(document.body).append(dragElement);
			$(event.dataTransfer)[0].setDragImage(dragElement[0], -10, -10);
			
			$(document).ready(function() {
				$(document).off("drag").on("drag", function(e) {
					$('.SC_dg').remove();
					$('.SC_dg').css({
						'top' : e.originalEvent.clientY + "px", // No I18N
						'left' : e.originalEvent.clientX + "px" // No I18N
					});
				});
				
				$(".zmTreeNode, .SC_tre").off("dragenter").on("dragenter", function(e) {
					$('.SC_dg').remove();
					e.preventDefault();
					
					if($(e.currentTarget).find('.zmTreeDrop').length == 0 && $(e.currentTarget).find('.msi-plus').length == 0) {
						$(e.currentTarget).find('span').last().after('<div id="zmTreeDrop" class="zmTreeDrop"></div>');
					}
					
					setTimeout(function() {
						if (zmcontact.isRootFolder(e.currentTarget.id) && e.currentTarget.id.substr(-4) != "_add") {
							var dropDownClassName;
							if($(e.currentTarget).hasClass('SC_tre') == true) {
								dropDownClassName = ".msi-arrow45"; // No I18N
							} else {
								dropDownClassName = ".msi-barrow"; // No I18N
							}
							
							if($(e.currentTarget).find(dropDownClassName).length == 0){
								$(e.currentTarget).find('.msi-rarrow').click();
								
								$(".zmTreeNode, .SC_tre").off("dragover").on("dragover", function(e) {
									setTimeout(function() {
										e.preventDefault();
										e.stopPropagation();
										
										$('.zmTreeNode, .SC_tre').not($(this)).find('.zmTreeDrop').remove()
										$('.SC_dg').css("opacity","0");
										if($(e.currentTarget).find('.zmTreeDrop').length == 0 && $(e.currentTarget).find('.msi-plus').length == 0) {
											$(e.currentTarget).find('span').last().after('<div id="zmTreeDrop" class="zmTreeDrop"></div>');
										}
										if(e.originalEvent.clientY == e.originalEvent.clientX) {
											zmcontact.doDrop(e, contactIdsArr);
										}
									}, 20);
								});
								
								$(".zmTreeNode, .SC_tre").off("dragleave").on("dragleave", function(e) {
									e.preventDefault();
									if (e.originalEvent.clientY == e.originalEvent.clientX) {
										zmcontact.doDrop(e, contactIdsArr);
									}
									$(e.currentTarget).find('#zmTreeDrop').remove();
									$('.SC_dg').remove();
								});
								
								$(".zmTreeNode, .SC_tre").off("drop").on("drop", function(e) {
									e.preventDefault();
									zmcontact.doDrop(e, contactIdsArr);
								});
							}
						}
					}, 500);
				});
				
				$(".zmTreeNode, .SC_tre").off("dragover").on("dragover", function(e) {
					e.preventDefault();
					$('.zmTreeNode, .SC_tre').not($(this)).find('.zmTreeDrop').remove()
					$(".zmTreeNode, .SC_tre").off("drop").on("drop", function(e) {
						e.preventDefault();
						zmcontact.doDrop(e, contactIdsArr);
					});
				});
				
				$(".zmTreeNode, .SC_tre").off("dragleave").on("dragleave", function(e) {
					e.preventDefault();
					$('.SC_dg').remove();
				});
			});
		},

		doDrop : function(event, contactIdsArr) {
			event.preventDefault();
			$('.zmTreeDrop').remove();
			$('.SC_dg').remove();
			if (event.currentTarget.id.substr(-4) == "_add") {
				return;
			}
			var updateCategoryId = event.currentTarget.id;
			var categoryId = (zmcontact.isRootFolder(updateCategoryId)) ? -1 : updateCategoryId;
			var sourceZid = ZContacts.getCurrentAccount().getAccountId();
			var destAcc = ZContacts.AccountsVsRootFolderMap[zmcontact.getRootFolderId(event.currentTarget.id)];
			if (!destAcc.is_writable) {
				zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.ERROR.WRITE.OPERATION.NOT.ALLOWED")); // No I18N
				return;
			}
			if (sourceZid == destAcc.account_id) {
				zmcontact.addContactsToCategory(contactIdsArr, updateCategoryId);
				return;
			}
			var copy = ZContacts.Copy.create();
			var copyfrom = ZContacts.CopyFrom.create({
				zid : sourceZid,
				contact_ids : contactIdsArr
			});
			var copyto = ZContacts.CopyTo.create({
				zid : destAcc.getAccountId(),
				category_id : categoryId
			});
			copy.addSubResource(copyto);
			copy.addSubResource(copyfrom);
			new URI(ZContacts.Copy, destAcc.getAccountId()).POST(copy).then(function(response) {
				if (response.status_code == 201) {
					zmcontact.refreshContactCounts(destAcc.getAccountId());
					if (sourceZid == destAcc.account_id) {
						zmcontact.loadFirstPage(zmcontact.getCategory(zmcontact.getMyAccountForType(ZContacts.ZMailConstants.VIEW_ID_CONTACTS).getRootFolderId()));
					}
					zmUtil.succErrMsg("s", ZContacts.getMessageFromResponse(response));// NO I18N
					return;
				} else {
					zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response));// NO I18N
					return;
				}
			}, function(json) {
				zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
			});
			zmcontact.unChkAll();
		},
		
		openChat : function(contactZuid, event) {
			WebMessanger.chat(contactZuid);
			event.stopPropagation();
		},

		inviteChat : function(event, contactId, status) {
			var msg;
			if (status == ContactStatus.NO_CHAT) {
				msg = "IAM.CONTACTS.ERROR.SURE.INVITE";// No I18N
			}
			if (status == ContactStatus.DELETED || status == ContactStatus.REJECTED) {
				msg = "IAM.CONTACTS.ERROR.SURE.REINVITE";// No I18N
			}
			if (status == 0) {
				msg = "IAM.CONTACTS.SURE.INVITE.ZOHO"; // No I18N
			}
			zmsDialog.confirm(I18N.get(msg), {
				onOk : function() {
					new URI(ZContacts.InviteChat, ZContacts.getCurrentAccount().getAccountId(), contactId).POST(ZContacts.InviteChat.create({})).then(function(response) {
						if (response.status_code == 200) {
							delete ZContacts._audit[contactId];
							zmUtil.succErrMsg("s", response.message);// NO I18N
							$(event.target).attr("class", "msi-chat-pending")
							$(event.target).removeAttr('onclick');
							return;
						} else {
							zmUtil.succErrMsg("s", I18N.get('IAM.ERROR.GENERAL'));// NO I18N
							return;
						}
					}, function(json) {
						zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
					});
				}
			});
			event.stopPropagation();
		},
		
		select : function(event) {
			var t = $(event.target);
			var menuNode = zmsuite.getCenter()[0].getNodes()[0];
			var centerElem = zmsuite.getCenter()[0].$el;
			var currentElem = t.parents('.SC_cont');// No I18N
			var selectedCount;
			if (currentElem.hasClass("SC_check")) {
				if (event.shiftKey) {
					var elem;
					if (ZContacts._prevContact) {
						if (currentElem.prevAll("#" + ZContacts._prevContact.attr('id')).length) {
							elem = ZContacts._prevContact;
							while(elem.attr('id') != currentElem.attr('id')) {
								elem = elem.next();
								elem.removeClass("SC_check");
								elem.find('.msi-check').removeClass().addClass("msi-uncheck");
								elem.find('.msi-uncheck').removeClass().addClass("msi-uncheck");
							}
						} else if (currentElem.nextAll("#" + ZContacts._prevContact.attr('id')).length) {
							elem = ZContacts._prevContact;
							while(elem.attr('id') != currentElem.attr('id')) {
								elem = elem.prev();
								elem.removeClass("SC_check");
								elem.find('.msi-check').removeClass().addClass("msi-uncheck");
								elem.find('.msi-uncheck').removeClass().addClass("msi-uncheck");
							}
						}
						if(ZContacts._prevContact.hasClass("SC_check")) {
							ZContacts._prevContact.removeClass("SC_check");// No I18N
							ZContacts._prevContact.find('.msi-check').removeClass().addClass("msi-uncheck");// No I18N
						}
					}
				}
				if(currentElem.hasClass("SC_check")) {
					currentElem.removeClass("SC_check");// No I18N
					t.removeClass("msi-check").addClass("msi-uncheck");// No I18N
				}
				ZContacts._prevContact = currentElem;
				selectedCount = centerElem.find('.zmL.SC_cont.SC_check').length;
				zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId), selectedCount, false);
				if (zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').children().length != 0) {
					var contactsNode = zmsuite.getCenter()[0].getNodes()[2];
					zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#contacts")[0].innerHTML = zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.OF.SELECTED'),contactsNode.$el.find(".zmL.SC_cont.SC_check").length);
				}
			} else {
				var currentElem = $(event.target).parents('.SC_cont');
				if (event.shiftKey) {
					var elem;
					if (ZContacts._prevContact) {
						if (currentElem.prevAll("#" + ZContacts._prevContact.attr('id')).length) {
							elem = ZContacts._prevContact;
							while(elem.attr('id') != currentElem.attr('id')) {
								elem = elem.next();
								elem.addClass("SC_check");
								elem.find('.msi-check').removeClass().addClass("msi-check");
								elem.find('.msi-uncheck').removeClass().addClass("msi-check");
							}
						} else if (currentElem.nextAll("#" + ZContacts._prevContact.attr('id')).length) {
							elem = ZContacts._prevContact;
							while(elem.attr('id') != currentElem.attr('id')) {
								elem = elem.prev();
								elem.addClass("SC_check");
								elem.find('.msi-check').removeClass().addClass("msi-check");
								elem.find('.msi-uncheck').removeClass().addClass("msi-check");
							}
						}
						if(!ZContacts._prevContact.hasClass("SC_check")) {
							ZContacts._prevContact.addClass("SC_check");// No I18N
							ZContacts._prevContact.find('.msi-uncheck').removeClass().addClass("msi-check");// No I18N
						}
					}
				}
				if(!currentElem.hasClass("SC_check")) {
					currentElem.addClass("SC_check");
					t.removeClass("msi-uncheck").addClass("msi-check"); // No I18N
				}
				ZContacts._prevContact = currentElem;
				selectedCount = centerElem.find('.zmL.SC_cont.SC_check').length;
				zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId), selectedCount, false);
				if (zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').children().length != 0) {
					var contactsNode = zmsuite.getCenter()[0].getNodes()[2];
					zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#contacts")[0].innerHTML = zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.OF.SELECTED'),contactsNode.$el.find(".zmL.SC_cont.SC_check").length);
				}
			}
			if (ZContacts.getCurrentAccount().is_writable) {
				if (ZContacts.isDeletable()) {
					menuNode.showGroup("delete"); // No I18N
				}
				menuNode.showGroup("print"); // No I18N
				if (!zmcontact.isRootFolder()) {
					menuNode.showGroup("clearcontacts"); // No I18N
				}
				if (selectedCount > 1 && ZContacts.isMergeable()) {
                     menuNode.showGroup("merge"); // No I18N
                } else {
                     menuNode.hideGroup("merge"); // No I18N
                }
				if (selectedCount > 0 && ZContacts.isFunctionableForCurrAcc('is_archiveable')) {
					menuNode.showGroup("archive"); // No I18N
					menuNode.hideGroup("unarchive"); // No I18N
				} else if (selectedCount > 0 && ZContacts.isFunctionableForCurrAcc('is_unarchiveable')) {
					menuNode.showGroup("unarchive"); // No I18N
					menuNode.hideGroup("archive"); // No I18N
				} else {
					menuNode.hideGroup("archive"); // No I18N
					menuNode.hideGroup("unarchive"); // No I18N
				}    
				if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {//Order should not be changed
					menuNode.hideGroup("archive"); // No I18N
					menuNode.hideGroup("unarchive"); // No I18N
				}            
                if (selectedCount > 1 && ZContacts.isBulkEditable()) {
					menuNode.showGroup("bulkEdit"); // No I18N
				} else {
					menuNode.hideGroup("bulkEdit"); // No I18N
				}
			}
			if (ZContacts.isFunctionableForCurrAcc('view_add_to')) {
				menuNode.showGroup("addto"); // No I18N
			}
			menuNode.showGroup("mail"); // No I18N
			var contCount = $('.zmL.SC_cont').length;
			menuNode.hideGroup("sort"); // No I18N
			if (selectedCount == contCount) {
				menuNode.$el.find(".msi-uncheck").removeClass().addClass("msi-check zcs-check"); // No I18N
			} else if (selectedCount == 0) {
				menuNode.$el.find(".msi-check").removeClass().addClass("msi-uncheck zcs-check"); // No I18N
				menuNode.$el.find(".msi-partcheck").removeClass().addClass("msi-uncheck zcs-check"); // No I18N
				menuNode.hideGroup("delete"); // No I18N
				menuNode.hideGroup("print"); // No I18N
				menuNode.hideGroup("mail"); // No I18N
				menuNode.hideGroup("addto"); // No I18N
				menuNode.hideGroup("clearcontacts"); // No I18N
				if (!isOldSearchWorkSpace() && ZContacts.AccountConstants[ZContacts.getCurrentAccount().getViewType()].is_sortable) {
					menuNode.showGroup("sort"); // No I18N
				}
			} else {
				zmcontact.partiallyCheck();
			}
			zmcontact.restrictionBand("select_contacts"); // No I18N
			event.stopPropagation();
		},
		
		restrictionBand : function(type) {
			var center = zmsuite.getCenter()[0].$el;
			$("#zcs_top_banner").remove();
			var elem = document.createElement("div");
			elem.id = 'zcs_top_banner'; // No I18N
			elem.className = 'SC_simg'; // No I18N
			if (type == "select_contacts") {
				if (ZContacts.selectedCount > ZContacts.ZMailConstants.SELECT_LIMIT) {
					if (!$("#zcs_top_banner").length) {
						center.addClass("SC_trsh");
						elem.innerHTML = '<span class="SC_ldot">'+zmcontact.formatMessage(ZContacts.I18N.get("IAM.CONTACTS.SELECT.CONTACTS.LIMIT"), ZContacts.ZMailConstants.SELECT_LIMIT)+'</span>';
						center[0].insertBefore(elem, center[0].childNodes[2]);
					}
				} else {
					center.removeClass("SC_trsh");
					$("#zcs_top_banner").remove();
				}
			}
		},

		partiallyCheck : function() {
			var menuNode = zmsuite.getCenter()[0].getNodes()[0];
			menuNode.$el.find(".msi-uncheck").removeClass().addClass("msi-uncheck msi-partcheck zcs-check"); // No I18N
			menuNode.$el.find(".msi-check").removeClass().addClass("msi-uncheck msi-partcheck zcs-check"); // No I18N
		},

		createContactInTab : function(contactEditor) {
			if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.WORKSPACE_APP_ID)) {
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.WORKSPACE_APP_ID);
			} else {
				var _this = contactEditor;
				var contactsTabObj = {
					appname : 'Create Contact', // No I18N
					appId : ZContacts.ZMailConstants.WORKSPACE_APP_ID,
					appIcon : "msi-edit", // No I18N
					searchPlaceHolder : I18N.get('IAM.CONTACTS.SEARCH.CONTACTS'), // No I18N
					data : {
						CNodes : "3"
					}
				};
				zmsuite.setWorkSpace(contactsTabObj);
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.WORKSPACE_APP_ID);
			}
			var workspaceCenter = zmsuite.getCenter(ZContacts.ZMailConstants.WORKSPACE_APP_ID);
			var centerNodes = workspaceCenter[0].getNodes();

			centerNodes[0].push([]);
			var headerObj = {
				left : {
					leftHTML : I18N.get("IAM.CONTACTS.ADD.CONTACT")
				},
				right : []
			};

			centerNodes[1].push(headerObj);
			var headericon = {
				left : [],
				right : [ {
					actionArr : [ {
						iconList : [ "msi-close" ], // No i18N
						tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
					} ]
				} ]
			};
			centerNodes[0].push(headericon);
			centerNodes[0].setListener("click", function(ev, iconName) {
				if (iconName == "msi-close") {
					zmsuite.closeWorkspace("zm_createContact"); // No I18N
				}
			});

			var listingCenter = centerNodes[2];
			var $containerDiv = $('<div>').addClass('SC_PUcen').width('700px');
			$(contactEditor.$e).find('#zcs_name_label').removeAttr('id');
			contactEditor.rerender($containerDiv, false);
			listingCenter.$el.append($containerDiv);
			listingCenter.$el.addClass('zcs-editor-form');
			zmsuite.renderWorkSpace();
			
			var rightContainer = listingCenter.$el[0];
			
			$(rightContainer).find('#zcs-photo').find('.msi-edit').click(function(event) {
				$(rightContainer).find('#zcs-photo-input').click();
			});
			$(rightContainer).find('[name="zcs-add-photo"]').find('img').click(function(event) {
				if (event.target.id == 'zcs-photo-form') {
					return;
				}
				if (event.target.id != 'zcs-photo-input') {
					$(rightContainer).find('#zcs-photo-input').click();
				}
				event.stopPropagation();
			});
			$(rightContainer).find('#zcs-photo-input').click(function(event) {
				event.stopPropagation();
			});
			$(rightContainer).find('#zcs-photo-input').change(function(event) {
				const file = event.target.files[0];
				const reader = new FileReader();
				reader.onload = e => {
    				$(rightContainer).find('[name="zcs-add-photo"]').find('img').attr("src", e.target.result); // No I18N
				};
				reader.readAsDataURL(file);
			});
			
			$('.zcs-editor-form').off("keypress").on("keypress",function(e) {
				if (e.which == 13 && e.target.type != "textarea" && !e.shiftKey) {
					$(this).find('#zcs-save-btn')[0].click();
				}
			});
			listingCenter.$el.find('[data-field-type="first_name"]')[0].focus();
		},

		restrictClick : function(elements, isRestrict) {
			if (isRestrict) {
				elements.attr('disabled', 'disabled'); // No I18N
			} else {
				elements.removeAttr('disabled'); // No I18N
			}
		},
		
		storeAccountsFromResponse : function(resp) {
			for (var i = 0; i < resp.length; i++) {
				var acc = resp[i];
				var rootFolderId = acc.getRootFolderId();
				ZContacts.AccountsVsRootFolderMap[rootFolderId] = acc;
				if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_CONTACTS) {
					ZContacts.AccountsVsRootFolderMap[acc.getAccountId()] = rootFolderId;
				}
				ZContacts.AccountIdVsTotalCountMap[acc.getAccountId()] ? ZContacts.AccountIdVsTotalCountMap[acc.getAccountId()] += acc.getCount() : ZContacts.AccountIdVsTotalCountMap[acc.getAccountId()] = acc.getCount();
				if (!ZContacts.AccountIdVsTypeVsRootFolderMap[acc.getAccountId()]) {
					ZContacts.AccountIdVsTypeVsRootFolderMap[acc.getAccountId()] = {};
				}
				ZContacts.AccountIdVsTypeVsRootFolderMap[acc.getAccountId()][acc.getViewType()] = acc;
				// Accounts List used while exporting contacts
				ZContacts.AccountsList.push({
					id : acc.getAccountId(),
					name : acc.getName(),
					type : acc.getViewType(),
					display_text : acc.getName(),
					is_writable : acc.is_writable,
					is_contacts_exportable : acc.is_contacts_exportable,
					is_deletable : acc.is_deletable
				});
				if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT) {

					if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_CONTACTS) {
						ZContacts.personal_contacts = acc;
					}
					if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_ARCHIVED) {
						ZContacts.personal_archived = acc;
					}
					if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_INACTIVE) {
						ZContacts.personal_inactive = acc;
					}
				} else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {

					if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_CONTACTS) {
						ZContacts.org_contacts = acc;
					}
					if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_ARCHIVED) {
						ZContacts.org_archived = acc;
					}
					if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_INACTIVE) {
						ZContacts.org_inactive = acc;
					}
				}
				else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {
					if (!ZContacts.org_groups) {
						ZContacts.org_groups = [];
					}
					ZContacts.org_groups.push(acc);
				}
				ZContacts._countObj[rootFolderId] = {
						c : acc.count,
						p : -1
					};
				if(acc.categories) {
					ZContacts._childObj[rootFolderId] = {
							CH : {}
						}
					var seq = 1;
					var categories = acc.categories;
					ZContacts._parentObj[acc.getRootFolderId()] = categories;
					for(var j = 0; j < categories.length; j++) {
						var catId = categories[j].category_id.toString();
						ZContacts._countObj[catId] = {
							c : categories[j].count,
							p : rootFolderId
						};
						ZContacts._childObj[rootFolderId].CH[catId] = {
							category_id : catId,
							category_name : encodeHTML(categories[j].category_name),
							E : 0,
							HC : false,
							SE : seq
						};
						seq++;
					}
					
				}
			}
		},
		
		storeAccountsPreferencesFromResponse : function (response) {
			let result = response.contacts.org;
			ZContacts.preferenceResult = result;
		},
		
		formatMessage : function() {
			var msg = arguments[0];
			if (msg) {
				for (var i = 1; i < arguments.length; i++) {
					msg = msg.replace('{' + (i - 1) + '}', arguments[i]);
				}
			}
			return msg;
		},
		
		getJsStdUrl : function(url) {
			url = url.replace("ht"+"tps://", "");
			url = url.replace("ht"+"tp://", "");
			if(!url.startsWith("//")) {
				url = "//"+url;
			}
			return url;
		},

		getAccountName : function(contact){
			var accountName = "";
			var acc = zmcontact.getAccountByZidForType(contact.zid, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
			if (contact.is_org && acc.type == "org") {
				accountName = I18N.get("IAM.CONTACTS.ORGANIZATION");
			} else if (acc.type == "personal") {
				accountName = I18N.get("IAM.CONTACTS.PERSONAL");
			} else {
				accountName = I18N.get("IAM.CONTACTS.GROUPS");
			}
			return accountName;
		},
		
		getJsStdUrl : function(url) {
			url = url.replace("ht"+"tps://", ""); // No I18N
			url = url.replace("ht"+"tp://", ""); // No I18N
			if(!url.startsWith("//")) { // No I18N
				url = "//"+url; // No I18N
			}
			return url;
		},
		
		restoreContacts : function(zid, days) {
			zmcontact.unChkAll();
			var restoreContact = ZContacts.TrashRestoreContacts.create();
			var centerNode = zmsuite.getCenter()[0].getNodes()[2].$el;
			var loadingDiv = function(){};
			zmsuite.getCenter()[0].$el.prepend("<div id='zcs_loading'></div>");
			loadingDiv = zmComponent.loadingBand({
				container : $('#zcs_loading').get(0), // No i18N
				type : "listing" // No i18N
			});
			new URI(ZContacts.TrashRestoreContacts, zid).addPostParam("days", days).POST(restoreContact).then(function(response){ // No I18N
				loadingDiv();
				if(response.status_code == "200") {
					$('#zcs_loading').remove();
					var category = zmcontact.getCategory(ZContacts._currentCategoryId);
					zmcontact.loadFirstPage(category);
					zmcontact.refreshContactCounts();
					delete ZContacts._accountAudit[ZContacts.getCurrentAccount().getAccountId()];
					zmUtil.succErrMsg("s", ZContacts.getMessageFromResponse(response));// NO I18N
				}
			}, function(response){
				loadingDiv();
				$('#zcs_loading').remove();
				zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response));// NO I18N
			});
		},
		
		restorePopUp : function(zid) {
			var restoreDiv = {};
			restoreDiv.title = I18N.get("IAM.CONTACTS.RESTORE.CONTACTS"); // No I18N
			restoreDiv.mask = true;
			restoreDiv.buttons = [ {
				txt : I18N.get("IAM.CONTACTS.RESTORE"), // No I18N
				selected : true,
				callback : function(data) {
					var days = $('#zcs_restorePopup').find("#days").attr('data-field-type');
					zmcontact.restoreContacts(ZContacts.getCurrentAccount().getAccountId(), days);
					zmsDialog.remove();
					zmcontact.unChkAll();

				}
			}, {
				isCancel : true,
				txt : I18N.get("IAM.CANCEL"),
				callback : function() {
					zmsDialog.remove();
					$("#zcs_restorePopup").remove();
				}
			} ];

			restoreDiv.closeaction = function() {
				zmsDialog.remove();
				$("#zcs_restorePopup").remove();
			};
			restoreDiv.pos = "center"; // No I18N
			createFolElem = $("<div id='zcs_restorePopup'></div>");
			if (!$("#zcs_restorePopup").length) {
				var tags = "<div class='SC_tdtl'>";
				tags = tags + "<div class='SC_flt SC_fst' style='width: 100%; margin-top:1px; margin-bottom:1px;'><ul class='zmListReset'><li>" + I18N.get("IAM.CONTACTS.RESTORE.CONTACTS.MSG") + "</li></ul></div>";

				tags = tags + "<div class='SC_flt SC_select' style='width: 30%;' data-field-type='trash_format' id='zcs_format'><ul class='zmListReset'><li><b><input class='SC_tiput' placeholder='" + I18N.get("IAM.CONTACTS.10.DAYS") + "' id='days' name='format' data-field-type='10' style='display: inline-block;border:0px; cursor:pointer;' readonly=readonly></b></li></ul></div></div>"; // No I18N
				createFolElem.append(tags);
				$(document.body).append(createFolElem);
			}
			zmsDialog.create("zcs_restorePopup", restoreDiv); // No I18N
			$('#zcs_restorePopup').parents('.SC_pe').on("click", function(e){
				  e.stopPropagation();
				});
			$('#zcs_restorePopup').parents('.SC_Pop').on("click",function(){
				this.remove();
			});
			$('#zcs_restorePopup').find('[data-field-type="trash_format"]').click(function() {
				zmcontact.getFormatRestoreList(this)
			})
		},
		
		clearContacts : function(zid, action) {
			zmcontact.unChkAll();
			new URI(ZContacts.TrashClearContacts, zid).DELETE().then(function(response){ // No I18N
				if(response == "true") {
					delete ZContacts._accountAudit[ZContacts.getCurrentAccount().getAccountId()];
					zmUtil.succErrMsg("s", I18N.get("IAM.CONTACTS.ERROR.TRASH.SUCCESS"));// NO I18N
				} else {
					zmUtil.succErrMsg("e", I18N.get("IAM.CONTACTS.ERROR.TRASH.FAILURE"));// NO I18N
				}
			});
		},

		
		contactsAuditPopUp : function(contactId,zid) {
			zmsuite.renderCenter();
			zmcontact.unChkAll();
			var centerWrapper = zmsuite.getCenter();
			var tabNodes = centerWrapper[1].getNodes();
			var icons = [];
			icons.push({
				groupId : "contacthistory", // NO I18N
				actionArr : [ {
					iconClass : "msi-close", // NO I18N
					data : "msi-close", // NO I18N
					tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
				} ]
			});
			var prevHeader = {
				rIcons : icons
			};
			headerDOM = [ "DIV", { // NO I18N
				"attrs" : { // NO I18N
					"class" : "SC_phd" // NO I18N
				},
				"child" : [ // NO I18N
				[ "text", I18N.get("IAM.CONTACTS.HISTORY") ] // NO I18N
				]
			} ];
			prevHeader.text = headerDOM;
			tabNodes[0].push(prevHeader);
			centerWrapper[1].show();
			$(zmsuite.getCenter()[1]).ready(function() {
				$(zmsuite.getCenter()[1].$el).attr("id","zcs_audit_main"); // No I18N
				$(zmsuite.getCenter()[1].$el).css("left", "initial"); // No I18N
				$(zmsuite.getCenter()[1].$el).css("z-index", "5"); // No I18N
				$(zmsuite.getCenter()[1].$el).css("width", "440px"); // No I18N
				$(zmsuite.getCenter()[0].$el.find('.SC_mclst')).addClass("zcs_mclst");
			});

			tabNodes[0].setListener("click", function(iconName, element) { // NO I18N
				if (iconName == "msi-close") {
					centerWrapper[1].close();
					centerWrapper[1].$el.remove();
				}
			});
			if(ZContacts._audit[contactId]) {
				zmcontact.contactAuditHistory(ZContacts._audit[contactId]);
			} else {
				new URI(ZContacts.ContactsAudit, zid, contactId.toString()).GET().then(function(resp) {
					ZContacts._audit[contactId] = resp;
					zmcontact.contactAuditHistory(ZContacts._audit[contactId]);
				});
			}
			
			$(document).bind('mouseup', function (e){
				centerWrapper[1].close();
				centerWrapper[1].$el.remove();
			});

		},

		accountAuditPopUp : function(zid) {
			zmsuite.renderCenter();
			zmcontact.unChkAll();
			var centerWrapper = zmsuite.getCenter();
			var tabNodes = centerWrapper[1].getNodes();
			var icons = [];
			icons.push({
				groupId : "accountaudit", // NO I18N
				actionArr : [ {
					iconClass : "msi-close", // NO I18N
					data : "msi-close", // NO I18N
					tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
				} ]
			});
			var prevHeader = {
				rIcons : icons
			};
			headerDOM = [ "DIV", { // NO I18N
				"attrs" : { // NO I18N
					"class" : "SC_phd" // NO I18N
				},
				"child" : [ // NO I18N
				[ "text", I18N.get("IAM.CONTACTS.ACCOUNT.HISTORY") ] // NO I18N
				]
			} ];
			prevHeader.text = headerDOM;
			tabNodes[0].push(prevHeader);
			centerWrapper[1].show();
			$(zmsuite.getCenter()[1]).ready(function() {
				$(zmsuite.getCenter()[1].$el).attr("id","zcs_account_audit_main"); // No I18N
				$(zmsuite.getCenter()[1].$el).css("left", "initial"); // No I18N
				$(zmsuite.getCenter()[1].$el).css("z-index", "5"); // No I18N
				$(zmsuite.getCenter()[1].$el).css("width", "440px"); // No I18N
				$(zmsuite.getCenter()[0].$el.find('.SC_mclst')).addClass("zcs_mclst");
			});

			tabNodes[0].setListener("click", function(iconName, element) { // NO I18N
				if (iconName == "msi-close") {
					centerWrapper[1].close();
					centerWrapper[1].$el.remove();
				}
			});

			if(ZContacts._accountAudit[zid]) {
				zmcontact.accountAuditHistory(ZContacts._accountAudit[zid]);
			} else {
				new URI(ZContacts.AccountAudit, zid).GET().then(function(resp) {
					if(resp.status_code == "200") {
						ZContacts._accountAudit[zid] = resp.audits;
						zmcontact.accountAuditHistory(ZContacts._accountAudit[zid]);
					}
				}, function(resp) {
					centerWrapper[1].close();
					centerWrapper[1].$el.remove();
					zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(resp)); // No I18N
				});
			}

			$(document).bind('mouseup', function(e) {
				if (!e.target.closest("#zcs_account_audit_main")) {
					centerWrapper[1].close();
					centerWrapper[1].$el.remove();
				}
			});
				
		},
		
		accountAuditHistory : function(resp){
			var resp_length = Object.keys(resp).length;
			var right_container = $(zmsuite.getCenter()[1].$el);
			var account_history = new ZContacts.StringBuilder();
			account_history.append('<div class="zcs_Audit_validity">'+I18N.get("IAM.CONTACTS.AUDIT.VALIDITY")+'</div>'); //No I18N
			for (var i=0; i< resp_length; i++) {
				var dateFormat	= resp[i].date;
				var timeFormat = resp[i].time;
				account_history.append('<div class="zcs_cAudit_main">'); //No I18N
				if(resp[i].is_not_modified){
					account_history.append('<div class="icon-edit zcs_audit_not_edit"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_message zcs_audit_not_edit_msg">'+encodeHTML(resp[i].message)+'</div>'); //No I18N
				} else if(resp[i].is_imported){
					account_history.append('<div class="icon-import zcs_cAudit_img" style="color: #56CC66;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.ACCOUNT.IMPORT")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_deleted) {
					account_history.append('<div class="icon-delete zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.ACCOUNT.DELETED")+'</div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_date">'+dateFormat+'</div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_message">'+ encodeHTML(resp[i].message) +'</div>'); //No I18N
					if(resp[i].names) {
						for(var j=0; j < resp[i].names.length; j++){
							account_history.append('<div class="zcs_cAudit_more_details"><span style="margin: 5px;">-</span>' + zmcontact.formatMessage(I18N.get("IAM.CONTACTS.ACCOUNT.DELETED.LIST"),resp[i].names[j])+'</div>');
						}
					}
					account_history.append('<div class="zcs_cAudit_time" style="margin-top: 10px;">'+timeFormat+'</div>'); //No I18N
				} else if(resp[i].is_exported) {
					account_history.append('<div class="icon-export zcs_cAudit_img" style="color: #F3AA2E;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.ACCOUNT.EXPORTED")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_auto_clean){
					account_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.ACCOUNT.CLEAN.DUPLICATE")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_reset){
					account_history.append('<div class="icon-delete zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.ACCOUNT.RESET")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_restored){
					account_history.append('<div class="icon-import zcs_cAudit_img" style="color: #56CC66;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.ACCOUNT.RESTORE")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_cleared){
					account_history.append('<div class="icon-delete zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.ACCOUNT.TRASH.CLEAR")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_created) {
					account_history.append('<div class="icon-new zcs_cAudit_img" style="color: #56CC66;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.CREATED.HEADER")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_category_created) {
					account_history.append('<div class="icon-new zcs_cAudit_img" style="color: #56CC66;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.CATEGORY.CREATED.HEADER")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_category_updated) {
					account_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.CATEGORY.UPDATED.HEADER")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if(resp[i].is_category_deleted) {
					account_history.append('<div class="icon-delete zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">'+I18N.get("IAM.CONTACTS.CATEGORY.DELETED.HEADER")+'</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if (resp[i].is_email_visibility_changed) {
					account_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.ORG.SETTINGS.EMAIL.VISIBILITY.UPDATED") + '</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if (resp[i].is_org_contacts_visibility_changed) {
					account_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.ORG.SETTINGS.ORG.CONTACTS.VISIBILITY.UPDATED") + '</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				} else if (resp[i].is_export_permission_changed) {
					account_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					account_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.ORG.SETTINGS.EXPORT.PERMISSION.UPDATED") + '</div>'); //No I18N
					account_history = zmcontact.ContactAuditCommonMessage(account_history, resp[i]);
				}
				account_history.append('</div>'); //No I18N
			}
			$(right_container).find(".SC_Twpr").html(account_history.toString());
		},
		
		contactAuditHistory : function(resp){
			var resp_length = Object.keys(resp).length;
			var right_container = $(zmsuite.getCenter()[1].$el);
			var contact_history = new ZContacts.StringBuilder();
			contact_history.append('<div class="zcs_Audit_validity">'+I18N.get("IAM.CONTACTS.AUDIT.VALIDITY")+'</div>'); //No I18N
			for (var i = resp_length; i--;) {
				contact_history.append('<div class="zcs_cAudit_main">'); //No I18N
				if (resp[i].is_not_modified) {
					contact_history.append('<div class="icon-edit zcs_audit_not_edit"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_message zcs_audit_not_edit_msg">' + encodeHTML(resp[i].message) + '</div>'); //No I18N
				} else if (resp[i].is_added_to_category) {
					contact_history.append('<div class="icon-category zcs_cAudit_img" style="color: #56CC66;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.ADD.CATEGORY") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_removed_from_category) {
					contact_history.append('<div class="icon-category zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.DELETE.CATEGORY") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_created) {
					contact_history.append('<div class="icon-new zcs_cAudit_img"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.CREATED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_photo_uploaded) {
					contact_history.append('<div class="icon-profile zcs_cAudit_img" style="color: #56CC66;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.PHOTO.UPLOADED") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_photo_updated) {
					contact_history.append('<div class="icon-profile zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.PHOTO.UPDATED") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_photo_deleted) {
					contact_history.append('<div class="icon-profile zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.PHOTO.DELETED") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_email_added) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.EMAIL.ADDED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_email_deleted) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.EMAIL.REMOVED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_chat_invited) {
					contact_history.append('<div class="icon-chat zcs_cAudit_img" style="color: #00B1FF;" ></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.CHAT.INVITE.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_chat_accepted) {
					contact_history.append('<div class="icon-chat zcs_cAudit_img" style="color: #56CC66;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.CHAT.ACCEPTED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_chat_rejected) {
					contact_history.append('<div class="icon-chat zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.CHAT.REJECTED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_chat_deleted) {
					contact_history.append('<div class="icon-chat zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.AUDIT.CHAT.DELETED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_updated) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.EDITED") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_inactivated) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.INACTIVATED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_activated) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.ACTIVATED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_archived) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.ARCHIVED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_unarchived) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.UNARCHIVED.HEADER") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_note_added) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.NOTES") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_url_added) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.URLS") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_phone_added) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.BASIC.PHONE") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_address_added) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #00B1FF;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.WORK.ADDRESS") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_note_removed) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.NOTES") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_url_removed) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.URLS") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_phone_removed) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.BASIC.PHONE") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				} else if (resp[i].is_address_removed) {
					contact_history.append('<div class="icon-edit zcs_cAudit_img" style="color: #FF6C6C;"></div>'); //No I18N
					contact_history.append('<div class="zcs_cAudit_header">' + I18N.get("IAM.CONTACTS.WORK.ADDRESS") + '</div>'); //No I18N
					contact_history = zmcontact.ContactAuditCommonMessage(contact_history, resp[i]);
				}
				contact_history.append('</div>');
			}
			$(right_container).find(".SC_Twpr").html(contact_history.toString());
		},
		
		ContactAuditCommonMessage: function(html, resp) {
			html.append('<div class="zcs_cAudit_date">' + resp.date + '</div>'); //No I18N
			if (resp.message && resp.message != "") {
				html.append('<div class="zcs_cAudit_message">' + encodeHTML(resp.message) + '</div>'); //No I18N
			}
			if (resp.messages) {
				for (const message of resp.messages) {
					html.append('<div class="zcs_cAudit_more_details"><span style="margin: 5px;">-</span>' + message + '</div>'); //No I18N
				}
			}
			html.append('<div class="zcs_cAudit_time">' + resp.time + '</div>'); //No I18N
			return html;
		},
		
		showCustomSearchPage: function(contactIds, accountId) {
			var searchAppObj = {
				appname: 'Search', // No I18N
				appId: ZContacts.ZMailConstants.CUSTOM_SEARCH_WORKSPACE_APP_ID,
				appIcon: "msi-search", // No I18N
				searchPlaceHolder: I18N.get("IAM.CONTACTS.SEARCH.CONTACTS"), // No I18N
				data: {
					CNodes: "3"
				}
			};
			zmsuite.createWorkspace(searchAppObj);
			zmsuite.showWorkSpace(ZContacts.ZMailConstants.CUSTOM_SEARCH_WORKSPACE_APP_ID);
			var uri = new URI(ZContacts.Contacts, accountId, contactIds).include("emails").include("phones").include("address").include("urls").include("categories");// No I18N
			if (contactIds.length > 1) {
				uri.isInstance = false;
				uri.GETS().then(function(contacts) {
					zmcontact.contactsList(contacts, false, false);
				});
			} else {
				uri.GET().then(function(contacts) {
					zmcontact.contactsList([contacts], false, false);
				});
			}
		}
	};
	
	var getCurrentSearchTab = function(currentTab){
		if(zmail.forContactsApp && currentTab == ZContacts.ZMailConstants.SEARCH_WORKSPACE_APP_ID){
			return currentTab;
		} else if(ZContacts.Utils.isValidSearchTab(currentTab)){
			return ZContacts.ZMailConstants.GLOBAL_SEARCH;
		} else {
			return currentTab;
		}
	};
	
	var isOldSearchWorkSpace = function(tab) {
		if(!tab) {
			tab = zmTab.currentTab;
		}
		if(zmail.forContactsApp) {
			return tab == ZContacts.ZMailConstants.SEARCH_WORKSPACE_APP_ID || tab == ZContacts.ZMailConstants.CUSTOM_SEARCH_WORKSPACE_APP_ID;
		}
		return false;
	};
	
	var isNewSearchWorkSpace = function(tab) {
		if(!tab) {
			tab = zmTab.currentTab;
		}
		if(isOldSearchWorkSpace(tab)) {
			return false;
		}
		return isSearchWorkSpace(tab);
	};
	
	var getSynchronizedText = function(value, limit) {
		if (!value || value.length <= limit) {
			return value;
		}
		return value.substring(0, limit) + "...";
	}
	
	var getHighlightedName = function(fname, lname, sortBy) {
		switch (sortBy) {
			case "first_name":
				if (lname) {
					return "<span class='zcs-sortby-column-element'>" + fname + "</span>" + " " + lname;
				} else {
					return "<span class='zcs-sortby-column-element'>" + fname + "</span>"
				}
			case "last_name":
				if (lname) {
					return fname + " " + "<span class='zcs-sortby-column-element'>" + lname + "</span>";
				} else {
					return "<span class='zcs-sortby-column-element'>" + fname + "</span>";
				}
		}
	}
	
	var isSearchWorkSpace = function(tab) {
		if(!tab) {
			tab = zmTab.currentTab;
		}
		return ZContacts.Constants.REGEX.ZM_SRCH_TAB_PATTERN.test(tab);
	};
	
	var isCleanWorkSpace = function(tab) {
		if(!tab) {
			tab = zmTab.currentTab;
		}
		return tab == ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID;
	}
	
	var isPrintWorkSpace = function(tab) {
		if(!tab) {
			tab = zmTab.currentTab;
		}
		return tab == ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID;
	}
	
	var isImportWorkSpace = function(tab) {
		if(!tab) {
			tab = zmTab.currentTab;
		}
		return tab == ZContacts.ZMailConstants.IMPORT_APP_ID;
	}
	
	var isContactDetailWorkSpace = function(tab) {
		if(!tab) {
			tab = zmTab.currentTab;
		}
		return tab == ZContacts.ZMailConstants.CONTACTS_APP_ID;
	}

	var loadZCon = function(msMode) {
		if (zmail.forContactsApp && !zmail.fromNewMailFrameWork) {
			zmcontact.topbarHelpDoc();
		}
		
		if (zmsuite.isWorkspaceAvailable("zm_Contacts")) {
			var curAppObj = zmsuite.getAppObj("zm_Contacts"); // No I18N
			zmTab.setTabForApp(curAppObj.obj);
			zmsuite.showApp("zm_Contacts"); // No i18N

			zcon.contactLeft.setListener("click", function(data) {// No I18N
				zmcontact.bindLeftActions(data);
			});
			zcon.contactLeft.setListener("contextmenu", function(data) { // No I18N
				zmcontact.bindLeftActions(data);
			});
			try {
				zcon.contactLeft.getNodes()[0].getLayer("PERSONAL").setChildToggle(function(data) { // No I18N
				});	
				zcon.contactLeft.getNodes()[0].getLayer("ORGANIZATION").setChildToggle(function(data) { // No I18N
				});
				zcon.contactLeft.getNodes()[0].getLayer("ORG_GROUPS").setChildToggle(function(data) { // No I18N
				});
			} catch (e) {

			}
		} else {
			zmcontact.initContactSuite();
		}
		document.addEventListener("click", function(event) {
			if (event.target.id === "cntPhoto" || event.target.classList.contains("zcs_photo")) {
				zmcontact.closeViewPhotoPopup(event);
			}
			if (event.target.id === "cntPhotoClose") {
				zmcontact.closeModalOnly(event);
			}
		});
		document.addEventListener("keydown", function(event) {
			if (event.key === "Escape") {
				zmcontact.closeViewPhotoPopup(event);
			}
		});
	};

	doAllowClick = function(element) {
		if (element.attr('disabled') == "disabled") {
			return false;
		}
		return true;
	};
	
	showPassWord = function(t) {
		if(t.className == "msi-check") {
			t.className = "msi-uncheck";
			$('#zcs_export_password_div').hide();
			$("#zcs_export_password_div").find("input").val('');
		} else {
			t.className = "msi-check";
			$('#zcs_export_password_div').show();
		}
	};
	
	var logout = function(){
		var server_url = ZContacts.meta.serviceInfo.contacts_server_url;
		var f = $('<form name="logoutForm" method="POST" action="'+server_url+'/logout"><input type="hidden" name="'+ZContacts.meta.serviceInfo.csrf_param_name+'" value="'+ZContacts.Cookie.getCSRFValue()+'"/></form>');
		$('body').append(f);
		f.submit();
	};
	

	$.subscribe("contacts/metaDataLoaded", function(ev, obj) { // No i18N
		var metaJson = obj.data;
		ZContacts.meta = metaJson;
		ZContacts.serviceInfo = metaJson.serviceInfo;
		new URI(ZContacts.Accounts).include("user.categories").include("org.categories").include("contacts.total_count").GETS().then(function(resp) { // No I18N
			ZContacts.AccountsList = [];
			zmcontact.storeAccountsFromResponse(resp);
			ZContacts.setAccount(ZContacts.personal_contacts);
			ZContacts.loadI18N = $.get(ZContacts.getContextPath() + '/new/jsp/i18n.jsp?' + metaJson.i18n_query_param);
			ZContacts.loadI18N.then(function(data) {
			if(zmail.globalI18N.companyName && zmail.globalI18N.companyName != ZContacts.meta.rebrand_name){
				$.each(data, function(key, value) {
					value = value.replace(new RegExp("\\b"+ZContacts.meta.rebrand_name+"\\b", "gi"), zmail.globalI18N.companyName);
					data[key] = value;
				
				});
			}
			
			I18N.load(data);
			$.publish("contacts/i18NLoaded", { // NO I18N
                    data: data
            });
			
			if ((zmail.forContactsApp && obj.showApp) || window.location.hash == ZContacts.ZMailConstants.CONTACTS_HAS_TAG) {
				loadZCon();
				ZContacts.meta.isLoaded = true;
				$("#ms_load").remove();
				typeof CrmPlusImpl !== 'undefined' && CrmPlusImpl.trigger("UIReady"); //No I18N
			}

			if (ZContacts.meta.isLoaded == false) {
				$.publish("/contacts/load", {}); //No I18N
			}
		});
	});
	
	
	// fetching preferences for settings page
	new ZContacts.URI(ZContacts.Preferences, "org").GET().then((response) => { // No I18N
		zmcontact.storeAccountsPreferencesFromResponse(response);
	}, (response) => {
		if (response.status_code == 403) {
			ZContacts.preferenceResult = "false";
		}
	});
	
		
	if(ZContacts.meta.user.sort_by==4) {
		ZContacts.sortBy = "last_name"; // No I18N
	} else {
		ZContacts.sortBy = "first_name"; // No I18N
	}
});

	$.subscribe("/contacts/load", function() { // NO I18N
		if (ZContacts.personal_contacts) {
			ZContacts.loadI18N.then(function() {
				ZContacts.meta.isLoaded = true;
				loadZCon();
			});
		} else {
			if(zmApp.currentApp == "cn") {
				ZContacts.meta.isLoaded = false;
			}
		}
	});
	
	$.subscribe("/contacts/logout", function() { // NO I18N
		logout();
	});

	return initObj;
})();

$(document).on("focusout",".SC_contApp #ztb-container #ztb-search-field", function(t){
	removeSearchAutoList(true);
});

function removeSearchAutoList(doClearTimer) {
	if (doClearTimer) {
		clearTimeout(searchMoreTimer);
	}
	$('#zc_search_auto_list').remove();
}

function search(t, e) {
	clearTimeout(searchMoreTimer);
	var contactId = $(t).attr("contact_id");
	var contact = ZContacts.Contacts.create(staticObj[contactId]);
	removeSearchAutoList(true);
	zmsuite.showWorkSpace(ZContacts.ZMailConstants.CONTACTS_APP_ID);
	zmcontact.loadContactDetails(contact.get("contact_id"), contact.get("zid"));
	zmsuite.getCenter()[0].$el.find(".zmSLst").removeClass("zmSLst");
	zmsuite.getCenter()[0].$el.find(".SC_conRgt").addClass("zmSLst");
	setTimeout(function() {
		zmsuite.getCenter()[0].$el.find(".SC_conRgt").removeClass("zmSLst");
	}, 50);
	event.stopPropagation();
}
