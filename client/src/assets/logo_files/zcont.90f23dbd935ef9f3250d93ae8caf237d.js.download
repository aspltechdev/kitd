//$Id:$

ZContacts.selectedCount = 0;
ZContacts.deletedCount = 0;
ZContacts.newSearchDeletedCount = 0;
ZContacts._countObj = {};  // this will have categories including rootFolder(Personal/Org/Group) contacts count with parent reference
ZContacts._childObj = {};  // this object will have categoryId as key and hold corresponding category as value
ZContacts._parentObj = {}; // this array will hold categories for individual account
ZContacts._currentCategoryId; // this defines current category contacts are showing
ZContacts._prevContact;
ZContacts._authenticatedMailId;
ZContacts._sync;
ZContacts._syncedTime;
ZContacts._enableStatus;
ZContacts._audit = {};
ZContacts._accountAudit = {};
ZContacts.isRemoved = false;

// this is a map containing zid Vs rootFolderId and rootFolderId Vs account
ZContacts.AccountsVsRootFolderMap = {};
ZContacts.AccountIdVsTotalCountMap = {};
ZContacts.AccountIdVsTypeVsRootFolderMap = {};
/*
 * Root Folder means Personal or Org or Group Folder rootFolderId is unique id which represents respective Root Folder Account means Personal or Org or Group
 * 
 */
var printResponse = {};
var checkValues = {};
var headerValue = {};

var searchMoreTimer;

ZContacts.setAccount = function(acc) {
	this.acc = acc;
};

ZContacts.getMessageFromResponse = function(json) {
	if (json.message) {
		var value =  ZContacts.checkCompanyName(json.message);
		return value;
	} else if (json.errors && json.errors.length && json.errors[0].message) {
		var value =  ZContacts.checkCompanyName(json.errors[0].message);
		return value;
	}
	return ZContacts.I18N.get("IAM.ERROR.GENERAL");
};

ZContacts.checkCompanyName = function(value){
	if(zmail.globalI18N.companyName && zmail.globalI18N.companyName != ZContacts.meta.rebrand_name){
		value =  value.replace(new RegExp("\\b"+ZContacts.meta.rebrand_name+"\\b", "gi"), zmail.globalI18N.companyName);
	}
	return value;
};

var zmcontact = (function() {
	var URI = ZContacts.URI;
	var encodeHTML = ZContacts.Utils.encodeHTML;
	var I18N = ZContacts.I18N;
	var ContactStatus = ZContacts.Constants.ChatStatus;
    
	var bulkEdits = {
		I18ValueKeyMap: { "last_name": "IAM.CONTACTS.LASTNAME", "middle_name": "IAM.CONTACTS.MIDDLENAME", "nick_name": "IAM.CONTACTS.BASIC.NNAME", "company": "IAM.CONTACTS.COMPANY", "designation": "IAM.CONTACTS.DESIGNATION" }, //No I18N
		selectedBulkEditfields: [],
		selecter: 1,
		rowCount: 1
	}
					
	var headerObj = {
		list : {
			left : {
				leftHTML : ""
			},
			right : []
		}
	};

	var zcon = {};
	var listingMetaData = {
		page : 1,
		noOfResults : 50,
		isLoading : false
	};
	
	var listingPrintMetaData = {
		isLoading : false,
		totalCount : 0,
		fetchedCount : 0
	}
	
	var existingContactMetaData = {
		page : 0,
		noOfResults : 50,
		isLoading : false,
		hasMore : true,
		contacts : []
	}
	
	var initObj = {
		
		
		initContactSuite: function() {
			zmcontact.init();
			zmcontact.constructView();
			zcon = {
				// Left Pane Obj
				contactLeft: zmsuite.getLeft(),
				// Center Pane Obj
				contactsCenter: zmsuite.getCenter()
			};
			// Load Personal Contacts by default
			zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts.getCurrentAccount().getRootFolderId()));
			if (ZContacts.personal_contacts) {
				zcon.contactLeft.getNodes()[0].getLayer("PERSONAL").setChildToggle(function(data) { // No I18N
				});
			}
			if (ZContacts.org_contacts) {
				zcon.contactLeft.getNodes()[0].getLayer("ORGANIZATION").setChildToggle(function(data) { // No I18N
				});
			}
			
			// lazy appending groups and group's categories

			new URI(ZContacts.Accounts).include("groups.categories").include("contacts.total_count").GETS().then(function(resp) { // No I18N
				zmcontact.storeAccountsFromResponse(resp);
				if (ZContacts.org_groups && ZContacts.org_groups.length) {
					zmcontact.appendAccountLayer(ZContacts.org_groups, "ORG_GROUPS"); // No I18N
					zcon.contactLeft.render();
					if (ZContacts.personal_contacts) {
						zcon.contactLeft.getNodes()[0].getLayer("PERSONAL").setChildToggle(function(data) { // No I18N
						});
					}
					if (ZContacts.org_contacts) {
						zcon.contactLeft.getNodes()[0].getLayer("ORGANIZATION").setChildToggle(function(data) { // No I18N
						});
					}
					zcon.contactLeft.getNodes()[0].getLayer("ORG_GROUPS").setChildToggle(function(data) { // No I18N
					});
				}
			});
		},

		// Bulk Action menu
		getActionMenuList : function() {
			return [ {
				groupId : "select", // No i18N
				actionArr : [ {
					iconList : [ "msi-uncheck zcs-check" ],// No i18N
					tooltip : I18N.get('IAM.CONTACTS.SELECTALL')
				} ]
			}, {
				groupId : "sort", // No I18N
				actionArr : [ {
					iconList : [ "msi-sort" ], // No I18N
					tooltip : I18N.get('IAM.CONTACTS.SORT.BY')
				// No I18N
				} ]
			}, {
				groupId : "archive", // No i18N
				actionArr : [ {
					iconList : [ "msi-archive" ], // No I18N
					tooltip : I18N.get('IAM.CONTACTS.ARCHIVE')
				} ]
			}, {
				groupId : "unarchive", // No i18N
				actionArr : [ {
					iconList : [ "msi-unarchive" ], // No I18N
					tooltip : I18N.get('IAM.CONTACTS.UNARCHIVE')
				} ]
			}, {
				groupId : "delete", // No i18N
				actionArr : [ {
					iconList : [ "msi-trash" ], // No I18N
					tooltip : I18N.get('IAM.DELETE')
				} ]
			}, {
				groupId : "addto", // No i18N
				actionArr : [ {
					iconList : [ "msi-folder" ], // No I18N
					dropAction : true,
					tooltip : I18N.get('IAM.CONTACTS.ADD.TO')
				} ]
			}, {
				groupId : "clearcontacts", // No i18N
				actionArr : [ {
					iconList : [ "msi-clearContacts" ], // No I18N
					dropAction : true,
					tooltip : I18N.get('IAM.CONTACTS.CLEAR.CONTACTS')
				} ]
			}, {
				groupId : "merge", // No I18N
				actionArr : [ {
					iconList : [ "msi-contactMerge" ], // No I18N
					tooltip : I18N.get("IAM.CONTACTS.MERGE")
				} ]
			}, {
				groupId : "bulkEdit", // No I18N
				actionArr : [ {
					iconList : [ "msi-edit" ], // No I18N
					tooltip : I18N.get('IAM.CONTACTS.BULK.EDIT')
				} ]
			}, {
				groupId : "mail", // No I18N
				actionArr : [ {
					iconList : [ "msi-mail" ], // No I18N
					tooltip : I18N.get('IAM.CONTACTS.SEND.MAIL')
				// No I18N
				} ]
			},{
				groupId : "print", // No I18N
				actionArr : [ {
					iconList : [ "msi-print" ], // No I18N
					tooltip : I18N.get('IAM.CONTACTS.PRINT')
				// No I18N
				} ]
			}, {
				groupId : "addcontact", // No i18N
				actionArr : [ {
					iconList : [ "msi-plus" ], // No i18N
					tooltip : I18N.get('IAM.CONTACTS.ADD.CONTACT') // No i18N
				} ]
			}, {
				groupId : "copycontact", // No I18N
				actionArr : [ {
					iconList : [ "zci-folder_move" ], // No I18N
					tooltip : I18N.get('IAM.CONTACTS.COPY.CONTACT') // No i18N
				// No I18N
				} ]
			}, {
				groupId : "action", // No i18N
				actionArr : [ {
					iconList : [ "msi-action" ], // No i18N
					dropAction : true,
					tooltip : I18N.get('IAM.CONTACTS.MORE.ACTIONS'), // No i18N
					separator : true
				} ]
			}];
		},
		/**
		 * Get Category obj in Left Pane using CategoryId
		 */
		getCategory : function(categoryId) {
			var node = ZContacts._countObj[categoryId];
			if(!node) {
				return undefined;
			}
			var acc = ZContacts.AccountsVsRootFolderMap[categoryId];
			if (node.p == -1) {
				var index = 0;
				if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT) {
					index = 0;
				} else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
					index = 1;
				} else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {
					if (ZContacts.org_contacts) {
						index = 2;
					} else { // if org contacts not exist. org groups will be in 2nd layer
						index = 1;
					}
				}
				var category;
				var data = zcon.contactLeft.getNodes(0)[0].layerArr[index].listObject[categoryId];
				if(data) {
					category = {
							category_id : data.category_id,
							category_name : data.category_name,
							count : ZContacts._countObj[categoryId].c
						};
				} else {
					acc = zmcontact.getMyAccountForType(ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
					category = {
							category_id : acc.getRootFolderId(),
							category_name : acc.getName(),
							count : acc.getCount()
						};
				}
				return ZContacts.Categories.create(category);
			} else {
				var data = ZContacts._childObj[node.p].CH[categoryId];
				var category = {
					category_id : data.category_id,
					category_name : data.category_name,
					count : ZContacts._countObj[categoryId].c
				};
				return ZContacts.Categories.create(category);
			}
		},

		getRootFolderId : function(categoryId) {
			if (!categoryId) {
				categoryId = ZContacts._currentCategoryId;
			}
			return ZContacts._countObj[categoryId].p != -1 ? ZContacts._countObj[categoryId].p : categoryId;
		},
		
		getAccountByZidForType : function(zid, type) {
			return ZContacts.AccountIdVsTypeVsRootFolderMap[zid][type];
		},
		
		getMyAccountForType : function(type) {
			zid = ZContacts.getCurrentAccount().getAccountId();
			return ZContacts.AccountIdVsTypeVsRootFolderMap[zid][type];
		},
		
		isRootFolder : function(catId) {
			if (!catId) {
				catId = ZContacts._currentCategoryId;
			}
			var acc=ZContacts.AccountsVsRootFolderMap[catId];
			if (acc &&(acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_CONTACTS || acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_ARCHIVED || acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_INACTIVE)) {
				return true;
			}
			return false;
		},
		
		isInOrgGroup : function(catId) {
			if (!catId) {
				catId = ZContacts._currentCategoryId;
			}
			var acc=ZContacts.AccountsVsRootFolderMap[catId];
			return acc.getAccountType() == ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT;
		},

		loadCategoryContacts : function(categoryId) {
			if (categoryId != ZContacts._currentCategoryId) {
				$('.SC_tre.Stre').removeClass("Stre");
				$('#' + categoryId).addClass("Stre");
				var category = zmcontact.getCategory(categoryId);
				zmcontact.loadFirstPage(category);
				zmcontact.unChkAll();
			}
		},

		updateHeaderBand : function(category, count, isUpdate) {
			var htm;
			if(isPrintWorkSpace()){
				htm = I18N.get('IAM.CONTACTS.PRINT');
			} else if (isOldSearchWorkSpace() || isCleanWorkSpace()) {
				htm = encodeHTML(category.category_name);
				var cnt = category.count;
				if (cnt == 1) { // NO I18N
					htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.SINGLE.CONTACT"), cnt) + ' </span>';
				} else if (cnt > 1) { // NO I18N
					htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.MULTIPLE.CONATCT"), cnt) + '</span>';
				}
				headerObj.list.left.leftHTML = htm;
				var headerNode = zmsuite.getWorkSpace(ZContacts.ZMailConstants.CONTACTS_APP_ID)[0].getNodes()[1];
				headerNode.push(headerObj.list);
				headerNode.paint();
				if (isOldSearchWorkSpace()) {
					htm = I18N.get('IAM.CONTACTS.SEARCH.RESULTS');
				} else if (isCleanWorkSpace()) {
					htm = I18N.get('IAM.CONTACTS.CLEAN.DUPLICATES');
				}
			} else if (isImportWorkSpace()){
				htm = I18N.get("IAM.CONTACTS.IMPORT.CONTACTS");
			} else {
				var htm = encodeHTML(category.category_name);
				if (count && (ZContacts.selectedCount + count) > 0) { // Selected Counts
					if (isUpdate) {
						ZContacts.selectedCount = ZContacts.selectedCount + count;
					} else {
						ZContacts.selectedCount = count;
					}
					if (ZContacts.selectedCount > 1) {
						htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get('IAM.CONTACTS.OF.SELECTED'), ZContacts.selectedCount) + '</span>';
					} else {
						htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get('IAM.CONTACTS.SELECTED'), ZContacts.selectedCount) + '</span>';
					}
				} else { // Contacts Count
					count = category.count;
					if(isNewSearchWorkSpace()) {
						if (count > 50 || count == 50 && count != 0) { // NO I18N
							if(category.has_more) {
								htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.MULTIPLE.CONATCT"), count+"+") + ' </span>';
							} else {
								htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.MULTIPLE.CONATCT"), count) + ' </span>';
							}
						} else if (count == 1){
							htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.SINGLE.CONTACT"), count) + ' </span>';
						}else if (count < 50 && count != 0) { // NO I18N
							htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.MULTIPLE.CONATCT"), count) + '</span>';
						}
					} else {
						if (count == 1) { // NO I18N
							htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.SINGLE.CONTACT"), count) + ' </span>';
						} else if (count > 1) { // NO I18N
							htm += '<span class="sum"> ' + zmcontact.formatMessage(I18N.get("IAM.MULTIPLE.CONATCT"), count) + '</span>';
						}
					}
					ZContacts.selectedCount = 0;
				}
			}
			headerObj.list.left.leftHTML = htm;
			var headerNode = zmsuite.getCenter()[0].getNodes()[1];
			headerNode.push(headerObj.list);
			headerNode.paint();
		},

		loadFirstPage : function(category) {
			zmsuite.showExistingApp("zm_Contacts"); // No I18N
			var div = "<div class='SC_conLft'></div><div class='SC_conRgt'><div class='zcs-cont-details'></div><div class='zcs-multiCont-edit'></div><div class='zcs-cont-edit zcs-editor-form'></div></div>";
			$(zcon.contactsCenter.listElem).html(div);
			listingMetaData.page = 1;
			zmcontact._loadContacts(category);
			zmcontact.unChkAll();
		},

		loadSearchFirstPage : function(category) {
			zmcontact.unChkAll();
			zmcontact._loadContacts(category);
		},

		loadNextPage : function(category) {
			if (listingMetaData.hasMore) {
				listingMetaData.page++;
				zmcontact._loadContacts(category);
			}
		},

		_loadContacts : function(category) {
			ZContacts._currentCategoryId = category.category_id;
			ZContacts._prevContact = undefined;
			ZContacts.setAccount(zmcontact.getAccByCategoryId(category.category_id));
			$('.msi-uncheck.zcs-check').parents("li").attr("style", "display: block;");
			var uri = new URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId()).include("emails").setSortBy(ZContacts.sortBy, true); // No I18N
			uri.setPagination(listingMetaData.page, listingMetaData.noOfResults);
			if (ZContacts.deletedCount > 0) {
				uri.prependContacts(ZContacts.deletedCount); // No I18N
			}
			if (ZContacts.getCurrentAccount().getViewType() == ZContacts.ZMailConstants.VIEW_ID_ARCHIVED) {
				uri.addFilter("type", "archived"); // No I18N
			}
			if (ZContacts.getCurrentAccount().getViewType() == ZContacts.ZMailConstants.VIEW_ID_INACTIVE) {
				uri.addFilter("type", "inactive"); // No I18N
			}
			var categoryId = category.get('category_id');
			if (!zmcontact.isRootFolder(categoryId)) {
				uri.addFilter("categories", categoryId); // No I18N
			}
			$('.SC_tre.Stre').removeClass("Stre");
			$('#' + categoryId).addClass("Stre");
			var isNextPage = listingMetaData.page != 1;
			listingMetaData.isLoading = true;
			var destroyLoadingDiv = zmComponent.loadingBand({
				container : $(zmsuite.getCenter()[0].getNodes()[2].$el[0]).find('.SC_conLft').get(0), // No i18N
				type : "pagination" // No i18N
			});
			uri.GETS().then(function(json) {
				destroyLoadingDiv();
				listingMetaData.isLoading = false;
				listingMetaData.hasMore = uri.apiResponse.has_more;
				zmcontact.contactsList(json, isNextPage);
				ZContacts.deletedCount = 0;
				zmsuite.getCenter()[0].$el.find('[data-field-type=zcont-import-button]').on("click", function(event){
					zmcontact.zconImportDetails();
				});
				zmsuite.getCenter()[0].$el.find('[data-field-type=zcont-quick-create-button]').on("click", function(event){
					zmcontact.showQuickCreate()
				});
				
			}, function(json) {
				destroyLoadingDiv();
				listingMetaData.isLoading = false;
				if (json.status_code === ZContacts.Constants.StatusCode.NOT_FOUND) {
					ZContacts.deletedCount = 0;
					zmcontact.contactsList(null);
				}
			});

			if(zmail.Search && zmail.newSearch){
				ZContactsContext = ZContacts.newSearchContext;
				var contactsURI = new ZContacts.URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId()).setSortBy("usage_count", false).include("emails").include("phones"); // NO I18N
				if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT) {
					contactsURI.includes.push("org"); //NO I18N
				}
				var defaultParams = (contactsURI.getParams() ? ('?' +contactsURI.getParams()) : "");
				ZContactsContext.url =  contactsURI.requestURI + defaultParams; zmail.Search.registerContext(ZContactsContext);
			}
		},

		init : function() {
			var contactsAppObj = {
				appname : I18N.get("IAM.CONTACTS"), // No I18N
				appId : ZContacts.ZMailConstants.CONTACTS_APP_ID,
				appIcon : "msi-contacts", // No I18N
				searchPlaceHolder : I18N.get("IAM.CONTACTS.SEARCH.CONTACTS"), // No I18N
				data : {
					LNodes : "2",
					CNodes : "3"
				}
			};
			contactsAppObj.handler = {
				create : zmcontact.showQuickCreate
			};
			zmsuite.setAppInfo(contactsAppObj);
		},

		constructView : function() {
			zcon.contactLeft = zmsuite.getLeft();
			zcon.contactsCenter = zmsuite.getCenter();
			zmcontact.constructLeft();
			zmcontact.constructCenter();
			zmsuite.showApp(ZContacts.ZMailConstants.CONTACTS_APP_ID); // No I18N
			zcon.contactsCenter.listElem = zcon.contactsCenter[0].getNodes()[2].$el[0];
		},
		
		topbarHelpDoc : function() {
			var helpmenu = {
					uitype: "button", // No I18N
					id: "zcs_help_doc", // No I18N
					iconClass : "ztb-icon-group ztb-help-icon", // No I18N
					title : I18N.get("IAM.CONTACTS.HELP"),
					action: "URL:"+ZContacts.meta.serviceInfo.help_page_url // No I18N
			}
			if(!zmail.isFuji) {
				ztopbar.addItem(helpmenu);
			}
		},

		updateCountInCategories : function(category, count, isUpdate) {
			if (isUpdate) {
				count = ZContacts._countObj[category.category_id].c + count;
				ZContacts._countObj[category.category_id].c = count >= 0 ? count : 0;
				category.count = ZContacts._countObj[category.category_id].c;
			} else {
				ZContacts._countObj[category.category_id].c = count;
				category.count = count;
			}
		},

		getCategoriesListLayer : function(categoryId) {
			if (!categoryId) {
				categoryId = ZContacts._currentCategoryId;
			}
			var rootFolderId = zmcontact.getRootFolderId(categoryId);
			var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
			var index = 0;
			if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT) {
				index = 0;
			} else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
				index = 1;
			} else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {
				index = 2;
			}
			return zcon.contactLeft.getNodes()[0].layerArr[index];
		},
		
		/**
		 * @param count
		 *            delete contact, Given value will be decremented from `All Contacts`
		 */
		refreshContactCounts : function(zid) {
			if (!zid) {
				zid = ZContacts.getCurrentAccount().getAccountId();
			}
			new URI(ZContacts.Contacts, zid).addFields("count").include('categories').GETS().then(function(response) { // No I18N
				if (!response) {
					return;
				}
				response = response._apiResponse;
				var rootFolderId = ZContacts.AccountsVsRootFolderMap[zid];
				var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
				var contacts = ZContacts.Contacts.create(response.contacts);
				var totalCount = 0;
				var myContacts = zmcontact.getCategory(zmcontact.getAccountByZidForType(zid, ZContacts.ZMailConstants.VIEW_ID_CONTACTS).getRootFolderId());
				totalCount+=contacts.get(ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
				zmcontact.updateCountInCategories(myContacts, contacts.get(ZContacts.ZMailConstants.VIEW_ID_CONTACTS), false);
				if (acc.getAccountType() != ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {
					var archived = zmcontact.getCategory(zmcontact.getAccountByZidForType(zid, ZContacts.ZMailConstants.VIEW_ID_ARCHIVED).getRootFolderId());
					totalCount+=contacts.get(ZContacts.ZMailConstants.VIEW_ID_ARCHIVED);
					zmcontact.updateCountInCategories(archived, contacts.get(ZContacts.ZMailConstants.VIEW_ID_ARCHIVED), false);
					var inactive = zmcontact.getCategory(zmcontact.getAccountByZidForType(zid, ZContacts.ZMailConstants.VIEW_ID_INACTIVE).getRootFolderId());
					totalCount+=contacts.get(ZContacts.ZMailConstants.VIEW_ID_INACTIVE);
					zmcontact.updateCountInCategories(inactive, contacts.get(ZContacts.ZMailConstants.VIEW_ID_INACTIVE), false);
				}
				ZContacts.AccountIdVsTotalCountMap[zid] = totalCount;
				if (contacts.get('categories')) {
					var categories = contacts.get('categories');
					for (var i = 0; i < categories.length; i++) {
						var category = categories[i];
						if (!ZContacts._countObj[category.category_id]) {
							ZContacts._countObj[category.category_id] = {};
						}
						ZContacts._countObj[category.category_id] = {
							p : rootFolderId,
							c : category.count
						};
					}
				}
				zmcontact.updateHeaderBand(zmcontact.getCategory(rootFolderId));
				zmcontact.unChkAll();
			});
		},

		/**
		 * @param categoryId
		 * @param count
		 *            postive number to increament and negative number to decreament the count
		 * @param applyInAllContacts
		 *            if TRUE, change in apply count change in All Contacts also
		 * 
		 */

		constructLeft : function() {
			var leftNodes = zcon.contactLeft.getNodes()[0];
			leftNodes.push({
				layerArr : []
			});
			var personal = [];
			personal.push(ZContacts.personal_contacts);
			personal.push(ZContacts.personal_archived);
			personal.push(ZContacts.personal_inactive);
			var org = [];
			org.push(ZContacts.org_contacts);
			org.push(ZContacts.org_archived);
			org.push(ZContacts.org_inactive);
			
			zmcontact.appendAccountLayer(personal, "PERSONAL"); // No I18N
			zmcontact.appendAccountLayer(org, "ORGANIZATION"); // No I18N

			zcon.contactLeft.setListener("click", function(data) { // No i18N
				try {
					zcon.contactLeft.getNodes()[0].getLayer("PERSONAL").setChildToggle(function(data) { }); // No I18N
					zcon.contactLeft.getNodes()[0].getLayer("ORGANIZATION").setChildToggle(function(data) { }); // No I18N
					zcon.contactLeft.getNodes()[0].getLayer("ORG_GROUPS").setChildToggle(function(data) { }); // No I18N
				} catch (e) {

				}
				if (isContactDetailWorkSpace() && (data.zmsData.eventInfo.currentTarget.id == ZContacts._currentCategoryId)) {
					return;
				}
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.CONTACTS_APP_ID);
				zmcontact.bindLeftActions(data);
			});

			zcon.contactLeft.setListener("contextmenu", function(data) { // No i18N
				zmcontact.bindLeftActions(data);
			});
			zcon.contactLeft.render();
		},
		
		appendAccountLayer : function(accounts, type) {
			var categoryMapObj = {
					id : "category_id", // No i18N
					name : "category_name", // No i18N
					count : "count", // No i18N
					hasChild : "HC", // No I18N
					expChild : "E", // No I18N
					sequence : "SE", // No I18N
					parentId : "p", // No I18N
					notBold : "notBold" // No I18N
				};
			var name;
			if (type == "PERSONAL") {
				name = I18N.get('IAM.CONTACTS.PERSONAL'); // No I18N
			} else if (type == "ORGANIZATION") {
				name = I18N.get('IAM.CONTACTS.ORGANIZATION'); // No I18N
			} else if (type == "ORG_GROUPS") {
				name = I18N.get('IAM.CONTACTS.ORG.GROUPS');
			}
			var acc;
			var listObject = {};
			var expand = 0;
			var categoryTreeObj = {
				type : "1", // No I18N
				listId : type + "H", // No I18N
				id : type,
				hasChild : true,
				hasCountObject : true,
				notBold : true,
				mapObject : categoryMapObj,
				dataObject : {
					headerObject : {
						licon : "msi-folder", // No I18N
						id : "zcateH", // No I18N
						name : name,
						showList : true
					}
				}
			};
			for (var i = 0; i < accounts.length; i++) {
				var hasChild = false;
				acc = accounts[i];
				if(!acc){
					continue;
				}
				var rootFolderId = acc.getRootFolderId();
				var catName = encodeHTML(acc.getName());
				expand = 0;
				if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT && acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_CONTACTS) {
					expand = 1;
				}
				hasChild= acc.getCategories() &&  acc.getCategories().length;
				if (acc.is_writable && ZContacts.AccountConstants[acc.getViewType()].view_add_category_button) {
						hasChild = true;
						ZContacts._countObj[rootFolderId + "_add"] = { // No I18N
							c : 0,
							p : rootFolderId
						};
						if(!ZContacts._childObj[rootFolderId]) {
							ZContacts._childObj[rootFolderId] = {
									CH : {}
							};
						}
						ZContacts._childObj[rootFolderId].CH[rootFolderId + "_add"] = { // No I18N
							id : rootFolderId + "_add", // No I18N
							account_id : acc.getAccountId(),
							category_id : rootFolderId + "_add", // No I18N
							category_name : I18N.get('IAM.CONTACTS.ADD.CATEGORY'), // No I18N
							E : 0,
							HC : false,
							SE : 999,
							addNewType : true
						};
				}
				var layer = zcon.contactLeft.getNodes()[0].getLayer(type);
				if(layer) {
					layer.childObject = ZContacts._childObj;
					layer.countObject = ZContacts._countObj;
					layer.listObject[rootFolderId] = {
							category_name : catName,
							category_id : rootFolderId,
							account : acc,
							type : acc.type,
							E : expand,
							HC : hasChild
						};
				} else {
					listObject[rootFolderId] = {
							category_name : catName,
							category_id : rootFolderId,
							account : acc,
							type : acc.type,
							E : expand,
							HC : hasChild
						};
					categoryTreeObj.dataObject.listObject = listObject;
					categoryTreeObj.dataObject.countObject = ZContacts._countObj;
					categoryTreeObj.dataObject.childObject = ZContacts._childObj;
					var categoriesLayer = new ZMLayer();
					categoriesLayer.push(categoryTreeObj);
					zcon.contactLeft.getNodes()[0].layerArr.push(categoriesLayer);
				}
			}
		},

		addExistingContacts: function(isNextPage) {
			if (!isNextPage) {
				zmcontact.showAddExistingContactsPopUp();
				existingContactMetaData.page = 1;
				existingContactMetaData.contacts = [];
				$("#zmsdialog_contacts_list").find("#contacts_list").find("#content").empty();
			} else {
				existingContactMetaData.page++;
			}
			var uri = new URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId()).include("emails").setSortBy(ZContacts.sortBy, true); // No I18N
			uri.setPagination(existingContactMetaData.page, existingContactMetaData.noOfResults);
			existingContactMetaData.isLoading = true;
			if (existingContactMetaData.hasMore) {
				uri.GETS().then(function(json) {
					var cntElem = $(zmcontact.constructContactsRow(json));
					$("#zmsdialog_contacts_list").find("#contacts_list").find("#content").append(cntElem);
					existingContactMetaData.contacts = existingContactMetaData.contacts.concat(json);

					existingContactMetaData.isLoading = false;
					existingContactMetaData.hasMore = uri.apiResponse.has_more;
					$(".SC_icn").remove();
					$("#zmsdialog_contacts_list").find("#contacts_list").find("#content").unbind("scroll").bind("scroll", function() { // No I18N
						zmcontact.scrollDownExistingContactsList();
						$(".SC_icn").remove();
					});

					if ($("#zmsdialog_contacts_list").find("#contacts_list").find('.zmL.SC_cont').find('.msi-check').length) {
						$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class', 'msi-partcheck'); // No I18N
					}

					$("#zmsdialog_contacts_list").find("#contacts_list").find('.zmL.SC_cont').off("click").click(function() { // No I18N
						if ($(this).find('.msi-uncheck').length) {
							$(this).addClass('SC_check');
							$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class', 'msi-partcheck'); // No I18N
							$(this).find('.msi-uncheck').addClass('msi-check').removeClass('msi-uncheck'); // No I18N
						} else {
							$(this).removeClass('SC_check');
							$(this).find('.msi-check').addClass('msi-uncheck').removeClass('msi-check'); // No I18N
							if ($("#zmsdialog_contacts_list").find("#contacts_list").find('.zmL.SC_cont').find('.msi-check').length == 0) {
								$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class', 'msi-uncheck'); // No I18N
							}
						}
					});
				});
			} else {
				existingContactMetaData.isLoading = false;
			}
		},

		showAddExistingContactsPopUp : function() {
			var existingContactsDiv = {};
			existingContactsDiv.title = I18N.get('IAM.CONTACTS.COPY.CONTACT'); // No I18N
			existingContactsDiv.mask = true;
	
			existingContactsDiv.buttons = [ {
				txt : ZContacts.I18N.get("IAM.ADD"), // No I18N
				selected : true,
				callback : function() {
					var noOfContactsSelected = $("#zmsdialog_contacts_list").find("#contacts_list").find(".zmL.SC_cont.SC_check").length;
					if (noOfContactsSelected) {
						var selectContactArr = zmcontact.getSelectedContactIds($("#zmsdialog_contacts_list").find("#contacts_list").find("#content"));
						zmcontact.addContactsToCategory(selectContactArr, ZContacts._currentCategoryId);
						zmsDialog.remove();
						$("#zmsdialog_contacts_list").find("#contacts_list").remove();
					} else {
						zmUtil.succErrMsg("e", "Please select some contacts first");// NO I18N
					}
				}
	
			}, {
				isCancel : true,
				txt : ZContacts.I18N.get("IAM.CANCEL"),
				callback : function() {
					zmsDialog.remove();
					$("#zmsdialog_contacts_list").find("#contacts_list").remove();
					$("#contacts_list").remove();
					$("#content").remove(); 
					existingContactMetaData.hasMore = true;
					existingContactMetaData.isLoading = false;
				}	
			} ];
	
			existingContactsDiv.closeaction = function() {
				zmsDialog.remove();
				$("#zmsdialog_contacts_list").find("#contacts_list").remove();
				$("#contacts_list").remove();
				$("#content").remove();
				existingContactMetaData.hasMore = true;
				existingContactMetaData.isLoading = false;
			};
			existingContactsDiv.pos = "center"; // No I18N
	
			createFolElem = $("<div id='contacts_list'></div>");
			if (!$("#zmsdialog_contacts_list").find("#contacts_list").length) {
				var searchDiv = $("<div>")
					.attr("id", "ztb-search") // No I18N
					.addClass("ztb-font-family ztb-search-focus SC_srcmore")
					.css({
						"left": "0%", // No I18N
						"width": "397px", // No I18N
						"padding": "2px", // No I18N
						"margin": "0 auto", // No I18N
						"display": "flex", // No I18N
						"align-items": "center", // No I18N
						"justify-content": "center" // No I18N
					});

				var selectAllIcon = $("<i>")
				    .addClass("msi-uncheck") // No I18N
				    .attr("id", "select-all") // No I18N
				    .css("margin", "0 5px"); // No I18N

				var inputField = $("<input>")
				    .attr("type", "text") // No I18N
				    .attr("id", "ztb-search-field") // No I18N
				    .addClass("ztb-font-family zm_sgst") // No I18N
				    .attr("placeholder", I18N.get("IAM.CONTACTS.SELECT")) // No I18N
				    .css({
				        "width": "327px", // No I18N
				        "border": "none", // No I18N
				        "padding": "0px", // No I18N
						"margin-left": "7px" // No I18N
				    });

				var contentDiv = $("<div>")
				    .addClass("SC_conLft")
				    .attr("id", "content"); // No I18N

				searchDiv.append(selectAllIcon, inputField);
				setTimeout(() => inputField.focus(), 1500);
				createFolElem.append(searchDiv, contentDiv);

				$(document.body).append(createFolElem);
			}
			
			$("#content").css({
				"max-height": "40vh", // No I18N
				"overflow-y": "auto", // No I18N
				"padding": "10px", // No I18N
				"box-sizing": "border-box", // No I18N
				"position": "relative" // No I18N
			});


			zmsDialog.create("contacts_list", existingContactsDiv); // No I18N

			$("#zmsdialog_contacts_list").css({
				"position": "fixed", // No I18N
				"border-radius": "6px", // No I18N
				"overflow-y": "auto", // No I18N
				"top": "21vh", // No I18N
				"left": "40%" // No I18N
			});
			
			$(document).on("keydown", function(e) {
			    if (e.key === "Escape") {
			        $("#zmsdialog_contacts_list").find("#contacts_list").find('#ztb-search-field').blur();
			    }
			});
			
			$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').on('click', function() {
				if ($("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class') === 'msi-uncheck') {
					$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class', 'msi-check'); // No I18N
					$("#zmsdialog_contacts_list").find("#contacts_list").find('.SC_cont').addClass('SC_check');
					$("#zmsdialog_contacts_list").find("#contacts_list").find('.SC_cont').find('.msi-uncheck').attr('class', 'msi-check'); // No I18N
				} else if ($("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class') === 'msi-check' || $("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class') === 'msi-partcheck') { // No I18N
					$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class', 'msi-uncheck'); // No I18N
					$("#zmsdialog_contacts_list").find("#contacts_list").find('.SC_cont').removeClass('SC_check'); // No I18N
					$("#zmsdialog_contacts_list").find("#contacts_list").find('.SC_cont').find('.msi-check').attr('class', 'msi-uncheck'); // No I18N
				}
			});
			
			$("#zmsdialog_contacts_list").find("#contacts_list").parents('.SC_pe').on("click", function(e) {
				e.stopPropagation();
			});
			$("#zmsdialog_contacts_list").find("#contacts_list").parents('.SC_Pop').on("click", function() {
				existingContactsDiv.closeaction();
			});
			
			var isSearchAllowed = true;
			var searchQuery = '';
			$($("#zmsdialog_contacts_list").find("#contacts_list").find('#ztb-search-field')).off('input').on('input', function() { // No I18N
				var value = $("#zmsdialog_contacts_list").find("#contacts_list").find('#ztb-search-field').val();
				var valLength = value.length;

				if (valLength == 0) {
					searchQuery = '';
					isSearchAllowed = true;
					zmcontact.searchExistingContact(value, existingContactMetaData.contacts);
					$(zmsuite.$el.centerHolder).find('#zcs_printConLft').unbind("scroll").bind("scroll", function() {
						zmcontact.scrollDownContactsPrint();
					});
				} else {
					var uri = new URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId()).include("emails").include("phones").include("categories").addSearchQuery(value).setPagination('1', '100').setSortBy(ZContacts.sortBy, true); // No I18N
					if (isSearchAllowed) {
						uri.GETS().then(function(json) {
							if (json.length == 0) {
								isSearchAllowed = false;
							} else {
								searchQuery = value;
							}
							zmcontact.searchExistingContact(value, json);
						});
					} else {
						if (value == searchQuery) {
							isSearchAllowed = true;
							uri.GETS().then(function(json) {
								if (json.length == 0) {
									isSearchAllowed = false;
								} else {
									searchQuery = value;
								}
								zmcontact.searchExistingContact(value, json);
							});
						}
					}
				}
			});

		},

		showCreateCategoryPopUp : function(obj, data) {
			var popOpt, folTitle, folMode, posLeft, posTop, posElem, posOffset, newParId = "new", folPath = "", folPathArr = [], folId; // No I18N

			obj = obj || {};
			folMode = obj.mode || "new"; // No I18N
			posElem = $(".zm_compose");
			posOffset = posElem.offset();
			posTop = posOffset.top + "px"; // No I18N
			posLeft = posOffset.left + posElem.width() + "px"; // No I18N
			var categoryMapObj = {
				id : "category_id", // No i18N
				name : "category_name", // No i18N
				hasChild : "HC", // No I18N
				expChild : "E", // No I18N
				sequence : "SE", // No I18N
				parentId : "p" // No I18N
			};
			var categoryName = '';
			if (folMode === "rename") {
				folTitle = I18N.get("IAM.CONTACTS.RENAME.CATEGORY"), categoryName = data.category.category_name; 
			} else if (folMode === "new") { // No I18N
				folTitle = I18N.get("IAM.CONTACTS.ADD.CATEGORY");
			}
			var all_contacts_id = obj.id;
			popOpt = {
				title : folTitle,
				style : {
					width : "200px" // No I18N
				},
				posParent : {
					top : posTop,
					left : posLeft
				},
				buttons : [ {
					txt : I18N.get("IAM.SAVE"),
					selected : true,
					callback : function() { // No I18N
						var oldParId, param = {};
						var newCategoryName = $("#zc_categorypopup").find("input:first").val().trim();

						if (zmcontact.isValidCategoryName(newCategoryName, {
							mode : obj.mode,
							parElem : $("#zc_categorypopup")[0]
						})) {
							var categoryModel = ZContacts.Categories.create({
								category_name : newCategoryName
							});
							if (obj.mode === "new") {
								new URI(ZContacts.Categories, obj.account_id).POST(categoryModel).then(function(json) {
									var category = data.category;
									if (!category) {
										category = data.rowObject[data.eventInfo.currentTarget.id];
										category.category_id = category.category_id.replace("_add", ""); // No I18N
									}
									var rootFolderId = zmcontact.getRootFolderId(category.category_id);
									if (!ZContacts._parentObj[rootFolderId]) {
										ZContacts._parentObj[rootFolderId] = [];
									}
									ZContacts._parentObj[rootFolderId].push(json.categories);
									var rowInfo = {};
									rowInfo[json.categories.category_id] = {
										category_id : json.categories.category_id,
										category_name : json.categories.category_name,
										E : 1,
										HC : 0
									};
									var layer = zmcontact.getCategoriesListLayer(rootFolderId);
									layer.insertNodeBefore(rowInfo, categoryMapObj, rootFolderId+"_add", rootFolderId); // No I18N
									zmUtil.succErrMsg('s', I18N.get("IAM.CONTACTS.ERROR.CATEGORY.ADDED")); // No I18N
									zmcontact.publishCategory([{ name: json.categories.category_name, id: json.categories.category_id, type: "category_add" }]);//No I18N
									$("#"+json.categories.category_id).trigger("click"); // No I18N
									setTimeout(function() {
										zmcontact.addExistingContacts();
									}, 500);
								}, function(json) {
									zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
								});

							} else if (obj.mode === "rename") { // No I18N
								new URI(ZContacts.Categories, obj.account_id, data.category.category_id).PUT(categoryModel).then(function(json) {
									data.category.category_name = encodeHTML(json.categories.category_name);
									var rootFolderId = zmcontact.getRootFolderId(data.category.category_id);
									var listObj = ZContacts._parentObj[rootFolderId];
									for (var i = 0; i < listObj.length; i++) {
										var cat = listObj[i];
										if (cat.category_id == data.category.category_id) {
											cat.category_name = encodeHTML(json.categories.category_name);
											break;
										}
									}
									var rowObj = {};
									rowObj[data.category.category_id] = data.category;
									var editChild = {};
									editChild[data.category.category_id] = {
										E : 1,
										HC : 0,
										category_name : json.categories.category_name,
										category_id : data.category.category_id
									};
									zmcontact.getCategoriesListLayer(all_contacts_id).editNode(rowObj, categoryMapObj, editChild);
									zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId));
									zmUtil.succErrMsg('s', I18N.get("IAM.CONTACTS.ERROR.CATEGORYNAME.CHANGED")); // No I18N
									zmcontact.publishCategory([{ name: json.categories.category_name, id: json.categories.category_id, type: "category_rename" }]); //No I18N
								}, function(json) {
									zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
								})

							}
							zmsDialog.remove();
						}
						$("#zmsdialog_zm_createfolpopup").hide()
					}

				}, {
					isCancel : true,
					txt : I18N.get("IAM.CANCEL"), // No I18N
					callback : function() {
						zmsDialog.remove();
					}
				} ],
				closeaction : function() {
					$("#zc_categorypopup").remove();
				},
				afterDisplay : function() {
					$("#zc_categorypopup").find("input")[0].focus();
				}
			};

			var $createFolElem = $("<div id='zc_categorypopup'><ul class='zmListReset'><li><input type='text' class='SC_tiput' placeholder='" + I18N.get("IAM.CONTACTS.CATEGORY.NAME") + "'/></li></ul></div>");
			$createFolElem.find('.SC_tiput').val(categoryName);

			if (!$("#zc_categorypopup").length) {
				$(document.body).append($createFolElem);
			}
			zmsDialog.create("zc_categorypopup", popOpt); // No I18N
			$("#zmsdialog_zc_categorypopup").mousedown(function(ev) { // No I18N
				zmUtil.stopEvents(ev, true);
			});

			$("#zmsdialog_zc_categorypopup").click(function(ev) { // No I18N
				zmUtil.hideMenu(false, true);
			});
			
			$('#zmsdialog_zc_categorypopup').off("keypress").on("keypress",function(e) {
				if (e.which == 13 && !e.shiftKey) {
					$(this).find('.sel')[0].click();
				}
			});
		},
		
		publishCategory: function(data) {
			$.publish("contacts/update", { // No I18N
				data: data
			});
		},

		isValidCategoryName : function(catName) {
			catNameLwrCase = catName.toLowerCase();
			if (!catName.length) {
				zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.ERROR.INVALID.CATEGORY.NAME")); // No I18N
				return false;
			} else {
				return true;
			}
		},
		
		bindLeftActions : function(data) {
			var layerType, evntType, evntObj, rowobj;
			data = data.zmsData;
			rowobj = data.rowObject;
			evntType = data.type;
			evntObj = data.eventInfo;
			elem = evntObj.srcElement || evntObj.target;
			layerType = data.rowInfo.type;
			if (evntType == "contextmenu" && evntObj.currentTarget.id.substr("-4") != "_add") { // No I18N
				zmcontact.rightClickMenu(evntObj, rowobj);
			} else if (evntType == "click" && layerType == "list") { // No i18N
				if (evntObj.currentTarget.id.substr("-4") == "_add") { // No I18N
					zmcontact.showCreateCategoryPopUp({
						mode : "new", // No i18N
						account_id : data.rowObject[evntObj.currentTarget.id].account_id,
						id : data.rowObject[evntObj.currentTarget.id].category_id
					}, data);

				} else {
					ZContacts.currentCategoryId = data.eventInfo.currentTarget.id;
					zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts.currentCategoryId));
				}
			}
		},

		rightClickMenu : function(e, categoryModel) {
			if (!e.currentTarget.id) {
				return false;
			}
			var menuObj = {
				clk : function(ev, data, layerId) {
					zmcontact.bindAction(data, ev, layerId);
				},
				conArr : []
			};
			var rootFolderId = zmcontact.getRootFolderId(e.currentTarget.id.toString());
			var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
			if (acc.is_writable) {
				if (zmcontact.isRootFolder(e.currentTarget.id)) {
					if (acc.getViewType() == ZContacts.ZMailConstants.VIEW_ID_CONTACTS){
						menuObj.conArr.push({
							htm : I18N.get('IAM.CONTACTS.ADD.CATEGORY'), // No I18N
							id : "RtMenu_ADD", // No I18N
							data : {
								"action" : "Add", // No I18N
								category : categoryModel[e.currentTarget.id]
							}
						}, {
							sep : true,
							id : "rightMenu_lne2" // No i18N
						});
						if (ZContacts._parentObj[rootFolderId]) {
							menuObj.conArr.push({
								htm : I18N.get('IAM.CONTACTS.DELETE.CATEGORIES'), // No I18N
								id : "RtMenu_CLEAR", // No I18N
								data : {
									"action" : "DeleteCategories", // No I18N
									category : categoryModel[e.currentTarget.id]
								}
							}, {
								sep : true,
								id : "rightMenu_lne2" // No i18N
							});
						}
					}				
					} else {
					menuObj.conArr.push({
						htm : I18N.get("IAM.CONTACTS.RENAME"), // No I18N
						id : "RtMenu_RN", // No i18N
						data : {
							action : "Rename", // No i18N
							category : categoryModel[e.currentTarget.id]
						}
					});
					menuObj.conArr.push({
						sep : true,
						id : "rightMenu_lne2" // No i18N
					});
					menuObj.conArr.push({
						htm : I18N.get("IAM.DELETE"), // No I18N
						id : "RtMenu_DC",// No i18N
						data : {
							action : "Delete",// No i18N
							category : categoryModel[e.currentTarget.id]
						}
					});
					menuObj.conArr.push({
						sep : true,
						id : "rightMenu_lne2" // No i18N
					});
				}
			}
			
			if (ZContacts.AccountConstants[acc.getViewType()].is_exportable) {
				menuObj.conArr.push({
					htm: I18N.get('IAM.CONTACTS.EXPORT'), // No I18N
					id: "RtMenu_EX", // No I18N
					data: {
						"action": "Export", // No I18N
						category: categoryModel[e.currentTarget.id]
					}
				});
			}

			if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {
				menuObj.conArr.push({
					sep : true,
					id : "rightMenu_lne2" // No i18N
				});
				menuObj.conArr.push({
					htm : I18N.get('IAM.CONTACTS.MANAGE.GROUPS'), // No I18N
					id : "RtMenu_EX", // No I18N
					data : {
						"action" : "Manage" // No I18N
					}
				});
			}
			zmsuite.showContextMenu(e, menuObj);
			zmUtil.stopEvents(e);
		},

		bindAction : function(data, elem) {
			if (!data) {
				return;
			}
			var mode = data.action;
			if (mode == "Manage") {
				zmUtil.hideMenu();
				window.open(ZContacts.meta.serviceInfo.groups_url); // No I18N
				return;
			}
			var categoryId = data.category.category_id;
			var rootFolderId = zmcontact.getRootFolderId(categoryId);
			var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
			switch (mode) {
				case "Add": // No I18N
					zmUtil.hideMenu();
					zmcontact.showCreateCategoryPopUp({
						mode : "new", // No i18N
						account_id : acc.getAccountId(),
						id : categoryId
					}, data);
					break;
					
				case "DeleteCategories": // No I18N
					zmUtil.hideMenu();
					zmcontact.deleteAllCategories(acc);
					break;
					
				case "Rename": // No I18N
					zmUtil.hideMenu();
					zmcontact.showCreateCategoryPopUp({
						mode : "rename", // No i18N
						account_id : acc.getAccountId(),
						id : $('#' + data.category.category_id).parent().children()[0].id
					}, data, elem); // No i18N
					break;

				case "Delete": // No i18N
					zmUtil.hideMenu();
					zmcontact.deletecategory(data);
					break;

				case "Export": // No I18N
					var result = ZContacts.isExportable(acc.account_type);
					if (result == true) {
						zmUtil.hideMenu();
						zmcontact.exportPopUp(zmsuite.getCenter()[0].getNodes()[2], data.category);
					} else {
						zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.EXPORT.DISABLED'), result)); // No I18N
					}
					break;

				default:
					zmUtil.hideMenu();
					break;
			}
		},
		showCleanWorkspace : function() {
			if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID)) {
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
			}else {
				var contactsTabObj2 = {
					appname : I18N.get("IAM.CONTACTS.CLEAN.DUPLICATES"), // No I18N
					appId : ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID,
					appIcon : "msi-contactMerge", // No I18N
					searchPlaceHolder : I18N.get('IAM.CONTACTS.CLEAN.DUPLICATES'), // No I18N
					data : {
						CNodes : "3"
					}
				};
				zmsuite.setWorkSpace(contactsTabObj2);
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
				var workspaceCenter = zmsuite.getCenter(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
				var centerNodes = workspaceCenter[0].getNodes();
				centerNodes[0].push([]);
				var headerObj = {
					left : {
						leftHTML : I18N.get("IAM.CONTACTS.CLEAN.DUPLICATES")
					},
					right : []
				};

				centerNodes[1].push(headerObj);
				var headericon = {
					left : [],
					right : [ {
						actionArr : [ {
							iconList : [ "msi-close" ], // No i18N
							tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
						} ]
					} ]
				};
				centerNodes[0].push(headericon);
				centerNodes[0].setListener("click", function(ev, iconName) {
					if (iconName == "msi-close") {
						zmsuite.closeWorkspace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID); 
					}
				});
			}
		},
		
		bindHeaderIcons : function(ev, iconName) {
			var elem = ev.srcElement || ev.target;
			var menuNode = zmsuite.getCenter()[0].getNodes()[0];
			var contactsNode = zmsuite.getCenter()[0].getNodes()[2];
			switch (iconName) {
				case "msi-uncheck zcs-check": // No I18N
					zmcontact.chkAll(elem); // No I18N
					break;
				case "msi-uncheck msi-partcheck zcs-check": // No I18N
				case "msi-check zcs-check": // No I18N
					zmcontact.unChkAll(elem);
					break;
				case "msi-sort": // No I18N
					zmUtil.hideMenu();
					menuNode.$el.find(".msi-sort").closest("b").addClass("SC_ddn");// No I18N
					var listObj = {};
					var fnameTick = "", lnameTick = "";
					if (ZContacts.sortBy == "first_name") { // No I18N
						fnameTick = "class='msi-tick'"; // No I18N
					} else {
						lnameTick = "class='msi-tick'"; // No I18N
					}
					var list = [ {
						htm : "<i " + fnameTick + "></i>" + I18N.get("IAM.CONTACTS.FIRSTNAME"), // No I18N
						data : {
							action : "first_name" // No I18N
						}
					}, {
						sep : true,
						id : "rightMenu_lne2" // No i18N
					}, {
						htm : "<i " + lnameTick + "></i>" + I18N.get("IAM.CONTACTS.LASTNAME"), // No I18N
						data : {
							action : "last_name" // No I18N
						}
					} ];
					listObj.par = menuNode.$el.find(".msi-sort").closest("li");// No I18N
					listObj.defaultclass = true;
					listObj.parWidth = true;
					listObj.onHide = function() {
						menuNode.$el.find(".msi-sort").closest("b").removeClass();// No I18N
					};
					listObj.list = list;
					listObj.clk = function(data, elem, event) {
						if ($(elem).find("i").attr("class") != "msi-tick") { // No I18N
							$(elem).parent().find(".msi-tick").removeClass("msi-tick"); // No I18N
							$(elem).find("i").addClass("msi-tick"); // No I18N
							if(!$.isEmptyObject(data) && data != null ) {
								ZContacts.sortBy = data.action;
								new URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId(), "sort").addPostParam("sort", data.action).PUT().then(function(response) { // No I18N
									zmUtil.succErrMsg('s', ZContacts.getMessageFromResponse(response)); // No I18N
									zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
								}, function(response) {
									zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(response)); // No I18N
								});
							}
						}
						zmUtil.hideMenu();
						menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
					};
					zmsuite.showMenu(listObj);
					break;
					
				case "msi-edit": //No I18N
					zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-editor-form').hide();
					if (zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').children().length != 0) {
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-cont-details').hide();
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').show();
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#contacts")[0].innerHTML = zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.OF.SELECTED'), contactsNode.$el.find(".zmL.SC_cont.SC_check").length);
						break;
					}
					var noOfContactsSelected = contactsNode.$el.find(".zmL.SC_cont.SC_check").length;
					if (noOfContactsSelected < 2 || noOfContactsSelected > 100) {
						zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.ERROR.BULK.EDIT.LIMIT'), 100)); // No I18N
						zmcontact.unChkAll();
						ev.stopPropagation();
					} else {
						var $rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el;
						var contactIds = zmcontact.getSelectedContactIds(zmsuite.getCenter()[0].getNodes()[2].$el);
						var $multiEditBlock = $rightContainer.find('.zcs-multiCont-edit') // No I18N
						var $innerMultiEdit = zmcontact.multiEditUi(contactIds);
						$multiEditBlock.html($innerMultiEdit);
						var rightContainer = zmsuite.getWorkSpace(zmTab.currentTab)[0].$el.find('.SC_mclst').find('.SC_conRgt');
						$(rightContainer).find('.zcs-cont-details').hide();
						$(rightContainer).find('.zcs-multiCont-edit').show();
						$(".zcs-addAnAction").css("width", ($(".zcs-addAnAction .dummy-width-finder").width() + parseInt($(".zcs-addAnAction .SC_tiput").css("padding-left")) + $(".arrow-width-finder").width()+2) + "px"); // No I18N
						$(".zcs-addAnAction .dummy-width-finder , .addAnAction .arrow-width-finder, .arrow-width-finder.SC_select").remove();
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#bulkRows").find("[data-field-type='bulk1']").click(function(event) {
							if (bulkEdits.selectedBulkEditfields.length < 5) {
								zmcontact.getBulkEditFields(this);
							}
						});
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#bulkRows").find("[data-field-type='bulk1Action']").click(function (event){
							zmcontact.getBulkEditActions(this);
						});
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find(".zcs-addAnAction").click(function (event){
							zmcontact.getBulkEditAddOptions(this);
						});
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#bulkRows").find("[data-field-type='bulk1Trash']").click(function() {
							zmcontact.removeBulkEditField(this);
						});
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#bulkRows").find("[data-field-type='bulk1Input']").click(function (event){
							$(this).siblings().remove();
							$(this).removeClass("zcs-bulk-input_boxErr");
						});
						
						$(rightContainer).find('.zcs-multiCont-edit').find("#zcs-cancel-btn").click(function(event) {
							$(rightContainer).find('.zcs-multiCont-edit').children().remove();
							$(rightContainer).find('.zcs-cont-details').show();
							zmcontact.unChkAll();
							bulkEdits.selectedBulkEditfields.length = 0; // clearing all elements in a array
						});

						$(rightContainer).find('.zcs-multiCont-edit').find("#zcs-save-btn").click(function(event) {
							if (contactsNode.$el.find(".zmL.SC_cont.SC_check").length < 2) {
								zmUtil.succErrMsg('e', ZContacts.I18N.get('IAM.CONTACTS.BULK.ERROR.CONTACTS.REQUIRED')); // NO I18N
							} else {
								zmcontact.getBulkEditConsent(zmcontact.getSelectedContactIds(zmsuite.getCenter()[0].getNodes()[2].$el));
							}
						});
					}
					break;
				case "msi-contactMerge": // No I18N
					var noOfContactsSelected = contactsNode.$el.find(".zmL.SC_cont.SC_check").length;
					if (noOfContactsSelected < 2 || noOfContactsSelected > 5) {
						zmUtil.succErrMsg("e", zmcontact.formatMessage(I18N.get("IAM.CONTACTS.ERROR.SELECT.LIMIT"), 5)); // NO I18N
						zmcontact.unChkAll();
						ev.stopPropagation();
					} else {
						var contactIds = zmcontact.getSelectedContactIds(zmsuite.getCenter()[0].getNodes()[2].$el);
						if (contactIds) {
							zmcontact.showMergeUI(contactIds, true);
						}
					}
					break;
				case "msi-action": // No I18N
					zmUtil.hideMenu();
					menuNode.$el.find(".msi-action").closest("b").addClass("SC_ddn");// No I18N
					var listObj = {};
					var list = [];
//					if(!isNewSearchWorkSpace()) {
						list.push({
							htm : I18N.get("IAM.CONTACTS.EXPORT"), // No I18N
							data : {
								action : "export" // No I18N
							}
						});
					
//					}
						if(!isNewSearchWorkSpace()) {
							if (contactsNode.$el.find('.SC_conLft').length && ZContacts.isFunctionableForCurrAcc("print_all")){
						list.push({
							htm : I18N.get("IAM.PRINT"), // No I18N
							data : {
								action : "print" // No I18N
							}
						});
					}
						}
					if (ZContacts.isFunctionableForCurrAcc("add_contact") && !isNewSearchWorkSpace()) {
						list.push({
							htm : I18N.get("IAM.CONTACTS.IMPORT"), // No I18N
							data : {
								action : "import" // No I18N
							}
						});
						if (ZContacts.isDeletable()) {
							list.push({
								htm : I18N.get("IAM.CONTACTS.RESET.CONTACTS"), // No I18N
								data : {
									action : "reset" // No I18N
								}
							});
						}
						list.push({
							htm : I18N.get("IAM.CONTACTS.CLEAN.DUPLICATES") + "<i class='msi-rarrow'></i>", // No I18N
							data : {
								action : "clean_dupes" // No I18N
							},
							child : {
								divId : "zcs_cleanDupes", // No I18N
								list : [{ htm : I18N.get("IAM.CONTACTS.AUTO"), data : {action : "auto" }}, { htm : I18N.get("IAM.CONTACTS.MANUAL"), data : {action : "manual"} }], // No I18N
								align : "cleft", // No I18N
								clk : function(data, elem, event) {
									$('#zm_dropDown').hide();// No I18N
									$('#zcs_cleanDupes').hide();// No I18N
									menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
									var rootFolderId = zmcontact.getRootFolderId();
									if(ZContacts._countObj[rootFolderId].c == 0) {
										zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.NO.CONTACT.ADDED.YET")); // No I18N
										return;
									}
									var acc = ZContacts.getCurrentAccount();
									if (data.action == "auto") {
										var infoContent = I18N.get("IAM.CONTACTS.DUPLICATES.AUTO.CLEAN.NOTE"); // No I18N
										zmsDialog.confirm(infoContent, {
											onOk : function() {
												var container;
												if (!zmsuite.getCenter()[0].$el.find('#zcs_loading').length) { // No I18N
													zmsuite.getCenter()[0].$el.prepend("<div id='zcs_loading'></div>"); // No I18N
													type = "listing"; // No I18N
												}
												container = $('#zcs_loading').get(0); // No I18N
												var loadingDiv = zmComponent.loadingBand({
													container : container,
													type : "listing" // No I18N
												});
												new URI(ZContacts.ContactsDuplicates, acc.getAccountId()).DELETE().then(function(resp) {
													loadingDiv();
													if(resp.status_code == 204) {
														try {
															if(acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
																zmcontact.invokeEvent("contactsApp/refresh", { zid : acc.getAccountId() }); // NO I18N
															}
														} catch (e) {

														}
														zmUtil.succErrMsg('s', ZContacts.getMessageFromResponse(resp)); // No I18N
													} else if (resp.status_code == 200) {
														zmUtil.succErrMsg("s", ZContacts.getMessageFromResponse(resp));// NO I18N
													} else {
														zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(resp)); // No I18N
													}
													zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
													zmcontact.refreshContactCounts();
													delete ZContacts._accountAudit[acc.getAccountId()];
													return;
												}, function(resp) {
													loadingDiv();
													zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(resp)); // No I18N
													return;
												});
											}
										});
									} else if (data.action == "manual") {
										new URI(ZContacts.ContactsDuplicates, ZContacts.getCurrentAccount().getAccountId()).GETS().then(function(contacts) {
											if (!contacts.length) {
												zmUtil.succErrMsg('e', I18N.get('IAM.CONTACTS.NO.DUPES.FOUND')); // No I18N
												return;
											} else {
												zmcontact.showCleanWorkspace();
											}
											zmcontact.unChkAll();
											var isCleanDupes = true;
											zmcontact.contactsList(contacts, false, isCleanDupes);
											zmsuite.renderWorkSpace();
											var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find('.SC_conLft');
											$(rightContainer).find('[data-val=show_duplicates]').click(function(event) {
												zmcontact.showDuplicates(event, false);
											});
											delete ZContacts._accountAudit[ZContacts.getCurrentAccount().getAccountId()];
											var _this = $(rightContainer).children()[0];
											zmcontact.showDuplicates(_this, true);
 										});	
									}
									event.stopPropagation();
								}
							}
						});

						list.push({
							htm : I18N.get("IAM.CONTACTS.ACCOUNT.AUDIT"), // No I18N
							data : {
								action : "account_audit" // No I18N
							}
						});
						
						list.push({
							htm : I18N.get("IAM.CONTACTS.TRASH") + "<i class='msi-rarrow'></i>", // No I18N
							data : {
								action : "restore_contacts" // No I18N
							},
							child : {
								divId : "zcs_trash", // No I18N
								list : [{ htm : I18N.get("IAM.CONTACTS.RESTORE"), data : {action : "restore"} } , { htm : I18N.get("IAM.CONTACTS.CLEAR"), data : {action : "clear" }}], // No I18N
								align : "cleft", // No I18N
								clk : function(data, elem, event) {
									$('#zm_dropDown').hide();// No I18N
									$(event.currentTarget.offsetParent).hide();
									menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
									var rootFolderId = zmcontact.getRootFolderId();
									var acc = ZContacts.getCurrentAccount();
									if(data.action == "clear") {
										var msg = I18N.get("IAM.CONTACTS.CLEAR.TRASH.MSG");
										var html = "<img style='float: left;left: 29px;top: 30px;margin-right: 5px;' src='"+ZContacts.getFingerPrintedFile("/images/error.png")+"''/><h4 style='float: left;width:90%;padding-top: 5px;padding-bottom: 5px;'>"+msg+"</h4>"; // No I18N
										html += "<div class='SC_PUbtm'><span id='zcs_delete' class='sel' data-field-type='clear_contact'>"+I18N.get('IAM.CONTACTS.CLEAR')+"</span><span data-val='Cancel' data-field-type='cancel_clear_contact'>"+I18N.get('IAM.CANCEL')+"</span></div>"; // No I18N
										var dialog =  Dialog['new']({
											title: "", // NO I18N
											$content: html,
											defaultCloseIcon:true
										});
										$(".SC_PUcen").find('[data-field-type="clear_contact"]').click(function() {
											zmcontact.clearContacts(ZContacts.getCurrentAccount().getAccountId(), "clear"); //No I18N
											zmcontact.removeDialog(this);
										});
										$(".SC_PUcen").find('[data-field-type="cancel_clear_contact"]').click(function() {
											zmcontact.removeDialog(this);
										});
									} else if (data.action == "restore") {
										zmcontact.restorePopUp(ZContacts.getCurrentAccount().getAccountId());
									}
									event.stopPropagation();
								}
							}
						});
					}
					listObj.par = menuNode.$el.find(".msi-action").closest("li");// No I18N
					listObj.defaultclass = true;
					listObj.parWidth = true;
					listObj.onHide = function() {
						menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
					};
					listObj.list = list;
					listObj.clk = function(data, elem, event) {
						if (data.action == "import") {
							zmcontact.zconImportDetails();
						}
						if (data.action == "export") {
							var result = ZContacts.isExportable();
							if (result == true) {
								var selectedContactIds = zmcontact.getSelectedContactIds(contactsNode.$el);
								if (selectedContactIds.length <= ZContacts.ZMailConstants.SELECT_LIMIT) {
									zmcontact.exportPopUp(contactsNode);
								}
							} else {
								zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.EXPORT.DISABLED'), result)); // No I18N
							}
						}
						if(data.action == "print"){
							zmcontact.printWorkspace(contactsNode);
						}
						if (data.action == "reset") {
							var rootFolderId = zmcontact.getRootFolderId();
							var acc = ZContacts.getCurrentAccount();
							var count = ZContacts.AccountIdVsTotalCountMap[acc.getAccountId()];
							if(count== 0 || count==undefined) {
								zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.NO.CONTACT.ADDED.YET")); // No I18N
								$('#zm_dropDown').hide();// No I18N
								menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
								return;
							}
							var msg = acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT ? I18N.get("IAM.ERROR.SURE.RESETALL.CONTACTS.ORG") : (zmcontact.isInOrgGroup(rootFolderId)) ? zmcontact.formatMessage(I18N.get("IAM.ERROR.SURE.RESETALL.CONTACTS.GROUP"), encodeHTML(ZContacts.getCurrentAccount().getName())) : I18N.get("IAM.ERROR.SURE.RESETALL.CONTACTS.PERSONAL"); // No I18N
							var html = "<img style='float: left;left: 29px;top: 30px;margin-right: 5px;' src='"+ZContacts.getFingerPrintedFile("/images/error.png")+"' /><h4 style='float: left;width:90%;padding-top: 5px;padding-bottom: 5px;'>"+msg+"</h4>"; // No I18N
							var txt = count == 1 ? I18N.get('IAM.CONTACTS.SINGLE.COUNT.DELETE') : I18N.get('IAM.CONTACTS.MULTIPLE.COUNT.DELETE'); // NO I18N
							html += "<div class='SC_PUbtm'><span id='zcs_delete' class='sel'>"+zmcontact.formatMessage(txt, count)+"</span><span data-val='Cancel'>"+I18N.get('IAM.CANCEL')+"</span></div>"; // No I18N
							var dialog =  Dialog['new']({
								title: "", // NO I18N
								$content: html,
								defaultCloseIcon:true
							});
							$(".SC_PUcen").find('#zcs_delete').click(function() {
								zmcontact.resetContacts(event);
								zmcontact.removeDialog(this);
							});
							$(".SC_PUcen").find('[data-val=Cancel]').click(function() {
								zmcontact.removeDialog(this);
							});
						}
						if (data.action == "clean_dupes") {
							$('#zcs_cleanDupes').hide();// No I18N
							menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
						}
						if (data.action == "account_audit") {
							zmcontact.accountAuditPopUp(ZContacts.getCurrentAccount().getAccountId());
						}
						if (data.action == "restore_contacts") {
							$('#zcs_trash').hide();// No I18N
							menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
						}

						$('#zm_dropDown').hide();// No I18N
						menuNode.$el.find(".msi-action").closest("b").removeClass();// No I18N
					};
					zmsuite.showMenu(listObj);
					break;
				case "msi-trash":// No I18N
					var contactIds = zmcontact.getSelectedContactIds(contactsNode.$el);
					if(contactIds.length > ZContacts.ZMailConstants.SELECT_LIMIT) {
						return false;
					}
					zmcontact.deleteMultiContacts(contactIds);
					break;
				case "msi-archive":// No I18N
					var contactIds = zmcontact.getSelectedContactIds(contactsNode.$el);
					if (contactIds.length > ZContacts.ZMailConstants.SELECT_LIMIT) {
						return false;
					}
					zmcontact.archiveContacts(contactIds);
					break;
				case "msi-unarchive":// No I18N
					var contactIds = zmcontact.getSelectedContactIds(contactsNode.$el);
					if (contactIds.length > ZContacts.ZMailConstants.SELECT_LIMIT) {
						return false;
					}
					zmcontact.unarchiveContacts(contactIds);
					break;
				case "msi-folder": // No I18N
					var contactIds = zmcontact.getSelectedContactIds(contactsNode.$el);
					if(contactIds.length > ZContacts.ZMailConstants.SELECT_LIMIT) {
						return false;
					}
					zmcontact.addTo(menuNode.$el.find(".msi-folder").closest("li"), "move"); // No I18N
					break;

				case "msi-clearContacts": // No I18N
					var selectedContactIds = zmcontact.getSelectedContactIds(contactsNode.$el);
					if(selectedContactIds.length > ZContacts.ZMailConstants.SELECT_LIMIT) {
						return false;
					}
					var categoryId = ZContacts._currentCategoryId;
					var msg;
					if (selectedContactIds.length == 1) {
						msg = zmcontact.formatMessage(I18N.get("IAM.CONTACTS.SURE.REMOVE.FROM.CATEGORY"), zmsuite.getCenter()[0].$el.find('#' + selectedContactIds[0]).get(0).__zc_contact.getFullName().trim(), zmcontact.getCategory(categoryId).category_name);
					} else {
						msg = zmcontact.formatMessage(I18N.get("IAM.CONTACTS.SURE.REMOVE.THESE.FROM.CATEGORY"), selectedContactIds.length, zmcontact.getCategory(categoryId).category_name);
					}
					zmsDialog.confirm(msg, {
						onOk : function() {
							new URI(ZContacts.ContactsCategories, ZContacts.getCurrentAccount().getAccountId(), selectedContactIds, categoryId).DELETE().then(function(resp) {
								var elem;
								var loadedCntDetail = $('div[data-field-type=zcs-cnt-view]');
								var selectedCount = selectedContactIds.length;
								var category = zmcontact.getCategory(categoryId);
								if (resp.status_code == 204) {
									for (var i = 0; i < selectedContactIds.length; i++) {
										elem = $('#' + selectedContactIds[i]);
										var nextElem;
										if (!elem.next().length && !elem.prev().length) {
											zmcontact.updateCountInCategories(category, -selectedCount, true);
											zmcontact.loadFirstPage(category);
											zmcontact.unChkAll();
											zmcontact.updateHeaderBand(category);
											zmUtil.succErrMsg("s", ZContacts.I18N.get('IAM.CONTACTS.REMOVED.FROM.CATEGORY')); // NO I18N
											return;
										} else if (elem.next().length) {
											nextElem = elem.next();
										} else {
											nextElem = $($(".zmL.SC_cont")[0]);
											zmcontact.initScroll($(zmsuite.getCenter()[0].getNodes()[2].$el.children()[0]), nextElem, elem);
										}
										elem.remove();
									}
									nextElem.click();
									zmcontact.updateCountInCategories(category, -selectedCount, true);
									zmcontact.unChkAll();
									zmcontact.updateHeaderBand(category);

									if (loadedCntDetail.attr('data-field-type') != "zcs-cnt-view") {
										zmcontact.loadContactDetails($('div[data-field-type=zcs-cnt-view]')[0].id); // No I18N
									}
									zmUtil.succErrMsg("s", ZContacts.I18N.get('IAM.CONTACTS.REMOVED.FROM.CATEGORY')); // NO I18N
								} else {
									zmUtil.succErrMsg("e", ZContacts.I18N.get('IAM.ERROR.GENERAL')); // NO I18N
								}
							});
						}
					});
					break;

				case "msi-mail": // No I18N
					var selectedMailIds = zmcontact.getSelectedMailIds(contactsNode.$el).toString();
					if (selectedMailIds.split(",").length > 100) {
						zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.ERROR.EMAIL.LIMIT.SEND'), 100)); // No I18N
						return;
					}
					zmcontact.sendMail(selectedMailIds);
					break;

				case "msi-plus": // No I18N
					zmcontact.showQuickCreate();
					break;
					
				case "zci-folder_move":
					zmcontact.addExistingContacts();
					break;
				
				case "msi-print": // No I18N
					zmcontact.printWorkspace(contactsNode);
					break;
			}
		},
		
		addRow_bulkEdit: function(selecter, rowCount) {
			var html = new ZContacts.StringBuilder();
			html.append("<div style='margin-top: 26px;display: flex'>");
			html.append("<div class='rowNumber zcs-period' style='width:23px;margin-top: 9px'>" + rowCount + "</div>");
			html.append("<div style='display: flex;flex-direction: column;'><div class='SC_flt SC_select zcs-bulk-field_name zcs-bulkBox' style='width: 210px;height: auto;border: 1px solid white;' data-field-type=bulk" + selecter + "><ul class='zmListReset' style='padding-left: 0px;margin: 0px'><li><b><input class='SC_tiput' data-field-type='empty' style='display: inline-block;min-height: 32px;padding-left: 12px' readonly=readonly></b></li></ul></div></div>");
			html.append("<div style='display: flex;flex-direction: column;'><span class='SC_flt SC_select zcs-bulk-field_action zcs-bulkBox' style='width: 210px;margin-left: 12px;height: auto;border: 1px solid white;' data-field-type=bulk" + selecter + "action ><ul class='zmListReset' style='padding-left: 0px;margin: 0px'><li><b><input class='SC_tiput' value='" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.SELECT.ACTION') + "' data-field-type='empty' style='display: inline-block;min-height: 32px;padding-left: 12px' readonly=readonly></b></li></ul></span></div>");
			html.append('<div style="display: flex;flex-direction: column;"><input type="text" class="zcs-bulk-input_box SC_select" placeholder="Enter the value" style="display: none;margin-left: 12px;padding-left: 8px;width: 242px;height: 34px;border: 1px solid white;cursor:pointer"></div>');
			html.append('<div class="msi-trash-hov" style="width: 22px;height: 22px;margin-left: 10px;margin-top: 6px;"><span class="msi-trash" style="margin-top: 4px;margin-left: 4px;"></span></div>');
			html.append('</div>');
			return html.toString();
		},
		
		getBulkEditConsent: function(contactIds) {
			var zid = ZContacts.getCurrentAccount().getAccountId();
			if (!$('#zcs_loading').length) {
				zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').prepend("<div id='zcs_loading' style='padding-bottom: 10px;'></div>");
				type = "listing"; // No I18N		
			}
			loadingDiv = zmComponent.loadingBand({
				container: $('#zcs_loading').get(0), // No i18N
				type: "listing" // No I18N
			});
			var childNodes = $('#bulkRows').children();
			var add = {};
			var edit = {};
			var clear = [];
			var isInValidField = false;
			for (var child = 0; child < childNodes.length; child++) {
				var fieldName = $(childNodes[child]).find(".zcs-bulk-field_name").find('.SC_tiput').attr("data-field-type"); // No I18N
				var action = $(childNodes[child]).find(".zcs-bulk-field_action").find('.SC_tiput').attr("data-field-type"); // No I18N
				if (fieldName == "empty") {
					loadingDiv();
					if (!$(childNodes[child]).find(".zcs-bulk-field_name").hasClass("zcs-bulkBoxErr zcs-bulk-field_nameErr")) {
						$(childNodes[child]).find(".zcs-bulk-field_name").addClass("zcs-bulkBoxErr zcs-bulk-field_nameErr");
						var errMsgDiv = $("<div></div>");
						errMsgDiv.attr("class", "zcs-field-err-msg"); //No I18N
						$(errMsgDiv).text(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.PLEASE.SELECT.FIELD'));
						$($(childNodes[child]).children()[1]).append(errMsgDiv[0]);
					}
					isInValidField = true;
				} else if (action == "empty") {
					loadingDiv();
					if (!$(childNodes[child]).find(".zcs-bulk-field_action").hasClass("zcs-bulkBoxErr zcs-bulk-field_actionErr")) {
						$(childNodes[child]).find(".zcs-bulk-field_action").addClass("zcs-bulkBoxErr zcs-bulk-field_actionErr");
						var errMsgDiv = $("<div></div>");
						errMsgDiv.attr("class", "zcs-field-err-msg"); //No I18N
						$(errMsgDiv).text(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.PLEASE.SELECT.FIELD'));
						$(errMsgDiv).css("margin-left", "12px");
						$($(childNodes[child]).children()[2]).append(errMsgDiv[0]);
					}
					isInValidField = true;
				} else {
					if (action != "clear") {
						var value = $(childNodes[child]).find(".zcs-bulk-input_box").val();
						if (ZContacts.Utils.isValidBulkEditInput(value)) {
							if (action == "add") {
								add[fieldName] = value;
							} else if (action == "edit") {
								edit[fieldName] = value;
							}
						} else {
							loadingDiv();
							if (!$(childNodes[child]).find(".zcs-bulk-input_box").hasClass("zcs-bulk-input_boxErr")) {
								$(childNodes[child]).find(".zcs-bulk-input_box").addClass("zcs-bulk-input_boxErr");
								var errMsgDiv = $("<div></div>");
								errMsgDiv.attr("class", "zcs-field-err-msg"); //No I18N
								$(errMsgDiv).text(zmcontact.formatMessage(I18N.get("IAM.CONTACTS.PLEASE.ENTER.VALID.FIELD"), ZContacts.I18N.get(bulkEdits.I18ValueKeyMap[fieldName])));
								$(errMsgDiv).css("margin-left", "13px");
								$($(childNodes[child]).children()[3]).append(errMsgDiv[0]);
							}
							isInValidField = true;
						}
					} else {
						clear.push(fieldName);
					}
				}
			}
			if (isInValidField) {
				return;
			}
			var mappingConfirmation = ZContacts.BulkEditConsent.create();
			mappingConfirmation.set('contact_ids', contactIds); //No I18N
			mappingConfirmation.set('add', add); //No I18N
			mappingConfirmation.set('edit', edit); //No I18N
			mappingConfirmation.set('clear', clear); //No I18N
			new ZContacts.URI(ZContacts.BulkEditConsent, zid).PUT(mappingConfirmation).then(function(response) {
				loadingDiv();
				if (response.contacts) {
					var notNullFields = response.contacts.notNullFields;
					if (notNullFields != null && Object.keys(notNullFields).length != 0) {
						$(zmsuite.getCenter()[0].getNodes()[2]).append(zmcontact.bulkEditOverWriteConsent(response.contacts)); // appending row
					} else {
						loadingDiv();
						zmUtil.succErrMsg("e", ZContacts.I18N.get('IAM.ERROR.GENERAL')); // NO I18N
						return;
					}
				}
			}, function(response) {
				loadingDiv();
				if (response.status_code == 500) {
					zmUtil.succErrMsg("e", ZContacts.I18N.get('IAM.ERROR.GENERAL')); // NO I18N
					return;
				} else if (response.status_code == 400) {
					$txtBox = $($(zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#bulkRows")).children().find('[data-field-type="'+response.errors["0"].params.param_name+'"]').closest(".zcs-bulk-field_name").parent().siblings()[2]).find(".zcs-bulk-input_box"); //No I18N
					if (! $txtBox.hasClass("zcs-bulk-input_boxErr")) {
						$txtBox.addClass("zcs-bulk-input_boxErr");
						var errMsgDiv = $("<div></div>");
						errMsgDiv.attr("class", "zcs-field-err-msg"); //No I18N
						$(errMsgDiv).text(ZContacts.getMessageFromResponse(response));
						$(errMsgDiv).css("margin-left", "13px");
						$txtBox.parent().append(errMsgDiv[0]);
					}
				}
			});
		},
		
		bulkEditOverWriteConsent: function(response) {
			var consentDetails = {};
			var notNullFields = response.notNullFields;

			consentDetails.title = ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.CONFIRM.CHANGES');
			consentDetails.mask = true;
			consentDetails.buttons = [{
				isCancel: true,
				txt: ZContacts.I18N.get("IAM.CANCEL"),
				callback: function() {
					zmsDialog.remove();
					$("#zcs-bulkConsentPopup").remove(); // No I18N
				}
			}, {
				isProceed: true,
				txt: ZContacts.I18N.get('IAM.CONTACTS.PROCEED'),
				callback: function() {
					if (!$('#zcs_loading').length) {
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').prepend("<div id='zcs_loading' style='padding-bottom: 10px;'></div>");
						type = "listing"; // No I18N		
					}
					loadingDiv = zmComponent.loadingBand({
						container: $('#zcs_loading').get(0), // No i18N
						type: "listing" // No i18N
					});
					$("#zmsdialog_zcs-bulkConsentPopup").find(".msi-close").click();
					removefieldArrNames = [];
					var rowElementFields = $("#zmsdialog_zcs-bulkConsentPopup").find('#zcs-bulkConsentPopup').children();
					for (var i = 0; i < rowElementFields.length - 2; i++) {
						if ($($("#zmsdialog_zcs-bulkConsentPopup").find('#zcs-bulkConsentPopup').children()[i]).find(".SC_PUbtm").children()[0].dataset.val == "removed") {
							removefieldArrNames.push($($("#zmsdialog_zcs-bulkConsentPopup").find('#zcs-bulkConsentPopup').children()[i]).find(".itemName").attr("data-field-type")); //No I18N
						}
					}
					if (removefieldArrNames.length == $("#zmsdialog_zcs-bulkConsentPopup").find('#zcs-bulkConsentPopup').children().length - 2) {
						loadingDiv();
						zmUtil.succErrMsg("e", ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ERROR.NONE.SELECTED')); //No I18N
						return;
					}

					for (var i = 0; i < removefieldArrNames.length; i++) {
						for (var action in response) {
							if (action == "clear") {
								response[action].splice(response[action].indexOf(removefieldArrNames[i]), 1)
							} else if (response[action].hasOwnProperty(removefieldArrNames[i])) {
								delete response[action][removefieldArrNames[i]];
								break;
							}
						}
					}
					
					// checking for no update
					if (zmcontact.checkForNoUpdate(response)) {
						loadingDiv();
						zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#zcs-cancel-btn").click();
						zmUtil.succErrMsg("e", ZContacts.I18N.get("IAM.CONTACTS.BULK.NO.UPDATE"));// NO I18N
						return;
					}
				

					var zid = ZContacts.getCurrentAccount().getAccountId();
					var mappingConfirmation = ZContacts.BulkEdit.create();
					mappingConfirmation.set('contact_ids', response.contact_ids); //No I18N
					mappingConfirmation.set('add', response.add); //No I18N
					mappingConfirmation.set('edit', response.edit); //No I18N
					mappingConfirmation.set('clear', response.clear); //No I18N
					new ZContacts.URI(ZContacts.BulkEdit, zid).PUT(mappingConfirmation).then(function(response) {
						if (response) {
							loadingDiv();
							zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#zcs-cancel-btn").click();
							zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts.getCurrentAccount().getRootFolderId()));
							zmUtil.succErrMsg("s", ZContacts.I18N.get("IAM.CONTACTS.BULK.UPDATE.SUCCESS"));// NO I18N
						}
					}, function(response) {
						loadingDiv();
						if (response.status_code == 500) {
							zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#zcs-cancel-btn").click();
							zmUtil.succErrMsg("e", ZContacts.I18N.get('IAM.ERROR.GENERAL')); // NO I18N
							return;
						} else if (response.status_code == 400) {
							zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response)); // NO I18N
						}
					});
				}
			}];


			consentDetails.closeaction = function() {
				zmsDialog.remove();
				$("#zcs-bulkConsentPopup").remove(); // No I18N
			};

			consentDetails.pos = "center"; // No I18N
			createFolElem = $("<div id='zcs-bulkConsentPopup' style='max-height: 500px;'>"); // No I18N
			var description = "";
			var consentRowCount = 0;
			for (var action in notNullFields) {
				for (var fieldName in notNullFields[action]) {
					description += '<div style="display: flex;justify-content: space-between;margin-bottom: 20px;align-items: center;column-gap: 14px;">';
					description += '<div style="display: flex;column-gap: 14px"><div style="width: 2px;background: #3869D5;border-radius: 2px 0px 0px 2px;"></div>';
					description += '<div style="line-height: 22px"><span data-field-type="' + encodeHTML(fieldName) + '" class="itemName" style="color: #3869D5;font-weight: 600;">' + ZContacts.I18N.get(bulkEdits.I18ValueKeyMap[fieldName]) + '</span><br>';
					var notNullCount = notNullFields[action][fieldName];
					notNullCount = encodeHTML(notNullCount.toString());
					var addCount = response.contact_ids.length - (notNullCount);
					if (action == "add") {
						if (addCount == 0) {
							description += '<span>' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ADD.CONSENT.NO.CONTACT') + '</span></div></div>'
						}
						else if (addCount == 1) {
							description += '<span>' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ADD.CONSENT.SINGLE') + '</span></div></div>'
						} else {
							description += '<span>' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ADD.CONSENT'), addCount) + '</span></div></div>'
						}
					} else if (action == "edit") {
						if (addCount == 0) {
							description += '<span>' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.CONSENT.UPDATE.MANY'), notNullCount) + '</span></div></div>'
						} else if (addCount == 1) {
							if (notNullCount == 1) {
								description += '<span>' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.CONSENT.UPDATE.ADD.SINGLE') + '</span></div></div>'
							} else {
								description += '<span>' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.CONSENT.UPDATE.SINGLE.ADD'), notNullCount) + '</span></div></div>'
							}
						} else if (addCount > 1) {
							if (notNullCount == 0) {
								description += '<span>' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.CONSENT.ADD.ONLY'), addCount) + '</span></div></div>'
							} else if (notNullCount == 1) {
								description += '<span>' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.CONSENT.UPDATE.SINGLE.ADD.MANY'), addCount) + '</span></div></div>'
							} else {
								description += '<span>' + zmcontact.formatMessage(I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.CONSENT.UPDATE.MULTIPLE'), notNullCount, addCount) + '</span></div></div>'
							}
						}
					} else {
						if (notNullCount == 0) {
							description += '<span>' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.CLEAR.CONSENT.NO.CONTACT') + '</span></div></div>'
						} else if (notNullCount == 1) {
							description += '<span>' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.CLEAR.CONSENT.SINGLE') + '</span></div></div>'
						} else {
							description += '<span >' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.CLEAR.CONSENT.MANY'), notNullCount) + '</span></div></div>'
						}
					}
					description += '<div class="SC_PUbtm zcs-remove-button-bulk-edit" onclick="zmcontact.removeOptionBulkEdit(this)" style="margin-top: unset"><span data-val="noRemove" style="position: relative;background: white;color: black;border: 1px solid #CCCCCC;border-radius: 4px;white-space: nowrap;">'+ZContacts.I18N.get("IAM.REMOVE")+'</span></div>';
					description += '</div>';
					consentRowCount++;
				}
			}

			createFolElem.append(description);
			createFolElem.append("</div>");
			createFolElem.append('<div style="height: 1px;background: #e7e7e7;margin-left:-33px;position: absolute;width: 100%;"></div>');
			var endDescription = '<div style="position: fixed; margin-top: 25px"><span style="color: #00000099;">' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.OF.SELECTED'), encodeHTML(response.contact_ids.length.toString())) + '</span></div>';
			createFolElem.append(endDescription);
			$(document.body).append(createFolElem);
			zmsDialog.create("zcs-bulkConsentPopup", consentDetails); // No I18N
			$(".SC_PUtt h3").css('line-height', '20px');
			$("#zmsdialog_zcs-bulkConsentPopup").find('.SC_PUbtm').css("text-align", "right"); // No I18N
			$("#zmsdialog_zcs-bulkConsentPopup").css("inset", "0px");
			$(".SC_pe").find("[data-val='Cancel']").siblings().css("background", "#3869D5"); // No I18N
			$(".SC_pe").find("[data-val='Cancel']").siblings().css("border-radius", "4px"); // No I18N
			$(".SC_pe").find("[data-val='Cancel']").css("border-radius", "4px"); // No I18N
			
		},
		
		removeOptionBulkEdit: function(elem) {
			var $removeElem = $($(elem).children()[0]);
			if (elem.children[0].dataset.val === "noRemove") {
				$(elem).children()[0].innerText = ZContacts.I18N.get('IAM.CONTACTS.REMOVED');
				$removeElem.prepend("<i class='msi-tik' style='height: auto;width: auto;padding: 0px !important;border: unset;'></i>");
				$removeElem.css("background", "#EBF1FE"); // No I18N
				$removeElem.css("border", "1px solid #3869D6"); // No I18N
				elem.children[0].dataset.val = "removed"
			} else {
				$(elem).children()[0].innerText =  ZContacts.I18N.get('IAM.REMOVE');
				$removeElem.removeClass("msi-tik");
				$removeElem.css("width", "unset"); // No I18N
				$removeElem.css("background", "white"); // No I18N
				$removeElem.css("border", "1px solid #CCCCCC"); // No I18N
				elem.children[0].dataset.val = "noRemove"
			}
		},
		
		checkForNoUpdate: function(response) {
			var actionArr = ["add", "clear"]; //NO I18N
			for (var i = 0; i < actionArr.length; i++) {
				for (var keyNotNull in response.notNullFields[actionArr[i]]) {
					if (actionArr[i] == "add") {
						if (response.notNullFields[actionArr[i]][keyNotNull] == response.contact_ids.length) {
							delete response[actionArr[i]][keyNotNull];
						}
					} else {
						if (response.notNullFields[actionArr[i]][keyNotNull] == 0) {
							response[actionArr[i]].splice(response[actionArr[i]].indexOf(keyNotNull), 1)
						}
					}
				}
			}

			if (Object.keys(response.add).length === 0 && Object.keys(response.edit).length === 0 && Object.keys(response.clear).length === 0) {
				return true;
			} else {
				return false;
			}
		}, 
		
		removeDialog : function(t) {
			$(t).parents('.SC_PU').find('.msi-close').click();
		},
		
		resetContacts : function(e) {
			if (ZContacts.meta.user.reset_scheduled == true) {
				zmUtil.succErrMsg("s", I18N.get("IAM.RESET.CONTACTS.IS.SCHEDULED"));// NO I18N
			} else {
				if(e && ZContacts.getCurrentAccount().is_writable) {
					zmcontact.deleteAllContacts(ZContacts.getCurrentAccount().account_id);
				}
			}
		},
		
		sendMail : function(mailIds) {
			if(zmail.forContactsApp){
				var mailBoxExist = zmail.isMailBoxExist;
				if(mailBoxExist) {
					 var url = zmail.urls.mailToUrl.replace(/&amp;/g, "&").replace(/&equals;/g, "=");
                     zmcontact.wopen(url+mailIds, 80, 77).focus();
					return;
				} else {
					window.location.href = "mailto:"+mailIds.split(",").join(";");
				}
			} else {
				zmUtil.compose({
					"TO" : mailIds, // No I18N
					"fetchContacts" : true // No I18N
				});
			}
		},
		
		wopen : function(url, wd, ht, name) {
		    var nW = parseInt((wd * screen.width) / 100);
		    var nH = parseInt((ht * screen.height) / 100);
		    var l = (screen.width - nW) / 2;
		    var t = (screen.height - nH) / 2;
		    name = name ? name : new Date().getTime();
		    return window.open(url, name, "height=" + nH + ", width=" + nW + ",status=yes,toolbar=no,top=" + t + ", left=" + l + ", menubar=no,location=no,scrollbars=yes,resizable=yes");
		},
		
		exportPopUp : function(contactsNode, category) {
			var noOfContactsSelected = contactsNode.$el.find(".zmL.SC_cont.SC_check").length;
			var contactIdsArr = zmcontact.getSelectedContactIds(zmsuite.getCenter()[0].getNodes()[2].$el);
			var exportDiv = {};
			exportDiv.title = I18N.get("IAM.CONTACTS.EXPORT.CONTACTS"); // No I18N
			exportDiv.mask = true;
			exportDiv.buttons = [ {
				txt : I18N.get("IAM.CONTACTS.EXPORT.CONTACTS"), // No I18N
				selected : true,
				callback : function(data) {
					var password = $("#zcs_export_password_div").find("input").val();
					if($("#zcs_exportPopup").find(".msi-check").length) {
						if(!password || !password.trim()) {
							zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.PASSWORD.REQUIRED.TO.EXPORT")); // No I18N
							return false;
						}
						if(password.length < 4) {
							zmUtil.succErrMsg('e', zmcontact.formatMessage(I18N.get("IAM.CONTACTS.PASSWORD.MINIMUMLENGTH"), 4)); // No I18N
							return false;
						}
					}
					var accountId, categoryId;
					if (noOfContactsSelected) {
						accountId = ZContacts.getCurrentAccount().getAccountId();
					} else {
						accountId = $('#zcs_account').find("input")[0].id;
						categoryId = $('#zcs_category').find("input")[0].id;
					}
					var uri;
					if(contactIdsArr && contactIdsArr.length) {
						uri = new URI(ZContacts.ExportContacts, accountId, contactIdsArr.toString());
						var acc = zmcontact.getAccountByZidForType(accountId, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
						if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT && isNewSearchWorkSpace()) {
							uri.include("org"); // No I18N
						}
					} else {
						if(ZContacts._countObj[categoryId].c != undefined && ZContacts._countObj[categoryId].c == 0) {
							var name;
							if(zmcontact.isRootFolder(categoryId)) {
								name = I18N.get('IAM.CONTACTS.ALL.CONTACTS'); 
							} else {
								var category = zmcontact.getCategory(categoryId);
								name = category.category_name;
							}
							zmUtil.succErrMsg('e', zmcontact.formatMessage(I18N.get("IAM.CONTACTS.NO.CONTACTS.AVAILABLE.CATEGORY"), name)); // No I18N
							return;
						}
						uri = new URI(ZContacts.ExportContacts, accountId);
						if (categoryId && !zmcontact.isRootFolder(categoryId)) {
							uri.addPostParam("filter_categories", categoryId); // No I18N
						}
					}
					var exportModel = ZContacts.ExportContacts.create();
					var format = $('#zcs_exportPopup').find("#format").attr('data-field-type');
					if(password) {
						uri.setAuthHeader(accountId, password);
					}
					uri.addPostParam("filter_format", format); // No I18N
					uri.POST(exportModel);
					delete ZContacts._accountAudit[accountId];
					zmsDialog.remove();
					zmcontact.unChkAll();

				}
			}, {
				isCancel : true,
				txt : I18N.get("IAM.CANCEL"),
				callback : function() {
					zmsDialog.remove();
					$("#zcs_exportPopup").remove();
				}
			} ];

			exportDiv.closeaction = function() {
				zmsDialog.remove();
				$("#zcs_exportPopup").remove();
			};
			exportDiv.pos = "center"; // No I18N
			createFolElem = $("<div id='zcs_exportPopup'></div>");
			if (!$("#zcs_exportPopup").length) {
				var tags = "<div class='SC_tdtl'>";
				if (noOfContactsSelected) {
					tags = tags + "<div class='SC_flt SC_fst' style='padding-top: 6px;'><ul class='zmListReset'><li><b>" + zmcontact.formatMessage(I18N.get("IAM.CONTACTS.OF.SELECTED"), noOfContactsSelected) + "</b></li></ul></div>";
				} else {
					if (category) {
						var categoryId = category.category_id;
						var rootFolderId = zmcontact.getRootFolderId(categoryId);
						var name = encodeHTML(category.category_name);
						if (rootFolderId == categoryId) {
							name = I18N.get('IAM.CONTACTS.ALL.CONTACTS');
						}
						var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
						tags = tags + "<div class='SC_flt SC_select' data-field-type='export_accounts_type' style='width: 30%' id='zcs_account'><ul class='zmListReset'><li><b><input id='" + acc.getAccountId() + "' name='" + encodeHTML(acc.getName()) + "' placeholder='" + encodeHTML(acc.getName()) + "' class='SC_tiput' style='border:0px;min-height: 30px;' readonly=readonly></b></li></ul></div>";
						tags = tags + "<div class='SC_flt SC_select' data-field-type='export_category_type' style='width: 30%;margin-left: 5px;' id='zcs_category'><ul class='zmListReset'><li><b><input id='" + category.category_id + "' name='filter_categories' placeholder='" + name + "' class='SC_tiput' style='border:0px;min-height: 30px;' readonly=readonly></b></li></ul></div>";
					} else {
						var acc = zmcontact.getMyAccountForType(ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
						var category = zmcontact.getCategory(acc.getRootFolderId());
						tags = tags + "<div class='SC_flt SC_select' data-field-type='export_accounts_type' style='width: 30%' id='zcs_account'><ul class='zmListReset'><li><b><input id='" + acc.getAccountId() + "' name='" + encodeHTML(acc.getName()) + "'placeholder='" + encodeHTML(acc.getName()) + "' class='SC_tiput' style='border:0px;min-height: 30px;' readonly=readonly></b></li></ul></div>";
						tags = tags + "<div class='SC_flt SC_select' data-field-type='export_category_type' style='width: 30%;margin-left: 5px;' id='zcs_category'><ul class='zmListReset'><li><b><input id='" + category.category_id + "' name='filter_categories' placeholder='" + I18N.get('IAM.CONTACTS.ALL.CONTACTS') + "' class='SC_tiput' style='border:0px;min-height: 30px;' readonly=readonly></b></li></ul></div>";
					}

				}

				tags = tags + "<div class='SC_flt SC_select' style='width: 30%;;margin-left: 5px;' data-field-type='export_format_type' id='zcs_format'><ul class='zmListReset'><li><b><input class='SC_tiput' placeholder='" + I18N.get("IAM.CONTACTS.EXPORT.FORMAT.CSV") + "' id='format' name='format' data-field-type='csv' style='display: inline-block;border:0px;min-height: 30px;' readonly=readonly></b></li></ul></div></div>"; // No I18N
				tags = tags + "<div class='SC_flt' style='position: relative;padding-bottom: 15px;top: 12px;'><div class='zmFlt' style='color: #878787'><i class='msi-uncheck' data-field-type='show_password'></i><span style='font-size: 12px'>"+I18N.get('IAM.CONTACTS.SECURE.EXPORT.FILE')+"</span></div></div>";
				tags = tags + "<br><div class='SC_flt' style='display: none;' id='zcs_export_password_div'><input type='password' name='password' autocomplete='new-password' placeholder='"+I18N.get("IAM.CONTACTS.ENTER.PASSWORD.EXPORT.ZIP")+"' class='SC_tiput'>";
				tags = tags + "<div style='clear:both;padding-top: 10px;'><span style='font-size: 12px;color: #878787;'>"+I18N.get('IAM.NOTE')+": </span><span style='font-size: 12px;color: #878787'>"+I18N.get('IAM.CONTACTS.PASSWORD.ZIP.NOTE')+"</span></div></div>";
				createFolElem.append(tags);
				$(document.body).append(createFolElem);
			}
			zmsDialog.create("zcs_exportPopup", exportDiv); // No I18N
			$("#zcs_exportPopup").parent().css("overflow-y","hidden");
			$('#zcs_exportPopup').parents('.SC_pe').on("click", function(e){
				  e.stopPropagation();
				});
			$('#zcs_exportPopup').parents('.SC_Pop').on("click",function(){
				this.remove();
			});
			$('#zcs_exportPopup').find('[data-field-type="export_accounts_type"]').click(function() {
				var list = $("#zcs_exportPopup").find("#zcs_account ul li");
				zmcontact.getScrollList(list, 'account', false); //No I18N
			})
			$('#zcs_exportPopup').find('[data-field-type="export_category_type"]').click(function() {
				var list = $("#zcs_exportPopup").find("#zcs_category ul li");
				zmcontact.getScrollList(list, 'category', false); //No I18N
			})
			$('#zcs_exportPopup').find('[data-field-type="export_format_type"]').click(function() {
				zmcontact.getFormatList(this)
			})
			$('#zcs_exportPopup').find('[data-field-type="show_password"]').click(function() {
				showPassWord(this)
			})
		},

		exportContacts : function(account_id, contactIdsArr, categoryId) {
			if(contactIdsArr && !contactIdsArr.length) {
				if(ZContacts._countObj[categoryId].c != undefined && ZContacts._countObj[categoryId].c == 0) {
					var name;
					if(zmcontact.isRootFolder(categoryId)) {
						name = I18N.get('IAM.CONTACTS.ALL.CONTACTS'); 
					} else {
						var category = zmcontact.getCategory(categoryId);
						name = category.category_name;
					}
					zmUtil.succErrMsg('e', zmcontact.formatMessage(I18N.get("IAM.CONTACTS.NO.CONTACTS.AVAILABLE.CATEGORY"), name)); // No I18N
					return;
				}
			}
			var form = document.createElement("form"); // NO I18N
			form.setAttribute("style", "display : none");
			form.setAttribute("id", "zcs_export_form");
			var format = $('#zcs_format input')[0].getAttribute("data-field-type").trim();
			var formatEle = document.createElement("input");
			formatEle.setAttribute("name", "filter_format");
			formatEle.setAttribute("value", format);
			form.appendChild(formatEle);
			var acc = zmcontact.getAccountByZidForType(account_id, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
			var uri = new URI(ZContacts.ExportContacts, account_id).requestURI;
			if (contactIdsArr && contactIdsArr.length) {
				uri += "/" + contactIdsArr.join(",");
				if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT && isNewSearchWorkSpace()) {
					var include = document.createElement("input");
					include.setAttribute("name", "include");
					include.setAttribute("value", "org");
					form.appendChild(include);
				}
			} else {
				if (!zmcontact.isRootFolder(categoryId)) {
					var catEle = document.createElement("input");
					catEle.setAttribute("name", "filter_categories");
					catEle.setAttribute("value", categoryId);
					form.appendChild(catEle);
				}
			}

			var csrfElem = document.createElement("input");
			csrfElem.setAttribute("value", ZContacts.Cookie.getCSRFValue());
			csrfElem.setAttribute("name", ZContacts.meta.serviceInfo.csrf_param_name);
			form.appendChild(csrfElem);

			form.setAttribute("action", uri);
			form.setAttribute("method", "get");
			var iframe = document.createElement("iframe");
			iframe.setAttribute("src", ZContacts.meta.serviceInfo.contacts_server_url + "/html/blank.html");
			iframe.setAttribute("width", 0);
			iframe.setAttribute("heigth", 0);
			iframe.style.display = "none";
			iframe.setAttribute("name", "zcs_exportFrame");
			form.target = "zcs_exportFrame";
			form.appendChild(iframe);
			document.body.appendChild(form);
			zmcontact.unChkAll();
			zmsDialog.remove();
			form.submit();
			
		},

		getSelectedMailIds : function(ele) {
			var mailArr = [];
			ele = $(ele.find(".zmL.SC_cont.SC_check"));
			for (var i = 0; i < ele.length; i++) {
				if (ele.get(i).__zc_contact.emails) {
					mailArr.push(ele.get(i).__zc_contact.getPrimaryEmail());
				}
			}
			return mailArr;
		},

		showMergeUI : function(contactIds, isMerge) {
			new URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId(), contactIds).include("emails").include("phones").include("address").include("urls").GET().then(function(contacts) { // No i18N
				if (!contacts[0]) {
					zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
					zmUtil.succErrMsg("e", ZContacts.I18N.get('IAM.ERROR.GENERAL')); // NO I18N
					return;
				}
				var leftObj;
				if (!isMerge) {
					leftObj = {
						leftHTML : I18N.get("IAM.CONTACTS.CLEAN.DUPLICATES")
					};
					var headerObj = {
						left : leftObj,
						right : []
					};
					zmsuite.getCenter()[0].getNodes()[1].push(headerObj);
					zmsuite.getCenter()[0].getNodes()[1].paint();
				}
				zmcontact.showMergePage(contacts, contactIds, isMerge);
				var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_PUcen');
				$(rightContainer).find('#zcs_name_label').removeAttr("id");
				$(rightContainer).find('[data-field-type=merge_first_name]').on("click", function(event){
					$('input[data-field-type=first_name]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_middle_name]').on("click", function(event){
					$('input[data-field-type=middle_name]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_last_name]').on("click", function(event){
					$('input[data-field-type=last_name]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_nick_name]').on("click", function(event){
					$('input[data-field-type=nick_name]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_home_street_addr]').on("click", function(event){
					$('input[data-field-type=hme_street_addr]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_home_street_addr1]').on("click", function(event){
					$('input[data-field-type=hme_street_addr1]').val(encodeHTML(event.target.firstChild.data));
				});

				$(rightContainer).find('[data-field-type=merge_home_city]').on("click", function(event){
					$('input[data-field-type=hme_city]').val(encodeHTML(event.target.firstChild.data));
				});

				$(rightContainer).find('[data-field-type=merge_home_state]').on("click", function(event){
					$('input[data-field-type=hme_state]').val(encodeHTML(event.target.firstChild.data));
				});

				$(rightContainer).find('[data-field-type=merge_home_country]').on("click", function(event){
					$('input[data-field-type=hme_country]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_home_postal_code]').on("click", function(event){
					$('input[data-field-type=hme_postal_code]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_company_name]').on("click", function(event){
					$('input[data-field-type=company]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_designation]').on("click", function(event){
					$('input[data-field-type=designation]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_wrk_street_addr]').on("click", function(event){
					$('input[data-field-type=wrk_street_addr]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_wrk_street_addr1]').on("click", function(event){
					$('input[data-field-type=wrk_street_addr1]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_wrk_city]').on("click", function(event){
					$('input[data-field-type=wrk_city]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_wrk_state]').on("click", function(event){
					$('input[data-field-type=wrk_state]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_wrk_country]').on("click", function(event){
					$('input[data-field-type=wrk_country]').val(encodeHTML(event.target.firstChild.data));
				});
				
				$(rightContainer).find('[data-field-type=merge_wrk_postal_code]').on("click", function(event){
					$('input[data-field-type=wrk_postal_code]').val(encodeHTML(event.target.firstChild.data));
				});
			});
		},
		checkFav : function(t) {
			var $t = $(t);
			$t.parent(".zcs-mfield-row").siblings().find(".SC_fav").removeClass("SC_fav"); // No I18N
			$t.addClass('SC_fav');
		},
		
		getFormatList : function(t) {
			var formatObj = {};
			var format = [ {
				htm : I18N.get("IAM.CONTACTS.EXPORT.FORMAT.CSV"),
				data : {
					action : "csv" // No I18N
				}
			}, {
				htm : I18N.get("IAM.CONTACTS.EXPORT.FORMAT.VCF"),
				data : {
					action : "vcf" // No I18N
				}
			}, {
				htm : I18N.get("IAM.CONTACTS.EXPORT.FORMAT.LDIF"),
				data : {
					action : "ldif" // No I18N
				}
			}, {
				htm : I18N.get("IAM.CONTACTS.EXPORT.FORMAT.HTML"),
			    data : {
			        action : "html" // No I18N
			    }
			}, {
				htm : I18N.get("IAM.CONTACTS.EXPORT.FORMAT.OUTLOOK.CSV"),
			    data : {
			        action : "outlook" // No I18N
			    }
			}];
			
			formatObj.list = format;
			formatObj.par = $("#zcs_exportPopup").find("#zcs_format ul li");// No I18N
			formatObj.defaultclass = true;
			formatObj.parWidth = true;
			formatObj.onHide = function() {

			};
			formatObj.clk = function(data, elem, event) {
				if (data.action == "csv") {
					$('#zmsdialog_zcs_exportPopup').find("#format")[0].placeholder = I18N.get("IAM.CONTACTS.EXPORT.FORMAT.CSV");
				}
				if (data.action == "vcf") {
					$('#zmsdialog_zcs_exportPopup').find("#format")[0].placeholder = I18N.get("IAM.CONTACTS.EXPORT.FORMAT.VCF");
				}
				if (data.action == "ldif") {
					$('#zmsdialog_zcs_exportPopup').find("#format")[0].placeholder = I18N.get("IAM.CONTACTS.EXPORT.FORMAT.LDIF");
				}
				if (data.action == "html") {
					$('#zmsdialog_zcs_exportPopup').find("#format")[0].placeholder = I18N.get("IAM.CONTACTS.EXPORT.FORMAT.HTML");
				}
				if (data.action == "outlook") {
					$('#zmsdialog_zcs_exportPopup').find("#format")[0].placeholder = I18N.get("IAM.CONTACTS.EXPORT.FORMAT.OUTLOOK.CSV");
				}
				
				$('#zmsdialog_zcs_exportPopup').find("#format")[0].setAttribute("data-field-type", data.action);
				$('#zm_dropDown').hide();// No I18N
			};
			zmsuite.showMenu(formatObj);
		},

		getFormatRestoreList : function(t) {
			var formatObj = {};
			var format = [ {
				htm : I18N.get("IAM.CONTACTS.10.DAYS"),
				data : {
