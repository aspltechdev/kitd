				$('#zm_dropDown').hide();// No I18N
			};
			zmsuite.showMenu(formatObj);
		},

		addTo : function(parentEle, operation){
			var contactsNode = zmsuite.getCenter()[0].getNodes()[2];
			var contactIdsArr = zmcontact.getSelectedContactIds(contactsNode.$el);
			var viewCategoriesList = null;
			var config = {};
			config.parentDOM = parentEle;// No I18N
			config.displayAs = "dropdown"; // NO I18N
			config.hltPar = true;
			config.offsets = {
				left : 0,
				top : 0
			};
			config.onSelect = function(id, elem) {
				if(!id){
					zmcontact.unChkAll();
					viewCategoriesList.hide();
					return;
				}
				var destZid = ZContacts.AccountsVsRootFolderMap[zmcontact.getRootFolderId(id)];
				var sourceZid = ZContacts.getCurrentAccount().getAccountId();
				var categoryId = (zmcontact.isRootFolder(id))? -1 : id;
				if (operation == "move") {
//					zmcontact.addContactsToCategory(contactIdsArr, categoryId);
					var copy = ZContacts.Copy.create();
					var obj = {};
					var size = 0;
					$.each(zmsuite.getCenter()[0].$el.find('.SC_cont.SC_check'), function(key, value) {
						if(!obj[value.__zc_contact.zid]) {
							obj[value.__zc_contact.zid] = [];
							size++;
						}
						obj[value.__zc_contact.zid].push(value.__zc_contact.contact_id);
					});
					if(size == 1) {
						$.each(obj, function(zid, idsArr) {
							var from = ZContacts.CopyFrom.create({ 
								zid : zid, contact_ids : idsArr
							});
							copy.addSubResource(from);
						});
					} else {
						$.each(obj, function(zid, idsArr) {
							var from = ZContacts.CopyFromMultiple.create({zid : zid, contact_ids : idsArr});
							copy.addSubResource(from);
						});
					}
					var copyto = ZContacts.CopyTo.create({
						zid : destZid.account_id,
						category_id : categoryId
					});
					copy.addSubResource(copyto);
					new URI(ZContacts.Copy, destZid.getAccountId()).POST(copy).then(function(response) {
						if (response.status_code == 201) {
							zmcontact.refreshContactCounts(destZid.getAccountId());
							zmUtil.succErrMsg('s', ZContacts.getMessageFromResponse(response)); // No I18N
							return;
						} else {
							zmUtil.succErrMsg("e", I18N.get('IAM.ERROR.GENERAL'));// NO I18N
							return;
						}
					}, function(json) {
						zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
					});
					zmcontact.unChkAll();
				}
				viewCategoriesList.hide();
			};
			var rootFolderId = null;
			config.dataCallback = function() {
				var cat = [];
				if(ZContacts.getCurrentAccount().is_writable){
					if(isNewSearchWorkSpace()) {
						cat.push({
							id : ZContacts.getCurrentAccount().getRootFolderId(),
							display_text : encodeHTML(ZContacts.getCurrentAccount().name) + "/",
							tooltip : encodeHTML(ZContacts.getCurrentAccount().name) + "/"
						});
					}
					var cate = ZContacts._parentObj[ZContacts.getCurrentAccount().getRootFolderId()];
					if (cate) {
						for (var i = 0; i < cate.length; i++) {
							var display = "/" + encodeHTML(cate[i].category_name) + "/";
							if(display.length > 20){
								var displayText = ".../" + encodeHTML(cate[i].category_name.substring(0,19)) + "...";
							}else{
								var displayText = encodeHTML(ZContacts.getCurrentAccount().name) + "/" + encodeHTML(cate[i].category_name) + "/";
							}
							cat.push({
								id : cate[i].category_id,
								name : displayText,
								display_text : displayText,
								tooltip : encodeHTML(ZContacts.getCurrentAccount().name) + "/" + encodeHTML(cate[i].category_name) + "/"
							});
						}
					}
				}
				for(var i=0; i < ZContacts.AccountsList.length; i++){
					if (ZContacts.AccountsList[i].id != ZContacts.getCurrentAccount().account_id && ZContacts.AccountConstants[ZContacts.AccountsList[i].type].add_contact) {
						var rootFolderId = ZContacts.AccountsVsRootFolderMap[ZContacts.AccountsList[i].id];
						var acc = ZContacts.AccountsVsRootFolderMap[rootFolderId];
						if (acc && acc.is_writable){
							cat.push({
								id : acc.getRootFolderId(),
								display_text : encodeHTML(ZContacts.AccountsList[i].name) + "/",
								tooltip : encodeHTML(ZContacts.AccountsList[i].name) + "/"
							});
							var categories = ZContacts._parentObj[acc.getRootFolderId()];
							if (categories) {
								for (var j = 0; j < categories.length; j++) {
									var display = "/" + encodeHTML(categories[j].category_name) + "/";
									if(display.length > 20){
										var displayText = ".../" + encodeHTML(categories[j].category_name.substring(0,19)) + "...";
									}else{
										var displayText = encodeHTML(acc.name) + "/" + encodeHTML(categories[j].category_name) + "/";
									}
									cat.push({
										id : categories[j].category_id,
										name : categories[j].encrypt_cat_id,
										display_text : displayText,
										tooltip : encodeHTML(acc.name) + "/" + encodeHTML(categories[j].category_name) + "/"
									});
								}
							}
						}
					}
				}
				return cat;
			};
			viewCategoriesList = zmUtil.createFLComp("generic", config); // No I18N
			viewCategoriesList.show();
		},
		
		// see 4
		getScrollList : function(parentEle, operation, isWritable) {
			$(".zcs-import-form").on( 'scroll', function(){
				   $('#zm_flpopup').remove();
			});
			var viewCategoriesList = null;
			var config = {};
			config.parentDOM = parentEle;// No I18N
			config.displayAs = "dropdown"; // NO I18N
			config.hltPar = true;
			config.offsets = {
				left : 0,
				top : 0
			};
			if (operation == "category") {
				config.onSelect = function(id, elem) {
					if (id) {
						$('#zcs_category').find("input").attr({
							"id" : id, // No I18N
							"placeholder" : elem.display_text, // No I18N
							"name" : elem.name // No I18N
						}); 
					}
					viewCategoriesList.hide();
				};
			} else {
				config.onSelect = function(id, elem) {
					var acc = zmcontact.getAccountByZidForType(id, elem.type);
					$('#zcs_account').find("input").attr({ "id": id, "name": encodeHTML(acc.name), "placeholder": encodeHTML(acc.name) }); // No I18N
					var onclickValue = "zmcontact.getScrollList(this, \"category\", false)"; // No I18N
					$('#zcs_category').find("input").attr({ "onclick": onclickValue, "id": acc.getRootFolderId(), "name": I18N.get('IAM.CONTACTS.ALL.CONTACTS'), "placeholder": I18N.get('IAM.CONTACTS.ALL.CONTACTS') }); // No I18N
					viewCategoriesList.hide();
				};
			}
			config.dataCallback = function() {
				if (operation == "account") {
					if (!is_writable) {
						var accArr = [];
						for (var i = 0; i < ZContacts.AccountsList.length; i++) {
							var acc = ZContacts.AccountsList[i];
							if (ZContacts.AccountConstants[acc.type].is_exportable && acc.is_contacts_exportable) {
								accArr.push(acc);
							}
						}
						return accArr;
					} else {
						var accArr = [];
						for(var i=0; i < ZContacts.AccountsList.length; i++) {
							var acc = ZContacts.AccountsList[i];
							if (acc.is_writable && ZContacts.AccountConstants[acc.type].is_importable) {
								accArr.push(acc);
							}
						}
						return accArr;
					}
				}
				rootFolderId = zmcontact.getRootFolderId($('#zcs_category').find("ul li input").attr('id'));
				return zmcontact.getCategoriesList(rootFolderId, operation);
			};
			viewCategoriesList = zmUtil.createFLComp("generic", config); // No I18N
			viewCategoriesList.show();
		},

		getCategoriesList : function(categoryId, operation) {
			var cat = [];
			if (!categoryId) {
				categoryId = ZContacts._currentCategoryId;
			}
			var rootFolderId = zmcontact.getRootFolderId(categoryId);
			if (operation == "category") {
				cat.push({
					id : rootFolderId,
					name : I18N.get("IAM.CONTACTS.ALL.CONTACTS"),
					display_text : I18N.get("IAM.CONTACTS.ALL.CONTACTS") // No I18N
				});
			}
			var cate = ZContacts._parentObj[rootFolderId];
			if (cate) {
				for (var i = 0; i < cate.length; i++) {
					cat.push({
						id : cate[i].category_id,
						name : encodeHTML(cate[i].category_name),
						display_text : encodeHTML(cate[i].category_name)
					});
				}
			}
			if (cat.length == 0) {
				cat.push({
					display_text : I18N.get("IAM.CONTACTS.NO.CATEGORIES") // No i18N
				});
			}
			return cat;
		},

		addContactsToCategory : function(contactIdsArr, categoryId) {
			if (!zmcontact.isRootFolder(categoryId)) {
				var contactIds = contactIdsArr.join(',');
				new URI(ZContacts.ContactsCategories, ZContacts.getCurrentAccount().getAccountId(), contactIds, categoryId).POST(ZContacts.ContactsCategories.create({})).then(function(response) {
					if (response.status_code == 200) {
						zmUtil.succErrMsg("s", ZContacts.getMessageFromResponse(response)); // NO I18N
						new URI(ZContacts.Categories, ZContacts.getCurrentAccount().getAccountId(), categoryId).include('contacts.total_count').GET().then(function(json) { // No I18N
							var count = json.get("count");
							if (!ZContacts._countObj[categoryId]) {
								ZContacts._countObj[categoryId] = {
									c : count,
									p : ZContacts.AccountsVsRootFolderMap[ZContacts.getCurrentAccount().getAccountId()]
								};
							}
							var category = zmcontact.getCategory(categoryId);
							zmcontact.updateCountInCategories(category, count, false);
							if (categoryId == ZContacts._currentCategoryId) {
								zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
							}
						});
					} else {
						zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(json));// NO I18N
					}
				}, function(json) {
					zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(json));// NO I18N
				});
			}
			zmcontact.unChkAll();
		},
		archiveContacts: async function(contactIds) {
			if (await zmcontact.updateVisibleType(contactIds, "1") == true) {
				zmUtil.succErrMsg("s", I18N.get("IAM.CONTACTS.ARCHIVED.SUCCESS")); // NO I18N
			} else {
				zmUtil.succErrMsg("e", I18N.get("IAM.ERROR.GENERAL"));// NO I18N
			}
		},
		
		unarchiveContacts: async function(contactIds) {
			if (await zmcontact.updateVisibleType(contactIds, "0") == true) {
				zmUtil.succErrMsg("s", I18N.get("IAM.CONTACTS.UNARCHIVED.SUCCESS")); // NO I18N
			} else {
				zmUtil.succErrMsg("e", I18N.get("IAM.ERROR.GENERAL"));// NO I18N
			}
		},
		
		updateVisibleType: function(contactIds, type) {
			return new Promise((resolve) => {
				currentAccount = ZContacts.getCurrentAccount();
				accountId = currentAccount.account_id;
				if (currentAccount.is_writable) {
					new URI(ZContacts.ContactVisibility, ZContacts.getCurrentAccount().getAccountId(), contactIds, type).PUT().then(function(response) {
						if (response.status_code == 200) {
							zmcontact.refreshContactCounts();
							var elem = $(zmsuite.getCenter()[0].$el.find('div[data-field-type=zcs-cnt-view]')[0]);
							if (isContactDetailWorkSpace() || isOldSearchWorkSpace()) {
								var deletingElem = $(zmsuite.getCenter()[0].$el.find('#' + contactIds[contactIds.length - 1])[0]);
								if (deletingElem.length) {
									elem = deletingElem;
								}
							}
							if (elem) {
								var noOfRowsDelete;
								var noOfRow;
								noOfRow = zmsuite.getCenter()[0].$el.find('.zmL.SC_cont');
								if (isCleanWorkSpace()) {
									noOfRowsDelete = 1;
								} else {
									noOfRowsDelete = contactIds.length;
								}
								if (noOfRow.length == noOfRowsDelete) {
									if (isCleanWorkSpace()) {
										zmsuite.closeWorkspace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
									}
									zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
								} else {
									var nextElem;
									if ($(elem).next().length) {
										nextElem = $(elem).next();
									} else {
										nextElem = $(zmsuite.getCenter()[0].$el.find('.zmL.SC_cont')[0]);
									}
									zmcontact.initScroll($(zmsuite.getCenter()[0].getNodes()[2].$el.children()[0]), nextElem, elem);
									if (isContactDetailWorkSpace() || isOldSearchWorkSpace()) {
										if (isContactDetailWorkSpace()) {
											ZContacts.deletedCount = ZContacts.deletedCount + contactIds.length;
											if (ZContacts.deletedCount > 10) {
												zmcontact.scrollDownContacts(true);
											}
										}
										$.each(contactIds, function(key, value) {
											$(zmsuite.getCenter()[0].$el.find('#' + value)[0]).remove();
										});
									} else {
										elem.remove();
									}
									$(nextElem).click();
								}
							}
							resolve(true);
						} else {
							resolve(false);
						}
					}, function(json) {
						resolve(false);
					});
				}
			});
		},
		
		multiEditUi: function(contactIds) {
			var html = new ZContacts.StringBuilder();
			bulkEdits.rowCount = 1;
			bulkEdits.selecter = 1;
			html.append('<div>');
			html.append('<span style="font-size: large;"><b>' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT') + '</b></span>');
			html.append('<span class="zcs-dot" style="position: absolute;margin: 10px;"></span>');
			html.append('<span id ="contacts" style="margin-left: 22px;font-size: 15px;font-style: normal;">' + zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.OF.SELECTED'), contactIds.length) + '</span>');
			html.append('<div style="font-size: 15px;margin-top: 15px;margin-bottom: 15px;width: 990px;color: #555555;line-height: 20px">' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.DESCRIPTION') + '</div>');
			html.append('<div style="height: 1px;background: #e7e7e7;left: 0px;right: 0px;position: absolute;width: 100%;"></div>');
			html.append('<div class="zcs-scrollable-div" style="display: flex;flex-direction: column">');
			html.append('<div id="zcs-bulkEdit">');
			html.append('<div id="bulkRows">');
			html.append("<div style='margin-top: 26px;display: flex'>");
			html.append("<div class='rowNumber zcs-period' style='width: 23px;margin-top: 9px'>" + bulkEdits.rowCount + "</div>");
			html.append("<div style='display: flex;flex-direction: column;'><div class='SC_flt SC_select zcs-bulk-field_name zcs-bulkBox' style='width: 210px;height: auto;border: 1px solid white;' data-field-type='bulk1'><ul class='zmListReset' style='padding-left: 0px;margin:0px;'><li><b><input class='SC_tiput' value='" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.SELECT.FIELD') + "'  data-field-type='empty' style='display: inline-block;min-height:32px;padding-left:12px' readonly=readonly></b></li></ul></div></div>");
			html.append("<div style='display: flex;flex-direction: column;'><span class='SC_flt SC_select zcs-bulk-field_action zcs-bulkBox' style='width: 210px;margin-left:12px;height: auto;border: 1px solid white;' data-field-type='bulk1Action'><ul class='zmListReset' style='padding-left: 0px;margin: 0px;'><li><b><input class='SC_tiput' value='" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.SELECT.ACTION') + "' data-field-type='empty' style='display: inline-block;min-height:32px;padding-left:12px' readonly=readonly></b></li></ul></span></div>");
			html.append('<div style="display: flex;flex-direction: column;"><input type="text" class="zcs-bulk-input_box SC_select" placeholder="Enter the value" data-field-type="bulk1Input" style="display: none;margin-left: 12px;padding-left: 8px;width: 242px;height: 34px;border: 1px solid white;cursor: pointer"></div>');
			html.append('<div class="msi-trash-hov" data-field-type="bulk1Trash" style="width: 22px;height: 22px;margin-left: 10px;margin-top: 6px;display: none;"><span class="msi-trash" style="margin-top: 4px;margin-left: 4px;"></span></div>');
			html.append("</div>");
			html.append("</div>");
			html.append("<div class='SC_flt SC_select zcs-addAnAction' style='margin-top: 24px;border-color: #305AB5;border-radius: 4px;margin-left:24px;height:28px' id='zcs-bulk-option'><ul class='zmListReset' style='padding-left: 0px;margin: 0px'><li><b><input class='SC_tiput' value='" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ANOTHER.FIELD') + "' data-field-type='empty' style='display: inline-block;border: 0px;color: #305AB5;min-height:0px;padding-left: 6px ' readonly=readonly>  <span style='display:inline-block;' class='dummy-width-finder'>" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ANOTHER.FIELD') + "</span><span class='arrow-width-finder SC_select' style='position:relative;'></span></b></li></ul></div></div>");
			html.append('<div class="zcs-editor-qkcreate-hide SC_PUbtm " style="display: block;margin-top: 24px;margin-left: 22px; padding:2px!important"><span id="zcs-save-btn" style="border-radius: 4px;" data-field-type="zcs-save-btn">' + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.BUTTON.EDIT.ALL') + '</span><span data-val="Cancel" data-field-type="zcs-cancel-btn" id="zcs-cancel-btn" style="margin-left: 10px;border-radius: 4px;">' + ZContacts.I18N.get('IAM.CANCEL') + '</span></div>');
			html.append('</div>');
			return html.toString();
		},
		
		getBulkEditFields: function(locater) {
			var formatObj = {};
			var format = [{
				htm: ZContacts.I18N.get('IAM.CONTACTS.LASTNAME'),
				data: {
					action: "last_name", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.LASTNAME')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.MIDDLENAME'),
				data: {
					action: "middle_name", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.MIDDLENAME')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.BASIC.NNAME'),
				data: {
					action: "nick_name", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.BASIC.NNAME')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.COMPANY'),
				data: {
					action: "company", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.COMPANY')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.DESIGNATION'),
				data: {
					action: "designation", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.DESIGNATION')
				}
			}];

			formatObj.list = format;
			formatObj.par = $(locater);
			formatObj.defaultclass = true;
			formatObj.parWidth = true;
			formatObj.ulClass = "zcs-editFields"; // No I18N
			formatObj.onHide = function() {
			};

			formatObj.clk = function(data, elem, event) {
				var oldValue = $(locater).find(".SC_tiput").attr("data-field-type");
				if (oldValue != "empty") {
					bulkEdits.selectedBulkEditfields.splice(bulkEdits.selectedBulkEditfields.indexOf(ZContacts.I18N.get(bulkEdits.I18ValueKeyMap[oldValue])), 1);
				}
				//push new in array
				bulkEdits.selectedBulkEditfields.push(data.txt);
				//push new in html 
				$(locater).find(".SC_tiput")[0].setAttribute("data-field-type", data.action);
				$(locater).find(".SC_tiput").val(data.txt);
				//clearing the text field to enter new;
				$($(locater).parent().siblings()[2]).find(".zcs-bulk-input_box").val("");
				$($(locater).parent().siblings()[2]).find(".zcs-bulk-input_box").attr("placeholder", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.PLACEHOLDER'), data.txt)); // No I18N
				$('#zm_dropDown').hide();// No I18N
			};
			if ($(locater).hasClass("zcs-bulkBoxErr zcs-bulk-field_nameErr")) {
				$(locater).removeClass("zcs-bulkBoxErr zcs-bulk-field_nameErr");
				$(locater).siblings().remove();
			}
			
			zmsuite.showMenu(formatObj);
			$($("#zm_dropDown")[0]).css("border", "unset"); // No I18N
			$($("#zm_dropDown")[0]).css("margin-top", "4px"); // No I18N
			$($("#zm_dropDown")[0]).css("box-shadow", "0px 1px 4px #0000005C"); // No I18N
			$(".SC_dd li").css("line-height", "32px");
			$(".SC_dd li").css("padding-left", "12px");
			var $li = $('#zm_dropDown').find('ul').children();
			for (var i = 0; i < bulkEdits.selectedBulkEditfields.length; i++) {
				for (var j = 0; j < $li.length; j++) {
					if ($li[j].outerText === bulkEdits.selectedBulkEditfields[i].trim()) {
						$($li[j]).hide();
					}
				}
			}
		},
		
		getBulkEditAddOptions: function(locater) {
			if (bulkEdits.selectedBulkEditfields.length >= 5) {
				return;
			}
			var formatObj = {};
			var format = [{
				htm: ZContacts.I18N.get('IAM.CONTACTS.LASTNAME'),
				data: {
					action: "last_name", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.LASTNAME')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.MIDDLENAME'),
				data: {
					action: "middle_name",// No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.MIDDLENAME')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.BASIC.NNAME'),
				data: {
					action: "nick_name", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.BASIC.NNAME')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.COMPANY'),
				data: {
					action: "company", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.COMPANY')
				}
			}, {
				htm: ZContacts.I18N.get('IAM.CONTACTS.DESIGNATION'),
				data: {
					action: "designation", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.DESIGNATION')
				}
			}];

			formatObj.list = format;
			formatObj.par = $(locater);
			formatObj.defaultclass = true;
			formatObj.parWidth = true;
			formatObj.ulClass = "zcs-editFields"; // No I18N
			formatObj.onHide = function() {

			};
			formatObj.clk = function(data, elem, event) {
				$(locater).find(".SC_tiput").val(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ANOTHER.FIELD'));
				$('#bulkRows').append(zmcontact.addRow_bulkEdit(++(bulkEdits.selecter), ++bulkEdits.rowCount)); //No I18N 
				
				$($('#bulkRows').children()[$('#bulkRows').children().length-1]).find(".zcs-bulk-field_name").click(function(event) {
					if (bulkEdits.selectedBulkEditfields.length < 5 ) {
						zmcontact.getBulkEditFields(this);
					}
				});
				$($('#bulkRows').children()[$('#bulkRows').children().length-1]).find(".zcs-bulk-field_action").click(function(event) {
					zmcontact.getBulkEditActions(this);
				});
				$($('#bulkRows').children()[$('#bulkRows').children().length-1]).find(".msi-trash-hov").click(function(){
					zmcontact.removeBulkEditField(this);
				});
				$($('#bulkRows').children()[$('#bulkRows').children().length-1]).find(".zcs-bulk-input_box").click(function(){
					$(this).siblings().remove();
					$(this).removeClass("zcs-bulk-input_boxErr");
				});
				zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find(".zcs-addAnAction").click(function(event) {
					zmcontact.getBulkEditAddOptions(this);
				});
				
				bulkEdits.selectedBulkEditfields.push(data.txt);
				$(locater).find(".SC_tiput")[0].setAttribute("data-field-type", data.action);
				$("#zcs-bulkEdit").find('[data-field-type="bulk' + bulkEdits.selecter + '"]').find(".SC_tiput")[0].setAttribute("data-field-type", data.action);
				$("#zcs-bulkEdit").find('[data-field-type="bulk' + bulkEdits.selecter + '"]').find(".SC_tiput").val(data.txt);
				$('#zm_dropDown').hide();// No I18N
				$('#bulkRows').children().find(".msi-trash-hov").show(); // showing all trash buttons
				if (bulkEdits.selectedBulkEditfields.length >= 5) {
					$(locater).hide();
				}
			};
			zmsuite.showMenu(formatObj);
			$($("#zm_dropDown")[0]).css("border", "unset"); // No I18N
			$($("#zm_dropDown")[0]).css("margin-top", "4px"); // No I18N
			$($("#zm_dropDown")[0]).css("box-shadow", "0px 1px 4px #0000005C"); // No I18N
			$(".SC_dd li").css("line-height", "32px");
			$(".SC_dd li").css("padding-left", "12px");
			var $li = $('#zm_dropDown').find('ul').children();
			for (var i = 0; i < bulkEdits.selectedBulkEditfields.length; i++) {
				for (var j = 0; j < $li.length; j++) {
					if ($li[j].outerText == bulkEdits.selectedBulkEditfields[i].trim()) {
						$($li[j]).hide();
						break;
					}
				}
			}
		},
		
		getBulkEditActions: function(locater) {
			var formatObj = {};
			var format = [{
				htm: "<b style='color: #000'>" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.ADD') + "</b><br>" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.ADD.DESC'),
				data: {
					action: "edit", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.UPDATE.ADD')
				}
			}, {
				htm: "<b style='color: #000'>" + ZContacts.I18N.get('IAM.ADD') + "</b><br>" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.ADD.DESC'),
				data: {
					action: "add", // No I18N
					txt: ZContacts.I18N.get('IAM.ADD')
				}
			}, {
				htm: "<b style='color: #F02828'>" + ZContacts.I18N.get('IAM.CONTACTS.CLEAR') + "</b><br>" + ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.CLEAR.DESC'),
				data: {
					action: "clear", // No I18N
					txt: ZContacts.I18N.get('IAM.CONTACTS.CLEAR')
				}
			}];

			formatObj.list = format;
			formatObj.par = $(locater);
			formatObj.defaultclass = true;
			formatObj.parWidth = true;
			formatObj.ulClass = "zcs-editAction"; // No I18N
			formatObj.onHide = function() {

			};
			formatObj.clk = function(data, elem, event) {
				$(locater).find(".SC_tiput").attr("data-field-type", data.action);
				if (data.action != "clear") {
					$(locater).find(".SC_tiput").val(data.txt).css("color", "#000"); //No I18N
					var fieldName = $($(locater).parent().siblings()[1]).find(".SC_tiput").attr('data-field-type'); //No I18N
					$($(locater).parent().siblings()[2]).children().attr("placeholder", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.PLACEHOLDER'), ZContacts.I18N.get(bulkEdits.I18ValueKeyMap[fieldName])));
					$($(locater).parent().siblings()[2]).children().val("");
					$($(locater).parent().siblings()[2]).children().show();
				} else {
					$(locater).find(".SC_tiput").val(data.txt).css("color", "#F02828"); //No I18N
					$($(locater).parent().siblings()[2]).children().hide();
				}

				$('#zm_dropDown').hide();// No I18N
			};
			if ($(locater).hasClass("zcs-bulkBoxErr zcs-bulk-field_actionErr")) {
				$(locater).removeClass("zcs-bulkBoxErr zcs-bulk-field_actionErr");
				$(locater).siblings().remove();
			}
			var fieldName = $($(locater).parent().siblings()[1]).find(".SC_tiput").attr('data-field-type'); // NO I18N
			if (fieldName == "empty") {
				if (!$($(locater).parent().siblings()[1]).find(".zcs-bulk-field_name").hasClass("zcs-bulkBoxErr zcs-bulk-field_nameErr")) {
					$($(locater).parent().siblings()[1]).find(".zcs-bulk-field_name").addClass("zcs-bulkBoxErr zcs-bulk-field_nameErr");
					var errMsgDiv = $("<div></div>");
					errMsgDiv.attr("class", "zcs-field-err-msg"); //No I18N
					$(errMsgDiv).text(ZContacts.I18N.get('IAM.CONTACTS.BULK.EDIT.PLEASE.SELECT.FIELD'));
					$(locater).parent().siblings()[1].append(errMsgDiv[0]);
				}
			} else {
				zmsuite.showMenu(formatObj);
				$($("#zm_dropDown")[0]).css("border", "unset"); // No I18N
				$($("#zm_dropDown")[0]).css("margin-top", "4px"); // No I18N
				$($("#zm_dropDown")[0]).css("box-shadow", "0px 1px 4px #0000005C"); // No I18N
				$("#zm_dropDown").css("width", "350px");
				$(".SC_dd li").css("white-space", "normal");
				$(".SC_dd li").css("padding-left", "12px");
			}

		},
		
		removeBulkEditField: function(elem) {
			var oldValue = $($(elem).siblings().find(".SC_tiput")[0]).attr("data-field-type");
			if (oldValue != "empty") {
				bulkEdits.selectedBulkEditfields.splice(bulkEdits.selectedBulkEditfields.indexOf(ZContacts.I18N.get(bulkEdits.I18ValueKeyMap[oldValue])), 1);
			}
			for (var row = 0; row < $(elem).parent().siblings().length; row++) {
				$($(elem).parent().siblings()[row]).find(".rowNumber")[0].innerHTML = (row + 1);
			}
			bulkEdits.rowCount = $(elem).parent().siblings().length;
			$($(elem).parent().parent().siblings()[0]).show();
			if ($(elem).parent().siblings().length == 1) {
				$(elem).parent().siblings().find(".msi-trash-hov").hide()
			}
			$(elem).parent().remove();
		},

		deleteMultiContacts : function(contactIds) {
			if(!$("#zcs_delete")[0]) {
				if (contactIds == "") {
					zmUtil.succErrMsg("e", I18N.get("IAM.CONTACTS.NO.CONTACTS"));// NO I18N
					return;
				}
				var count = contactIds.length;
				if (count == 1) {
					zmcontact.deleteSingleContact(contactIds);
					return;
				}
				var rootFolderId = zmcontact.getRootFolderId(ZContacts._currentCategoryId);
				var acc = ZContacts.getCurrentAccount();
				var msg;
				if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT) {
					msg = I18N.get("IAM.CONTACTS.SURE.DELETE.THESE");
				} else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
					msg = I18N.get("IAM.CONTACTS.SURE.DELETE.CONTACTS.ORG");
				} else if (zmcontact.isInOrgGroup(rootFolderId)) {
					msg = zmcontact.formatMessage(I18N.get("IAM.CONTACTS.SURE.DELETE.CONTACTS.GROUP"), ZContacts.getCurrentAccount().getName());
				}
				var html = "<img style='float: left;left: 29px;top: 30px;' src='"+ZContacts.getFingerPrintedFile("/images/error.jpg")+"' /><h4 style='float: left;width:90%; padding: 5px 0px 15px 5px;'>"+msg+"</h4>"; // No I18N
				var txt = count == 1 ? I18N.get('IAM.CONTACTS.SINGLE.COUNT.DELETE') : I18N.get('IAM.CONTACTS.MULTIPLE.COUNT.DELETE'); // NO I18N
				html += "<div class='SC_PUbtm'><span id='zcs_delete' class='sel'>"+zmcontact.formatMessage(txt, count)+"</span><span data-val='Cancel' id='zcs_delete_cancel'>"+I18N.get('IAM.CANCEL')+"</span></div>"; // No I18N
				var dialog =  Dialog.new({
					title: "", // NO I18N
					$content: html,
					defaultCloseIcon:true
				});
			}
			$(".SC_PUcen").find('#zcs_delete').click(function() {
				zmcontact.deleteContact(contactIds.toString(), ZContacts.getCurrentAccount().account_id);
				zmcontact.unChkAll();
				zmcontact.removeDialog(this);
			});

			$(".SC_PUcen").find('#zcs_delete_cancel').click(function() {
				zmcontact.removeDialog(this);
			});

			$(".SC_PUtt").remove(); // NO I18N
		},

		deleteSingleContact : function(contactId) {
			var msg,zid,acc,rootFolderId;
			var contact = zmsuite.getCenter()[0].$el.find('#' + contactId).get(0);
			if (!contact) {
				contact = staticObj[contactId]; // if contact is clicked from auto list (not search) and tried to delete, getting contact from static auto list. 
			} else {
				contact = contact.__zc_contact;
			}
			var name = encodeHTML(contact.getFullName().trim());
			zid = contact.get("zid");
			acc = zmcontact.getAccountByZidForType(zid, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
			rootFolderId = acc.getRootFolderId();
			if (!ZContacts._currentCategoryId || isNewSearchWorkSpace()) {
				rootFolderId = acc.getRootFolderId(acc.getName)
			}
			if (acc.getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT) {
				msg = zmcontact.formatMessage(I18N.get("IAM.CONTACTS.CONFIRM.DELETE.SINGLE.CONTACT"), name);
			} else if (acc.getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
				msg = zmcontact.formatMessage(I18N.get("IAM.ERROR.SURE.RESETONE.CONTACTS.ORG"), name);
			} else if (zmcontact.isInOrgGroup(rootFolderId)) {
				msg = zmcontact.formatMessage(I18N.get("IAM.ERROR.SURE.RESETONE.CONTACTS.GROUP"), name, encodeHTML(ZContacts.getCurrentAccount().getName()));
			}
			if(!$("#zcs_delete")[0]) {
				var html = "<img style='float: left;left: 29px;top: 30px;' src='"+ZContacts.meta.serviceInfo.contacts_server_url+"/images/error.jpg' /><h4 style='float: left;width:90%; padding: 5px 0px 15px 5px;'>"+msg+"</h4>"; // No I18N
				html += "<div class='SC_PUbtm'><span id='zcs_delete' class='sel' >"+I18N.get('IAM.DELETE')+"</span><span data-val='Cancel' id='zcs_delete_cancel'>"+I18N.get('IAM.CANCEL')+"</span></div>"; // No I18N
				var dialog =  Dialog.new({
					 title: "", // NO I18N
					 $content: html,
					 defaultCloseIcon:true
				});
			}
			$(".SC_PUcen").find('#zcs_delete').click(function() {
				zmcontact.deleteContact(contactId.toString(), acc.account_id);
				zmcontact.removeDialog(this);
			});

			$(".SC_PUcen").find('#zcs_delete_cancel').click(function() {
				zmcontact.removeDialog(this);
			});

			$(".SC_PUtt").remove(); // NO I18N
		},

		deleteAllContacts : function(zid) {
			zmcontact._deleteContacts("reset",zid);// No I18N
		},

		deleteContact : function(contactId, zid) {
			if (contactId) {
				zmcontact._deleteContacts(contactId,zid);
			}
		},
		
		_deleteContacts : function(param, accountId) {
			currentAccount = zmcontact.getAccountByZidForType(accountId, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
			delete ZContacts._accountAudit[accountId];
			if(currentAccount.is_writable) {
				new ZContacts.URI(ZContacts.Contacts, currentAccount.getAccountId(), param).DELETE().then(function(response) {
					if (response.status_code == 204) { // No I18N
						/*	Event triggering to notify mail client	*/
						if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
							try {
								if(param == "reset") { // No I18N
									zmcontact.invokeEvent("contactsApp/refresh", { zid :  acc.getAccountId() }); // No I18N
								} else {
									zmcontact.invokeEvent("contactsApp/deleted", { zid : currentAccount.getAccountId(), contact_ids : param.split(",") }); // No I18N
								}
							} catch (e) {

							}
						}
						zmcontact.refreshContactCounts();
						if (isNewSearchWorkSpace()) {
							ZContacts._countSearchObj = {};
							ZContacts._countSearchObj.category_name = I18N.get("IAM.CONTACTS.SEARCH.RESULTS");
							zmUtil.succErrMsg("s", I18N.get("IAM.CONTACTS.ERROR.DELETE.SUCCESS"));// NO I18N
							var searchEle = zmsuite.getCenter()[0].$el.find('.SC_conLft');
							if(param.length > 1) {
								param = param.split(",");
								var elem = $(searchEle.find('#' + param[param.length - 1])[0]);
							} else {
								var elem = $(searchEle.find('#'+param[0]));
							}
							var nextElem = elem.next();
							zmcontact.updateHeaderBand(ZContacts._countSearchObj, 0, false);
							ZContacts.newSearchDeletedCount = ZContacts.newSearchDeletedCount + param.length;

							$.each(param, function(key, value) {
								$(searchEle).find("#"+value).remove();
							});

							var cListRow = $(searchEle).children();
							if(cListRow.length == 0){
								var searchPage = zmsuite.getCenter()[0].getNodes()[2].$el[0];
								$(searchPage).html('<div class="SC_nmsg zcs_SC_nmsg">' + I18N.get("IAM.CONTACTS.NO.CONTACTS") + '</div>');
							} else {
								nextElem = $(searchEle.find('.zmL.SC_cont')[0]);
								nextElem.click();
								zmcontact.initScroll($(zmsuite.getCenter()[0].getNodes()[2].$el.children()[0]), nextElem, elem);
							}
							if (searchEle.children().length != 0) {
								ZContacts._countSearchObj.contacts_count = searchEle.children().length;
							}
							if (ZContacts.newSearchDeletedCount > 10) {
								ZContactsContext.getNextPage();
							}
						}  else if (param == "reset") {
							zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
							zmUtil.succErrMsg("s", ZContacts.getMessageFromResponse(response));// NO I18N
						} else {
							zmUtil.succErrMsg("s", I18N.get("IAM.CONTACTS.ERROR.DELETE.SUCCESS"));// NO I18N
							if(param.length > 1) {
								param = param.split(",");
							}
							for(var i=0; i < param.length; i++) {
								delete ZContacts._audit[param[i]];
							}
							var elem = $(zmsuite.getCenter()[0].$el.find('div[data-field-type=zcs-cnt-view]')[0]);
							if(isContactDetailWorkSpace() || isOldSearchWorkSpace()) {
								var deletingElem = $(zmsuite.getCenter()[0].$el.find('#' + param[param.length - 1])[0]);
								if (deletingElem.length) {
									elem = deletingElem;
								}
							}
							if (elem) {
								var noOfRowsDelete;
								var noOfRow;
								noOfRow = zmsuite.getCenter()[0].$el.find('.zmL.SC_cont');
								if(isCleanWorkSpace()) {
									noOfRowsDelete = 1;
								} else {
									noOfRowsDelete = param.length;
								}
								if (noOfRow.length == noOfRowsDelete) {
									if (isCleanWorkSpace()) {
										zmsuite.closeWorkspace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
									}
									zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
								} else {
									var nextElem;
									if ($(elem).next().length) {
										nextElem = $(elem).next();
									} else {
										nextElem = $(zmsuite.getCenter()[0].$el.find('.zmL.SC_cont')[0]);
									}
									zmcontact.initScroll($(zmsuite.getCenter()[0].getNodes()[2].$el.children()[0]), nextElem, elem);
									if (isContactDetailWorkSpace() || isOldSearchWorkSpace()) {
										if (isContactDetailWorkSpace()) {
											ZContacts.deletedCount = ZContacts.deletedCount + param.length;
											if (ZContacts.deletedCount > 10) {
												zmcontact.scrollDownContacts(true);
											}
										}
										$.each(param, function(key, value) {
											$(zmsuite.getCenter()[0].$el.find('#' + value)[0]).remove();
										});
									} else {
										elem.remove();
									}
									$(nextElem).click();
								}
							}
						}
					} else if(response.status_code == 200) {
						ZContacts.meta.user.reset_scheduled = true;
						zmUtil.succErrMsg("s", ZContacts.getMessageFromResponse(response));// NO I18N
					} else {
						zmUtil.succErrMsg("e", I18N.get("IAM.ERROR.GENERAL"));// NO I18N
					}
				}, function(response) {
					$('#zcs_delete').parents('.SC_PU').find('.msi-close').click();
					zmUtil.succErrMsg("e", ZContacts.getMessageFromResponse(response));// NO I18N
				});
			}
		},

		getSelectedContactIds : function(elem) {
			var contactIdsArr = [];
			for (var i = 0; i < elem.find(".zmL.SC_cont.SC_check").length; i++) {
				contactIdsArr.push(elem.find(".zmL.SC_cont.SC_check")[i].id);
			}
			return contactIdsArr;
		},

		constructCenter : function() {
			var centerNodes = zcon.contactsCenter[0].getNodes();
			centerNodes[0].push(zmcontact.getActionMenuList());
			centerNodes[0].setListener("click", function(event, iconName) {
				zmcontact.bindHeaderIcons(event, iconName);
			});

			centerNodes[2].setListener("click", function(event) {
				zmcontact.bindEventsContactsRow(event);
			});

			centerNodes[2].setListener("contextmenu", function(event) {
			});
			zmsuite.renderCenter();
		},

		chkAll : function(elem) {
			var centerNode = zmsuite.getCenter()[0].getNodes();
			if (centerNode[2].$el.find('.zcs-contDup-row').length || !centerNode[2].$el.find('.zmL.SC_cont').length) {
				return;
			}
			centerNode[0].hideGroup("sort"); // No I18N
			if (!$(elem).hasClass("msi-uncheck")) {
				elem = $(elem).find(".msi-uncheck");
			}
			$(elem).attr("class", "msi-check zcs-check"); // No I18N
			centerNode[2].$el.find(".SC_conLft .zmL.SC_cont").addClass("SC_check");
			centerNode[2].$el.find(".msi-uncheck").removeClass("msi-uncheck").addClass("msi-check"); // No I18N
			var selectedCount = centerNode[2].$el.find('.SC_check').length;
			if(isNewSearchWorkSpace()) {
				zmcontact.updateHeaderBand(ZContacts._countSearchObj, selectedCount, false);
			} else {
				zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId), selectedCount, false);
			}
			if (zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').children().length != 0) {
				zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#contacts")[0].innerHTML = zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.OF.SELECTED'), selectedCount);
			}
			if (selectedCount) {
				centerNode[0].showGroup("mail");// No I18N
				if (ZContacts.isFunctionableForCurrAcc('view_add_to')) {
					centerNode[0].showGroup("addto");// No I18N
				}
				centerNode[0].showGroup("print");// No I18N
			}
			if (ZContacts.getCurrentAccount().is_writable) {
				if (selectedCount) {
					if (ZContacts.isDeletable()) {
						centerNode[0].showGroup("delete");// No I18N
					}
					if (!zmcontact.isRootFolder()) {
						centerNode[0].showGroup("clearcontacts"); // No I18N
					}
				}
				if (selectedCount > 1 && ZContacts.isBulkEditable()) {
					centerNode[0].showGroup("bulkEdit"); // No I18N
				} else {
					centerNode[0].hideGroup("bulkEdit"); // No I18N
				}
			}
			if (selectedCount > 1 && ZContacts.isMergeable()) {
                centerNode[0].showGroup("merge"); // No I18N
            } else {
                centerNode[0].hideGroup("merge"); // No I18N
			}
			if (selectedCount > 0 && ZContacts.isFunctionableForCurrAcc('is_archiveable')) {
				centerNode[0].showGroup("archive"); // No I18N
				centerNode[0].hideGroup("unarchive"); // No I18N
			} else if (selectedCount > 0 && ZContacts.isFunctionableForCurrAcc('is_unarchiveable')) {
				centerNode[0].showGroup("unarchive"); // No I18N
				centerNode[0].hideGroup("archive"); // No I18N
			} else {
				centerNode[0].hideGroup("archive"); // No I18N
				centerNode[0].hideGroup("unarchive"); // No I18N
			}
			if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {//Order should not be changed
				centerNode[0].hideGroup("archive"); // No I18N
				centerNode[0].hideGroup("unarchive"); // No I18N
			}
			zmcontact.restrictionBand("select_contacts"); // No I18N
		},

		unChkAll : function() {
			var centerNode = zmsuite.getCenter()[0].getNodes();
			centerNode[0].$el.find(".msi-partcheck").removeClass().addClass("msi-uncheck zcs-check"); // No I18N
			centerNode[0].$el.find(".msi-check").removeClass().addClass("msi-uncheck zcs-check"); // No I18N
			centerNode[2].$el.find(".SC_check").removeClass("SC_check"); // No I18N
			centerNode[2].$el.find(".msi-check").removeClass("msi-check").addClass("msi-uncheck");
			if(isNewSearchWorkSpace()) {
				zmcontact.updateHeaderBand(ZContacts._countSearchObj, 0, false);
			} else {
				zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId), 0, false);
			}
			if (zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').children().length != 0) {
				zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-multiCont-edit').find("#contacts")[0].innerHTML = zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.OF.SELECTED'), 0);
			}
			centerNode[0].hideGroup("delete"); // No I18N
			centerNode[0].hideGroup("mail");// No I18N
			centerNode[0].hideGroup("addto"); // No I18N
			centerNode[0].hideGroup("clearcontacts"); // No I18N
			centerNode[0].hideGroup("merge"); // No I18N
			centerNode[0].hideGroup("archive"); // No I18N
			centerNode[0].hideGroup("unarchive"); // No I18N
			centerNode[0].hideGroup("bulkEdit"); // No I18N
			if (ZContacts.isFunctionableForCurrAcc('add_contact')) {
				centerNode[0].showGroup("addcontact");// No I18N
			} else {
				centerNode[0].hideGroup("addcontact");// No I18N
			}
			
			if ($(".zmCurTree").parent().attr("data-testid") === 'lhs-sub-tree') {
				centerNode[0].showGroup("copycontact");
			} else {
				centerNode[0].hideGroup("copycontact");
			}
			
			if(isNewSearchWorkSpace()) {
				ZContacts.selectedCount = 0;
			}
			centerNode[0].hideGroup("print"); // No I18N
			if (ZContacts._countObj[ZContacts._currentCategoryId] && ZContacts._countObj[ZContacts._currentCategoryId].c > 1 && !isSearchWorkSpace() && ZContacts.AccountConstants[ZContacts.getCurrentAccount().getViewType()].is_sortable) {
				centerNode[0].showGroup("sort");// No I18N
			} else {
				centerNode[0].hideGroup("sort");// No I18N
			}
			zmcontact.restrictionBand("select_contacts"); // No I18N
		},

		deletecategory : function(data) {
			var category_id = data.category.category_id;
			var category_name = data.category.category_name;
			var account_id = zmcontact.getAccByCategoryId(zmcontact.getRootFolderId(category_id)).getAccountId();
			var rowObj = {};
			rowObj[category_id] = data.category;
			zmsDialog.confirm(zmcontact.formatMessage(I18N.get("IAM.CONTACTS.ERROR.SURE.DLT.CATEGORY"), data.category.category_name), {// No I18N
				onOk : function() {
					new URI(ZContacts.Categories, account_id, category_id).DELETE().then(function(json) {
						zmUtil.succErrMsg('s', I18N.get("IAM.CONTACTS.ERROR.DLTCATGRY.SUCCESS"));
						var rootFolderId = zmcontact.getRootFolderId(category_id);
						var listObj = ZContacts._parentObj[rootFolderId];
						var catArr = [];
						for (var i = 0; i < listObj.length; i++) {
							var cat = listObj[i];
							if (cat.category_id != category_id) {
								catArr.push(cat);
							}
						}
						ZContacts._parentObj[rootFolderId] = [];
						ZContacts._parentObj[rootFolderId] = catArr;
						zmcontact.loadFirstPage(zmcontact.getCategory(rootFolderId));
						delete ZContacts._countObj[category_id];
						delete ZContacts._childObj[rootFolderId].CH[category_id];
						zmcontact.publishCategory([{ name: category_name, id: category_id, type: "category_delete" }]); //No I18N
						zmcontact.getCategoriesListLayer(rootFolderId).deleteNode(rowObj, rootFolderId);
					}, function(json) {
						zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
					});
				}
			});
		},
		
		deleteAllCategories : function(account){
			zmsDialog.confirm(I18N.get("IAM.CONTACTS.ERROR.SURE.DLT.ALL.CATEGORY"), {// No I18N
				onOk : function() {
					new URI(ZContacts.Categories, account.account_id).DELETE().then(function(json) {
						var publishData = [];
						zmUtil.succErrMsg("s", ZContacts.getMessageFromResponse(json));// NO I18N
						var rootFolderId = account.getRootFolderId();
						var categories = ZContacts._parentObj[rootFolderId];
						for (var i = 0; i < categories.length; i++) {
							try {
								var rowObj = {};
								rowObj[categories[i].category_id] = categories[i];
								delete ZContacts._countObj[categories[i].category_id];
								delete ZContacts._childObj[rootFolderId].CH[categories[i].category_id];
								publishData.push({ name: categories[i].category_name, id: categories[i].category_id, type: "category_delete" }); //No I18N
								zmcontact.getCategoriesListLayer(rootFolderId).deleteNode(rowObj, rootFolderId);
							} catch (e) {

							}
						}
						zmcontact.publishCategory(publishData);
						delete ZContacts._parentObj[rootFolderId];
						zmcontact.loadFirstPage(zmcontact.getCategory(rootFolderId));
						if(zmsuite.getCenter()[0].$el.find('.zmSLst').length > 0){
							zmcontact.loadContactDetails(zmsuite.getCenter()[0].$el.find('.zmSLst')[0].id);
						}
						
					}, function(json) {
						zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
					});
				}
			});
		},

		getAccByCategoryId : function(categoryId) {
			categoryId = zmcontact.getRootFolderId(categoryId);
			return ZContacts.AccountsVsRootFolderMap[categoryId];
		},

		bindEventsContactsRow : function(evt) {
			var tEle = evt.target || $tEle, clsNme, $listRow, contact;
			$tEle = $(tEle);
			clsNme = $tEle.attr("class") || ""; // No i18N
			$listRow = $(tEle).closest(".zmL"); // No I18N
			if (!$(evt.target).hasClass('SC_cont')) {
				$tEle = $(evt.target).parents('.SC_cont');
			}
			if ($tEle.length && !$tEle.hasClass('zmSLst')) {
				$('.SC_cont.zmSLst').removeClass("zmSLst");
				$tEle.addClass('zmSLst');
				if ($listRow.length > 0) {
					contact = $listRow.get(0).__zc_contact;
					zmcontact.loadContactDetails(contact.get('contact_id'), contact.get('zid')); // No I18N
				}
			}
		},

		zconImportDetails : function(){
			var zid = ZContacts.getCurrentAccount().getAccountId();
			new URI(ZContacts.SyncDetails, zid).GET().then(function(details) {
				delete ZContacts._accountAudit[zid];
				ZContacts._sync = details.contacts.syncEnable;
				if(ZContacts._sync == true){
					ZContacts._authenticatedMailId = details.contacts.authenticatedMailId;
					var date = new Date(parseInt(details.contacts.lastSyncedTime));
					ZContacts._syncedTime = date.toLocaleDateString() + "," + date.toLocaleTimeString();
					ZContacts._enableStatus = details.contacts.enableDisableStatus;
				}
				zmcontact.zconImport();
			}, function() {
				
			});
		},
		
		zconImport : function(){
			if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.IMPORT_APP_ID)) {
				zmUtil.hideMenu();
				$("#impcont").replaceWith($("#impcont").val('').clone(true));
				var contactImport = new ZContacts.contactimport();
				contactImport.createPageContent(getHtmlForImport());
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.IMPORT_APP_ID);
			} else {
				var importTabObj = {
					appname : I18N.get('IAM.CONTACTS.IMPORT.CONTACTS'),// No I18N
					appId : ZContacts.ZMailConstants.IMPORT_APP_ID,
					appIcon : "msi-edit", // No I18N
					searchPlaceHolder : I18N.get("IAM.CONTACTS.SEARCH.CONTACTS"),
					data : {
						CNodes : "3"
					}
				};
				zmsuite.setWorkSpace(importTabObj);
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.IMPORT_APP_ID);
				var workspaceCenter = zmsuite.getCenter(ZContacts.ZMailConstants.IMPORT_APP_ID);
				var centerNodes = workspaceCenter[0].getNodes();
	
				centerNodes[0].push([]);
				var headerObj = {
					left : {
						leftHTML : I18N.get("IAM.CONTACTS.IMPORT.CONTACTS")
					},
					right : []
				};
	
				centerNodes[1].push(headerObj);
	
				var headericon = {
					left : [],
					right : [ {
						actionArr : [ {
							iconList : [ "msi-close" ], // No i18N
							tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
						} ]
					} ]
				};
				centerNodes[0].push(headericon);
				centerNodes[0].setListener("click", function(ev, iconName) {
					if (iconName == "msi-close") {
						zmsuite.closeWorkspace(ZContacts.ZMailConstants.IMPORT_APP_ID);
						if (ZContacts.importContacts.refreshContacts) {
							zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
							ZContacts.importContacts.refreshContacts = false;
						}
						zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId));
						$(zcon.contactsCenter.listElem).find('.SC_conLft').children()[0].click();
					}
				});
	
				var listingCenter = centerNodes[2];
				var $containerDiv = $('<div>').addClass('SC_import');
				var contactImport = new ZContacts.contactimport();
				ZContacts.contactimport.$containerElem = $containerDiv;
				contactImport.createPageContent(getHtmlForImport());
				listingCenter.$el.append($containerDiv);
				listingCenter.$el.addClass('zcs-import-form');
				zmsuite.renderWorkSpace();
			}
			var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find('.SC_import');
			$(rightContainer).find('[data-field-type=import_accounts_list]').on("click", function(eve){
				zmcontact.getScrollList($(this), 'account', true); //No I18N
			});
			$(rightContainer).find('[data-field-type=import_category_list]').on("click", function(eve){
				zmcontact.getScrollList($(this), 'category', true); //No I18N
			});
			$(rightContainer).find('[data-field-type=local_file]').change(function(ev){
				processFile();
			});
			$(rightContainer).find('[data-field-type=google_import]').on("click", function(ev){
				importGoogle();
			});
			$(rightContainer).find('[data-field-type=google_sync]').on("click", function(ev){
				twoWaySyncPopup();
			});
			$(rightContainer).find('[data-field-type=yahoo_import]').on("click", function(ev){
				importYahoo()
			});
			$(rightContainer).find('[data-field-type=outlook_import]').on("click", function(ev){
				importOutlook();
			});
			$(rightContainer).find('[data-field-type=sync_details]').on("click", function(ev){
				showSyncDetails();
			});
			$(rightContainer).find('[data-field-type=zcs-sync-popup-cancel-btn]').on("click", function(event){
				showSyncDetails();
			});
			$(rightContainer).find('[data-field-type=on_off_button]').on("click", function(event){
				onOffButton(event);
			});
			$(rightContainer).find('[data-field-type=zcs-sync-now]').on("click", function(event){
				syncNow();
			});
			$(rightContainer).find('[data-field-type=zcs-revoke-btn]').on("click", function(event){
				revokeSync();
			});
			$(rightContainer).find('[data-field-type=validate_contacts]').click(function(event) {
				validateContacts(mappingForm);
			});
			$(rightContainer).find('[data-field-type=close_import_page]').on("click", function(event){
				closeImport(false);
			});

		},

		contactsList : function(contacts, isNextPage, isCleanDupes) {
			if(ZContacts.isRemoved == true) {
				ZContacts.isRemoved = false;
			} else if(ZContacts._filterList != undefined && ZContacts._filterList.length > 0 && ZContacts._filterList.includes("SearchTypeFilter") == false){
				zmail.Search.addToSearch({
	                className: "SearchTypeFilter", // No I18N
	                value: "contains" // No I18N
	            }, {
	            	silent: true, 
	            	avoidDependencyLoad: false
	            });
				ZContacts._filterList.push("SearchTypeFilter");
			}
			zcon.contactsCenter = zmsuite.getCenter();
			var menuNode;
			var listElem = zmsuite.getCenter()[0].getNodes()[2].$el[0];
			zcon.contactsCenter.listElem = listElem;
			var cntElem = $(zmcontact.constructContactsRow(contacts, isCleanDupes));

			if(isContactDetailWorkSpace()){
				menuNode = zmsuite.getWorkSpace(ZContacts.ZMailConstants.CONTACTS_APP_ID)[0];
			} else if(isCleanWorkSpace() || isSearchWorkSpace()){
				removeSearchAutoList(true);
				menuNode = zmsuite.getCenter()[0].getNodes()[0];
			} 
			
			if (!isSearchWorkSpace()) {
				if (!(contacts && contacts.length) && !isPrintWorkSpace()) {
					var html = new ZContacts.StringBuilder();
					var rootFolderId = zmcontact.getRootFolderId(ZContacts._currentCategoryId);
					html.append('<div class="zsc_nmsg zmNightMode" style="padding: 10px;font-size: 15px;line-height: 48px;font-family: inherit;">' + I18N.get("IAM.CONTACTS.NO.CONTACT.ADDED.YET") + '</div>');
					if ((rootFolderId == ZContacts._currentCategoryId) && ZContacts.isFunctionableForCurrAcc("add_contact")) {
						html.append('<div class="zsc_nmsg zmNightMode" style="line-height: 35px;font-family: inherit;font-size: 15px;">' + I18N.get("IAM.CONTACTS.ADD.NEW.CONTACT.HOME.PAGE") + '</div>');
						html.append('<div class="SC_PUbtm zsc_nmsg" style="padding:25px"><span class="sel" data-field-type="zcont-import-button">'+I18N.get("IAM.CONTACTS.IMPORT.CONTACTS")+'</span></div>');
						html.append('<div class="SC_PUbtm"><span class="sel" id="zcs_add_plus" data-field-type="zcont-quick-create-button"><div class="zcs_css_plus"></div></span></div>');
					}
					$(zcon.contactsCenter.listElem).html(html.toString());
					return;
				}
			}
			if (isCleanDupes) {
				zmcontact.unChkAll();
				var div = "<div class='SC_conLft' id='zcs_conLft'></div><div class='SC_conRgt' id='zcs_conRgt'><div class='zcs-cont-details'></div><div class='zcs-multiCont-edit'></div><div class='zcs-cont-edit zcs-editor-form'></div></div>";
				$(listElem).html(div);
				$(listElem).find('.SC_conLft').html(cntElem); // No I18N
				$(listElem).find('.SC_conLft').children()[0].click();
				return;
			}
			if (isNextPage) {
				if (contacts && contacts.length > 0) {
					if (isNewSearchWorkSpace()) {
						$(listElem).find('.SC_conLft').append(cntElem);
						$(listElem).find('.SC_conLft').children()[0].click();
					} else {
						if (menuNode.$el.find('.SCmb').find(".msi-check").length) {
							menuNode.$el.find('.SCmb').find(".msi-check").removeClass().addClass("msi-uncheck msi-partcheck zcs-check");
						}
						$(listElem).find('.SC_conLft').append(cntElem);
					}
				}
			} else if (isSearchWorkSpace()) {
				zmcontact.constructCenter();
                zmcontact.unChkAll();
				if (contacts && contacts.length > 0) {
					var div = "<div class='SC_conLft'></div><div class='SC_conRgt' id='zcs_srch'><div class='zcs-cont-details'></div><div class='zcs-multiCont-edit'></div><div class='zcs-cont-edit zcs-editor-form'></div></div>";
					$(listElem).html(div);
					$(listElem).find('.SC_conLft').html(cntElem); // No I18N
					$(listElem).find('.SC_conLft').children()[0].click();
				} else {
					$(listElem).html('<div class="SC_nmsg zcs_SC_nmsg">' + I18N.get("IAM.CONTACTS.NO.CONTACTS") + '</div>');
					return;
				}
			} else if(isPrintWorkSpace()){
				zmcontact.addContactsToPrint(contacts, cntElem);
			}  else if(zmTab.currentTab == ZContacts.ZMailConstants.IMPORT_APP_ID){
				$(listElem).find('.SC_conLft').html(cntElem); // No I18N
			} else {
				$(listElem).find('.SC_conLft').html(cntElem); // No I18N
				$(listElem).find('.SC_conLft').children()[0].click();
			}
			$("#ms_load").remove();
			$(zcon.contactsCenter.listElem).children('.SC_conLft').unbind("scroll").bind("scroll", function() {
				zmUtil.hideMenu();
				if (!isCleanDupes) {
					zmcontact.scrollDownContacts();
				}
			});
			var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find('.SC_conLft')[0];
			$(rightContainer).find('[data-field-type="crow_select_box"]').unbind().on("click",function(event) {
				zmcontact.select(event);
			});

			$(rightContainer).find('[data-field-type=send_mail]').on("click", function(e){
				var email_id = e.target.dataset.id;
				zmcontact.sendMail(email_id)
			});
			$(rightContainer).find('[data-field-type=invite_zoho]').on("click", function(e){
				var contact_id = e.target.dataset.id;
				zmcontact.inviteChat(event,contact_id ,0)
			});
			$(rightContainer).find('[data-field-type=invite_zoho]').on("click", function(e){
				var contact_id = e.target.dataset.id;
				zmcontact.inviteChat(event,contact_id ,0)
			});
			$(rightContainer).find('[data-field-type=open_chat]').on("click", function(e){
				var contactZuid = e.target.dataset.id;
				zmcontact.openChat(contactZuid,event);
			});
			$(rightContainer).find('[data-field-type=chat_reject]').on("click", function(e){
				var idArray = e.target.dataset.id.split(',');
				var contact_id = idArray[0].toString();
				var contactStatus = idArray[1].toString();
				zmcontact.inviteChat(event,contact_id,contactStatus);
			});
			
			$(rightContainer).find('[data-val=zcs-cnt-view]').ready(function(event) {
				if (isNewSearchWorkSpace()) {
					var _this = zmsuite.getCenter()[0].getNodes()[2].$el.find('.SC_conLft').children()[0];
					var idArray = _this.dataset.id.split(',');
					var contact_id = idArray[0].toString();
					var zid = idArray[1].toString();
					zmcontact.loadContactDetails(contact_id,  zid);
				}
			});

			$(rightContainer).find('[data-val=new_search_load_contact_details]').on("click", function(e){
				var idArray = this.dataset.id.split(',');
				var contact_id = idArray[0].toString();
				var zid = idArray[1].toString();
				zmcontact.loadContactDetails(contact_id,  zid);
			});

			$(rightContainer).find('.SC_cont').on("dragstart", function(event, _this) {
				var contactId = event.target.closest(".zmL.SC_cont").id; // No I18N
				var eve = event.originalEvent;
				zmcontact.doDrag(eve, contactId);
			});

			$(rightContainer).find('.SC_cont').on("dragleave", function(event) {
				var eve = event.originalEvent;
				zmcontact.dodragend(eve)
			});
		},

		showQuickCreate : function(elem) {
			if (!ZContacts.getCurrentAccount().is_writable) {
				zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.ERROR.WRITE.OPERATION.NOT.ALLOWED")); // No I18N
				return;
			}
			if(zmApp.currentApp != ZContacts.ZMailConstants.CONTACTS_TAB){
				var acc = zmcontact.getAccountByZidForType(zmail.zuid, ZContacts.ZMailConstants.VIEW_ID_CONTACTS);
				if(acc.getCount() >= acc.getLimit()) {
					zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.ERROR.MAX.CTS.LIMIT.EXCEEDED'), acc.getLimit())); // No I18N
					return;
				} else {
					zmcontact.utilQuickCreate(elem);
				}
			} else {
				var rootFolderId = ZContacts.getCurrentAccount().getRootFolderId();
				if(ZContacts._countObj[rootFolderId].c && ZContacts._countObj[rootFolderId].c >= ZContacts.getCurrentAccount().getLimit()) {
					zmUtil.succErrMsg("e", zmcontact.formatMessage(ZContacts.I18N.get('IAM.CONTACTS.ERROR.MAX.CTS.LIMIT.EXCEEDED'), ZContacts.getCurrentAccount().getLimit())); // No I18N
					return;
				} else {
					zmcontact.utilQuickCreate(elem);
				}
			}
		},

		utilQuickCreate : function(elem) {
			var posElem = $(".zm_compose");
			var posOffset = posElem.offset();
			var posTop = posOffset.top + "px"; // No I18N
			var posLeft = posOffset.left + posElem.width() + "px"; // No I18N
			var zc_popright = false;
			if(zmail.userDisplayLang == "Persian" || zmail.userDisplayLang == "Arabic" || zmail.userDisplayLang == "Hebrew"){
				 zc_popright = true;
				 var posRight = posOffset.left - 1000 + "px"; // No I18N
			}
			if (zmsuite.isWorkspaceAvailable('zm_createContact')) {
				zmsuite.showWorkSpace('zm_createContact'); // No I18N
				return;
			}

			var contactEditor = new ZContacts.ContactEditor(true);
			var editorActions = {
				save : function(t) {
					if ($('.SC_PUbtm.addContEnableDisable')[0] != undefined && $('.SC_PUbtm.addContEnableDisable')[0].hasAttribute("disabled")) {
						return;
					}
					
					var contact = contactEditor.toContactsModel(ZContacts.Contacts.create());
					if (zmsuite.isWorkspaceAvailable('zm_createContact')) {
						if (!ZContacts.getCurrentAccount().is_writable) {
							zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.ERROR.WRITE.OPERATION.NOT.ALLOWED")); // No I18N
							return;
						}
					}

					if (!contact) {
						return;
					}
					var elem;
					if (!t) {
						elem = this.$e.find('.SC_PUbtm');
					} else {
						elem = $(t.currentTarget.parentElement);
					}
					zmcontact.restrictClick(elem, true);
					$(elem).addClass("addContEnableDisable");
					var container;
					var type;
					if (!$('#zcs_loading').length) {
						if (contactEditor.quickCreate) {
							$('#zmsdialog_zc_contactpopup').prepend("<div id='zcs_loading' style='padding-bottom: 10px;' ></div>");
							type = "listing"; // No I18N
						} else {
							zmsuite.getCenter()[0].$el.prepend("<div id='zcs_loading' style='padding-bottom: 10px;'></div>");
							type = "listing"; // No I18N
						}
					}
					container = $('#zcs_loading').get(0);
					var destroyLoadingDiv = zmComponent.loadingBand({
						container : container,
						type : type
					});
					new URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId()).addPostParam("source", "manual").POST(contact).then(function(json) { // No I18N
						$('.SC_PUbtm').removeAttr('disabled');
						destroyLoadingDiv();
						if ($('#zcs-photo-form').find("#zcs-photo-input").val()) {
							var photo = ZContacts.Photo.create();
							photo.set('__form', '#zcs-photo-form'); // No I18N
							var contactId = json.contacts.contact_id;
							new URI(ZContacts.Photo, ZContacts.getCurrentAccount().getAccountId(), contactId).POST(photo).then(function(resp) {
								
							}, function(resp) {
								
							});
						}
						
						if (!contactEditor.quickCreate) {
							zmsuite.showWorkSpace('zm_Contacts'); // No i18N
						} else {
							zmsDialog.remove();
						}
						if(json.status_code == 201){
							zmUtil.succErrMsg('s', I18N.get("IAM.CONTACTS.ERROR.ADDED.SUCCESS")); // No I18N
							contact.contact_id = json.contacts.contact_id;
							/*	Event triggering to notify mail client	*/
							try {
								if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
									zmcontact.invokeEvent("contactsApp/added", {zid : ZContacts.getCurrentAccount().getAccountId(), contact : contact} ); // No I18N
								}
							} catch (e) {
								zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
							}
							
							if(zmApp.currentApp == ZContacts.ZMailConstants.CONTACTS_TAB){
								zmcontact.constructCenter();
								var currentCategory = zmcontact.getCategory(ZContacts._currentCategoryId);
								if (zmcontact.isRootFolder()) {
									zmcontact.updateCountInCategories(currentCategory, 1, true);
									zmcontact.refreshContactCounts();
									zmcontact.loadFirstPage(currentCategory);
								} else {
									var contactIdsArr = [];
									contactIdsArr.push(json.contacts.contact_id);
									zmcontact.addContactsToCategory(contactIdsArr, ZContacts._currentCategoryId);
									var rootFolderId = zmcontact.getRootFolderId(ZContacts._currentCategoryId);
									var rootFolderCategory = zmcontact.getCategory(rootFolderId);
									zmcontact.updateCountInCategories(rootFolderCategory, 1, true);
									zmcontact.refreshContactCounts();
								}
							}
							printResponse = {};
						}

						if (!contactEditor.quickCreate) {
							zmsuite.closeWorkspace(ZContacts.ZMailConstants.WORKSPACE_APP_ID);
						}
					}, function(json) {
						zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
						destroyLoadingDiv();
						if (json.status_code == "409") {
							var exist_contacts = json.errors[0].params.exist_contacts;
							var html = "<h4 style='float: left;width:90%; padding: 5px 0px 15px 5px;'>" + I18N.get("IAM.CONTACTS.DUPLICATE.EMAIL.RESTRICTED") + "</h4>"; // No I18N
							html += "<div class='SC_PUbtm'><span id='zcs_delete' class='sel'>" + I18N.get('IAM.CONTACTS.VIEW') + "</span><span data-val='Cancel'>" + I18N.get('IAM.CANCEL') + "</span></div>"; // No I18N
							Dialog.new({
								title: "", // NO I18N
								$content: html,
								defaultCloseIcon: true
							});
							$('.SC_PUbtm').removeAttr('disabled');
						}
						$(".SC_PUcen").find('#zcs_delete').click(function() {
							zmcontact.showCustomSearchPage(exist_contacts, ZContacts.getCurrentAccount().getAccountId());
							zmcontact.removeDialog(this);
						});
						$(".SC_PUcen").find('[data-val=Cancel]').click(function() {
							zmcontact.removeDialog(this);
						});
					});
				},
				cancel : function() {
					$('.SC_PUbtm').removeAttr('disabled');
					if (contactEditor.quickCreate) {
						zmsDialog.remove();
					} else {
						zmsuite.closeWorkspace("zm_createContact"); // No I18N
					}
				}
			};
			contactEditor.setOptions({
				actions : editorActions
			});
			var tit = I18N.get("IAM.CONTACTS.ADD.CONTACT") + " - (" + encodeHTML(ZContacts.getCurrentAccount().getName()) + ")"; // No I18N

			var popOpt = {
				title : tit,
				posParent : {
					top : posTop,
					left : posLeft
				},
				buttons : [ {
					txt : I18N.get("IAM.SAVE"), // No I18N
					selected : true,
					callback : editorActions.save
				}, {
					isCancel : true,
					txt : I18N.get("IAM.CANCEL"), // No I18N
					callback : editorActions.cancel
				} ],
				afterDisplay : function() {
					if(zc_popright){
						var elem = $("#zmsdialog_zc_contactpopup").parent().parent();
						$(elem).css({'right': posRight, 'left': '0px'});
					}
					$("#zc_contactpopup").find('[data-field-type="first_name"]')[0].focus();
				}

			};

			$('#zc_contactpopup').remove();
			$(document.body).append('<div id="zc_contactpopup"></div>');

			zmsDialog.create("zc_contactpopup", popOpt); // No I18N

			contactEditor.render($('#zc_contactpopup'));

			$("#zmsdialog_zc_contactpopup").mousedown(function(ev) { // No I18N
				zmUtil.stopEvents(ev, true);
			});
						
			$('#zmsdialog_zc_contactpopup').off("keypress").on("keypress",function(e) {
				if (e.which == 13 && !e.shiftKey) {
					$(this).find('.sel')[0].click();
				}
			});

		},
		
		editPageConfirm : function(contactId,currentAccountId) {
			if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.WORKSPACE_APP_ID)) {
				zmsuite.closeWorkspace("zm_createContact"); // No I18N
			} else {
				zmsDialog.remove();
			}

			new URI(ZContacts.Contacts, currentAccountId, contactId).include("emails").include("phones").include("address").include("urls").include("categories").GET().then(function(contact) { // No I18N
				zmcontact.showEditPage(contact); // No I18N
			});
		},

		invokeEvent : function(key, obj) {
			$.publish(key, obj);
		},

		scrollDownContacts : function(forceScroll) {
			var listElem = $(zmsuite.getCenter()[0].getNodes()[2].$el[0]).find('.SC_conLft');
			// Position percentage of scrollbar-head of the element
			var PAGINATE_SCROLL_PERCENT = 98;
			var currentScrollPercent = Math.round(((listElem[0].scrollTop + listElem.height()) * 100) / listElem[0].scrollHeight);
			var isNextPageLoading = (isSearchWorkSpace()) ? ZContacts.isSearchLoading : listingMetaData.isLoading;
			if (forceScroll || (currentScrollPercent >= PAGINATE_SCROLL_PERCENT && !isNextPageLoading)) {
				if (isNewSearchWorkSpace()) {
					ZContactsContext.getNextPage();
				} else if (isOldSearchWorkSpace()) {
					var searchRequest = new zmContactsSearch.contactsCollection();
					searchRequest.hasNextPage(searchRequest);
					ZContactsContext.getNextPage();
				} else {
					zmcontact.loadNextPage(zmcontact.getCategory(ZContacts._currentCategoryId));
				}
			}
		},
		
		scrollDownContactsPrint: function(forceScroll) {
			var listElem = $(zmsuite.$el.centerHolder).find('#zcs_printConLft');
			var PAGINATE_SCROLL_PERCENT = 98;
			var currentScrollPercent = Math.round(((listElem[0].scrollTop + listElem.height()) * 100) / listElem[0].scrollHeight);
			var isNextPageLoading = (isSearchWorkSpace()) ? ZContacts.isSearchLoading : listingPrintMetaData.isLoading;
			if (forceScroll || (currentScrollPercent >= PAGINATE_SCROLL_PERCENT && !isNextPageLoading && listingPrintMetaData.hasMore)) {
				var start = listingPrintMetaData.fetchedCount + 1;
				var limit = listingPrintMetaData.totalCount - listingPrintMetaData.fetchedCount;
				if (limit > 100) {
					limit = 100;
				}
				listingPrintMetaData.fetchedCount = listingPrintMetaData.fetchedCount + limit;
				listingPrintMetaData.isLoading = true;
				if (listingPrintMetaData.fetchedCount >= listingPrintMetaData.totalCount) {
					listingPrintMetaData.hasMore = false;
				}
				var uri = new URI(ZContacts.PrintContacts, accountId).include("emails").include("phones").include("address").setSortBy(ZContacts.sortBy, true); // No I18N
				uri.setRange(start, limit);

				uri.GETS().then(function(contactsToAdd) {
					listingPrintMetaData.isLoading = false;
					zmcontact.contactsList(contactsToAdd);
				});
			}
		},
		
		scrollDownExistingContactsList : function(forceScroll) {
			var listElem = $("#zmsdialog_contacts_list").find("#contacts_list").find('#content');
			var PAGINATE_SCROLL_PERCENT = 98; 
			var currentScrollPercent = Math.round(((listElem[0].scrollTop + listElem.height()) * 100) / listElem[0].scrollHeight);
			var isNextPageLoading = existingContactMetaData.isLoading;
			if (forceScroll || (currentScrollPercent >= PAGINATE_SCROLL_PERCENT && !isNextPageLoading)) {
				zmcontact.addExistingContacts(true);
			}
		},

		constructContactsRow : function(contacts, isCleanDupes) {
			var fragment = document.createDocumentFragment();
			for (var i = 0; i < contacts.length; i++) {
				var contact = contacts[i];
				fragment.appendChild(zmcontact.getContactRowElement(contact, isCleanDupes).get(0));
			}
			return fragment;
		},

		setAccountPhoto : function(t, contactId) {
			if (doAllowClick($(t))) {
				var contact = zmsuite.getCenter()[0].$el.find('#' + contactId).get(0);
				if (contact) {
					contact = contact.__zc_contact;
				} else {
					contact = staticObj[contactId];
				}
				zmcontact.restrictClick($('#zcs_uploadPopup').parent().siblings('.SC_PUbtm').children('span'), true); // No I18N
				zmcontact.restrictClick($(t), true);
				zmcontact.uploadPhoto(contact, false);
			}
		},

		setPhotoPath : function(value) {
			if (!value || value == "") {
				$('#zcs_choose_desktop').html(I18N.get("IAM.CONTACTS.CHOOSE.FROM.DESKTOP")); // No I18N
			} else {
				if (value.length > 20) {
					value = value.substring(0, 17) + "...";
				}
				$('#zcs_choose_desktop').html(value); // No I18N
			}
		},

		uploadPhoto : function(contact, isUpload) {
			var photo = ZContacts.Photo.create();
			var zid = contact.get("zid");
			var contact_id = contact.get("contact_id");
			if (isUpload) {
				photo.set('__form', '#zcs_uploadPopup'); // No I18N
			}
			$('#zcs_uploadPopup').parents('#zmsdialog_zcs_uploadPopup').prepend("<div id='uploadLoading' style='margin-bottom: 5%;' ></div>");
			var destroyLoadingDiv = zmComponent.loadingBand({
				container : $('#uploadLoading').get(0),
				type : "listing" // No i18N
			});
			new URI(ZContacts.Photo, zid, contact_id).POST(photo).then(function(json) {
				destroyLoadingDiv();
				zmcontact.restrictClick($('#zcs_uploadPopup').parent().siblings('.SC_PUbtm').children('span'), false); // No I18N
				zmcontact.restrictClick($('#zcs_user_photo'), false);
				$('#uploadLoading').remove();
				if (json.status_code == 200) {
					zmUtil.succErrMsg('s', ZContacts.getMessageFromResponse(json)); // No I18N
					delete ZContacts._audit[json.photo.contact_id];
					var date = new Date();
					var photo_url = zmcontact.getJsStdUrl(json.photo.photo_url) + "&nocache=" + date.getTime();  // No I18N
					// char "?" already present in photo_url
					zmsuite.getCenter()[0].$el.find("#" + json.photo.contact_id).find("img").attr("src", photo_url);
					$("#" + json.photo.contact_id).find("img").attr("src", photo_url);
					zmsuite.getCenter()[0].$el.find("#" + json.photo.contact_id + "_img").attr("src", photo_url);
					$("#" + json.photo.contact_id + "_img").attr("src", photo_url);
					zmsuite.getCenter()[0].$el.find("#" + json.photo.contact_id + "_bigimg").attr("src", photo_url);
					$("#" + json.photo.contact_id + "_bigimg").attr("src", photo_url);
					contact.photo_url = photo_url;
					if(zmsuite.getCenter()[0].$el.find('#' + json.photo.contact_id).get(0).__zc_contact) { // if contact clicked in auto list, this might be undefined
						zmsuite.getCenter()[0].$el.find('#' + json.photo.contact_id).get(0).__zc_contact.set("photo_url", photo_url);  // No I18N
						$('#' + json.photo.contact_id).get(0).__zc_contact.set("photo_url", photo_url);
						contact = $('#' + json.photo.contact_id).get(0).__zc_contact;
					}
					var rightContainer = zmsuite.getCenter()[0].$el;
					$(rightContainer).find('[name="zcs-update-photo"]').find('img').attr("src", photo_url);
					zmsDialog.remove();
					$('#zcs_uploadPopup').remove();
					/*	Event triggering to notify mail client	*/
					try {
						if(ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
							zmcontact.invokeEvent("contactsApp/updated", {zid : zid, contact : contact} ); // No I18N
						}
					} catch (e) {

					}
				} else {
					zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
				}
			}, function(json) {
				zmcontact.restrictClick($('#zcs_uploadPopup').parent().siblings('.SC_PUbtm').children('span'), false); // No I18N
				zmcontact.restrictClick($('#zcs_user_photo'), false);
				destroyLoadingDiv();
				$('#uploadLoading').remove();
				zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
			});
			$('#cnt-photo').val("");
			zmcontact.setPhotoPath("");
		},
		
		viewPhotoPopup : function (contact, container) {
			var $el = container ? $(container).find('#cntPhoto') : $('#cntPhoto'); // No I18N
			$el.css('display', 'flex'); // No I18N
		},
		
		
		closeViewPhotoPopup : function (e) {
  			if (e.key === 'Escape') {
    			$('[id="cntPhoto"]').filter(function() {
					return $(this).css('display') === 'flex'; // No I18N
				}).css('display', 'none'); // No I18N
  			} else if ($(e.target).hasClass('zcs_photo')) { // No I18N
    			$(e.target).css('display', 'none'); // No I18N
  			}
  		},
  	
  		closeModalOnly : function (e) {
  			e.stopPropagation();
  			$(e.target).closest('[id="cntPhoto"]').css('display', 'none'); // No I18N
		},



		openUploadPopup : function(contact) {
			if (!contact.isEditable()) {
				return false;
			}
			var ct = contact;
			var contact_id = contact.contact_id;
			var contact_zuid = contact.contact_zuid;
			var contact_name = contact.getFullName();
			var zid = contact.get('zid');
			createFolElem = $("<form id='zcs_uploadPopup'>");
			var tags = new ZContacts.StringBuilder();
			tags.append('<div class="SC_tdtl" style="width: 450px">'); // No I18N
			tags.append('<div class="SC_tiput" id="' + contact_id + '" style="float: left; width: 150px;height: auto; background-color: #fcfcfc;cursor: pointer;padding-top: 0%;padding-left: 0%;padding-right: 0%;padding-bottom: 0%;">');
			tags.append('<input style="left: 30px;top: 66px;width: 33%;position: absolute;cursor: pointer;height: 31px;opacity: 0;-webkit-user-select: none;-moz-user-select: none;-ms-user-select: none;user-select: none;" id="cnt-photo" name="photo" onchange="zmcontact.setPhotoPath(this.files[0].name);" type="file" />'); // No I18N
			tags.append('<div id="zcs_choose_desktop" style="font-size: 12px;color: #878787;max-width:100%;cursor: pointer;height: 97%;text-align : center;line-height: 30px;white-space: nowrap;overflow: hidden;padding-left: 5px;">' + I18N.get("IAM.CONTACTS.CHOOSE.FROM.DESKTOP") + '</div></div>'); // No I18N
			if (contact_zuid != -1) {
				tags.append('<div style="text-align: center;float: left;margin-left: 10px;margin-right: 10px;margin-top: 5px;color: #878787;font-size: 12px;line-height: 20px;">' + I18N.get("OR") + '</div>'); // No I18N
				tags.append('<div class="SC_tiput" style="padding-bottom: 0%;padding-right: 3%;float: left;width: auto;max-width: 300px;margin: auto;height: auto;font-size: 12px;color: #878787;background-color: #fcfcfc;cursor: pointer;" id="zcs_user_photo">'); // No I18N
				tags.append('<div style="float: left;margin-top: -2px;margin-left: -2px;"><img style="height: 25px;width: 25px;border-radius: 100%;" src="' + ZContacts.meta.serviceInfo.contacts_server_url + '/file?ID=' + contact_zuid + '" /></div>'); // No I18N
				tags.append('<span style="margin-left: 10px;line-height: 20px;">' + I18N.get("IAM.CONTACTS.KEEP.USER.PHOTO") + '</span>'); // No I18N
				tags.append('</div>'); // No I18N
			}
			tags.append('</div>'); // No I18N
			tags.append('<div style="clear: both;padding-top: 20px;">'); // No I18N
			tags.append('<li style="font-size: 13px;color: #999;padding-bottom: 5px;">' + I18N.get('IAM.NOTE') + ':</li>');
			tags.append('<li style="font-size: 11px;color: #878787">' + I18N.get('IAM.UPLOAD.NOTE1') + '</li>');
			tags.append('<li style="font-size: 11px;color: #878787">' + zmcontact.formatMessage(I18N.get('IAM.UPLOAD.NOTE2'), 3000) + '</li>');
			tags.append('<li style="font-size: 11px;color: #878787">' + I18N.get('IAM.UPLOAD.NOTE3') + '</li>');
			tags.append('</div>');
			tags.append('</form>'); // No I18N
			createFolElem.append(tags.toString());
			$(document.body).append(createFolElem);
			var uploadDiv = {};
			uploadDiv.title = zmcontact.formatMessage(I18N.get("IAM.CONTACTS.UPLOAD.TITLE"), encodeHTML(contact_name)); // No I18N
			uploadDiv.mask = true;
			uploadDiv.buttons = [ {
				txt : I18N.get("IAM.UPLOAD"), // No I18N
				selected : true,
				callback : function(data) {
					var button = $('#zcs_uploadPopup').parent().siblings('.SC_PUbtm').children('span'); // No I18N
					if (!doAllowClick(button)) {
						return;
					}
					var elem = $('#cnt-photo');
					var file = elem.val();
					if (file == "") {
						zmUtil.succErrMsg('e', I18N.get('IAM.CONTACTS.PLEASE.CHOOSE.PHOTO')); // No I18N
						return;
					}
					if (!/\.(jpe?g|png|gif|bmp)$/i.test(file)) {
						zmUtil.succErrMsg('e', I18N.get('IAM.CONTACTS.INVALID.PHOTO')); // No I18N
						return;
					}
					zmcontact.restrictClick($('#zcs_user_photo'), true);
					zmcontact.restrictClick(button, true);
					zmcontact.uploadPhoto(contact, true);
				}
			}, {
				isCancel : true,
				txt : I18N.get("IAM.CANCEL"), // No I18N
				callback : function(data) {
					var button = $('#zcs_uploadPopup').parent().siblings('.SC_PUbtm').children('span'); //No I18N
					if (!doAllowClick(button)) {
						return;
					}
					zmsDialog.remove();
					$('#zcs_uploadPopup').remove();
				}
			}, {
				isCancel : true,
				txt : I18N.get("IAM.CONTACTS.RESET.TO.DEFAULT"), // No I18N
				callback : function(data) {
					var button = $('#zcs_uploadPopup').parent().siblings('.SC_PUbtm').children('span'); //No I18N
					if (!doAllowClick(button)) {
						return;
					}
					zmcontact.restrictClick($('#zcs_user_photo'), true);
					zmcontact.restrictClick(button, true);
					var elem = $('#cnt-photo');
					var contact_id = elem.parent().attr('id'); // No I18N
					$('#zcs_uploadPopup').parents('#zmsdialog_zcs_uploadPopup').prepend("<div id='uploadLoading' style='margin-bottom: 5%;' ></div>");
					var destroyLoadingDiv = zmComponent.loadingBand({
						container : $('#uploadLoading').get(0),
						type : "listing" // No i18N
					});
					new URI(ZContacts.Photo, zid, contact_id).DELETE().then(function(json) {
						zmcontact.restrictClick(button, false);
						zmcontact.restrictClick($('#zcs_user_photo'), false);
						destroyLoadingDiv();
						$('#uploadLoading').remove();
						if (json.status_code == 204) {
							delete ZContacts._audit[json.photo.contact_id];
							zmUtil.succErrMsg('s', I18N.get("IAM.CONTACTS.PHOTO.RESET.SUCCESS")); // No I18N
							var date = new Date();
							var photoUrl = zmcontact.getJsStdUrl(json.photo.photo_url) + "&nocache=" + date.getTime();  // No I18N
							// char "?" already present in photo_url
							$("#" + json.photo.contact_id).find("img").attr("src", photoUrl);  
							$("#" + json.photo.contact_id + "_img").attr("src", photoUrl);
							var contact = ct;
							contact.photo_url = photoUrl;
							if($('#' + json.photo.contact_id).get(0).__zc_contact) {
								$('#' + json.photo.contact_id).get(0).__zc_contact.set("photo_url", photoUrl);
								contact = $('#' + json.photo.contact_id).get(0).__zc_contact;
							}
							var rightContainer = zmsuite.getCenter()[0].$el;
							$(rightContainer).find('[name="zcs-update-photo"]').find('img').attr("src", photoUrl);
							
							try {
								if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
									var contact = $('#' + json.photo.contact_id).get(0).__zc_contact;
									zmcontact.invokeEvent("contactsApp/updated", { zid : zid, contact : contact }); // No I18N
								}
							} catch (e) {

							}
							zmsDialog.remove();
							$('#zcs_uploadPopup').remove();
						} else {
							zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
						}
					}, function(json) {
						zmcontact.restrictClick(button, false);
						zmcontact.restrictClick($('#zcs_user_photo'), false);
						destroyLoadingDiv();
						$('#uploadLoading').remove();
						zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(json)); // No I18N
					});
				}
			} ];
			uploadDiv.closeaction = function() {
				zmsDialog.remove();
				$('#zcs_uploadPopup').remove();
			};
			uploadDiv.pos = "center"; // No I18N
			zmsDialog.create("zcs_uploadPopup", uploadDiv); // No I18N
			$('#zcs_uploadPopup').ready(function() {
				$($('#zcs_uploadPopup').parent().siblings('.SC_PUbtm').children('span')[2]).css('float', 'right'); // No I18N
			});
			
			$('#zcs_uploadPopup').parents('.SC_pe').on("click", function(e){
				  e.stopPropagation();
				});
			$('#zcs_uploadPopup').parents('.SC_Pop').on("click", function(e){
				this.remove();
			});
			
			$("#zcs_uploadPopup").find('#zcs_user_photo').click(function() {
				zmcontact.setAccountPhoto(this,contact_id);
			});
			
		},

		loadContactDetails : function(contactId,zid) {
			$('div[data-field-type=zcs-cnt-view]:not(:has(.zcs-contDup-row))').attr('data-field-type', ''); // No I18N
			zmsuite.getCenter()[0].$el.find('#' + contactId).attr('data-field-type', 'zcs-cnt-view'); // No I18N
			var srchTab = getCurrentSearchTab(zmTab.currentTab);
			if(!isNewSearchWorkSpace()){
				var $detailsContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find(".zcs-cont-details");
				$detailsContainer.html('');
				var destroyLoadingDiv = zmComponent.loadingBand({
					container : $detailsContainer.get(0), // No i18N
					type : "pagination" // No i18N
				});
			}
			if(zid == undefined){
				zid = ZContacts.getCurrentAccount().getAccountId();
			}
			new URI(ZContacts.Contacts, zid, contactId.toString()).include("emails").include("phones").include("address").include("urls").include("categories").include("work_details").GET().then(function(contact) { // No i18N
				var srchTab = getCurrentSearchTab(zmTab.currentTab);
				if(!isNewSearchWorkSpace()){
					destroyLoadingDiv();
				}
				zmcontact.renderContactDetails(contact);
				if (!isCleanWorkSpace()) {
					zmcontact.switchDetailsPage(true);
				}
				var rightContainer = zmsuite.getCenter()[0].$el.find('.SC_conRgt');
				$(rightContainer).find('[data-field-type=load_category]').on("click", function(event){
					var contact_id = event.target.dataset.id;
					zmcontact.loadCategoryContacts(encodeHTML(contact_id));
				});
				
			});
		},

		renderContactDetails : function(contact) {
			var contact_id = contact.get('contact_id'), name = encodeHTML(contact.getFullName());
			if(contact.is_writable == undefined){
				var cont = zmsuite.getCenter()[0].$el.find('#' + contact_id).get(0).__zc_contact;
				contact.is_writable = cont.is_writable;	
			}
			var contact_zuid = contact.get("contact_zuid"); // No I18N
			var photoUrl = zmcontact.getJsStdUrl(contact.get('photo_url')) + '&cache_expire=60'; // No I18N
			var bigPhotoUrl = photoUrl + '&photo_size=normal'; // No I18N
			var contacts_details = new ZContacts.StringBuilder();
			
			contacts_details.append('<div id="cntPhoto" class="zcs_photo">');
			contacts_details.append('<span id="cntPhotoClose" class="msi-close" style="position:absolute;top:10px;right:10px;cursor:pointer;font-size:20px;color:#fff;z-index:1;"></span>');
			contacts_details.append('<img class="zcs_cnt_photo" id="' + contact_id + '_bigimg" src="').append(bigPhotoUrl).append('" height="400" width="400">')
			contacts_details.append('</div>');
			
			contacts_details.append('<div>');
			contacts_details.append('<div style="float:left; padding:20px;"><div class="zcs-left" style="height: 143px";>'); // No I18N
			contacts_details.append('<div class="zcs-left" id="zcs-view-photo">'); // No I18N
			contacts_details.append('<img id="' + contact_id + '_img" style="position: absolute;" src=').append(photoUrl).append(' width="98" height="98" class="zcs-thumnail">'); // No I18N
			contacts_details.append('</div>'); // No I18N
			if (!contact.isActive()) {
				contacts_details.append("<div class='zmAct' style='top: 128px; left: 45px'>" + I18N.get('IAM.CONTACTS.INACTIVE') + "</div>");
			}
			contacts_details.append('<div style="margin-left: 125px;" class="zcs-name-info">'); // No I18N
			var nickName = encodeHTML(contact.get('nick_name'));
			contacts_details.append('<div class="zcs-title">').append(encodeHTML(contact.getFullName().trim())).append((nickName ? ' (' + nickName + ')' : '')).append('</div>');
			if (contact.getPrimaryEmail()) {
				contacts_details.append('<div class="zc-contact-details-email">');
				contacts_details.append('<div data-field-type="send_mail" data-id='+contact.getPrimaryEmail()+' class="zcs-title-mail" style="cursor: pointer; display: inline-block">').append(encodeHTML(contact.getPrimaryEmail())).append('</div>');
				contacts_details.append('<i class="zci-copy zc-copy-email"></i>');
				contacts_details.append('</div>');
			}
			var workAddress = null, homeAddr = null;
			if (contact.address) {
				for (var i = 0; i < contact.address.length; i++) {
					var addr = contact.address[i];
					if (addr.get('type') === 'home') {
						homeAddr = addr;
					} else if (addr.get('type') === 'work') {
						workAddress = addr;
					}
				}
			}
			
			if (contact.designation) {
				contacts_details.append('<div style="font-size: 11px;color:#9c999c;">');
				contacts_details.append(encodeHTML(contact.designation)).append("<br>");
				contacts_details.append("</div>");
			}

			if (contact.company) {
				contacts_details.append('<div style="font-size: 11px;color:#9c999c;">');
				contacts_details.append(encodeHTML(contact.company));
				contacts_details.append("</div>");
			}

			var contactId = contact.get('contact_id');
			var contactName = encodeHTML(contact.first_name);
			var zid = contact.get('zid');
			contacts_details.append('<div class="zcs-title-edit">');
			if (contact.isEditable()) {
				contacts_details.append('<a href="javascript:;" id="zcs-ac-editcont">').append(I18N.get("IAM.CONTACTS.EDIT.CONTACT")).append('</a> | ');
			}
			if (ZContacts.getCurrentAccount().getAccountType() != ZContacts.ZMailConstants.ORG_GROUP_ACCOUNT) {
				if (ZContacts.isFunctionableForCurrAcc("is_archiveable")) {
					contacts_details.append('<a href="javascript:;" id="zcs-ac-archivecont">').append(I18N.get("IAM.CONTACTS.ARCHIVE")).append('</a> | ');
				} else if (ZContacts.isFunctionableForCurrAcc("is_unarchiveable")) {
					contacts_details.append('<a href="javascript:;" id="zcs-ac-unarchivecont">').append(I18N.get("IAM.CONTACTS.UNARCHIVE")).append('</a> | ');
				}
			}
			if (contact.isDeletable()) {
				contacts_details.append('<a href="javascript:;" id="zcs-ac-deletecont">').append(I18N.get("IAM.DELETE")).append('</a> | ');
			}
			if (contact.is_writable) {
				contacts_details.append('<a href="javascript:;" id="zcs-ac-auditcont">').append(I18N.get("IAM.AUDIT.HISTORY")).append('</a> | ');
			}
			contacts_details.append('<a href="javascript:;" id="zcs-print">').append(I18N.get("IAM.PRINT")).append('</a></div>');
			contacts_details.append('</div>');
			contacts_details.append('</div>');

			if ((contact.emails && contact.emails.length) || (contact.get('categories') && contact.get('categories').length)) {
				contacts_details.append('<div class="zcs-space" style="height:1px"></div>');
				contacts_details.append('<div class="zcs-left"><div class="zcs-left">').append(I18N.get("IAM.CONTACTS.GENERAL")).append('</div>');
				contacts_details.append('<div>');
				if (contact.emails && contact.emails.length) {
					contacts_details.append('<div class="zcs-top">');
					contacts_details.append('<div  class="zcs-contacts-info">').append(I18N.get("IAM.EMAIL.IDS")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					var primaryEmail = encodeHTML(contact.getPrimaryEmail());
					contacts_details.append('<div class="zc-contact-details-email">');
					contacts_details.append('<a style="cursor: pointer" data-field-type="send_mail" data-id='+contact.getPrimaryEmail()+'').append('>').append(primaryEmail).append('</a>');
					contacts_details.append('<i class="zci-copy zc-copy-email"></i>');
					contacts_details.append('</div>');
					for (var i = 0; i < contact.emails.length; i++) {
						var emailId = encodeHTML(contact.emails[i].email_id);
						if(emailId != primaryEmail){
							contacts_details.append('<div class="zc-contact-details-email">');
							contacts_details.append('<a style="cursor: pointer" data-field-type="send_mail" data-id='+emailId+'').append('>').append(emailId).append('</a>');
							contacts_details.append('<i class="zci-copy zc-copy-email"></i>');
							contacts_details.append('</div>');
						}
					}
					contacts_details.append('</div></div>');
				}
				if (contact.get('categories') && contact.get('categories').length) {
					contacts_details.append('<div style="clear:both;" class="zcs-top">');
					contacts_details.append('<div  class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.CATEGORIES")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					for (var i = 0; i < contact.get('categories').length; i++) {
						var category = encodeHTML(contact.get('categories')[i]);
						if (i > 0) {
							contacts_details.append("<br>");
						}
						category = category.split(",");
						var html = "<span style='cursor: pointer;text-decoration: underline;color: #337fe5;' data-field-type='load_category' data-id="+category[0]+">" + category[1] + "</span>";
						contacts_details.append(html);
					}
					contacts_details.append('</div></div>');
				}
				contacts_details.append('</div>'); // No I18N
			}
			
			if (contact.phones) {
				contacts_details.append('<div class="zcs-space"></div>');
				contacts_details.append('<div class="zcs-left"><div class="zcs-left">').append(I18N.get("IAM.CONTACTS.BASIC.PHONE")).append('</div>');
				contacts_details.append('<div>');
				for (var i = 0; i < contact.phones.length; i++) {
					var type = encodeHTML(contact.phones[i].type);
					var number = encodeHTML(contact.phones[i].number);
					contacts_details.append('<div class="zcs-top" style="clear:both;">');
					if (type == "mobile") {// No I18N
						type = I18N.get("IAM.CONTACTS.BASIC.MOBILE"); // No I18N
					}
					if (type == "home") {
						type = I18N.get("IAM.CONTACTS.BASIC.HOME"); // No I18N
					}
					if (type == "work") { // No I18N
						type = I18N.get("IAM.CONTACTS.BASIC.WORK"); // No I18N
				    }
					if (type == "fax") {// No I18N
						type = I18N.get("IAM.CONTACTS.BASIC.FAX"); // No I18N
				    }
					if (type == "others") {// No I18N
						type = I18N.get("IAM.CONTACTS.OTHERS"); // No I18N
					}
					contacts_details.append('<div  class="zcs-contacts-info">').append(type).append(': </div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					contacts_details.append(number);
					contacts_details.append('</div>');
					contacts_details.append('</div>');
	            }
			}
			
			var workDetails = contact.get('work_details');
			if (workDetails) {
				contacts_details.append('<div class="zcs-space"></div>');
				contacts_details.append('<div class="zcs-left"><div class="zcs-left">').append(I18N.get("IAM.CONTACTS.JOB.INFO")).append('</div>');
				contacts_details.append('<div>');
				contacts_details.append('<div class="zcs-top">');
														
				var employeeId = workDetails.employee_id;
				if (employeeId) {
					contacts_details.append('<div style="clear: both" class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.EMPLOYEE.ID")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					contacts_details.append(employeeId);
					contacts_details.append('</div>');
	            }
														
				var designation = workDetails.designation;
				if (designation) {
					contacts_details.append('<div style="clear: both" class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.DESIGNATION")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					contacts_details.append(designation);
					contacts_details.append('</div>');
	            }
														
				var reportingTo = workDetails.reporting_to;
				if (reportingTo) {
					contacts_details.append('<div style="clear: both" class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.REPORTING.TO")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					contacts_details.append(reportingTo);
					contacts_details.append('</div>');
	            }
														
				var department = workDetails.department;
				if (department) {
					contacts_details.append('<div style="clear: both" class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.DEPARTMENT")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					contacts_details.append(department);
					contacts_details.append('</div>');
				}
														
				var company = workDetails.company;
				if (company) {
					contacts_details.append('<div style="clear: both" class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.COMPANY")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					contacts_details.append(company);
					contacts_details.append('</div>');
				}
			}

			if (homeAddr && !homeAddr.isEmpty()) {
				contacts_details.append('<div class="zcs-space"></div>');
				contacts_details.append('<div class="zcs-left"><div class="zcs-left">').append(I18N.get("IAM.CONTACTS.OTHERS.HADDRESS")).append('</div>');
				contacts_details.append('<div>');

				if (homeAddr && !homeAddr.isEmpty()) {
					var address = "";
					if (homeAddr.street_addr) {
						address += encodeHTML(homeAddr.street_addr) + "," + " " ;
					}
					if (homeAddr.street_addr1) {
						address = address + encodeHTML(homeAddr.street_addr1) + ",<br>";
					}
					if (homeAddr.city) {
						address = address + encodeHTML(homeAddr.city) + "," + " ";
					}
					if (homeAddr.state) {
						address = address + encodeHTML(homeAddr.state) + ",<br>";
					}
					if (homeAddr.country) {
						address = address + encodeHTML(homeAddr.country) + "," + " ";
					}
					if (homeAddr.postal_code) {
						address = address + encodeHTML(homeAddr.postal_code);
					}
					if (address) {
						if (address.substr("-1") == ",") {
							address = address.substring(0, address.length - 1);
						}
						contacts_details.append('<div class="zcs-top">');
						contacts_details.append('<div style="clear: both" class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.WORK.ADDRESS")).append(':</div>');
						contacts_details.append('<div class="zcs-contacts-info-right">');
						contacts_details.append(address);
						contacts_details.append('</div>');
						contacts_details.append('</div>');
					}
				}
			}
			if (workAddress && !workAddress.isEmpty()) {
				contacts_details.append('<div class="zcs-space"></div>');
				contacts_details.append('<div class="zcs-left"><div class="zcs-left">').append(I18N.get("IAM.CONTACTS.EXPORT.WORK.ADDRESS")).append('</div>');
				contacts_details.append('<div>');
				contacts_details.append('<div class="zcs-top">');
				
				if (workAddress && !workAddress.isEmpty()) {
					var address = "";
					if (workAddress.street_addr) {
						address += encodeHTML(workAddress.street_addr) + "," +  " ";
					}
					if (workAddress.street_addr1) {
						address = address + encodeHTML(workAddress.street_addr1) + ",<br>";
					}
					if (workAddress.city) {
						address = address + encodeHTML(workAddress.city) + "," + " ";
					}
					if (workAddress.state) {
						address = address + encodeHTML(workAddress.state) + ",<br>";
					}
					if (workAddress.country) {
						address = address + encodeHTML(workAddress.country) + "," + " ";
					}
					if (workAddress.postal_code) {
						address = address + encodeHTML(workAddress.postal_code) + "<br>";
					}
					if (address) {
						if (address.substr("-1") == ",") {
							address = address.substring(0, address.length - 1);
						}
						
						contacts_details.append('<div style="clear: both" class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.WORK.ADDRESS")).append(':</div>');
						contacts_details.append('<div class="zcs-contacts-info-right">');
						contacts_details.append(address);
						contacts_details.append('</div>');
					}
				}
				contacts_details.append('</div>');
			}
			
			if (contact.gender || contact.notes || contact.birth_day) {
				contacts_details.append('<div class="zcs-space"></div>');
				contacts_details.append('<div class="zcs-left"><div class="zcs-left">').append(I18N.get("IAM.CONTACTS.PERSONAL")).append('</div>');
				contacts_details.append('<div>');

				if (contact.gender) {
					contacts_details.append('<div class="zcs-top">');
					contacts_details.append('<div  class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.GENDER")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					if (contact.gender === "M") {
						contacts_details.append(I18N.get("IAM.CONTACTS.GENDER.MALE")); // No I18N
					} else {
						contacts_details.append(I18N.get("IAM.CONTACTS.GENDER.FEMALE")); // No I18N
					}
					contacts_details.append('</div>');
					contacts_details.append('</div>');
				}

				if (contact.birth_day) {
					contacts_details.append('<div class="zcs-top" style="clear:both;">');
					contacts_details.append('<div  class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.BASIC.BDAY")).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					var bday = "";
					if (contact.birth_day) {
						bday = bday + contact.birth_day + "-";
					}
					if (contact.birth_month) {
						bday = bday + contact.birth_month;
					}
					if (contact.birth_year) {
						bday = bday + "-" + contact.birth_year;
					}
					contacts_details.append(encodeHTML(bday));
					contacts_details.append('</div>');
					contacts_details.append('</div>');
				}

				if (contact.notes) {
					contacts_details.append('<div class="zcs-top" style="clear:both;">');
					contacts_details.append('<div  class="zcs-contacts-info">').append(I18N.get("IAM.CONTACTS.NOTES")).append(':</div>');
					contacts_details.append('<div style="white-space: pre-wrap;width: 1700px;max-width: 50%;word-wrap: break-word;white-space: -moz-pre-wrap;" class="zcs-contacts-info-right">');
					contacts_details.append(encodeHTML(contact.notes));
					contacts_details.append('</div>');
					contacts_details.append('</div>');

				}

			}

			if (contact.urls && contact.urls.length) {
				contacts_details.append('<div class="zcs-space"></div>');
				contacts_details.append('<div class="zcs-left"><div class="zcs-left">').append(I18N.get("IAM.CONTACTS.URLS")).append('</div>');
				contacts_details.append('<div>');
				var type;
				for (var i = 0; i < contact.urls.length; i++) {
					contacts_details.append('<div style="clear:both;" class="zcs-top">');
					type = encodeHTML(contact.urls[i].type);
					if (type == "home") {
						type = I18N.get("IAM.CONTACTS.EXPORT.PERSONALWEB.ADDRESS");
					} else if (type == "work") {
						type = I18N.get("IAM.CONTACTS.EXPORT.COMPANYWEB.ADDRESS");
					} else if (type == "blog") {
						type = I18N.get("IAM.CONTACTS.BLOG.URL");
					} else if (type == "linkedin") {
						type = I18N.get("IAM.CONTACTS.LINKEDIN.URL");
					} else if (type == "facebook") {
						type = I18N.get("IAM.CONTACTS.FACEBOOK.URL");
					} else if (type == "X") {
						type = I18N.get("IAM.CONTACTS.TWITTER.URL");
					} else if (type == "amazon") {
						type = I18N.get("IAM.CONTACTS.AMAZON.URL");
					} else if (type == "flickr") {
						type = I18N.get("IAM.CONTACTS.FLICKR.URL");
					} else if (type == "delicious") {
						type = I18N.get("IAM.CONTACTS.DELICIOUS.URL");
					} else {
						type = I18N.get("IAM.CONTACTS.OTHERS");
					}
					contacts_details.append('<div  class="zcs-contacts-info">').append(type).append(':</div>');
					contacts_details.append('<div class="zcs-contacts-info-right">');
					var readUrl = encodeHTML(contact.urls[i].url);
					var textElm = $('<a target="_blank">'+readUrl+'</a>');
					if(readUrl.indexOf('ht'+'tp:') != 0 && readUrl.indexOf('ht'+'tps:') !=0){
						readUrl = "//"+readUrl;
					}
					textElm.attr("href",readUrl); // No I18N
					contacts_details.append(textElm[0].outerHTML);
					contacts_details.append('</div>');
					contacts_details.append('</div>');
				}
				contacts_details.append('</div>');
			}

			contacts_details.append('</div>');
			contacts_details.append('</div>');
			contacts_details.append('</div>');
			
			$(document)
				.off("click", ".zc-contact-details-email") // No I18N
				.on("click", ".zc-contact-details-email", function(e) {
					e.preventDefault();

					const $container = $(this);

					let valueToCopy =
						$container.data("id") ||  // No I18N
						$container.find("[data-id]").data("id");  // No I18N

					if (!valueToCopy) {
						return
					};

					navigator.clipboard.writeText(valueToCopy).then(() => {
						zmUtil.succErrMsg("s", I18N.get("IAM.CONTACTS.EMAIL.ADDRESS.COPIED.TO.CLIPBOARD"));  // No I18N
					});
				});

			$(document).off("mouseenter", ".zc-contact-details-email").on("mouseenter", ".zc-contact-details-email", function() {
				$(this).addClass("hovered");
			});

			$(document).off("mouseleave", ".zc-contact-details-email").on("mouseleave", ".zc-contact-details-email", function() {
				$(this).removeClass("hovered");
			});

			var rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el.find(".SC_conRgt")[0];

			$(rightContainer).find(".zcs-cont-details").html(contacts_details.toString());
			$(rightContainer).find('#zcs-ac-editcont').click(function() {
				zmcontact.showEditPage(contact);
			});
			
			$(rightContainer).find('#zcs-ac-archivecont').click(function() {
				zmcontact.archiveContacts([contactId]);
			});

			$(rightContainer).find('#zcs-ac-unarchivecont').click(function() {
				zmcontact.unarchiveContacts([contactId]);
			});
			
			$(rightContainer).find('#zcs-ac-deletecont').click(function() {
				zmcontact.deleteSingleContact(contactId);
			});

			$(rightContainer).find('#zcs-ac-auditcont').click(function() {
				zmcontact.contactsAuditPopUp(contactId, zid);
			});

			$(rightContainer).find('#zcs-print').click(function() {
				zmcontact.printContact(contactId);
			});
			$(rightContainer).find('#zcs-view-photo').click(function() {
				zmcontact.viewPhotoPopup(contact, rightContainer);
			});
			$(rightContainer).find('#zcs-view-photo').mouseover(function() {
				$(this).css('display', 'block').css('cursor', 'pointer'); // No I18N
			});
			$(rightContainer).find('#zcs-view-photo').mouseout(function() {
				$(this).find('div').css('display', 'none');
			});
			$(rightContainer).find('[data-field-type="send_mail"]').on("click", function(e) {
					e.preventDefault();
					var email_id = e.target.dataset.id;
					zmcontact.sendMail(email_id);
				});
		},

		printContact : function(contactId) {
			var printDiv = {};
			printDiv.title = I18N.get("IAM.PRINT.PREVIEW"); // No I18N
			printDiv.mask = true;
			printDiv.buttons = [ {
				txt : I18N.get("IAM.PRINT"), // No I18N
				selected : true,
				callback : function(data) {
					var prtContent = document.getElementById("zcs_printPopup");
					var winPrint = window.open('', '', 'left=0,top=0,width=700,height=800,toolbar=no,scrollbars=yes,status=no');
					winPrint.document.write('<html><body onload="window.print()">');
					winPrint.document.write('<link type="text/css" rel="stylesheet" href="'+ ZContacts.meta.serviceInfo.contacts_server_url +'/new/css/new_style.css">');
					var logoSrc = ZContacts.getFingerPrintedFile("/images/contacts-logo.gif")+ "/"; // No I18N
					winPrint.document.write('<img alt="'+I18N.get("IAM.CONTACTS.ZOHO")+'" src="'+logoSrc+'" style="margin-top: -2px;height:24px;"/></div>');
					winPrint.document.write(prtContent.innerHTML);
					winPrint.document.write('</body></html>');
					winPrint.document.close();
					winPrint.focus();
					zmsDialog.remove();
				}
			}, {
				isCancel : true,
				txt : I18N.get("IAM.CANCEL"),
				callback : function() {
					zmsDialog.remove();
					$("#zcs_printPopup").remove();
				}
			} ];
			printDiv.closeaction = function() {
				zmsDialog.remove();
				$("#zcs_printPopup").remove();
			};
			printDiv.pos = "center"; // No I18N
			createFolElem = $("<div id='zcs_printPopup'></div>");
			if (!$("#zcs_printPopup").length) {
				var tags = "<div style='width: 200%; max-height: 555px; position: relative;'>";
				var prtContent = zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs-cont-details'); // No I18N
				tags = tags + prtContent[0].innerHTML + "</div>";
				createFolElem.append(tags);
				$(document.body).append(createFolElem);
				$("#zcs_printPopup").ready(function() {
					$("#zcs_printPopup").find('.zcs-title-edit').remove();
				});
			}
			zmsDialog.create("zcs_printPopup", printDiv); // No I18N
			$('#zcs_printPopup').parents('.SC_pe').on("click", function(e){
				  e.stopPropagation();
				});
			$('#zcs_printPopup').parents('.SC_Pop').on("click", function(e){
				this.remove();
			});

		},
		
		printWorkspace : function(contactsNode) {
			if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID)) {
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
				$('#zm_dropDown').hide();// No I18N
				return;
			} else {
				var workspace;
				if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.SEARCH_WORKSPACE_APP_ID)) {
					workspace = zmsuite.getCenter(ZContacts.ZMailConstants.SEARCH_WORKSPACE_APP_ID);
				} else if(isNewSearchWorkSpace()) {
					workspace = zmsuite.getCenter(ZContacts.ZMailConstants.NEW_SEARCH_WORKSPACE_APP_ID);
				} else {
					workspace = zmsuite.getCenter(ZContacts.ZMailConstants.CONTACTS_APP_ID);
				}
				var contactsTabObj2 = {
					appname : I18N.get("IAM.CONTACTS.PRINT"), // No I18N
					appId : ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID,
					appIcon : "msi-print", // No I18N
					searchPlaceHolder : I18N.get('IAM.CONTACTS.PRINT'), // No I18N
					data : {
						CNodes : "3"
					}
				};
				zmsuite.setWorkSpace(contactsTabObj2);
				zmsuite.showWorkSpace(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
			}
			var workspaceCenter = zmsuite.getCenter(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
			var centerNodes = workspaceCenter[0].getNodes();
			centerNodes[0].push([]);
			var headerObj = {
				left : {
					leftHTML : I18N.get("IAM.CONTACTS.PRINT")
				},
				right : []
			};
			centerNodes[1].push(headerObj);
			var headericon = {
				left : [],
				right : [ {
					actionArr : [ {
						iconList : [ "msi-plus" ], // No i18N
						tooltip : I18N.get("IAM.CONTACTS.ADD.CONTACT")
					} ]
				}, {
					actionArr : [ {
						iconList : [ "msi-thumbview" ], // No i18N
						tooltip : I18N.get("IAM.CONTACTS.PRINT.CARDVIEW")
					} ]
				}, {
					actionArr : [ {
						iconList : [ "msi-listview" ], // No i18N
						tooltip : I18N.get("IAM.CONTACTS.PRINT.LISTVIEW")
					} ]
				}, {
					actionArr : [ {
						iconList : [ "msi-close" ], // No i18N
						tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
					} ]
				} ]
			};
			centerNodes[0].push(headericon);

			var listingCenter = centerNodes[2];
			zmcontact.unChkAll();
			var $containerDiv = $('<div>').addClass('SC_print').width('1080px');
			var contactPrint = new ZContacts.contactprint();
			ZContacts.contactprint.$containerElem = $containerDiv;
			if (zmcontact.getCategory(ZContacts._currentCategoryId).count > 100) {
				if (contactsNode.$el.find(".zmL.SC_cont.SC_check").length > 100) {
					zmUtil.succErrMsg("s", I18N.get('IAM.CONTACTS.PRINT.PREVIEW'));// NO I18N
				} else if (contactsNode.$el.find(".zmL.SC_cont.SC_check").length == 0) {
					zmUtil.succErrMsg("s", I18N.get('IAM.CONTACTS.PRINT.PREVIEW'));// NO I18N
				}
			}
			contactPrint.createPageContent(getHtmlForPrintCard());
			listingCenter.$el.append($containerDiv);
			listingCenter.$el.addClass('zcs-print-form');
			contactPrint.render();
			zmsuite.renderWorkSpace();
			zmcontact.updateHeaderBand();
			zmcontact.showPrintPage(contactsNode, workspace);
			zmsuite.getCenter()[0].$el.find('.zcs-print-form').css('z-index','0'); // No I18N
			
			centerNodes[0].setListener("click", function(ev, iconName) {
				if (iconName == "msi-close") {
					zmsuite.closeWorkspace(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
					zmcontact.unChkAll();
				}
				if (iconName == "msi-listview") {
					if (contactPrint.$e.find('#final_table_view_print_div').is(':visible')) {
						return;
					}
					contactPrint.createPageContent(getHtmlForPrintTable());
					listingCenter.$el.append($containerDiv);
					listingCenter.$el.addClass('zcs-print-form');
					contactPrint.render();
					ZContacts.contactprint.tableView(contactsNode, workspace);
				}
				if (iconName == "msi-thumbview") {
					if (contactPrint.$e.find('#final_business_card_print_div').is(':visible')) {
						return;
					}
					contactPrint.createPageContent(getHtmlForPrintCard());
					listingCenter.$el.append($containerDiv);
					listingCenter.$el.addClass('zcs-print-form');
					contactPrint.render();
					zmcontact.showPrintPage(contactsNode, workspace, true);
					if(ZContacts._action != undefined && ZContacts._event != undefined){
						ZContacts.contactprint.select(ZContacts._event, ZContacts._action);
					}
				}
				if (iconName == "msi-plus") {
					var headerNode = zmsuite.getCenter()[1].getNodes();
					var headericon = {
						left : I18N.get("IAM.CONTACTS.PRINT"),
						right : [ {
							actionArr : [ {
								iconList : [ "msi-close" ], // No i18N
								tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
							} ]
						} ]
					};
					headerNode[0].push(headericon);
					zmsuite.getCenter()[1].getNodes()[0].render();
					zmsuite.renderCenter();

					var centerWrapper = zmsuite.getCenter();
					var tabNodes = centerWrapper[1].getNodes();
					var icons = [];
					icons.push({
						groupId : "prevIcons", // NO I18N
						actionArr : [ {
							iconClass : "msi-close", // NO I18N
							data : "msi-close", // NO I18N
							tooltip : I18N.get("IAM.CONTACTS.CLOSE.TAB")
						} ]
					});
					var prevHeader = {
						rIcons : icons
					};
					headerDOM = [ "DIV", { // NO I18N
						"attrs" : { // NO I18N
							"class" : "SC_phd" // NO I18N
						},
						"child" : [ // NO I18N
						[ "text", I18N.get("IAM.CONTACTS.SELECT") ] // NO I18N
						]
					} ];
					prevHeader.text = headerDOM;
					tabNodes[0].push(prevHeader);
					centerWrapper[1].show();
					$(zmsuite.getCenter()[1]).ready(function() {
						$(zmsuite.getCenter()[1].$el).css("left", "initial"); // No I18N
						$(zmsuite.getCenter()[1].$el).css("z-index", "5"); // No I18N
						$(zmsuite.getCenter()[1].$el).css("width", "350px"); // No I18N
						$(zmsuite.getCenter()[0].$el.find('.SC_mclst')).addClass("zcs_mclst");
						$(zmsuite.getCenter()[0].$el.find('.zcs_print_button_div')).css("z-index", "2"); // No I18N
					});

					tabNodes[0].setListener("click", function(iconName, element) { // NO I18N
						if (iconName == "msi-close") {
							centerWrapper[1].close();
							centerWrapper[1].$el.remove();
						}
					});
					accountId = ZContacts.getCurrentAccount().getAccountId();
					categoryId = zmcontact.getCategory(ZContacts._currentCategoryId).category_id;
					var uri = new URI(ZContacts.PrintContacts, accountId).include("emails").include("phones").include("address").setSortBy(ZContacts.sortBy, true); // No I18N
					if (!zmcontact.isRootFolder(categoryId)) {
						uri.addFilter("categories", categoryId); // No I18N
					}
					
					var limit, start;
					var totalContactsCount = zmcontact.getCategory(ZContacts._currentCategoryId).count;
					start = 1;
					limit = totalContactsCount;
					if(limit > 100){
						limit = 100;
					}
					
					uri.setRange(start,limit);
					listingPrintMetaData.fetchedCount = limit;
					listingPrintMetaData.totalCount = totalContactsCount;
					listingPrintMetaData.isLoading = true;
					if (totalContactsCount > 100) {
						listingPrintMetaData.hasMore = true;
					}
					
					if(start == 1 && limit == 0){
						var html = new ZContacts.StringBuilder();
						html.append('<div class="zsc_nmsg zmNightMode" style="padding: 10px;font-size: 15px;line-height: 48px;font-family: inherit;">' + I18N.get("IAM.CONTACTS.NO.CONTACT.ADDED.YET") + '</div>');
						zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').html(html.toString());
						printResponse[data.id] = [];
						$('#zm_dropDown').hide();// No I18N
						return;
					}
					uri.GETS().then(function(contactsToAdd) {
						listingPrintMetaData.isLoading = false;
						zmcontact.contactsList(contactsToAdd);
					});
				}
			});
		},
		
		showPrintPage : function(contactsNode, workspace, viewSwitch) {
			var toLoadCount;
			var uri = null;
			var noOfContactsSelected = contactsNode.$el.find(".zmL.SC_cont.SC_check").length;
			zmsuite.getCenter()[0].$el.find('.email_icon').css('background-image', 'url(' + ZContacts.getFingerPrintedFile("/images/Mail.png") + ')'); // No I18N
			zmsuite.getCenter()[0].$el.find('.address_icon').css('background-image', 'url(' + ZContacts.getFingerPrintedFile("/images/Address.png") +')'); // No I18N
			zmsuite.getCenter()[0].$el.find('.mobile_icon').css('background-image', 'url(' + ZContacts.getFingerPrintedFile("/images/Phone.png") + ')'); // No I18N
			zmsuite.getCenter()[0].$el.find('.dp_bg').css('background-image', 'url(' + ZContacts.getFingerPrintedFile("/images/user.svg") + ')'); // No I18N
			zmsuite.getCenter()[0].$el.find('.dp_show').css('background-image', 'url(' + ZContacts.getFingerPrintedFile("/images/user.svg") + ')'); // No I18N
			loadingDiv = zmComponent.loadingBand({
				container : zmsuite.getCenter()[0].getNodes()[2].$el.find('.zcs_contact_main_div').get(0), // No i18N
				type : "pagination" // No i18N
			});

			if (viewSwitch && ZContacts.contactprint.printValues(printResponse).length) {
				if (printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id].contact_id == undefined) {
					totalLength = printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id].length;
				} else {
					totalLength = ZContacts.contactprint.printValues(printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id]).length - 1;
				}
			}
			if (noOfContactsSelected) {
				accountId = ZContacts.getCurrentAccount().getAccountId();
				var contactIdsArr = zmcontact.getSelectedContactIds(workspace[0].getNodes()[2].$el);
				uri = new URI(ZContacts.Contacts, accountId, contactIdsArr).include("emails").include("phones").include("address").include("urls"); // No I18N
				if (viewSwitch && printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id] != null && totalLength > 0) {
					loadingDiv();
					zmcontact.printAllContact(printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id], totalLength, ZContacts.contactprint.$containerElem);
				} else {
					uri.GET().then(function(contactsToAdd) {
						loadingDiv();
						var contacts = [];
						if (noOfContactsSelected == 1) {
							contacts[0] = contactsToAdd;
						} else {
							contacts = contactsToAdd;
						}
						printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id] = contacts;
						zmcontact.printAllContact(contacts, noOfContactsSelected, ZContacts.contactprint.$containerElem);

					});
				}
			} else {
				accountId = ZContacts.getCurrentAccount().getAccountId();
				categoryId = zmcontact.getCategory(ZContacts._currentCategoryId).category_id;
				uri = new URI(ZContacts.PrintContacts, accountId).include("emails").include("phones").include("address").setSortBy(ZContacts.sortBy, true); // No I18N
				if (!zmcontact.isRootFolder(categoryId)) {
					uri.addFilter("categories", categoryId); // No I18N
				}
				var limit, start;
				start = 0;
				if (zmcontact.getCategory(ZContacts._currentCategoryId).count <= 100) {
					limit = zmcontact.getCategory(ZContacts._currentCategoryId).count;
					toLoadCount = -1;
				} else {
					limit = 100;
					toLoadCount = zmcontact.getCategory(ZContacts._currentCategoryId).count - limit;
				}
				uri.setRange(start,limit);
				if (viewSwitch && printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id] != null && totalLength > 0) {
					loadingDiv();
					zmcontact.printAllContact(printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id], totalLength, ZContacts.contactprint.$containerElem);
				} else {
					uri.GETS().then(function(contacts) {
						loadingDiv();
						printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id] = contacts;
						zmcontact.printAllContact(contacts, contacts.length, ZContacts.contactprint.$containerElem);
					});
				}

			}
			var editorActions = {
				print : function() {
					if(zmsuite.getCenter()[0].$el.find('#final_business_card_print_div').find('.contact_card').length == 0){
						zmUtil.succErrMsg('e', I18N.get("IAM.CONTACTS.PRINT.EMPTY.PREVIEW")); // No I18N
						return;
					}
					var winPrint = window.open('', '', 'left=0,top=0,width=850,height=800,toolbar=no,scrollbars=yes,status=no,position=fixed');
					var prtContent;
					winPrint.document.write('<html><body onload="window.print()">');
					winPrint.document.write('<link type="text/css" rel="stylesheet" href="' + ZContacts.meta.serviceInfo.contacts_server_url + '/new/css/new_style.css">');
					if (zmsuite.getCenter(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID)[0].$el.find('#final_business_card_print_div').is(':visible')) {
						prtContent = document.getElementById("final_business_card_print_div");
						winPrint.document.write('<div style="width:900px">');
					}
					var loadElement = document.createElement("div");
					loadElement.className = "zcs_loading_cls";
					winPrint.document.body.appendChild(loadElement);
					
					var element = document.createElement("div");
					element.setAttribute("id", "loadContent");
					element.innerHTML = I18N.get("IAM.CONTACTS.PRINT.FETCH");
					winPrint.document.body.appendChild(element);
					
					if (!noOfContactsSelected) {
						if(toLoadCount == -1){
							$(winPrint.document.getElementsByClassName('zcs_loading_cls')[0]).remove();
							$(winPrint.document.getElementById('loadContent')).remove();
							winPrint.document.write(prtContent.innerHTML);
							winPrint.document.write('</div></body></html>');
							zmsuite.closeWorkspace(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
							winPrint.document.close();
							winPrint.focus();
						} else {
							start = 100;
							limit = zmcontact.getCategory(ZContacts._currentCategoryId).count;
							uri.setRange(start,limit);
							uri.GETS().then(function(contacts) {
								$(winPrint.document.getElementsByClassName('zcs_loading_cls')[0]).remove();
								$(winPrint.document.getElementById('loadContent')).remove();
								zmcontact.printAllContact(contacts, contacts.length, ZContacts.contactprint.$containerElem);
								winPrint.document.write(prtContent.innerHTML);
								winPrint.document.write('</div></body></html>');
								zmsuite.closeWorkspace(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
								toLoadCount = -1;
								winPrint.document.close();
								winPrint.focus();
							});
						}
					} else {
						$(winPrint.document.getElementsByClassName('zcs_loading_cls')[0]).remove();
						$(winPrint.document.getElementById('loadContent')).remove();
						winPrint.document.write(prtContent.innerHTML);
						winPrint.document.write('</div></body></html>');
						zmsuite.closeWorkspace(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
						winPrint.document.close();
						winPrint.focus();
					}

				},
				cancel : function() {
					if (isPrintWorkSpace()) {
						zmsuite.closeWorkspace(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID);
					}
					zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId));
					zmcontact.unChkAll();
				}
			};
			var printAction = new ZContacts.contactprint({
				actions : editorActions
			});
			printAction.render();
			printAction.bindEvents();

			var printRightContainer = zmsuite.getCenter()[0].$el.find('.contact_card');
			$(printRightContainer).find('[data-field-type=zcs-address-check-box]').on("click", function(event){
				ZContacts.contactprint.select(event)
			});
			$(printRightContainer).find('[data-field-type=zcs-email-check-box]').on("click", function(event){
				ZContacts.contactprint.select(event)
			});
			$(printRightContainer).find('[data-field-type=zcs-phone-check-box]').on("click", function(event){
				ZContacts.contactprint.select(event)
			});

		},
		
		printAllContact : function(contacts, length, containerElement) {
			this.$e = containerElement;
			_this = this.$e.find('#final_business_card_print_div');
			var len = $(zmsuite.getCenter()[0].getNodes()[2].$el.find('#final_business_card_print_div').find('.contact_card')).length;
			if (len) {
				len = zmsuite.getCenter()[0].getNodes()[2].$el.find('#final_business_card_print_div').find('.contact_card').length
			}
			var contactCardArray = document.createDocumentFragment();
			var name, contact_info, email_head, contactCard, cardDesign, contactBasicInfo, basicInfoListDp, dpBg, dpShow, contactName, contactNameValue, contactInfo, contactEmail, emailIcon, emailHead, contactMobile, mobileIcon, mobileHead;
			for (var i = len, j = 0; i < length + len; i++, j++) {
				if(contacts[j] == null){
					continue;
				}
				name = (contacts[j].first_name || '') + ' ' + (contacts[j].middle_name || '') + ' ' + (contacts[j].last_name || '');
				contact_info = (contacts[j].designation ? (contacts[j].designation + '-') : '') + (contacts[j].company ? contacts[j].company : '');
				email_head = '';
				if (contacts[j].emails) {
					for (var k = 0; k < contacts[j].emails.length; k++) {
						if (contacts[j].emails[k].is_primary) {
							email_head = contacts[j].emails[k].email_id;
						}
					}
				}

				contactCard = document.createElement("div");
				contactCard.className = "contact_card";
				contactCard.id = contacts[j].contact_id;
				contactCard.style.minHeight = "220px"; // No I18N

				cardDesign = document.createElement("span");
				cardDesign.className = "card_design";
				contactCard.appendChild(cardDesign);

				contactBasicInfo = document.createElement("div");
				contactBasicInfo.className = "contact_basicinfo";
				basicInfoListDp = document.createElement("span");
				basicInfoListDp.className = "basic_info_list_dp";
				dpBg = document.createElement("span");
				dpBg.className = "dp_bg";
				dpBg.style.backgroundImage = 'url(' + contacts[j].photo_url + ')'; // No I18N

				basicInfoListDp.appendChild(dpBg);
				dpShow = document.createElement("span");
				dpShow.className = "dp_show";
				dpShow.style.backgroundImage = 'url(' + contacts[j].photo_url + ')'; // No I18N

				basicInfoListDp.appendChild(dpShow);
				contactBasicInfo.appendChild(basicInfoListDp);
				contactName = document.createElement("div");
				contactName.className = "contact_name";
				contactNameValue = document.createTextNode(name);
				contactName.appendChild(contactNameValue);
				if (contactNameValue.length > 31) {
					contactName.style.fontSize = "10px"; // No I18N
					contactName.style.overflow = "hidden"; // No I18N
				}

				contactInfo = document.createElement("div");
				contactInfo.className = "contact_info";
				contactInfo.appendChild(document.createTextNode(contact_info));
				contactBasicInfo.appendChild(contactName);
				contactBasicInfo.appendChild(contactInfo);

				contactCard.appendChild(contactBasicInfo);

				if (contacts[j].address) {
					for (var k = 0; k < contacts[j].address.length; k++) {
						var address = "";
						if (contacts[j].address[k].type == "work") {
							address += (contacts[j].address[k].street_addr ? contacts[j].address[k].street_addr : '') + (contacts[j].address[k].street_addr1 ? "," + contacts[j].address[k].street_addr1 : '') + (contacts[j].address[k].city ? "," + contacts[j].address[k].city : '') + (contacts[j].address[k].state ? "," + contacts[j].address[k].state : '') + (contacts[j].address[k].country ? "," + contacts[j].address[k].country : '') + (contacts[j].address[k].postal_code ? "," + contacts[j].address[k].postal_code : '');

							var address0 = document.createElement("div");
							address0.id = "address0";
							address0.className = "contact_address";
							var addressIcon = document.createElement("div");
							addressIcon.className = "address_icon";
							addressIcon.style.backgroundImage = 'url(' + ZContacts.getFingerPrintedFile("/images/Address.png") +')'; // No I18N
							address0.appendChild(addressIcon);
							var addressHead = document.createElement("div");
							addressHead.className = "address_head";
							addressHead.appendChild(document.createTextNode(contacts[j].address[k].type.charAt(0).toUpperCase() + contacts[j].address[k].type.substring(1, contacts[j].address[k].type.length)));
							var addressValue = document.createElement("div");
							addressValue.className = "address_value";
							addressValue.appendChild(document.createTextNode(address));
							address0.appendChild(addressHead);
							address0.appendChild(addressValue);
							contactCard.appendChild(address0);
						}
						if (contacts[j].address[k].type == "home") {
							address += (contacts[j].address[k].street_addr ? contacts[j].address[k].street_addr : '') + (contacts[j].address[k].street_addr1 ? "," + contacts[j].address[k].street_addr1 : '') + (contacts[j].address[k].city ? "," + contacts[j].address[k].city : '') + (contacts[j].address[k].state ? "," + contacts[j].address[k].state : '') + (contacts[j].address[k].country ? "," + contacts[j].address[k].country : '') + (contacts[j].address[k].postal_code ? "," + contacts[j].address[k].postal_code : '');

							var address1 = document.createElement("div");
							address1.id = "address1";
							address1.className = "contact_address";
							var addressIcon = document.createElement("div");
							addressIcon.className = "address_icon";
							addressIcon.style.backgroundImage = 'url(' + ZContacts.getFingerPrintedFile("/images/Address.png") +')'; // No I18N
							address1.appendChild(addressIcon);
							var addressHead = document.createElement("div");
							addressHead.className = "address_head";
							addressHead.appendChild(document.createTextNode(contacts[j].address[k].type.charAt(0).toUpperCase() + contacts[j].address[k].type.substring(1, contacts[j].address[k].type.length)));
							var addressValue = document.createElement("div");
							addressValue.className = "address_value";
							addressValue.appendChild(document.createTextNode(address));
							address1.appendChild(addressHead);
							address1.appendChild(addressValue);
							address1.style.display = "none";
							contactCard.appendChild(address1);
						}
					}
				}

				contactEmail = document.createElement("div");
				contactEmail.className = "contact_email";
				emailIcon = document.createElement("div");
				emailIcon.className = "email_icon";
				emailHead = document.createElement("div");
				emailHead.className = "email_head";
				emailHead.appendChild(document.createTextNode(email_head));
				if (contacts[j].emails && contacts[j].emails[0]) {
					emailIcon.style.backgroundImage = 'url(' + ZContacts.meta.serviceInfo.contacts_server_url + "/images/Mail.png" + ')'; // No I18N
				}
				contactEmail.appendChild(emailIcon);
				contactEmail.appendChild(emailHead);
				contactCard.appendChild(contactEmail);

				contactMobile = document.createElement("div");
				contactMobile.className = "contact_mobile";
				mobileIcon = document.createElement("div");
				mobileIcon.className = "mobile_icon";
				mobileHead = document.createElement("div");
				mobileHead.className = "mobile_head";
				
				var phone = '';
				if (contacts[j].phones) {
					for (var k = 0; k < contacts[j].phones.length; k++) {
						if (contacts[j].phones[k].type == "mobile") {
							mobileIcon.style.backgroundImage = 'url(' + ZContacts.getFingerPrintedFile("/images/Phone.png") + ')'; // No I18N
							phone += contacts[j].phones[k].number;
							break;
						}
					}
				}
				
				mobileHead.appendChild(document.createTextNode(phone));
				contactMobile.appendChild(mobileIcon);
				contactMobile.appendChild(mobileHead);
				contactCard.appendChild(contactMobile);

				contactCardArray.appendChild(contactCard);
			}
			document.getElementById('final_business_card_print_div').appendChild(contactCardArray);

			zmsuite.getCenter()[0].$el.find('.address_head').click(function() {
				var listObj = {};
				var list = [];
				list.push({
					htm : I18N.get("IAM.HOME"), // No I18N
					data : {
						action : "home" // No I18N
					}
				});
				list.push({
					htm : I18N.get("IAM.CONTACTS.BASIC.WORK"), // No I18N
					data : {
						action : "work" // No I18N
					}
				});

				listObj.par = zmsuite.getCenter()[0].$el.find('.address_head'); // No I18N
				listObj.defaultclass = true;
				listObj.parWidth = true;
				listObj.onHide = function() {
					$('#zm_dropDown').remove();// No I18N
				};
				listObj.list = list;
				listObj.clk = function(data, event) {
					ZContacts.contactprint.select(event, data.action);
					$('#zm_dropDown').hide();// No I18N
				};
				zmsuite.showMenu(listObj);
				$('#zm_dropDown').css('z-index', '1');
				$('#zm_dropDown').css('width', '120px');
				$('#zm_dropDown').css('margin-left', '-20px');
				$('#zm_dropDown').css('margin-top', '5px');
			});


			$(document).mouseup(function(e) {
				if ($(this).find('.dropdown-content').length) {
					if (!$(event.target).hasClass('dropdown-content')) {
						$(this).find('.dropdown-content').remove();
					}
				}
			});
			
			document.addEventListener('scroll', function (event) {
			    if($(document).find('#zm_dropDown').length == 1){
			    	$(document).find('#zm_dropDown').remove();
			    }
			}, true);
			
			zmsuite.getCenter(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID)[0].$el.find('#final_business_card_print_div').find('.contact_card').on("mouseover", function() { // No I18N
				if (!$(this).find('#cross').is(':visible')) {
					$(this).find('.contact_name').after('<a id="cross"><i class="msi-close"></i></a>');
					$('#cross').click(function() {
						for(var i = 0; i < ZContacts.contactprint.printValues(printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id]).length-1; i++){
							if(printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id][i] != null && printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id][i].contact_id == this.parentNode.parentNode.id){
								printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id][i] = null;
								break;
							}
						}
						$(this.parentNode.parentNode).remove();
					});
				}
			});

			zmsuite.getCenter(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID)[0].$el.find('#final_business_card_print_div').find('.contact_card').on("mouseleave", function() { // No I18N
				$(this).find('#cross').remove();
			});

		},
		
		addContactsToPrint : function(contacts, cntElem) {
			var accountId;
			var div = "<div style='padding: 2%; height:auto; width:96%;'><div id='ztb-search' style='left: 0%; width: 289px! important;' class='ztb-font-family ztb-search-focus SC_srcmore'><i class='msi-search' style='margin: 7px 0px;'></i><i class='msi-barrow'></i><input type='text' style='width: 255px! important; border:none; padding:0px;' id='ztb-search-field' class='ztb-font-family zm_sgst' placeholder='" + I18N.get("IAM.CONTACTS.SELECT") + "'></div></div><div class='SC_conLft' id='zcs_printConLft'></div>";
			if (zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').length == 0) {
				listingPrintMetaData.contacts = contacts;			
				$(zmsuite.getCenter()[1].contentObj.$el).html(div);
				zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').html(cntElem);
			} else {
				listingPrintMetaData.contacts = listingPrintMetaData.contacts.concat(contacts);
				zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').append(cntElem);
			}
			zmsuite.getCenter()[1].$el.find('#ztb-search-field')[0].focus();
			$(zmsuite.getCenter()[1].$el.find('.zmFrm')).css("text-overflow", "ellipsis"); // No I18N
			accountId = ZContacts.getCurrentAccount().getAccountId();

			zmsuite.getCenter()[1].$el.find('.msi-barrow').off("click").click(function() { // No I18N
				var parentEle = zmsuite.getCenter()[1].$el.find('#ztb-search');

				var listObj = {};
				var cat = [];
				cat.push({
					htm : encodeHTML(ZContacts.getCurrentAccount().name) + "/",
					data : {
						id : ZContacts.AccountsVsRootFolderMap[ZContacts.getCurrentAccount().getAccountId()]
					}
				});
				var cate = ZContacts._parentObj[ZContacts.getCurrentAccount().getRootFolderId()];
				if (cate) {
					for (var i = 0; i < cate.length; i++) {
						var display = "/" + encodeHTML(cate[i].category_name) + "/";
						if (display.length > 20) {
							var displayText = ".../" + encodeHTML(cate[i].category_name.substring(0, 19)) + "...";
						} else {
							var displayText = encodeHTML(ZContacts.getCurrentAccount().name) + "/" + encodeHTML(cate[i].category_name) + "/";
						}
						cat.push({
							htm : displayText,
							data : {
								id : cate[i].category_id
							}
						});
					}
				}

				listObj.par = parentEle;
				listObj.defaultclass = true;
				listObj.parWidth = true;
				listObj.onHide = function() {
					$('#zm_dropDown').remove();// No I18N
				};
				listObj.list = cat;

				listObj.clk = function(data, event) {
					var found = 0;
					if (data.id == null) {
						zmcontact.unChkAll();
						$('#zm_dropDown').hide();// No I18N
						return;
					}
					if (printResponse[data.id] != null) {
						if (printResponse[data.id].length) {
							contacts = printResponse[data.id];
							var cntElem = $(zmcontact.constructContactsRow(contacts));
							zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').html(cntElem);
							zmsuite.getCenter()[1].$el.find('.SC_icn').remove();
							zmsuite.getCenter()[1].$el.find('*[class^="wms"]').remove();
							zmsuite.getCenter()[1].$el.find('.zmFlt').children().css('padding-top','15px'); // No I18N
							$(zmsuite.getCenter()[1].$el.find('.zmL.SC_cont')).attr("draggable", "false"); // No I18N
							zmsuite.getCenter()[1].$el.find('.SC_conLft').after('<div class="SC_PUbtm zmModeBG printSelect"></div>');
							zmsuite.getCenter()[1].$el.find('.zmL.SC_cont').click(function() {
								if($(this).find('.msi-uncheck').length){
									$(this).addClass('SC_check');
									$(this).find('.msi-uncheck').addClass('msi-check').removeClass('msi-uncheck'); // No I18N
								} else {
									$(this).removeClass('SC_check')
									$(this).find('.msi-check').addClass('msi-uncheck').removeClass('msi-check'); // No I18N
								}
							});
							found = 1;
						}
					}
					accountId = (zmcontact.isRootFolder(data.id)) ? ZContacts.AccountsVsRootFolderMap[data.id].account_id : ZContacts.AccountsVsRootFolderMap[zmcontact.getRootFolderId(data.id)].account_id;
					categoryId = zmcontact.getCategory(data.id).category_id;
					var uri = new URI(ZContacts.PrintContacts, accountId).include("emails").include("phones").include("address").setSortBy(ZContacts.sortBy, true); // No I18N
					if (!zmcontact.isRootFolder(categoryId)) {
						uri.addFilter("categories", categoryId); // No I18N
					}
					var limit, start;
					start = 0;
					limit = zmcontact.getCategory(data.id).count;
					uri.setRange(start,limit);
					if(limit == 0 && start == 0){
						var html = new ZContacts.StringBuilder();
						html.append('<div class="zsc_nmsg zmNightMode" style="padding: 10px;font-size: 15px;line-height: 48px;font-family: inherit;">' + I18N.get("IAM.CONTACTS.NO.CONTACT.ADDED.YET") + '</div>');
						zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').html(html.toString());
						printResponse[data.id] = [];
						$('#zm_dropDown').hide();// No I18N
						return;
					}
					if (found == 0) {
						uri.GETS().then(function(contactsToAdd) {
							if (contactsToAdd.length) {
								printResponse[data.id] = contactsToAdd;
								contacts = contactsToAdd;
								var cntElem = $(zmcontact.constructContactsRow(contactsToAdd));
								zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').html(cntElem);
								zmsuite.getCenter()[1].$el.find('.SC_icn').remove();
								zmsuite.getCenter()[1].$el.find('*[class^="wms"]').remove();
								zmsuite.getCenter()[1].$el.find('.zmFlt').children().css('padding-top','15px'); // No I18N
								$(zmsuite.getCenter()[1].$el.find('.zmL.SC_cont')).attr("draggable", "false"); // No I18N
								zmsuite.getCenter()[1].$el.find('.SC_conLft').after('<div class="SC_PUbtm zmModeBG printSelect"></div>');
								zmsuite.getCenter()[1].$el.find('.zmL.SC_cont').click(function() {
									if($(this).find('.msi-uncheck').length){
										$(this).addClass('SC_check');
										$(this).find('.msi-uncheck').addClass('msi-check').removeClass('msi-uncheck'); // No I18N
									} else {
										$(this).removeClass('SC_check')
										$(this).find('.msi-check').addClass('msi-uncheck').removeClass('msi-check'); // No I18N
									}
								});
							}
						});
					}

					$('#zm_dropDown').hide();// No I18N
				};
				zmsuite.showMenu(listObj);
				$('#zm_dropDown').css('z-index', '10');
				$('#zm_dropDown').css('margin-right', '20px');
			});

			$(zmsuite.getCenter()[1].$el.find('#zcs_printConLft')).off("ready").ready(function() { // No I18N
				zmsuite.getCenter()[1].$el.find('.SC_icn').remove();
				zmsuite.getCenter()[1].$el.find('*[class^="wms"]').remove();
				zmsuite.getCenter()[1].$el.find('.zmFlt').children().css('padding-top','15px'); // No I18N
				$(zmsuite.getCenter()[1].$el.find('.zmL.SC_cont')).attr("draggable", "false"); // No I18N
				$(zmsuite.getCenter()[1].$el.find('.SC_conLft')).css("user-select", "none"); // No I18N
				if ($(zmsuite.getCenter()[1].$el).find(".printSelect").length == 0) {
					zmsuite.getCenter()[1].$el.find('.SC_conLft').after('<div class="SC_PUbtm zmModeBG printSelect"></div>');
					zmsuite.getCenter()[1].$el.find('.printSelect').append('<span id="zcs-select-btn" data-field-type="zcs-select-btn">' + I18N.get("IAM.ADD") + '</span>'); // No I18N
					zmsuite.getCenter()[1].$el.find('.printSelect').append('<span data-val="Cancel" data-field-type="zcs-cancel-btn" id="zcs-cancel-btn" style="margin-left: 10px;" data-val="Cancel">' + I18N.get("IAM.CANCEL") + '</span>');					
				}
			});

			zmsuite.getCenter()[1].$el.find('.zmL.SC_cont').off("click").click(function() { // No I18N
				if($(this).find('.msi-uncheck').length){
					$(this).addClass('SC_check');
					$(this).find('.msi-uncheck').addClass('msi-check').removeClass('msi-uncheck'); // No I18N
				} else {
					$(this).removeClass('SC_check');
					$(this).find('.msi-check').addClass('msi-uncheck').removeClass('msi-check'); // No I18N
				}
			});
			zmsuite.getCenter()[1].$el.off('click', '#zcs-select-btn').on('click', '#zcs-select-btn', function () { // No I18N
				var noOfContactsSelected = zmsuite.getCenter()[1].$el.find(".zmL.SC_cont.SC_check").length;
				if (noOfContactsSelected) {
					var contactIdsArr = zmcontact.getSelectedContactIds(zmsuite.getCenter(ZContacts.ZMailConstants.PRINT_WORKSPACE_APP_ID)[1].getNodes()[1].$el);
					new URI(ZContacts.Contacts, accountId, contactIdsArr).include("emails").include("phones").include("address").include("urls").GET().then(function(contacts) { // No I18N
						if (noOfContactsSelected == 1) {
							contacts[0] = contacts;
						}
						if(printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id].contact_id == undefined){
							totalLength = printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id].length;
						} else {
							totalLength = ZContacts.contactprint.printValues(printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id]).length-1;
						}
						for(var i=0;i<noOfContactsSelected;i++){
							printResponse[zmcontact.getCategory(ZContacts._currentCategoryId).category_id][totalLength+i]=contacts[i];
						}
						var div;
						if (zmsuite.getCenter()[0].$el.find('#final_table_view_print_div').is(':visible')) {
							div = zmsuite.getCenter()[0].$el.find('#final_table_view_print_div');
							ZContacts.contactprint.createTableContent(contacts, ZContacts.contactprint.$containerElem.find('#final_table_view_print_div'), noOfContactsSelected);
							zmsuite.getCenter()[0].$el.find('.zcs_print_main_div')[0].scrollTop = zmsuite.getCenter()[0].$el.find('.zcs_print_main_div')[0].scrollHeight;
							if(zmsuite.getCenter()[0].getNodes()[2].$el.find('.contact_list_header').find('.msi-uncheck').length > 0){
								if (zmsuite.getCenter()[0].getNodes()[2].$el.find('.contact_list_header').find('.msi-uncheck').length == 1) {
									div.find('.contact_list').addClass('contact_list_1050');
								} else {
									div.find('.contact_list').addClass('contact_list_710');
								}
							}
							for (var i = 0; i < ZContacts.contactprint.printValues(checkValues).length; i++) {
								if (ZContacts.contactprint.printValues(checkValues)[i] == false) {
									div.find(Object.keys(checkValues)[i]).hide();
								}
							}
						} else {
							zmcontact.printAllContact(contacts, noOfContactsSelected, ZContacts.contactprint.$containerElem);
							zmsuite.getCenter()[0].$el.find('.zcs_print_main_div')[0].scrollTop = zmsuite.getCenter()[0].$el.find('.zcs_print_main_div')[0].scrollHeight;
							div = zmsuite.getCenter()[0].$el.find('#final_business_card_print_div');
							for(var i=0;i<ZContacts.contactprint.printValues(checkValues).length;i++){
								var keyStore;
								if(Object.keys(checkValues)[i] == ".contact_address"){
									keyStore = ZContacts.contactprint.printValues(checkValues)[i];
								}
								if (ZContacts.contactprint.printValues(checkValues)[i] == true) {
									if(keyStore == true){
										if (ZContacts._action != undefined) {
											div.find('.contact_card').find(Object.keys(checkValues)[i]).show();
										} else {
											div.find(Object.keys(checkValues)[i]).show();
										}
									}
								} else {
									div.find('.contact_card').find(Object.keys(checkValues)[i]).hide();
								}
							}
						}
					});
					var centerNode = zmsuite.getCenter()[1].getNodes();
					centerNode[1].$el.find(".msi-check").removeClass().addClass("msi-uncheck"); // No I18N
					centerNode[1].$el.find(".SC_check").removeClass("SC_check"); // No I18N
				}
				zmsuite.getCenter()[1].close()
				zmsuite.getCenter()[1].$el.remove();

			}); 

			zmsuite.getCenter()[1].$el.off('click', '#zcs-cancel-btn').on('click', '#zcs-cancel-btn', function () { // No I18N
				zmsuite.getCenter()[1].close()
				zmsuite.getCenter()[1].$el.remove();
			});
			
			$(zmsuite.$el.centerHolder).find('#zcs_printConLft').unbind('scroll').bind('scroll', function() {
				zmcontact.scrollDownContactsPrint();
			});

			var isSearchAllowed = true;
			var searchQuery = "";
			
			$(zmsuite.getCenter()[1].$el.find('#ztb-search-field')).off('input').on('input', function(){ // No I18N
				var value = zmsuite.getCenter()[1].$el.find('#ztb-search-field').val();
				var valLength = value.length;
				if(categoryId == -1 || zmcontact.isRootFolder(categoryId) ){
	                categoryId = -1;
	            }
	            
	            if (valLength == 0) {
					searchQuery = '';
					isSearchAllowed = true;
					zmcontact.searchContactToPrint(value, listingPrintMetaData.contacts);
                    $(zmsuite.$el.centerHolder).find('#zcs_printConLft').unbind("scroll").bind("scroll", function() {
                        zmcontact.scrollDownContactsPrint();
                    });
				} else {
					var uri = new URI(ZContacts.Contacts, ZContacts.getCurrentAccount().getAccountId()).include("emails").include("phones").include("categories").addSearchQuery(value).setPagination('1', '100').setSortBy(ZContacts.sortBy, true); // No I18N
                    uri.addFilter("categories", categoryId); // No I18N
                    if (isSearchAllowed) {
                        uri.GETS().then(function(json) {
                            if (json.length == 0) {
                                isSearchAllowed = false;
                            } else {
								searchQuery = value;
							}
                            zmcontact.searchContactToPrint(value, json);
                        });
                    } else {
						if (value == searchQuery) {
                            isSearchAllowed = true;
                            uri.GETS().then(function(json) {
	                            if (json.length == 0) {
	                                isSearchAllowed = false;
	                            } else {
									searchQuery = value;
								}
	                            zmcontact.searchContactToPrint(value, json);
	                        });
                        }
					}
				}
			});
		},
		
		searchExistingContact: function(value, json) {
			var cntElem = $(zmcontact.constructContactsRow(json));
			$("#zmsdialog_contacts_list").find("#contacts_list").find("#content").unbind("scroll"); // No I18N
			if (json.length == 0) {
				var noContactsMsg = $("<p>")
					.text(I18N.get("IAM.CONTACTS.NO.CONTACTS.AVAILABLE"))
					.css({
						"text-align": "center", // No I18N
						"font-size": "15px", // No I18N
						"margin": "20px 0" // No I18N
					});
				$("#zmsdialog_contacts_list").find("#contacts_list").find("#content").html(noContactsMsg);
			} else {
				$("#zmsdialog_contacts_list").find("#contacts_list").find("#content").html(cntElem);
			}

			$("#zmsdialog_contacts_list").find("#contacts_list").find("#content").unbind("scroll").bind("scroll", function() { // No I18N
				zmcontact.scrollDownExistingContactsList();
				$(".SC_icn").remove();
			});

			$("#zmsdialog_contacts_list").find("#contacts_list").find('.zmL.SC_cont').off("click").click(function() { // No I18N
				if ($(this).find('.msi-uncheck').length) {
					$(this).addClass('SC_check');
					$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class', 'msi-partcheck'); // No I18N
					$(this).find('.msi-uncheck').addClass('msi-check').removeClass('msi-uncheck'); // No I18N
				} else {
					$(this).removeClass('SC_check');
					$(this).find('.msi-check').addClass('msi-uncheck').removeClass('msi-check'); // No I18N
					if ($("#zmsdialog_contacts_list").find("#contacts_list").find('.zmL.SC_cont').find('.msi-check').length == 0) {
						$("#zmsdialog_contacts_list").find("#contacts_list").find('#select-all').attr('class', 'msi-uncheck'); // No I18N
					}
				}
			});
		},
		
		searchContactToPrint : function(value, json) {
			var cntElem = $(zmcontact.constructContactsRow(json));
			$(zmsuite.$el.centerHolder).find('#zcs_printConLft').unbind("scroll");
			zmsuite.getCenter()[1].contentObj.$el.find('.SC_conLft').html(cntElem);
			zmsuite.getCenter()[1].$el.find('.SC_icn').remove();
			zmsuite.getCenter()[1].$el.find('.zmFlt').children().css('padding-top','15px'); // No I18N
			zmsuite.getCenter()[1].$el.find('*[class^="wms"]').remove();
			$(zmsuite.getCenter()[1].$el.find('.zmL.SC_cont')).attr("draggable", "false"); // No I18N
			$(zmsuite.getCenter()[1].$el.find('.SC_conLft')).css("user-select", "none"); // No I18N
			zmsuite.getCenter()[1].$el.find('.zmFrm').each(function() {
				var index = $(this).children("span").html().toLowerCase().indexOf(value.toLowerCase()); // No I18N
				if (index != -1) {
					var html = $(this).children("span").html(); // No I18N
					html = html.substring(0, index) + '<font class="afHgl">' + html.substring(index, index + value.length) + '</font>' + html.substring(index + value.length);
					$(this).children("span").html(html); // No I18N
				} else {
					if (this.nextSibling != null) {
						var index = $(this.nextSibling.children).html().toLowerCase().indexOf(value.toLowerCase());
						var html = $(this.nextSibling.children).html();
						html = html.substring(0, index) + '<font class="afHgl">' + html.substring(index, index + value.length) + '</font>' + html.substring(index + value.length);
						$(this.nextSibling.children).html(html);
					}
				}
			});
			zmsuite.getCenter()[1].$el.find('.zmL.SC_cont').click(function() {
				if($(this).find('.msi-uncheck').length){
					$(this).addClass('SC_check');
					$(this).find('.msi-uncheck').addClass('msi-check').removeClass('msi-uncheck'); // No I18N
				} else {
					$(this).removeClass('SC_check')
					$(this).find('.msi-check').addClass('msi-uncheck').removeClass('msi-check'); // No I18N
				}
			});

		},
		
		switchDetailsPage : function(isDetail) {
			var rightContainer = zmsuite.getWorkSpace(zmTab.currentTab)[0].$el.find('.SC_mclst').find('.SC_conRgt');
			if (isDetail) {
				$(rightContainer).find('.zcs-cont-edit').hide();
				$(rightContainer).find('.zcs-multiCont-edit').hide();
				$(rightContainer).find('.zcs-cont-details').show();
			} else {
				$(rightContainer).find('.zcs-multiCont-edit').hide();
				$(rightContainer).find('.zcs-cont-details').hide();
				if ($(rightContainer).find('.zcs-editor-qkcreate')[0] && !zmail.forContactsApp) {
				    $(rightContainer).find('#zcs_name_label').css("margin-bottom", "-14px");;
				}
				$(rightContainer).find('.zcs-cont-edit').show();
			}
		},

		initScroll : function(scrollElem, currElem, nearElem) {
			var sTop = scrollElem.scrollTop(), currTop = currElem.offset().top, prevTop = nearElem.offset().top, halfHeight = scrollElem.height() / 2, diff, diffLen;
			diffLen = (currTop) - (prevTop);
			scrollElem.scrollTop(sTop + diffLen);
			if (currTop < 0) {
				diff = halfHeight - currTop;
				scrollElem.scrollTop(sTop - diff);
			} else if (currTop > scrollElem.height()) {
				diff = currTop - halfHeight;
				scrollElem.scrollTop(sTop + diff);
			}
		},

		showMergePage : function(contacts, contactIds, isMerge) {
			delete ZContacts._accountAudit[ZContacts.getCurrentAccount().getAccountId()];
			var editorActions = {
				merge : function() {
					var contactModel = this.toContactsModel(ZContacts.ContactsMerge.create());
					if (!contactModel) {
						return;
					}
					zmsDialog.confirm(zmcontact.formatMessage(I18N.get("IAM.CONTACTS.MERGE.CONFIRM"), contactIds.length), {// No I18N
						onOk : function() {
							new URI(ZContacts.ContactsMerge, ZContacts.getCurrentAccount().getAccountId(), contactIds).POST(contactModel).then(function(response) {
								if (response.status_code == 201) {
									zmUtil.succErrMsg('s', I18N.get("IAM.CONTACTS.DUPLICATES.MERGED.SUCCESSFULLY"));
									
									/*	Event triggering to notify mail client	*/
									try {
										if (ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.PERSONAL_ACCOUNT || ZContacts.getCurrentAccount().getAccountType() == ZContacts.ZMailConstants.ORG_ACCOUNT) {
											contactModel.contact_id = response.contacts.contact_id
											zmcontact.invokeEvent("contactsApp/added", {zid : ZContacts.getCurrentAccount().getAccountId(), contact : contactModel}); // No I18N
											zmcontact.invokeEvent("contactsApp/deleted", {zid : zid, contact_ids : contactIds.split(',')}); // No I18N
										}
									} catch (e) {

									}
									
									if (!isMerge) {
										var noOfRow = $('.zcs-contDup-row').parents('.SC_cont');
										if (noOfRow.length != 1) {
											var elem = $("div[id='" + contactIds + "']");
											var nextElem = elem.next();
											if (!nextElem.length) {
												nextElem = $($('.zcs-contDup-row').parents('#zcs_conLft').find('.zmL')[0]);
											}
											nextElem.click();
											zmcontact.initScroll($(zmsuite.getCenter()[0].getNodes()[2].$el.children()[0]), nextElem, elem);
											elem.remove();
											zmcontact.refreshContactCounts();
											return;
										}
										if (noOfRow.length == 1) {
											if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID)) {
												zmsuite.closeWorkspace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
											}
										}
									}
									zmcontact.loadFirstPage(zmcontact.getCategory(ZContacts._currentCategoryId));
									zmcontact.refreshContactCounts();
									return;
								}
							}, function(response){
								zmUtil.succErrMsg('e', ZContacts.getMessageFromResponse(response)); // No I18N
							});
						}
					});
				},
				skip : function() {
					var prevElem = $('div[data-field-type="zcs-cnt-view"]:has(.zcs-contDup-row)');
					if ($('.zcs-contDup-row').length == 1) {
						if (zmsuite.isWorkspaceAvailable(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID)) {
							zmsuite.closeWorkspace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
						}
					} else {
						if (prevElem.next().length) {
							prevElem.next().click();
						} else {
							$('.zcs-contDup-row').parents('#zcs_conLft').find('.zmL')[0].click();
						}
						var currElem = $('div[data-field-type="zcs-cnt-view"]');
						zmcontact.initScroll($(zmsuite.getCenter()[0].getNodes()[2].$el.children()[0]), currElem, prevElem);
					}
				},
				deleteContact : function() {
					var elem = $('div[data-field-type=zcs-cnt-view]:has(.zcs-contDup-row)');
					var id = elem[0].id;
					zmcontact.deleteMultiContacts(id.split(","));
				},
				cancel : function() {
					if (isCleanWorkSpace()) {
						zmsuite.closeWorkspace(ZContacts.ZMailConstants.CLEAN_WORKSPACE_APP_ID);
					}else{
						zmcontact.switchDetailsPage(true);
					}
					zmcontact.updateHeaderBand(zmcontact.getCategory(ZContacts._currentCategoryId));
					zmcontact.unChkAll();
				}
			};
			var nameArr = {
				first_name : [],
				middle_name : [],
				last_name : [],
				nick_name : [],
				job_title : [],
				designation : [],
				company : [],
				notes : []
			}; // No I18N
			var hmeAddrArr = {
				street_addr : [],
				street_addr1 : [],
				city : [],
				state : [],
				country : [],
				postal_code : []
			};
			var wrkAddrArr = {
				street_addr : [],
				street_addr1 : [],
				city : [],
				state : [],
				country : [],
				postal_code : []
			};
			var contact = contacts[0];
			for (var i = 0; contacts[i]; i++) {
				if (i != 0) {
					var length = contact.emails ? contact.emails.length : 0;
					if (contacts[i].emails) {
						if (length == 0) {
							contact.emails = [];
						}
						for (var j = 0; (j < contacts[i].emails.length && (contact.emails && contact.emails.indexOf(contacts[i].emails[j].email_id) == -1)); j++) {
							contact.emails[length + j] = {
								is_primary : false,
								email_id : contacts[i].emails[j].email_id
							};
						}
					}
					length = contact.phones ? contact.phones.length : 0;
					if (contacts[i].phones) {
						if (length == 0) {
							contact.phones = [];
						}
						for (var j = 0; (j < contacts[i].phones.length && (contact.phones && contact.phones.indexOf(contacts[i].phones[j].number) == -1)); j++) {
							contact.phones[length + j] = {
								type : contacts[i].phones[j].type,
								number : contacts[i].phones[j].number
							};
						}
					}
					length = contact.urls ? contact.urls.length : 0;
					if (contacts[i].urls) {
						if (length == 0) {
							contact.urls = [];
						}
						for (var j = 0; (j < contacts[i].urls.length && (contact.urls && contact.urls.indexOf(contacts[i].urls[j].url) == -1)); j++) {
							contact.urls[length + j] = {
								type : contacts[i].urls[j].type,
								url : contacts[i].urls[j].url
							};
						}
					}
				}
				// Adding distinct fields to array to avoid duplicate fields
				distinctField(nameArr,contacts[i]);
				var hmeAddr, wrkAddr;
				if (contacts[i].address && contacts[i].address.length) {
					hmeAddr = contacts[i].address[0].type == "home" ? contacts[i].address[0] : contacts[i].address[1];
					wrkAddr = contacts[i].address[0].type == "work" ? contacts[i].address[0] : contacts[i].address[1];
				}
				if (hmeAddr) {
					distinctField(hmeAddrArr, hmeAddr);
				}
				if (wrkAddr) {
					distinctField(wrkAddrArr, wrkAddr);
				}
			}
			function distinctField(fieldArr, fieldObj){
				$.each(fieldArr, function(key, value) {
					if (fieldObj[key] && value.indexOf(fieldObj[key].trim()) == -1) {
						value[value.length] = fieldObj[key].trim();
					}
				});
			}
			// Emptying array if length of the field is 1 and already present in first contact
			$.each(nameArr, function(key, value) {
				if (key != "notes") {
					var firstCntField;
					if (contacts[0][key]) {
						firstCntField = contacts[0][key].trim();
					}
					if (nameArr[key].length == 1 && value[0] == firstCntField) {
						nameArr[key] = [];
					}
				}
			});
			var firstCntHmeAddr;
			if (contacts[0].address && contacts[0].address.length) {
				firstCntHmeAddr = contacts[0].address[0].type == "home" ? contacts[0].address[0] : contacts[0].address[1];
			}
			if (firstCntHmeAddr && i != 0) {
				$.each(hmeAddrArr, function(key, value) {
					var firstCntField;
					if (firstCntHmeAddr[key]) {
						firstCntField = firstCntHmeAddr[key].trim();
					}
					if (hmeAddrArr[key].length == 1 && value[0] == firstCntField) {
						hmeAddrArr[key] = [];
					}
				});
			}
			var firstCntWrkAddr;
			if (contacts[0].address && contacts[0].address.length) {
				firstCntWrkAddr = contacts[0].address[0].type == "work" ? contacts[0].address[0] : contacts[0].address[1];
			}
			if (firstCntWrkAddr && i != 0) {
				$.each(wrkAddrArr, function(key, value) {
					var firstCntField;
					if (firstCntWrkAddr[key]) {
						firstCntField = firstCntWrkAddr[key].trim();
					}
					if (wrkAddrArr[key].length == 1 && value[0] == firstCntField) {
						wrkAddrArr[key] = [];
					}
				});
			}
			var contact = ZContacts.ContactsDuplicates.create(contact);
			var ceditor = new ZContacts.ContactEditor(false, contact, {
				actions : editorActions
			});
			var $rightContainer = zmsuite.getCenter()[0].getNodes()[2].$el;
			ceditor.render($rightContainer.find('.zcs-cont-edit'), true, "merge"); // No I18N

			/* Name */

			zmsuite.getCenter()[0].$el.find('input[data-field-type="middle_name"]').after('<div id="zcs-first-middle" class="zcs-mr10" style="width :100%;float: left;">');
			if (nameArr.first_name.length || nameArr.middle_name.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-first-middle').append('<div id="zcs-dup-first" style="width:48%; margin-right: 1px;" class="zcs-merge-all-fields">');
				for (var i = 0; i < nameArr.first_name.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-first').append('<label data-field-type="merge_first_name" data-id='+nameArr.first_name[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(nameArr.first_name[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-first').append('</div>');
			}
			if (nameArr.first_name.length || nameArr.middle_name.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-first-middle').append('<div id="zcs-dup-middle" style="width:47%" class="zcs-merge-all-fields">');
				for (var i = 0; i < nameArr.middle_name.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-middle').append('<label data-field-type="merge_middle_name" data-id='+nameArr.middle_name[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(nameArr.middle_name[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-middle').append('</div>');
			}
			zmsuite.getCenter()[0].$el.find('#zcs-first-middle').append('</div>');
			zmsuite.getCenter()[0].$el.find('#zcs-first-middle').after('<div style="clear: both;"></div>');

			zmsuite.getCenter()[0].$el.find('input[data-field-type="nick_name"]').after('<div id="zcs-last-nick" class="zcs-mr10" style="width :100%;float: left;">');
			if (nameArr.last_name.length || nameArr.nick_name.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-last-nick').append('<div id="zcs-dup-last" style="width:48%; margin-right: 1px;" class="zcs-merge-all-fields">');
				for (var i = 0; i < nameArr.last_name.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-last').append('<label data-field-type="merge_last_name" data-id='+nameArr.last_name[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(nameArr.last_name[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-last').append('</div>');
			}
			if (nameArr.last_name.length || nameArr.nick_name.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-last-nick').append('<div id="zcs-dup-nick" style="width:47%" class="zcs-merge-all-fields">');
				for (var i = 0; i < nameArr.nick_name.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-nick').append('<label data-field-type="merge_nick_name" data-id='+nameArr.nick_name[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(nameArr.nick_name[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-nick').append("</div>");
			}
			zmsuite.getCenter()[0].$el.find('#zcs-last-nick').append("</div>");

			/* Home Address */

			zmsuite.getCenter()[0].$el.find('input[data-field-type="hme_street_addr"]').after('<div id="zcs-hme-street" class="zcs-mr10" style="width :66.5%;float: left;">');
			if (hmeAddrArr.street_addr.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-hme-street').append('<div id="zcs-dup-streetadd" style="width: 147.6%" class="zcs-merge-all-fields">');
				for (var i = 0; i < hmeAddrArr.street_addr.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-streetadd').append('<label data-field-type="merge_home_street_addr" data-id='+hmeAddrArr.street_addr[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(hmeAddrArr.street_addr[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-streetadd').append("</div>");
				zmsuite.getCenter()[0].$el.find('#zcs-hme-street').append('</div>');
				zmsuite.getCenter()[0].$el.find('#zcs-hme-street').append('<div style="clear: both;"></div>');
			}

			zmsuite.getCenter()[0].$el.find('input[data-field-type="hme_street_addr1"]').after('<div id="zcs-hme-street1" class="zcs-mr10" style="width :66.5%;float: left;">');
			if (hmeAddrArr.street_addr1.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-hme-street1').append('<div id="zcs-dup-streetadd1" style="width: 147.6%" class="zcs-merge-all-fields">');
				for (var i = 0; i < hmeAddrArr.street_addr1.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-streetadd1').append('<label data-field-type="merge_home_street_addr1" data-id='+hmeAddrArr.street_addr1[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(hmeAddrArr.street_addr1[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-streetadd1').append("</div>");
				zmsuite.getCenter()[0].$el.find('#zcs-hme-street1').append('</div>');
				zmsuite.getCenter()[0].$el.find('#zcs-hme-street1').append('<div style="clear: both;"></div>');
			}

			zmsuite.getCenter()[0].$el.find('input[data-field-type="hme_state"]').after('<div id="zcs-hme-state-city" class="zcs-mr10" style="width: 99.1%;float: left;">');
			if (hmeAddrArr.city.length || hmeAddrArr.state.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-hme-state-city').append('<div id="zcs-dup-city" style="width: 49%;margin-right: 8px" class="zcs-merge-all-fields">');
				for (var i = 0; i < hmeAddrArr.city.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-city').append('<label data-field-type="merge_home_city" data-id='+hmeAddrArr.city[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(hmeAddrArr.city[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-city').append('</div>');
			}
			if (hmeAddrArr.city.length || hmeAddrArr.state.length) {
				zmsuite.getCenter()[0].$el.find('#zcs-hme-state-city').append('<div id="zcs-dup-state" style="width: 48%" class="zcs-merge-all-fields">');
				for (var i = 0; i < hmeAddrArr.state.length; i++) {
					zmsuite.getCenter()[0].$el.find('#zcs-dup-state').append('<label data-field-type="merge_home_state" data-id='+hmeAddrArr.state[i]+' class="zcs-merge-field" style="cursor: pointer;">' + encodeHTML(hmeAddrArr.state[i]) + '</label>');// No I18N
				}
				zmsuite.getCenter()[0].$el.find('#zcs-dup-state').append("</div>");
			}
