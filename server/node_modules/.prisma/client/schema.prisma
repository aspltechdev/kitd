generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Banner {
  id           Int             @id @default(autoincrement())
  title        String
  subtitle     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  buttonLink   String?
  buttonText   String?
  description  String?
  displayOrder Int             @default(1)
  isActive     Boolean         @default(true)
  mediaType    BannerMediaType @default(IMAGE)
  mediaUrl     String
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  designation String
  biography   String?
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Membership {
  id Int @id @default(autoincrement())

  memberId String @unique
  fullName String
  email    String @unique
  mobile   String

  gender         String
  membershipType String

  city    String?
  state   String?
  country String?

  joinedDate DateTime?
  expiryDate DateTime?

  image String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id               Int       @id @default(autoincrement())
  title            String
  description      String
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  date             DateTime?
  displayOrder     Int       @default(0)
  isActive         Boolean   @default(true)
  location         String?
  shortDescription String?
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  eventDate   DateTime
  venue       String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Artist {
  id        Int      @id @default(autoincrement())
  name      String
  biography String?
  danceForm String
  city      String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id        Int      @id @default(autoincrement())
  title     String
  image     String
  createdAt DateTime @default(now())
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

model Contact {
  id Int @id @default(autoincrement())

  fullName String
  email    String
  phone    String?

  city    String?
  state   String?
  country String?

  subject     String?
  enquiryType String?

  message String

  status String @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  name        String
  designation String?
  company     String?
  message     String
  image       String?
  rating      Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id          Int         @id @default(autoincrement())
  name        String
  type        PartnerType
  logo        String
  website     String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model VolunteerRegistration {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String
  mobile       String?
  city         String?
  state        String?
  country      String?
  occupation   String?
  organization String?
  interests    String?
  experience   String?
  availability String?
  message      String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum BannerMediaType {
  IMAGE
  VIDEO
}

enum PartnerType {
  ACADEMIC_PARTNER
  TECHNOLOGY_PARTNER
  MEDIA_PARTNER
  EVENT_PARTNER
  SPONSOR
}

model MembershipEnquiry {
  id             Int       @id @default(autoincrement())
  photo          String?
  fullName       String
  stageName      String?
  email          String    @unique
  mobile         String
  gender         String?
  dateOfBirth    DateTime?
  occupation     String?
  biography      String?   @db.Text
  membershipType String?
  danceStyle     String?
  experience     String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  socialLinks    Json?
  message        String?   @db.Text

  registrations MemberRegistration[]

  registrationToken String?
  tokenExpiry       DateTime?

  remarks   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberRegistration {
  id        Int               @id @default(autoincrement())
  enquiryId Int
  enquiry   MembershipEnquiry @relation(fields: [enquiryId], references: [id])

  fullName    String
  stageName   String?
  gender      String?
  dateOfBirth DateTime?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  danceStyle  String?
  guru        String?
  experience  String?
  biography   String?   @db.Text
  socialLinks Json?
  document    String?

  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
